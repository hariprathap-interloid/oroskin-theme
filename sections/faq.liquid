{
  "name": "t:general.faq",
  "tag": "section",
  "class": "faq-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "blocks": [{ "type": "_faq-topic" }],
  "max_blocks": 12,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:labels.show_breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "How can we help?"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.italic_accent_info",
      "default": "Ask us <em>anything.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Find quick answers to your questions about our services, billing, or account setup. If you cannot find what you need, our team is always ready to assist you.</p>"
    },
    {
      "type": "url",
      "id": "ask_link",
      "label": "t:labels.faq_ask_link",
      "info": "t:labels.faq_ask_link_info"
    },
    {
      "type": "header",
      "content": "t:labels.faq_contact_header",
      "info": "t:labels.faq_contact_header_info"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "t:labels.faq_show_contact",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "t:labels.heading",
      "default": "Still unanswered?",
      "visible_if": "{{ section.settings.show_contact }}"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "t:labels.text",
      "default": "A real person replies within one working day — usually within the hour, Paris time.",
      "visible_if": "{{ section.settings.show_contact }}"
    },
    {
      "type": "text",
      "id": "contact_button_label",
      "label": "t:labels.button_label",
      "default": "Write message",
      "visible_if": "{{ section.settings.show_contact }}"
    },
    {
      "type": "url",
      "id": "contact_button_link",
      "label": "t:labels.button_link",
      "info": "t:labels.faq_contact_link_info"
    },
    {
      "type": "text",
      "id": "contact_second_label",
      "label": "t:labels.faq_second_label",
      "default": "Track order",
      "visible_if": "{{ section.settings.show_contact }}"
    },
    {
      "type": "url",
      "id": "contact_second_link",
      "label": "t:labels.faq_second_link",
      "info": "t:labels.faq_second_link_info"
    },
    {
      "type": "header",
      "content": "t:labels.style"
    },
    {
      "type": "range",
      "id": "question_radius",
      "label": "t:labels.faq_question_radius",
      "info": "t:labels.faq_question_radius_info",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.section_width.narrow"
        },
        {
          "value": "wide",
          "label": "t:options.section_width.wide"
        },
        {
          "value": "widest",
          "label": "t:options.section_width.widest"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "widest"
    },
    {
      "type": "checkbox",
      "id": "scale_screen",
