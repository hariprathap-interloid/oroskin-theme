{%- comment -%}
  Cart page (Figma "Cart"): breadcrumb, eyebrow + "Shopping bag" with the item count, then two columns:
  the items on the left, the cards (coupons, gift wrap, order summary) on the right. An empty cart shows
  a message and a link back to the shop instead.

  One <form id="CartForm"> holds the quantities; controls in the other column (the checkout button)
  join it with form="CartForm", so the page works without JavaScript: the browser posts the form to
  /cart and Shopify updates the cart or goes to checkout.

  M7.1 builds the frame. The item cards (M7.2), free-shipping bar (M7.3), order summary (M7.4), coupons
  (M7.5) and gift wrap (M7.6) replace the simple placeholders marked below.
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-1'

  # An empty Heading falls back to the translated word "Cart"
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'cart.title' | t
  endif

  assign continue_url = section.settings.continue_link
  if continue_url == blank
    assign continue_url = routes.all_products_collection_url
  endif

  # Free shipping (M7.3; the Order summary's Shipping row uses free_shipping_unlocked too).
  # The setting is in the store's own currency; Liquid has no exchange rates, so the bar only shows
  # when the visitor pays in that currency (in another currency a wrong promise is worse than none).
  # All money in Liquid is in cents: 200 -> 20000.
  assign show_free_shipping = false
  assign free_shipping_unlocked = false
  if section.settings.show_free_shipping and section.settings.free_shipping_threshold > 0
    if cart.currency.iso_code == shop.currency
      assign show_free_shipping = true
      assign threshold = section.settings.free_shipping_threshold | times: 100
      assign remaining = threshold | minus: cart.total_price
      if remaining <= 0
        assign free_shipping_unlocked = true
      endif
      # Bar fill in %: total / threshold, never over 100
      assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
    endif
  endif
-%}

<cart-page
  class="cart-page full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}"
  style="--color-accent: {{ section.settings.highlight_color }}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-section-id="{{ section.id }}"
  data-label-updated="{{ 'cart.updated' | t }}"
  data-label-error="{{ 'cart.error' | t }}"
  data-label-selected="{{ 'cart.selected_count' | t }}"
  data-label-coupon-applied="{{ 'cart.coupon_applied' | t }}"
  data-label-coupon-invalid="{{ 'cart.coupon_invalid' | t }}"
  data-label-coupon-exists="{{ 'cart.coupon_exists' | t }}"
  data-label-coupon-remove="{{ 'cart.coupon_remove' | t: code: '[code]' }}"
>
  {%- comment -%}
    Screen reader announcements ("Cart updated" or the error). Outside .cart-page__inner, which the
    script swaps for the new version after each change, so the message isn't lost in the swap.
  {%- endcomment -%}
  <p class="visually-hidden" role="status" data-cart-status></p>

  <div class="cart-page__inner">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="cart-page__breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
        <ol>
          <li><a href="{{ routes.root_url }}">{{ 'accessibility.home' | t }}</a></li>
          <li aria-current="page">{{ 'cart.title' | t }}</li>
        </ol>
      </nav>
    {%- endif -%}

    <header class="cart-page__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow cart-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="cart-page__title" tabindex="-1" data-cart-heading>
        {{- heading | escape -}}
        {%- unless cart.empty? -%}
          {%- comment -%} The small raised number is for sight only; screen readers hear "(2 items)" {%- endcomment -%}
          <sup class="cart-page__count" aria-hidden="true">{{ cart.item_count }}</sup>
          <span class="visually-hidden">({{ 'cart.item_count' | t: count: cart.item_count }})</span>
        {%- endunless -%}
      </h1>
    </header>

    {%- if cart.empty? -%}
      <div class="cart-page__empty">
        <p class="cart-page__empty-title h3">{{ 'cart.empty_title' | t }}</p>
        <p class="cart-page__empty-text">{{ 'cart.empty_text' | t }}</p>
        <a class="button" href="{{ continue_url }}">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <div class="cart-page__layout">
        <div class="cart-page__main">
          {%- if show_free_shipping -%}
            {%- comment -%}
              "You've unlocked free shipping   $285 / $200" with a bar below. The sentence says it all,
              so the bar itself is hidden from screen readers. Re-rendered with the rest of the cart.
            {%- endcomment -%}
            <div class="cart-shipping{% if free_shipping_unlocked %} is-unlocked{% endif %}">
              <p class="cart-shipping__message">
                {{- 'icon-truck.svg' | inline_asset_content -}}
                {%- if free_shipping_unlocked -%}
                  {{ 'cart.free_shipping_unlocked' | t }}
                {%- else -%}
                  {%- comment -%} Format the amount first: a filter can't go inside another filter's argument {%- endcomment -%}
                  {%- assign remaining_money = remaining | money -%}
                  {{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}
                {%- endif -%}
              </p>
              <p class="cart-shipping__amounts">
                {{ cart.total_price | money_without_trailing_zeros }} / {{ threshold | money_without_trailing_zeros }}
              </p>
              <div class="cart-shipping__bar" aria-hidden="true">
                <span class="cart-shipping__fill" style="--progress: {{ progress }}%;"></span>
              </div>
            </div>
          {%- endif -%}

          <form id="CartForm" class="cart-page__form" action="{{ routes.cart_url }}" method="post" novalidate>
            {%- comment -%} Shown by the script once at least one item is ticked {%- endcomment -%}
            <div class="cart-page__toolbar" data-cart-toolbar hidden>
              <span data-cart-selected-count></span>
              <button type="button" class="button button--text" data-cart-remove-selected data-cart-focus="remove-selected">
                {{- 'cart.remove_selected' | t -}}
              </button>
            </div>

            <p class="cart-page__error" role="alert" data-cart-error hidden></p>

            <ul class="cart-page__items" role="list">
              {%- for item in cart.items -%}
                {% render 'cart-item', item: item, index: forloop.index %}
              {%- endfor -%}
            </ul>

            {%- comment -%} Without JavaScript, this button saves changed quantities (the script updates them on its own) {%- endcomment -%}
            <button type="submit" class="button button--secondary cart-page__update" name="update">{{ 'cart.update' | t }}</button>
          </form>
        </div>

        <aside class="cart-page__aside" aria-label="{{ 'cart.summary' | t }}">
          {%- if section.settings.show_coupons -%}
            {%- comment -%}
              Coupons (Figma): a code field with Apply, then the codes that are working, each with its
              saving and a remove button. With JavaScript, Apply updates the cart in place (cart-page
              script, /cart/update.js "discount"). Without it, the form goes to checkout with the code
              (/checkout?discount=CODE), where Shopify applies it.
              Liquid only knows the codes that apply: cart.discount_applications of type
              "discount_code" (a wrong or not-yet-valid code simply isn't listed).
            {%- endcomment -%}
            {%- assign applied_codes = cart.discount_applications | where: 'type', 'discount_code' -%}
            <div class="cart-card cart-coupon">
              <h2 class="cart-card__title">{{ 'cart.coupons' | t }}</h2>

              <form class="cart-coupon__form" action="/checkout" method="get" data-cart-coupon>
                <label class="visually-hidden" for="CartCoupon">{{ 'cart.coupon_label' | t }}</label>
                <input
                  class="cart-coupon__input"
                  id="CartCoupon"
                  type="text"
                  name="discount"
                  placeholder="{{ 'cart.coupon_placeholder' | t }}"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  required
                  data-cart-focus="coupon-input"
                >
                <button type="submit" class="button cart-coupon__apply" data-cart-focus="coupon-apply">
                  {{- 'cart.apply' | t -}}
                  {{- 'icon-send.svg' | inline_asset_content -}}
                </button>
              </form>

              <p class="cart-coupon__message" role="alert" data-cart-coupon-message hidden></p>

              {%- comment -%}
                Always output (empty = hidden by CSS): the script adds the codes Liquid can't see, such
                as free-shipping codes, which only take effect at checkout.
              {%- endcomment -%}
              <ul class="cart-coupon__codes" role="list" data-cart-coupon-codes>
                  {%- for application in applied_codes -%}
                    <li class="cart-coupon__code" data-coupon-code="{{ application.title | escape }}">
                      <span class="cart-coupon__name">{{ application.title | escape }}</span>
                      {%- comment -%} Free-shipping codes save nothing in the cart; the saving shows at checkout {%- endcomment -%}
                      {%- if application.total_allocated_amount > 0 -%}
                        <span class="cart-coupon__saving">−{{ application.total_allocated_amount | money }}</span>
                      {%- endif -%}
                      <button
                        type="button"
                        class="cart-coupon__remove"
                        data-cart-coupon-remove="{{ application.title | escape }}"
                        aria-label="{{ 'cart.coupon_remove' | t: code: application.title }}"
                      >
                        <span aria-hidden="true">×</span>
                      </button>
                    </li>
                  {%- endfor -%}
              </ul>

              {%- comment -%} Copied by the script for a code Liquid can't list (e.g. free shipping) {%- endcomment -%}
              <template data-cart-coupon-template>
                <li class="cart-coupon__code" data-coupon-code="">
                  <span class="cart-coupon__name"></span>
                  <span class="cart-coupon__saving">{{ 'cart.coupon_at_checkout' | t }}</span>
                  <button type="button" class="cart-coupon__remove" data-cart-coupon-remove="" aria-label="">
                    <span aria-hidden="true">×</span>
                  </button>
                </li>
              </template>
            </div>
          {%- endif -%}

          {%- comment -%}
            Gift wrap (Figma "Buying for a loved one?"): the wrap styles are real products, one per
            "Wrap style" block (the price and photo come from the product). "Add gift wrap" turns the
            card into a small form (Figma, no popup): pick a style, write a free message, Save. The script adds that product to the
            cart (and removes another wrap if there was one) and saves the message as the cart
            attribute "Gift message", which the merchant sees on the order (Additional details).
            Needs JavaScript (the switch and the save), so it's hidden without it.
          {%- endcomment -%}
          {%- liquid
            assign wrap_blocks = section.blocks | where: 'type', 'wrap_style'

            # The wrap products, as "|id|" marks, to spot wrap lines in the cart
            assign wrap_ids = ''
            for wrap_block in wrap_blocks
              if wrap_block.settings.product != blank
                assign wrap_ids = wrap_ids | append: '|' | append: wrap_block.settings.product.id | append: '|'
              endif
            endfor

            # Wrap lines already in the cart (normally one): their keys and variant ids, for the script
            assign wrap_line = blank
            assign wrap_keys = ''
            assign wrap_variants = ''
            for item in cart.items
              assign mark = '|' | append: item.product_id | append: '|'
              if wrap_ids contains mark
                if wrap_line == blank
                  assign wrap_line = item
                endif
                assign wrap_keys = wrap_keys | append: item.key | append: ','
                assign wrap_variants = wrap_variants | append: item.variant_id | append: ','
              endif
            endfor

            # Fixed attribute name: it's data on the order, read by the merchant, not shopper text
            assign gift_message = cart.attributes['Gift message']
          -%}
          {%- if section.settings.show_gift_wrap and wrap_ids != '' -%}
            <div
              class="cart-card cart-gift{% if wrap_line != blank %} cart-gift--saved{% endif %}"
              data-cart-gift
              data-wrap-keys="{{ wrap_keys }}"
              data-wrap-variants="{{ wrap_variants }}"
            >
              {%- comment -%}
                Two states in the same card (Figma): the summary (title, text, Add gift wrap, ribbon) and,
                after "Add gift wrap" / "Edit", the form in its place (styles, message, Cancel / Save).
              {%- endcomment -%}
              <div class="cart-gift__summary" data-cart-gift-summary>
              {%- comment -%} Decorative ribbon: a gold band with the bow at its top (Figma) {%- endcomment -%}
              <div class="cart-gift__ribbon" aria-hidden="true">
                <img class="cart-gift__bow" src="{{ 'cart-gift-ribbon.png' | asset_url }}" alt="" width="676" height="369" loading="lazy">
              </div>

              <div class="cart-gift__body">
                {%- if wrap_line != blank -%}
                  {%- comment -%}
                    Saved state (Figma): "Gift wrapping", the wrap (photo, name, price), the message,
                    then Remove on the left and EDIT ↗ on the right.
                  {%- endcomment -%}
                  {%- if section.settings.gift_saved_title != blank -%}
                    <h2 class="cart-gift__title">{{ section.settings.gift_saved_title | escape }}</h2>
                  {%- endif -%}
                  <div class="cart-gift__item">
                    <span class="cart-gift__style-image">
                      {%- if wrap_line.image != blank -%}
                        {{ wrap_line.image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', widths: '80, 160' }}
                      {%- endif -%}
                    </span>
                    <p class="cart-gift__item-name">{{ wrap_line.product.title | escape }}</p>
                    <p class="cart-gift__item-price">{{ wrap_line.final_line_price | money }}</p>
                    {%- if gift_message != blank -%}
                      {%- comment -%} One line, like the design: long messages are cut with "..." {%- endcomment -%}
                      <p class="cart-gift__message">
                        <span class="cart-gift__message-label">{{ 'cart.gift_message' | t }}</span>
                        “{{ gift_message | truncate: 30 | escape }}”
                      </p>
                    {%- endif -%}
                  </div>
                  <div class="cart-gift__links">
                    <button type="button" class="cart-gift__remove" data-cart-gift-remove data-cart-focus="gift-remove">
                      {{- 'cart.gift_remove' | t -}}
                    </button>
                    <button type="button" class="cart-gift__link" data-cart-gift-open data-cart-focus="gift-open" aria-controls="CartGiftPanel" aria-expanded="false">
                      {{- 'cart.gift_edit' | t -}}
                      <span class="cart-gift__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
                    </button>
                  </div>
                {%- else -%}
                  {%- if section.settings.gift_title != blank -%}
                    <h2 class="cart-gift__title">{{ section.settings.gift_title | escape }}</h2>
                  {%- endif -%}
                  {%- if section.settings.gift_text != blank -%}
                    <p class="cart-gift__text">{{ section.settings.gift_text | escape }}</p>
                  {%- endif -%}
                  <button type="button" class="cart-gift__link" data-cart-gift-open data-cart-focus="gift-open" aria-controls="CartGiftPanel" aria-expanded="false">
                    {{- 'cart.gift_add' | t -}}
                    <span class="cart-gift__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
                  </button>
                {%- endif -%}
              </div>
              </div>

              <div class="cart-gift__panel" id="CartGiftPanel" data-cart-gift-panel hidden>
                <form class="cart-gift__form" data-cart-gift-form>
                  <img class="cart-gift__corner-bow" src="{{ 'cart-gift-ribbon.png' | asset_url }}" alt="" width="676" height="369" loading="lazy">

                  <fieldset class="cart-gift__styles">
                    <legend class="cart-gift__label" id="CartGiftHeading">{{ 'cart.gift_choose' | t }}</legend>
                    {%- for wrap_block in wrap_blocks -%}
                      {%- assign wrap_product = wrap_block.settings.product -%}
                      {%- if wrap_product != blank and wrap_product.available -%}
                        {%- liquid
                          assign wrap_variant = wrap_product.selected_or_first_available_variant
                          assign wrap_price = wrap_variant.price | money
                        -%}
                        <label class="cart-gift__style" {{ wrap_block.shopify_attributes }}>
                          <input
                            class="cart-gift__radio"
                            type="radio"
                            name="wrap"
                            value="{{ wrap_variant.id }}"
                            required
                            {% if wrap_line != blank and wrap_line.variant_id == wrap_variant.id %}
                              checked
                            {% endif %}
                          >
                          <span class="cart-gift__style-image">
                            {%- if wrap_product.featured_image != blank -%}
                              {{ wrap_product.featured_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', widths: '80, 160' }}
                            {%- endif -%}
                          </span>
                          <span class="cart-gift__style-name">{{ 'cart.gift_style' | t: title: wrap_product.title, price: wrap_price }}</span>
                        </label>
                      {%- endif -%}
                    {%- endfor -%}
                  </fieldset>

                  <label class="cart-gift__label" for="CartGiftMessage">{{ 'cart.gift_message_label' | t }}</label>
                  <textarea
                    class="cart-gift__textarea"
                    id="CartGiftMessage"
                    name="message"
                    rows="3"
                    maxlength="300"
                    placeholder="{{ 'cart.gift_message_placeholder' | t }}"
                  >{{ gift_message | escape }}</textarea>

                  <p class="cart-gift__error" role="alert" data-cart-gift-error hidden></p>

                  <div class="cart-gift__actions">
                    <button type="button" class="cart-gift__cancel" data-cart-gift-close>{{ 'cart.gift_cancel' | t }}</button>
                    <button type="submit" class="button cart-gift__save">{{ 'cart.gift_save' | t }}</button>
                  </div>
                </form>
              </div>
            </div>
          {%- endif -%}

          {%- comment -%}
            Order summary (Figma). Subtotal = before order discounts; order-level discounts listed;
            shipping FREE once the free-shipping amount is reached (M7.3), otherwise worked out at
            checkout; tax is never known before checkout (it depends on the address), so it says so.
          {%- endcomment -%}
          <div class="cart-card cart-summary">
            <h2 class="cart-card__title">{{ 'cart.summary' | t }}</h2>

            <dl class="cart-summary__rows">
              <div class="cart-summary__row">
                <dt>{{ 'cart.subtotal' | t }}</dt>
                <dd>{{ cart.items_subtotal_price | money }}</dd>
              </div>

              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="cart-summary__row cart-summary__row--discount">
                  <dt>{{ discount.title | escape }}</dt>
                  <dd>−{{ discount.total_allocated_amount | money }}</dd>
                </div>
              {%- endfor -%}

              <div class="cart-summary__row">
                <dt>{{ 'cart.shipping' | t }}</dt>
                {%- if free_shipping_unlocked -%}
                  <dd class="cart-summary__free">{{ 'cart.free' | t }}</dd>
                {%- else -%}
                  <dd class="cart-summary__later">{{ 'cart.at_checkout' | t }}</dd>
                {%- endif -%}
              </div>

              <div class="cart-summary__row">
                <dt>{{ 'cart.tax' | t }}</dt>
                {%- if cart.taxes_included -%}
                  <dd class="cart-summary__later">{{ 'cart.tax_included' | t }}</dd>
                {%- else -%}
                  <dd class="cart-summary__later">{{ 'cart.at_checkout' | t }}</dd>
                {%- endif -%}
              </div>

              <div class="cart-summary__row cart-summary__row--total">
                <dt>{{ 'cart.total' | t }}</dt>
                {%- comment -%} With more than one currency on sale, the code (USD, EUR) avoids "which dollar?" {%- endcomment -%}
                <dd>
                  {%- if shop.enabled_currencies.size > 1 -%}
                    {{ cart.total_price | money_with_currency }}
                  {%- else -%}
                    {{ cart.total_price | money }}
                  {%- endif -%}
                </dd>
              </div>
            </dl>

            {%- if section.settings.show_note -%}
              {%- comment -%}
                Cart note (Theme Store): saved when the visitor checks out (it's part of CartForm) and,
                with JavaScript, as soon as they leave the field (cart-page script).
              {%- endcomment -%}
              <details class="cart-summary__note"{% if cart.note != blank %} open{% endif %}>
                <summary>{{ 'cart.note_label' | t }}</summary>
                <label class="visually-hidden" for="CartNote">{{ 'cart.note_label' | t }}</label>
                <textarea id="CartNote" name="note" form="CartForm" rows="3" data-cart-note>{{ cart.note | escape }}</textarea>
              </details>
            {%- endif -%}

            <button type="submit" class="button cart-summary__checkout" name="checkout" form="CartForm">
              {{- 'cart.proceed_to_checkout' | t -}}
              {{- 'icon-send.svg' | inline_asset_content -}}
            </button>

            {%- comment -%}
              Express checkout (Shop Pay, PayPal, Apple Pay...): Shopify draws these buttons for the
              payment methods the store has turned on. On by default (Theme Store).
            {%- endcomment -%}
            {%- if section.settings.show_express_checkout and additional_checkout_buttons -%}
              <div class="cart-summary__express">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}

            <a class="cart-summary__continue" href="{{ continue_url }}">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
              {{- 'cart.continue_shopping' | t -}}
            </a>
          </div>
        </aside>
      </div>
    {%- endif -%}
  </div>
</cart-page>

{% stylesheet %}
  /* At least one screen tall (Figma: the cart fills the first screen, the footer comes after a scroll) */
  .cart-page {
    display: block;
    min-block-size: 100svh;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  .cart-page__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  /* "HOME > CART": small capitals, the current page in the accent colour (Figma) */
  .cart-page__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .cart-page__breadcrumb li + li::before {
    content: "›";
    margin-inline-end: var(--space-xs);
    color: var(--color-text);
  }

  .cart-page__breadcrumb a {
    color: var(--color-text);
    text-decoration: none;
  }

  .cart-page__breadcrumb a:hover {
    text-decoration: underline;
  }

  .cart-page__breadcrumb [aria-current] {
    color: var(--color-accent);
  }

  .cart-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* The Figma eyebrow here has no rule in front of the label */
  .cart-page__eyebrow {
    margin: 0;
  }

  .cart-page__eyebrow::before {
    display: none;
  }

  .cart-page__title {
    margin: 0;
    font-size: var(--font-size-h2);
  }

  /* "Shopping bag²": the count sits raised and small, without pushing the line height */
  .cart-page__count {
    margin-inline-start: 0.15em;
    font-size: 0.55em;
    line-height: 0;
    vertical-align: super;
  }

  /*
    Items left, cards right. Figma at 1920px: items ~1126px, cards ~556px, ~140px apart, so the cards
    column is fixed-ish and the items column takes the rest.
  */
  .cart-page__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(20rem, 29vw, 34.75rem);
    gap: clamp(var(--space-xl), 7vw, 8.75rem);
    align-items: start;
  }

  .cart-page__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /*
    Right-hand cards (Coupons, Gift wrap, Order summary): a soft gold tint of the page background,
    ~25px corners, ~40px padding at 1920px (Figma).
  */
  .cart-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: clamp(var(--space-lg), 2.1vw, 2.5rem);
    border-radius: var(--radius-md);
    background-color: color-mix(in srgb, var(--color-accent) 12%, var(--color-background));
  }

  .cart-card__title {
    margin: 0;
    font-size: var(--font-size-h3);
  }

  /*
    Coupons (Figma): one white pill holding the code field and, at its right end, the gold "Apply"
    pill with the paper plane. The field resets the global input rule with two classes (the global
    input[type="text"] rule beats a single class).
  */
  /*
    Figma: no inset around the field or the button. The pill is exactly as tall as the button (50px),
    the gold Apply sits flush in its right end, and only the text has room on the left.
    overflow: hidden keeps the button's square-ish ends inside the pill's round edge.
  */
  .cart-coupon__form {
    display: flex;
    align-items: stretch;
    min-block-size: 3.125rem;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, #ffffff 70%, transparent);
    box-shadow:
      0 4px 10px 0 #b9b9b91a,
      inset 1px 1px 0 #ffffffcc;
  }

  .cart-coupon__form:has(.cart-coupon__input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .cart-coupon__form .cart-coupon__input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: 0;
    margin: 0;
    padding-block: 0; /* the field fills the pill's height, so the text sits in the middle */
    padding-inline: 1.75rem var(--space-sm);
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--color-text);
    font-size: var(--font-size-body-sm);
  }

  .cart-coupon__form .cart-coupon__input:focus-visible {
    outline: none;
  }

  .cart-coupon__apply {
    --color-button: var(--color-accent);
    --color-button-border: var(--color-accent);
    --color-button-text: #ffffff;
    flex: none;
    margin: 0;
    gap: var(--space-xs);
    min-block-size: 0; /* takes the pill's height (stretch) instead of its own 50px */
  }

  .cart-coupon__apply svg {
    inline-size: 1.1em;
    block-size: auto;
  }

  /* Result under the field: gold when applied, red when not */
  .cart-coupon__message {
    margin: 0;
    font-size: var(--font-size-small);
  }

  .cart-coupon__message[data-tone='success'] {
    color: var(--color-accent);
  }

  .cart-coupon__message[data-tone='error'] {
    color: var(--color-error, #b3261e);
  }

  .cart-coupon__codes:empty {
    display: none;
  }

  /* Working codes: small pills "SAVE10  -$5.00  x" */
  .cart-coupon__codes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-coupon__code {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.25rem 0.25rem 0.25rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 50%, transparent);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-accent) 12%, var(--color-background));
    font-size: var(--font-size-small);
  }

  .cart-coupon__name {
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cart-coupon__saving {
    color: var(--color-accent);
  }

  .cart-coupon__remove {
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-text);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .cart-coupon__remove:hover {
    background-color: color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  /*
    Gift wrap card (Figma): Glass (Light -7deg 80% = the theme's --glass-rim, Frost 100 = 35px blur)
    over a soft gold tint with a light patch, a gold ribbon band near the right edge with the bow at its
    top. The text keeps clear of the ribbon. Needs JavaScript, so it's hidden without it.
  */
  .no-js .cart-gift {
    display: none;
  }

  .cart-gift {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-inline-end: 34%;
    /*
      Figma fill: a diagonal gold > light gold > white > light gold > gold sweep, every stop at 15%,
      over the page colour. Gold = the scheme accent (#C8A24B); light gold = accent mixed half with white (#E3D0A4).
    */
    --gift-gold: color-mix(in srgb, var(--color-accent) 15%, transparent);
    --gift-light: color-mix(in srgb, color-mix(in srgb, var(--color-accent) 50%, #ffffff) 15%, transparent);
    background:
      linear-gradient(
        115.33deg,
        var(--gift-gold) 2.78%,
        var(--gift-light) 25.41%,
        #ffffff26 48.72%,
        var(--gift-light) 73.66%,
        var(--gift-gold) 97.89%
      ),
      var(--color-background);
    box-shadow: var(--glass-rim);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  /* Figma ribbon: linear-gradient(180deg, #D9BB72 0%, #F7EED9 20.95%, #D9BB72 100%) */
  .cart-gift__ribbon {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 16%;
    z-index: -1;
    inline-size: 0.5rem;
    background: linear-gradient(180deg, #d9bb72 0%, #f7eed9 20.95%, #d9bb72 100%);
  }

  /* The bow fills ~37% of its (wide, transparent) image, so the image is ~2.7x the bow's width */
  .cart-gift__bow {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 50%;
    inline-size: 15rem;
    max-inline-size: none;
    block-size: auto;
    translate: -50% 0;
    pointer-events: none;
  }

  .cart-gift__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .cart-gift__title {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-body--family);
    font-size: var(--font-size-body); /* Figma: 20px at 1920 */
    font-weight: var(--font-weight-medium);
  }

  .cart-gift__text {
    margin: 0;
    font-size: var(--font-size-body-sm);
  }

  /* Saved state: content stops before the bow (Figma: the price ends ~50px left of the ribbon) */
  .cart-gift--saved {
    padding-inline-end: 27%;
  }

  .cart-gift--saved .cart-gift__body {
    align-items: stretch;
  }

  /* Photo | name | price, then the message under the name */
  .cart-gift__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: var(--space-md);
    row-gap: var(--space-xs);
  }

  /* Figma at 1920: name, message and Remove 16px, price 20px */
  .cart-gift__item-name,
  .cart-gift__item-price {
    margin: 0;
    font-size: var(--font-size-caption);
  }

  .cart-gift__item-price {
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
  }

  /* One line; the Liquid also shortens long messages so the closing quote usually stays visible */
  .cart-gift__message {
    grid-column: 2 / -1;
    margin: 0;
    overflow: hidden;
    font-size: var(--font-size-caption);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .cart-gift__message-label {
    color: var(--color-accent);
  }

  .cart-gift__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  /* "Remove": plain dark text (Figma), EDIT ↗ is the gold link on the right */
  .cart-gift__remove {
    margin-block-start: var(--space-sm);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font-size: var(--font-size-caption);
    cursor: pointer;
  }

  .cart-gift__remove:hover {
    text-decoration: underline;
  }

  /* "ADD GIFT WRAP ↗": gold capitals with a small arrow (the theme arrow turned up-right) */
  .cart-gift__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-sm);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-accent);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-nav);
    text-transform: uppercase;
    cursor: pointer;
  }

  .cart-gift__link:hover {
    text-decoration: underline;
  }

  .cart-gift__arrow svg {
    inline-size: 1em;
    block-size: auto;
    rotate: -45deg;
  }

  /*
    Open state (Figma): the same card shows the form instead of the summary. The ribbon band goes, the
    text gets the full width, and the bow moves to the top-right corner, tilted, half off the card
    (the card's overflow: hidden cuts it, as in the design).
  */
  .cart-gift.is-open {
    padding-inline-end: clamp(var(--space-lg), 2.1vw, 2.5rem);
  }

  .cart-gift__summary {
    display: contents;
  }

  .cart-gift__summary[hidden] {
    display: none;
  }

  .cart-gift__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Figma: the bow's knot sits ~50px in from the card's top and right edges; only the loops run off the edge */
  .cart-gift__corner-bow {
    position: absolute;
    inset-block-start: -0.75rem;
    inset-inline-end: -5.5rem;
    z-index: -1;
    inline-size: 18rem;
    max-inline-size: none;
    block-size: auto;
    rotate: 25deg;
    pointer-events: none;
  }

  .cart-gift__styles {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cart-gift__label {
    margin-block-end: var(--space-xs);
    padding: 0;
    color: var(--color-accent);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-medium);
  }

  /* One style: round radio, photo, "Signature Blush Box (+$5.00)" */
  .cart-gift__style {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    cursor: pointer;
  }

  .cart-gift__style .cart-gift__radio {
    flex: none;
    display: grid;
    place-content: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    margin: 0;
    border: 1px solid #ffffffcc;
    border-radius: 50%;
    background-color: #ffffffd9;
    box-shadow: 0 2px 6px #b9b9b94d;
    appearance: none;
    cursor: pointer;
  }

  .cart-gift__style .cart-gift__radio::after {
    content: "";
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    scale: 0;
    transition: scale var(--duration-fast) var(--ease-out);
  }

  .cart-gift__style .cart-gift__radio:checked::after {
    scale: 1;
  }

  .cart-gift__style-image {
    flex: none;
    inline-size: 3.25rem;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 0.25rem;
    background-color: var(--color-tint, #f3ede2);
  }

  /* Bigger in the style list, where the photo helps choose */
  .cart-gift__style .cart-gift__style-image {
    inline-size: 5rem;
    border-radius: 0.375rem;
  }

  .cart-gift__style-image img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Two classes: the global textarea rule would otherwise win (see the coupon field) */
  .cart-gift__form .cart-gift__textarea {
    min-block-size: 6.5rem;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid #ffffffcc;
    border-radius: var(--radius-md);
    background-color: #ffffff99;
    box-shadow: inset 0 1px 3px #b9b9b933;
    resize: vertical;
  }

  .cart-gift__error {
    margin: 0;
    color: var(--color-error, #b3261e);
    font-size: var(--font-size-small);
  }

  .cart-gift__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-start: var(--space-sm);
  }

  .cart-gift__cancel {
    padding: var(--space-sm) var(--space-md);
    border: 0;
    background: none;
    color: var(--color-text);
    font-size: var(--font-size-body);
    cursor: pointer;
  }

  .cart-gift__cancel:hover {
    text-decoration: underline;
  }

  .cart-gift__save {
    --color-button: var(--color-accent);
    --color-button-border: var(--color-accent);
    --color-button-text: #ffffff;
    margin: 0;
  }

  /* Rows: label left, amount right */
  .cart-summary__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: 0;
    font-size: var(--font-size-body-sm);
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .cart-summary__row dt,
  .cart-summary__row dd {
    margin: 0;
  }

  .cart-summary__row dd {
    text-align: end;
  }

  .cart-summary__row--discount,
  .cart-summary__free {
    color: var(--color-accent);
  }

  .cart-summary__later {
    color: color-mix(in srgb, var(--color-text) 65%, var(--color-background));
  }

  /* Total: bigger, with more space above (Figma) */
  .cart-summary__row--total {
    margin-block-start: var(--space-sm);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-medium);
  }

  /* "Add a note to your order": a quiet line that opens a text box */
  .cart-summary__note summary {
    color: var(--color-accent);
    font-size: var(--font-size-body-sm);
    cursor: pointer;
  }

  .cart-summary__note textarea {
    margin-block-start: var(--space-sm);
  }

  /* Proceed to checkout: the gold pill with the paper plane (Figma); the button reads its colours from these */
  .cart-summary__checkout {
    --color-button: var(--color-accent);
    --color-button-border: var(--color-accent);
    --color-button-text: #ffffff;
    inline-size: 100%;
    gap: var(--space-sm);
  }

  .cart-summary__checkout svg {
    inline-size: 1.1em;
    block-size: auto;
  }

  /* Shopify's express buttons fill the card's width */
  .cart-summary__express :is(.additional-checkout-buttons, shopify-accelerated-checkout-cart) {
    --shopify-accelerated-checkout-button-border-radius: var(--radius-pill);
    inline-size: 100%;
  }

  /* "<- Continue shopping": the theme arrow turned to point left */
  .cart-summary__continue {
    display: inline-flex;
    align-items: center;
    align-self: center;
    gap: var(--space-xs);
    color: var(--color-text);
    font-size: var(--font-size-body-sm);
    text-decoration: none;
  }

  .cart-summary__continue:hover {
    text-decoration: underline;
  }

  .cart-summary__continue svg {
    inline-size: 1em;
    block-size: auto;
    rotate: 180deg;
  }

  .cart-page__title:focus {
    outline: none;
  }

  /*
    Free-shipping bar (Figma): truck + gold sentence on the left, "$285 / $200" on the right, a
    rounded bar below that fills with the accent colour.
  */
  .cart-shipping {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    margin-block-end: var(--space-xl);
  }

  .cart-shipping__message,
  .cart-shipping__amounts {
    margin: 0;
    font-size: var(--font-size-body-lg);
  }

  .cart-shipping__message {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-accent);
  }

  .cart-shipping__message svg {
    flex: none;
    inline-size: 1.5rem;
    block-size: auto;
  }

  .cart-shipping__amounts {
    font-weight: var(--font-weight-medium);
  }

  .cart-shipping__bar {
    grid-column: 1 / -1;
    block-size: 0.5rem;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-accent) 18%, var(--color-background));
  }

  /* The fill grows from the old width to the new one when the cart is re-rendered after a change */
  .cart-shipping__fill {
    display: block;
    inline-size: var(--progress);
    block-size: 100%;
    border-radius: inherit;
    background-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cart-shipping__fill {
      animation: cart-shipping-fill 0.8s var(--ease-out);
    }
  }

  @keyframes cart-shipping-fill {
    from {
      inline-size: 0;
    }
  }

  .cart-page__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: 0 0 var(--space-lg);
    padding: 0;
    list-style: none;
  }

  /* "2 selected   Remove selected" above the list */
  .cart-page__toolbar:not([hidden]) {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-block-end: var(--space-md);
  }

  .cart-page__error {
    margin: 0 0 var(--space-md);
    color: var(--color-error, #b3261e);
  }

  /* The script saves quantities on its own; the Update button is only for visitors without JavaScript */
  .js .cart-page__update {
    display: none;
  }

  .cart-page__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    padding-block: var(--space-2xl);
  }

  .cart-page__empty-title,
  .cart-page__empty-text {
    margin: 0;
  }

  /* Tablets and phones: one column, the cards under the items (no mobile design yet, decision 7) */
  @media (max-width: 989px) {
    .cart-page__layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <cart-page>: changes the cart without reloading the page.
   *
   * Every change (- / +, a typed quantity, remove, remove selected) goes to Shopify's Cart AJAX API
   * together with `sections`: Shopify answers with the updated cart AND this section (and the header)
   * rendered again in Liquid. The script swaps in the new HTML, so prices, totals and counts always come
   * from Shopify, never from JavaScript maths. Focus goes back to the same control after the swap.
   *
   * Without JavaScript the page still works: the form posts to /cart (Update / Checkout) and the remove
   * buttons are plain links.
   */
  class CartPage extends HTMLElement {
    connectedCallback() {
      this.root = window.Shopify?.routes?.root || '/';
      this.status = this.querySelector('[data-cart-status]');

      // One set of listeners on the element itself: they keep working after the inner HTML is swapped
      this.addEventListener('click', (event) => this.onClick(event));
      this.addEventListener('change', (event) => this.onChange(event));
      this.addEventListener('submit', (event) => {
        // Gift wrap form: "Save wrap" (saved by the script; the form has no action of its own)
        if (event.target.matches('[data-cart-gift-form]')) {
          event.preventDefault();
          this.saveGift(event.target);
          return;
        }
        // Coupon form: apply here; the form's own target (/checkout?discount=...) is the no-JS fallback
        if (!event.target.matches('[data-cart-coupon]')) return;
        event.preventDefault();
        const code = event.target.querySelector('[name="discount"]').value.trim();
        if (code) this.applyCoupon(code);
      });

      if (this.querySelector('[data-cart-coupon]')) this.loadCodes();
      this.addEventListener('keydown', (event) => {
        // Enter in a quantity field saves it here instead of submitting the whole form; focus stays
        // in the field (render() puts it back on the new copy)
        if (event.key === 'Enter' && event.target.matches('[data-cart-quantity]')) {
          event.preventDefault();
          this.queueQuantity(event.target, 0);
        }
      });
    }

    onClick(event) {
      const step = event.target.closest('[data-cart-step]');
      if (step) {
        const input = step.closest('.cart-item').querySelector('[data-cart-quantity]');
        // The minus stops at 1: removing a product is the bin's job (the minus is disabled at 1)
        input.value = Math.max(1, Number(input.value) + Number(step.dataset.cartStep));
        this.queueQuantity(input);
        return;
      }

      const remove = event.target.closest('[data-cart-remove]');
      if (remove) {
        event.preventDefault(); // the link is the no-JavaScript fallback
        this.change({ [remove.closest('.cart-item').dataset.lineKey]: 0 }, remove.closest('.cart-item'));
        return;
      }

      if (event.target.closest('[data-cart-remove-selected]')) {
        const updates = {};
        this.querySelectorAll('[data-cart-select]:checked').forEach((box) => (updates[box.value] = 0));
        this.change(updates);
        return;
      }

      const removeCode = event.target.closest('[data-cart-coupon-remove]');
      if (removeCode) {
        this.removeCoupon(removeCode.dataset.cartCouponRemove);
        return;
      }

      // Gift wrap: switch the card to its form and back, or take the wrap off
      if (event.target.closest('[data-cart-gift-open]')) {
        this.toggleGift(true);
        return;
      }
      if (event.target.closest('[data-cart-gift-close]')) {
        this.toggleGift(false);
        return;
      }
      if (event.target.closest('[data-cart-gift-remove]')) this.removeGift();
    }

    /**
     * Figma: the gift card itself turns into the form (no popup). Open: hide the summary, show the
     * form, put focus on the first style. Close (Cancel or Esc): back, with focus on the button that
     * opened it, so a keyboard user isn't lost.
     */
    toggleGift(open) {
      const card = this.querySelector('[data-cart-gift]');
      const panel = card?.querySelector('[data-cart-gift-panel]');
      if (!panel) return;
      card.classList.toggle('is-open', open);
      card.querySelector('[data-cart-gift-summary]').hidden = open;
      panel.hidden = !open;
      card.querySelectorAll('[data-cart-gift-open]').forEach((button) => button.setAttribute('aria-expanded', String(open)));
      if (open) {
        panel.querySelector('[data-cart-gift-error]').hidden = true;
        (panel.querySelector('[name="wrap"]:checked') || panel.querySelector('[name="wrap"]'))?.focus();
        if (!this.giftEscape) {
          // Esc inside the form = Cancel
          this.giftEscape = (event) => {
            if (event.key === 'Escape' && event.target.closest('[data-cart-gift-panel]')) this.toggleGift(false);
          };
          this.addEventListener('keydown', this.giftEscape);
        }
      } else {
        card.querySelector('[data-cart-gift-open]')?.focus();
      }
    }

    /** The wrap lines in the cart now (keys and variant ids, written by Liquid on the gift card) */
    wrapLines() {
      const card = this.querySelector('[data-cart-gift]');
      const list = (value) => (value || '').split(',').filter(Boolean);
      const keys = list(card?.dataset.wrapKeys);
      const variants = list(card?.dataset.wrapVariants);
      return keys.map((key, index) => ({ key, variant: variants[index] }));
    }

    /**
     * Save wrap: add the chosen wrap product (unless it's already in the cart), take any other wrap
     * out, keep exactly one, and save the message as the "Gift message" cart attribute, then re-render.
     * Two requests: /cart/add.js only adds; the quantities and the attribute go in one update.
     */
    async saveGift(form) {
      const variant = form.querySelector('[name="wrap"]:checked')?.value;
      const message = form.querySelector('[name="message"]').value.trim();
      const errorBox = form.querySelector('[data-cart-gift-error]');
      if (!variant) return; // the radios are "required", so the browser asks for a choice first

      const lines = this.wrapLines();
      try {
        if (!lines.some((line) => line.variant === variant)) {
          const response = await fetch(`${this.root}cart/add.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [{ id: Number(variant), quantity: 1 }] }),
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.description || data.message || '');
        }
      } catch (error) {
        errorBox.textContent = error?.message || this.dataset.labelError;
        errorBox.hidden = false;
        return;
      }

      // Other wraps out; the chosen one (if it was already there) back to 1. The re-render brings the
      // card back in its summary state, now showing the wrap and the message.
      const updates = {};
      lines.forEach((line) => (updates[line.key] = line.variant === variant ? 1 : 0));
      await this.change(updates, null, { attributes: { 'Gift message': message } });
    }

    removeGift() {
      const updates = {};
      this.wrapLines().forEach((line) => (updates[line.key] = 0));
      this.change(updates, null, { attributes: { 'Gift message': '' } });
    }

    /**
     * The codes that work right now. Shopify's cart JSON lists every entered code with
     * "applicable": true / false; that's the truth. Liquid only sees codes that already change a price
     * (cart.discount_applications), so a free-shipping code, which only acts at checkout, would look
     * "not working" if we went by the page alone. Until the JSON has loaded, the page's list is used.
     */
    appliedCodes() {
      return this.codes ?? [...this.querySelectorAll('[data-coupon-code]')].map((el) => el.dataset.couponCode);
    }

    /** Reads the codes from a cart JSON (on load, and after every change) and shows any Liquid missed */
    setCodes(cart) {
      this.codes = (cart.discount_codes || []).filter((entry) => entry.applicable).map((entry) => entry.code);
      const list = this.querySelector('[data-cart-coupon-codes]');
      const template = this.querySelector('[data-cart-coupon-template]');
      if (!list || !template) return;
      const shown = [...list.querySelectorAll('[data-coupon-code]')].map((el) => el.dataset.couponCode.toLowerCase());
      for (const code of this.codes) {
        if (shown.includes(code.toLowerCase())) continue;
        const chip = template.content.firstElementChild.cloneNode(true);
        chip.dataset.couponCode = code;
        chip.querySelector('.cart-coupon__name').textContent = code;
        const remove = chip.querySelector('[data-cart-coupon-remove]');
        remove.dataset.cartCouponRemove = code;
        remove.setAttribute('aria-label', this.dataset.labelCouponRemove.replace('[code]', code));
        list.append(chip);
      }
    }

    /** On page load: ask Shopify which codes are in the cart (only when the coupon card is shown) */
    async loadCodes() {
      try {
        const cart = await fetch(`${this.root}cart.js`, { headers: { Accept: 'application/json' } }).then((r) => r.json());
        this.setCodes(cart);
      } catch (error) {
        // The page's own list stays; applying still works
      }
    }

    /**
     * Shopify's "discount" field replaces ALL codes, so a new code is sent together with the ones
     * already working. Shopify's answer says whether it applies (wrong, expired, scheduled, or the
     * cart doesn't qualify yet = not applicable), and the message says which.
     */
    async applyCoupon(code) {
      const same = (a) => a.toLowerCase() === code.toLowerCase();
      if (this.appliedCodes().some(same)) {
        this.couponMessage(this.dataset.labelCouponExists, code, 'error');
        return;
      }

      const cart = await this.change({}, null, { discount: [...this.appliedCodes(), code].join(',') });
      if (!cart) return;

      const applied = Boolean((cart.discount_codes || []).find((entry) => same(entry.code))?.applicable);
      this.couponMessage(applied ? this.dataset.labelCouponApplied : this.dataset.labelCouponInvalid, code, applied ? 'success' : 'error');
      if (!applied) {
        // Keep what they typed, so a typo can be fixed instead of retyped
        const input = this.querySelector('[data-cart-coupon] [name="discount"]');
        if (input) input.value = code;
      }
    }

    removeCoupon(code) {
      const rest = this.appliedCodes().filter((c) => c.toLowerCase() !== code.toLowerCase());
      this.change({}, null, { discount: rest.join(',') });
    }

    /** Shows the coupon result under the field (and, for screen readers, in the live region) */
    couponMessage(template, code, tone) {
      const box = this.querySelector('[data-cart-coupon-message]');
      const message = template.replace('[code]', code);
      if (box) {
        box.textContent = message;
        box.dataset.tone = tone;
        box.hidden = false;
      }
      this.announce(message);
    }

    onChange(event) {
      if (event.target.matches('[data-cart-quantity]')) this.queueQuantity(event.target, 0);
      if (event.target.matches('[data-cart-select]')) this.updateToolbar();
      if (event.target.matches('[data-cart-note]')) this.saveNote(event.target.value);
    }

    /**
     * Saves the cart note as soon as the visitor leaves the box ("change" fires then), so it isn't
     * lost if they go back to shopping. No re-render: nothing else on the page depends on the note.
     */
    async saveNote(note) {
      try {
        await fetch(`${this.root}cart/update.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ note }),
        });
      } catch (error) {
        // Still sent with the form when they check out
      }
    }

    /** Waits a moment, so clicking + three times sends one request with the final number */
    queueQuantity(input, delay = 400) {
      const line = input.closest('.cart-item');
      clearTimeout(line.saveTimer);
      line.saveTimer = setTimeout(() => {
        this.change({ [line.dataset.lineKey]: Math.max(0, Number(input.value) || 0) }, line);
      }, delay);
    }

    /** "2 selected  Remove selected" appears only while something is ticked */
    updateToolbar() {
      const toolbar = this.querySelector('[data-cart-toolbar]');
      const count = this.querySelectorAll('[data-cart-select]:checked').length;
      if (!toolbar) return;
      toolbar.hidden = count === 0;
      // "[count] selected" from the locale file, with the number filled in
      toolbar.querySelector('[data-cart-selected-count]').textContent = this.dataset.labelSelected.replace('[count]', count);
    }

    /**
     * updates = { lineKey: quantity, ... }. /cart/update.js accepts several lines at once and finds each
     * line by its key, so it works the same for one line or for "Remove selected".
     * extra = other cart fields to send in the same request (e.g. { discount: 'A,B' }).
     * Returns Shopify's cart JSON once the new cart is on the page, false if it failed or a newer
     * change won.
     */
    async change(updates, line, extra = {}) {
      const lines = line ? [line] : Object.keys(updates).map((key) => this.querySelector(`[data-line-key="${CSS.escape(key)}"]`));
      lines.forEach((el) => el?.classList.add('is-loading'));
      this.setAttribute('aria-busy', 'true');

      const header = document.querySelector('sticky-header')?.closest('.shopify-section');
      const sections = [this.dataset.sectionId, header?.id.replace('shopify-section-', '')].filter(Boolean);

      // Number every request. Two quick changes (e.g. on two lines) can come back in the wrong order;
      // only the newest answer is shown, so an older cart never replaces a newer one.
      const requestId = (this.latestRequest = (this.latestRequest || 0) + 1);

      try {
        const response = await fetch(`${this.root}cart/update.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ updates, ...extra, sections, sections_url: window.location.pathname }),
        });
        const data = await response.json();
        // Shopify explains a refused change (e.g. not enough stock) in "description" or "message"
        if (!response.ok) throw new Error(data.description || data.message || '');
        if (requestId !== this.latestRequest) return false; // a newer change is on its way; it will render

        this.render(data.sections, sections, header);
        this.setCodes(data); // the fresh card only lists what Liquid sees; add e.g. free-shipping codes
        this.announce(this.dataset.labelUpdated);
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: data } }));
        return data;
      } catch (error) {
        if (requestId !== this.latestRequest) return false;
        lines.forEach((el) => el?.classList.remove('is-loading'));
        const message = error?.message || this.dataset.labelError;
        const box = this.querySelector('[data-cart-error]');
        if (box) {
          box.textContent = message;
          box.hidden = false;
        }
        this.announce(message);
        return false;
      } finally {
        if (requestId === this.latestRequest) this.removeAttribute('aria-busy');
      }
    }

    /** Swaps in Shopify's freshly rendered cart (and the header's cart count), then restores focus */
    render(html, sectionIds, header) {
      const focusKey = document.activeElement?.closest('[data-cart-focus]')?.dataset.cartFocus;
      const parse = (id) => html?.[id] && new DOMParser().parseFromString(html[id], 'text/html');

      const fresh = parse(sectionIds[0])?.querySelector('.cart-page__inner');
      if (fresh) this.querySelector('.cart-page__inner').replaceWith(fresh);

      // Header: only its cart link (the red count bubble and the hidden "Cart, 2 items" label)
      const freshHeader = parse(sectionIds[1]);
      if (header && freshHeader) {
        const link = `.header__icon-button[href="${this.root}cart"]`;
        const next = freshHeader.querySelector(link);
        if (next) header.querySelector(link)?.replaceWith(next);
      }

      // Same control again if it still exists (e.g. the + button); otherwise the heading (line removed).
      // preventScroll: Safari doesn't focus buttons on click, so focus is often "nowhere" here; without
      // it, every + click there would jump the page up to the heading.
      const target = focusKey && this.querySelector(`[data-cart-focus="${CSS.escape(focusKey)}"]`);
      (target || this.querySelector('[data-cart-heading]'))?.focus({ preventScroll: true });
    }

    announce(message) {
      if (!this.status) return;
      this.status.textContent = '';
      requestAnimationFrame(() => {
        this.status.textContent = message;
      });
    }
  }

  if (!customElements.get('cart-page')) {
    customElements.define('cart-page', CartPage);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:labels.show_breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Your selection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shopping bag"
    },
    {
      "type": "url",
      "id": "continue_link",
      "label": "t:labels.continue_link",
      "info": "t:labels.continue_link_info"
    },
    {
      "type": "header",
      "content": "t:labels.checkout"
    },
    {
      "type": "checkbox",
      "id": "show_express_checkout",
      "label": "t:labels.show_express_checkout",
      "info": "t:labels.show_express_checkout_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "t:labels.show_cart_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_coupons",
      "label": "t:labels.show_coupons",
      "info": "t:labels.show_coupons_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.gift_wrap"
    },
    {
      "type": "checkbox",
      "id": "show_gift_wrap",
      "label": "t:labels.show_gift_wrap",
      "info": "t:labels.show_gift_wrap_info",
      "default": true
    },
    {
      "type": "text",
      "id": "gift_title",
      "label": "t:labels.heading",
      "default": "Buying for a loved one?",
      "visible_if": "{{ section.settings.show_gift_wrap }}"
    },
    {
      "type": "text",
      "id": "gift_text",
      "label": "t:labels.text",
      "default": "Add a personal message and have your order gift wrapped.",
      "visible_if": "{{ section.settings.show_gift_wrap }}"
    },
    {
      "type": "text",
      "id": "gift_saved_title",
      "label": "t:labels.gift_saved_heading",
      "info": "t:labels.gift_saved_heading_info",
      "default": "Gift wrapping",
      "visible_if": "{{ section.settings.show_gift_wrap }}"
    },
    {
      "type": "header",
      "content": "t:labels.free_shipping"
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping",
      "label": "t:labels.show_free_shipping",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "t:labels.free_shipping_threshold",
      "info": "t:labels.free_shipping_threshold_info",
      "default": 200,
      "visible_if": "{{ section.settings.show_free_shipping }}"
    },
    {
      "type": "header",
      "content": "t:labels.style"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.section_width.narrow"
        },
        {
          "value": "wide",
          "label": "t:options.section_width.wide"
        },
        {
          "value": "widest",
          "label": "t:options.section_width.widest"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "widest"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "t:labels.highlight_color",
      "info": "t:labels.cart_highlight_color_info",
      "default": "#c8a24b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "wrap_style",
      "name": "t:general.wrap_style",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:labels.product",
          "info": "t:labels.wrap_style_product_info"
        }
      ]
    }
  ]
}
