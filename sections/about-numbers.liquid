{%- comment -%}
  About numbers (M8.4 part 7, design/briefs/about-us.md §4.7, exports "Default-10", "big"; phones
  design/inbox/about-us-mobile/Property 1=Variant46-3.png):
  "By the numbers" / "Proof, not promises." and one Stat figure block per number.
  - From 1200px: up to 4 square cards in a row (fewer cards = fewer columns, centred), set at
    staggered heights ("Stagger the cards").
  - Below 1200px: 2 per row in a zig-zag (the right column sits lower, also "Stagger the cards").
  - The cards fade up one after another and each number counts up once, when its card is in view
    (only with animations on and motion allowed).
  - Empty cards render nothing; no card = no section on the store (a note in the editor).
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'

  # A section can't read its theme blocks' settings (section.blocks gives empty settings), so the
  # blocks are rendered first and their HTML is checked. data-stat-card is only on a real card (the
  # editor note for an empty card doesn't have it).
  capture cards_html
    content_for 'blocks'
  endcapture
  assign card_count = cards_html | split: 'data-stat-card' | size | minus: 1
  if request.design_mode
    # In the editor the notes for empty cards take a place in the row too
    assign note_count = cards_html | split: 'about-numbers__note' | size | minus: 1
    assign card_count = card_count | plus: note_count
  endif
  assign columns = card_count | at_most: 4 | at_least: 1
-%}

{%- if card_count > 0 or request.design_mode -%}
  {% render 'screen-scale' %}

  {%- comment -%} The titles are semibold (600): the page only loads regular and bold {%- endcomment -%}
  {% style %}
    {{ settings.type_heading_font | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}
  {% endstyle %}

  <about-numbers
    class="about-numbers full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}{% if section.settings.scale_screen %} section--screen-scale{% endif %}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --columns: {{ columns }};{% if section.settings.scale_screen %} --text-boost: {{ section.settings.text_scale | default: 110 | divided_by: 100.0 }};{% endif %}"
  >
    <div class="about-numbers__inner">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <header class="about-numbers__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="about-numbers__heading">{{ section.settings.heading }}</h2>
          {%- else -%}
            <h2 class="visually-hidden">{{ 'about.numbers_heading_hidden' | t }}</h2>
          {%- endif -%}
        </header>
      {%- else -%}
        {%- comment -%} No heading: the card titles (h3) still need an h2 above them {%- endcomment -%}
        <h2 class="visually-hidden">{{ 'about.numbers_heading_hidden' | t }}</h2>
      {%- endif -%}

      {%- if card_count > 0 -%}
        <animate-on-scroll
          class="about-numbers__list{% if section.settings.stagger %} about-numbers__list--stagger{% endif %}"
        >
          {{ cards_html }}
        </animate-on-scroll>
      {%- elsif request.design_mode -%}
        <p class="about-numbers__empty">{{ 'about.numbers_empty' | t }}</p>
      {%- endif -%}
    </div>
  </about-numbers>
{%- endif -%}

{% stylesheet %}
  /*
    Figma 1920 (Default-10): eyebrow y 148, heading ~66px y 205–265 ("*Proof,* not promises.",
    accent upright); 4 cards 371x371 at x 183 / 598 / 1015 / 1430 (gap ~45, row ~1618 wide);
    card tops staggered y 330 / 437 / 357 / 408 (0 / 107 / 27 / 78 below the first).
    Phones (Variant46-3, 375 wide): heading ~26px, cards ~148x150, 26px apart, the right column
    30px lower.
  */

  /* --px = one Figma pixel. Scale off: it follows the width only, never more than 1px */
  .about-numbers {
    --px: min(calc(100vw / 1920), 0.0625rem);

    display: block;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    background-color: var(--color-background);
  }

  /* Two classes: beats the shared .section--screen-scale rule whatever the bundle order */
  .about-numbers.section--screen-scale {
    --px: min(calc(100vw / 1920), calc(100svh / 1031));
  }

  .about-numbers__inner {
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .about-numbers__header {
    margin-block-end: max(var(--space-xl), calc(65 * var(--px)));
    text-align: center;
  }

  .about-numbers__heading {
    margin: max(var(--space-lg), calc(40 * var(--px))) 0 0;
    font-size: max(2rem, calc(66 * var(--px)));
    line-height: 1.15;
  }

  .about-numbers__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  /*
    Flex, not grid: a row that isn't full (1–3 cards, or 5–7) is centred. --columns (from Liquid) =
    the number of cards, at most 4; the row is never wider than that many cards.
  */
  .about-numbers__list {
    --numbers-columns: var(--columns, 4);
    --numbers-card: calc(371 * var(--px));
    --numbers-gap: max(var(--space-lg), calc(45 * var(--px)));

    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: var(--numbers-gap);
    max-inline-size: calc(
      var(--numbers-columns) * var(--numbers-card) + (var(--numbers-columns) - 1) * var(--numbers-gap)
    );
    margin-inline: auto;
  }

  .about-numbers__list > * {
    flex: 0 0 calc((100% - (var(--numbers-columns) - 1) * var(--numbers-gap)) / var(--numbers-columns));
    min-inline-size: 0;
  }

  /* Staggered heights from 1200px (the cards are the direct children: the block has no wrapper) */
  @media (min-width: 1200px) {
    .about-numbers__list--stagger > :nth-child(4n + 2) {
      margin-block-start: calc(107 * var(--px));
    }

    .about-numbers__list--stagger > :nth-child(4n + 3) {
      margin-block-start: calc(27 * var(--px));
    }

    .about-numbers__list--stagger > :nth-child(4n + 4) {
      margin-block-start: calc(78 * var(--px));
    }

    /* The cards fade up one after another */
    .about-numbers__list > :nth-child(4n + 2) {
      --animate-delay: 100ms;
    }

    .about-numbers__list > :nth-child(4n + 3) {
      --animate-delay: 200ms;
    }

    .about-numbers__list > :nth-child(4n + 4) {
      --animate-delay: 300ms;
    }
  }

  .about-numbers__empty {
    margin: 0;
    text-align: center;
  }

  /*
    Phones and tablets: 2 per row in a zig-zag. The right column moves down with a relative offset
    (not a margin), so each column keeps its own even gap, as in the phone design; the list gets the
    same space at the bottom so the last card doesn't run into the padding.
  */
  @media (max-width: 1199px) {
    .about-numbers__list {
      --numbers-columns: min(var(--columns, 2), 2);
      --numbers-card: 13.5rem;
      --numbers-gap: 2rem;
    }

    .about-numbers__list--stagger {
      --numbers-drop: 2.5rem;

      padding-block-end: var(--numbers-drop);
    }

    .about-numbers__list--stagger > :nth-child(even) {
      position: relative;
      inset-block-start: var(--numbers-drop);
    }

    .about-numbers__list > :nth-child(even) {
      --animate-delay: 100ms;
    }
  }

  @media (max-width: 749px) {
    .about-numbers__list {
      --numbers-card: 9.25rem;
      --numbers-gap: 1.625rem;
    }

    .about-numbers__list--stagger {
      --numbers-drop: 1.875rem;
    }

    .about-numbers__header {
      margin-block-end: 1.75rem;
    }

    .about-numbers__heading {
      margin-block-start: var(--space-sm);
      font-size: 1.625rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <about-numbers>: counts each card's number up from 0 once, when the card is in view.
   *
   * The real value is the data-count attribute (also in a visually hidden copy for screen readers);
   * only the visible, aria-hidden digits change, and the last frame is the saved value itself.
   * - Decimals and the number of digits are kept ("4.9" counts 0.0 → 4.9, "98" 00 → 98, "07" ends as 07).
   * - A value with thousands commas ("31,400"), or a collection count of 1000 or more
   *   (data-group), counts with the store language's separators (Intl.NumberFormat).
   * - Anything else ("N/A") is left as it is.
   * Off (the final value shows straight away): animations off (also in the theme editor), reduced
   * motion (also when it is turned on during the count), or no JS.
   */
  class AboutNumbers extends HTMLElement {
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.frames = new Set();

      this.counts = [...this.querySelectorAll('.stat-figure__count')]
        .map((element) => this.parse(element))
        .filter(Boolean);
      if (!this.counts.length) return;

      // A collection count of 1000 or more gets its separators even when nothing moves
      this.counts.forEach((count) => {
        if (count.group && !count.element.dataset.done) this.render(count, count.target);
      });

      const animations = document.documentElement.classList.contains('animations-on');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!animations || reduce.matches) return;

      // Reduced motion turned on while on the page: show every final value and stop
      reduce.addEventListener(
        'change',
        () => {
          if (reduce.matches) this.finish();
        },
        { signal }
      );

      const waiting = this.counts.filter((count) => !count.element.dataset.done);
      // Start from 0 before the cards come into view
      waiting.forEach((count) => this.render(count, 0));

      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            this.observer.unobserve(entry.target);
            const count = this.counts.find((item) => item.element === entry.target);
            if (count) this.countUp(count);
          });
        },
        { threshold: 0.5 }
      );
      waiting.forEach((count) => this.observer.observe(count.element));
    }

    disconnectedCallback() {
      // The editor re-attaches a moved section: a count cut off here shows its final value
      this.finish();
      this.controller?.abort();
    }

    /** Reads a card's saved value; null when it isn't a number this script can count. */
    parse(element) {
      const saved = element.dataset.count || '';
      const grouped = /^\d{1,3}(,\d{3})+(\.\d+)?$/.test(saved);
      if (!grouped && !/^\d+(\.\d+)?$/.test(saved)) return null;

      const plain = saved.replace(/,/g, '');
      const [whole, fraction = ''] = plain.split('.');
      const target = parseFloat(plain);
      const group = grouped || (element.hasAttribute('data-group') && target >= 1000);
      // The count keeps the saved number of digits (phone design: 98 counts 00 → 98; 07 ends as 07)
      const digits = Math.min(whole.length, 21);

      let format = null;
      if (group) {
        const formatter = new Intl.NumberFormat(document.documentElement.lang || undefined, {
          minimumIntegerDigits: digits,
          minimumFractionDigits: fraction.length,
          maximumFractionDigits: fraction.length,
          numberingSystem: 'latn',
        });
        format = (value) => formatter.format(value);
      }

      return {
        element,
        number: element.querySelector('.stat-figure__number'),
        saved,
        target,
        decimals: fraction.length,
        digits,
        group,
        format,
      };
    }

    render(count, value) {
      if (!count.number) return;
      if (count.format) {
        count.number.textContent = count.format(value);
        return;
      }
      const [whole, fraction] = value.toFixed(count.decimals).split('.');
      count.number.textContent = whole.padStart(count.digits, '0') + (fraction ? `.${fraction}` : '');
    }

    /** The final value: the saved text, or its grouped form for a collection count. */
    show(count) {
      count.element.dataset.done = '';
      if (count.group && count.format) this.render(count, count.target);
      else if (count.number) count.number.textContent = count.saved;
    }

    /** Stops every count and shows every final value (also the cards not in view yet). */
    finish() {
      this.observer?.disconnect();
      this.observer = null;
      this.frames?.forEach((frame) => cancelAnimationFrame(frame));
      this.frames?.clear();
      this.counts?.forEach((count) => {
        if (!count.element.dataset.done) this.show(count);
      });
    }

    countUp(count) {
      const duration = 1200;
      const start = performance.now();

      const step = (now) => {
        this.frames.delete(frame);
        const progress = Math.min((now - start) / duration, 1);
        if (progress < 1) {
          const eased = 1 - (1 - progress) ** 3; // ease-out: fast first, gentle at the end
          this.render(count, count.target * eased);
          frame = requestAnimationFrame(step);
          this.frames.add(frame);
        } else {
          this.show(count);
        }
      };
      let frame = requestAnimationFrame(step);
      this.frames.add(frame);
    }
  }

  if (!customElements.get('about-numbers')) customElements.define('about-numbers', AboutNumbers);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.about_numbers",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "blocks": [{ "type": "_stat-figure" }],
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "By the numbers"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.italic_accent_info",
      "default": "<em>Proof,</em> not promises."
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "checkbox",
      "id": "stagger",
      "label": "t:labels.numbers_stagger",
      "info": "t:labels.numbers_stagger_zigzag_info",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.section_width.narrow"
        },
        {
          "value": "wide",
          "label": "t:options.section_width.wide"
        },
        {
          "value": "widest",
          "label": "t:options.section_width.widest"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "widest"
    },
    {
      "type": "checkbox",
      "id": "scale_screen",
      "label": "t:labels.scale_screen",
      "info": "t:labels.about_scale_screen_info",
      "default": true
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "t:labels.text_scale",
      "info": "t:labels.about_text_scale_info",
      "min": 100,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 110,
      "visible_if": "{{ section.settings.scale_screen }}"
    },
    {
      "type": "header",
      "content": "t:labels.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "t:general.about_numbers",
      "blocks": [
        {
          "type": "_stat-figure",
          "settings": {
            "value": "98",
            "suffix": "%",
            "title": "Would buy again",
            "text": "Of 31,400 verified clients"
          }
        },
        {
          "type": "_stat-figure",
          "settings": {
            "value": "4.9",
            "suffix": "",
            "title": "Average rating",
            "text": "Across every piece we make"
          }
        },
        {
          "type": "_stat-figure",
          "settings": {
            "source": "collection",
            "suffix": "+",
            "title": "Global products",
            "text": "Luxury products curated globally"
          }
        },
        {
          "type": "_stat-figure",
          "settings": {
            "value": "15",
            "suffix": "",
            "title": "Total awards",
            "text": "Industry awards since 2018"
          }
        }
      ]
    }
  ]
}
{% endschema %}
