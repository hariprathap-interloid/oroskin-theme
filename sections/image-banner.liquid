{%- comment -%}
  Image banner: a full-width photo with a dark overlay, content on the left (any theme blocks:
  eyebrow, headings, text, buttons) and optional glass highlight cards on the right.
  Two presets build the Figma homepage sections from this one file:
  - "Image banner with stats" = The New Glow Manifesto (full screen, gradient, 3 highlight cards)
  - "Promo banner" = The Ultimate Glow-Up Event (shorter, even tint, no cards; the Figma countdown is
    a parked feature, decision 6)

  Two static blocks make the two areas (as in the Hero): _banner-content and _highlight-cards.

  Manifesto + Trending Now as ONE scene (Figma): a third static block, _trending-sheet, holds a dark
  sheet with the Trending list. When it's switched on, <image-banner> pins the section while scrolling:
  the photo stays, the content and cards slide away to the left and fade, the sheet slides in from the
  left over the photo, then the page continues. Runs with the theme's animations on (also in the editor,
  it never hides anything for good); not with reduced motion or without JavaScript, where the sheet
  simply sits under the banner content.
  This section's "Transition" setting can switch the scene to "vertical" (text slides up, sheet rises
  from below), and "Slide in the heading and View all" brings those in from outside the sheet once it
  is in place (data-scene-style / data-sheet-header from Liquid, data-sheet-placed from the script).
  Both sit next to "Scroll animation", so all the banner's animation choices are in one place.

  Entrance on first view: the banner's text uses this section's "Scroll animation" setting and the
  cards their own block setting (e.g. text from the right, cards from the left).
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-5'
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0

  # First section on the page: the photo is the main image (eager + high priority) and nothing animates
  assign is_first = false
  assign animation = section.settings.animation
  if section.index == 1
    assign is_first = true
    assign animation = 'none'
  endif
-%}

<image-banner
  class="image-banner full-width section-width--{{ section.settings.section_width | default: 'wide' }} color-{{ scheme_id }} image-banner--{{ section.settings.height }} image-banner--overlay-{{ section.settings.overlay_style }}"
  style="--banner-overlay: {{ overlay_opacity }}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --p: 0;"
  {% if settings.animations_enabled %}
    data-scene
    data-scene-style="{{ section.settings.scene_style }}"
    {% if section.settings.header_slide %}
      data-sheet-header
    {% endif %}
  {% endif %}
>
  <div class="image-banner__track">
  <div class="image-banner__stage">
  <div class="image-banner__media">
    {%- if section.settings.image != blank -%}
      {% render 'image',
        image: section.settings.image,
        class: 'image--cover',
        sizes: '100vw',
        priority: is_first
      %}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'image-banner__placeholder' }}
    {%- endif -%}
  </div>
  <div class="image-banner__overlay" aria-hidden="true"></div>

  <animate-on-scroll class="image-banner__inner">
    <div
      class="image-banner__content"
      {% if animation != 'none' %}
        data-animate="{{ animation }}"
      {% endif %}
    >
      {% content_for 'block', type: '_banner-content', id: 'banner-content' %}
    </div>
    <div class="image-banner__cards">
      {% content_for 'block', type: '_highlight-cards', id: 'highlight-cards' %}
    </div>
  </animate-on-scroll>

  {% content_for 'block', type: '_trending-sheet', id: 'trending-sheet' %}
  </div>
  </div>
</image-banner>

{% stylesheet %}
  /*
    The photo and the overlay fill the section (absolute, behind); the content sits on top in the
    page-width column, centred vertically.
  */
  image-banner {
    display: block;
  }

  .image-banner__stage {
    position: relative;
    display: grid;
    overflow: hidden;
    isolation: isolate;
  }

  .image-banner--full .image-banner__stage {
    min-block-size: 100svh;
  }

  .image-banner--large .image-banner__stage {
    min-block-size: 80svh;
  }

  .image-banner--medium .image-banner__stage {
    min-block-size: 64svh;
  }

  .image-banner--small .image-banner__stage {
    min-block-size: 48svh;
  }

  .image-banner__media,
  .image-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .image-banner__media .image,
  .image-banner__placeholder {
    inline-size: 100%;
    block-size: 100%;
  }

  .image-banner__placeholder {
    background-color: var(--color-tint);
  }

  /*
    Overlay: black, faded by the Overlay strength setting (opacity), so white text stays readable.
    Gradient (Manifesto): dark on the left behind the text, clear on the right where the face is.
    Even (promo): the same tint everywhere.
  */
  .image-banner__overlay {
    opacity: var(--banner-overlay);
  }

  .image-banner--overlay-gradient .image-banner__overlay {
    background: linear-gradient(90deg, #000000 0%, #000000b3 30%, #00000000 65%);
  }

  .image-banner--overlay-gradient-right .image-banner__overlay {
    background: linear-gradient(270deg, #000000 0%, #000000b3 30%, #00000000 65%);
  }

  .image-banner--overlay-even .image-banner__overlay {
    background-color: #000000;
  }

  .image-banner__inner {
    display: grid;
    align-items: center;
    gap: var(--space-xl);
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  /* From tablet landscape up: content left, cards right (the cards column only when it has cards) */
  @media (min-width: 990px) {
    .image-banner__inner {
      grid-template-columns: 1fr auto;
    }
  }

  .image-banner__cards:not(:has(.highlight-card)) {
    display: none;
  }

  /*
    Scene (only with data-scene-active, added by the script when a Trending sheet is shown):
    the track is Scene length tall, the stage sticks to the screen, and --p (0 -> 1) drives:
    - out: 0 -> 1 while --p goes 0.12 -> 0.42 (content + cards slide left and fade)
    - in:  0 -> 1 while --p goes 0.30 -> 0.65 (the sheet slides in from the left)
    then the sheet holds until the pin lets go.
  */
  .image-banner[data-scene-active] .image-banner__track {
    block-size: calc(var(--scene-length, 250) * 1svh);
  }

  .image-banner[data-scene-active] .image-banner__stage {
    --out: clamp(0, calc((var(--p) - 0.12) / 0.3), 1);
    --in: clamp(0, calc((var(--p) - 0.3) / 0.35), 1);

    position: sticky;
    inset-block-start: 0;
    block-size: 100svh;
    min-block-size: 0;
  }

  .image-banner[data-scene-active] .image-banner__inner,
  .image-banner[data-scene-active] .banner-sheet {
    grid-area: 1 / 1;
  }

  .image-banner[data-scene-active] .image-banner__inner {
    opacity: calc(1 - var(--out));
    transform: translateX(calc(var(--out) * -6rem));
  }

  /* Once the sheet is over the photo, the faded content can't be clicked by accident */
  .image-banner[data-sheet-shown] .image-banner__inner {
    pointer-events: none;
  }

  .image-banner[data-scene-active] .banner-sheet {
    justify-self: start;
    inline-size: var(--sheet-width, 50%);
    block-size: 100%;
    overflow-y: auto;
    transform: translateX(calc((1 - var(--in)) * -100%));
    box-shadow: 1.5rem 0 3rem #00000040;
  }

  /*
    Transition "vertical" (Trending sheet setting): the banner's text and cards slide UP and away, and
    the sheet rises from the bottom of the photo instead of coming in from the left. Same --out / --in
    timing as above; the stage's overflow: hidden keeps the sheet out of sight until it rises.
  */
  .image-banner[data-scene-active][data-scene-style='vertical'] .image-banner__inner {
    transform: translateY(calc(var(--out) * -6rem));
  }

  .image-banner[data-scene-active][data-scene-style='vertical'] .banner-sheet {
    transform: translateY(calc((1 - var(--in)) * 100%));
    box-shadow: 0 -1.5rem 3rem #00000040;
  }

  /*
    "Slide in the heading and View all": once the sheet is in place (the script sets data-sheet-placed)
    both come in from OUTSIDE the sheet to their own side: the heading from beyond the left edge,
    "View all" from beyond the right edge, quickly. Time-based, not tied to the scroll, so it always
    finishes. Scrolling back up sends them out again with the sheet.
    Each travels its own width plus 4rem (more than the sheet's side padding), so it starts fully
    outside; the sheet hides anything past its edges (overflow-x below), so they appear from the edge.
  */
  .image-banner[data-scene-active][data-sheet-header] .banner-sheet {
    overflow-x: hidden; /* no sideways scrollbar while "View all" is still out to the right */
  }

  .image-banner[data-scene-active][data-sheet-header] :is(.trending-list__heading, .trending-list__view-all) {
    transition:
      transform 0.55s var(--ease-out),
      opacity 0.3s var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .image-banner[data-scene-active][data-sheet-header] .trending-list__view-all {
    transition-delay: 0.08s, 0.08s, 0s, 0s, 0s;
  }

  .image-banner[data-scene-active][data-sheet-header]:not([data-sheet-placed]) .trending-list__heading {
    opacity: 0;
    transform: translateX(calc(-100% - 4rem));
  }

  .image-banner[data-scene-active][data-sheet-header]:not([data-sheet-placed]) .trending-list__view-all {
    opacity: 0;
    transform: translateX(calc(100% + 4rem));
  }

  /* Phones: the sheet takes the full width */
  @media (max-width: 749px) {
    .image-banner[data-scene-active] .banner-sheet {
      inline-size: 100%;
    }
  }

  /* Phones: the text needs the full width, so the tint covers the whole photo */
  @media (max-width: 749px) {
    .image-banner--overlay-gradient .image-banner__overlay,
    .image-banner--overlay-gradient-right .image-banner__overlay {
      background: linear-gradient(0deg, #000000 0%, #000000b3 60%, #00000066 100%);
    }

    .image-banner .highlight-cards {
      flex-flow: row wrap;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <image-banner>: the Manifesto -> Trending scroll scene. Active only when the section shows a
   * Trending sheet, the theme's animations are on (data-scene) and the visitor allows motion.
   * Turns the scroll position inside the tall track into --p (0 -> 1), smoothed so a mouse wheel
   * doesn't make it jump; the CSS moves the content and the sheet from that number.
   */
  class ImageBanner extends HTMLElement {
    connectedCallback() {
      this.sheet = this.querySelector('[data-banner-sheet]');
      this.track = this.querySelector('.image-banner__track');
      this.stage = this.querySelector('.image-banner__stage');
      if (!this.sheet || !this.track || !this.stage || !this.hasAttribute('data-scene')) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      this.style.setProperty('--scene-length', this.sheet.dataset.sceneLength || 250);
      this.setAttribute('data-scene-active', '');
      this.current = this.measure();
      this.paint();

      this.run = () => {
        if (!this.frame) this.frame = requestAnimationFrame(() => this.step());
      };
      this.observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          window.addEventListener('scroll', this.run, { passive: true });
          window.addEventListener('resize', this.run);
          this.run();
        } else {
          this.stopListening();
          this.current = this.measure();
          this.paint();
        }
      });
      this.observer.observe(this.track);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.stopListening();
    }

    stopListening() {
      window.removeEventListener('scroll', this.run);
      window.removeEventListener('resize', this.run);
      if (this.frame) cancelAnimationFrame(this.frame);
      this.frame = null;
    }

    /** 0 when the stage pins, 1 when it lets go (measured against the stage's own height) */
    measure() {
      const distance = this.track.offsetHeight - this.stage.offsetHeight;
      const scrolled = -this.track.getBoundingClientRect().top;
      return distance > 0 ? Math.min(Math.max(scrolled / distance, 0), 1) : 0;
    }

    /** Each frame the shown progress moves 12% of the way to the real one, until they meet */
    step() {
      this.frame = null;
      const target = this.measure();
      const gap = target - this.current;
      this.current = Math.abs(gap) < 0.0005 ? target : this.current + gap * 0.12;
      this.paint();
      if (this.current !== target) this.run();
    }

    paint() {
      this.style.setProperty('--p', this.current.toFixed(4));
      this.toggleAttribute('data-sheet-shown', this.current > 0.45);
      // The sheet is fully in place at 0.65 (see --in); a hair earlier so the smoothing never holds it back
      this.toggleAttribute('data-sheet-placed', this.current > 0.64);
    }
  }

  if (!customElements.get('image-banner')) {
    customElements.define('image-banner', ImageBanner);
  }
{% endjavascript %}

