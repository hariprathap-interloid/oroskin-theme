{%- comment -%}
  Collection tiles ("Where would you like to start?"): a heading, then photo tiles with a frosted glass
  bar along the bottom. Each "Tile" block points to a collection or a product; the picture and name
  come from there unless the block sets its own. Product tiles show the price, collection tiles "Shop".

  Usable on any page. On the cart page, "Only when the cart is empty" shows it under the empty bag
  message and hides it while the cart has items; the cart's script renders it again after each change
  (data-cart-refresh), like the Product list.
{%- endcomment -%}

{%- liquid
  assign hidden_by_cart = false
  if section.settings.show_only_empty_cart and cart.item_count > 0
    assign hidden_by_cart = true
  endif
-%}

{%- if hidden_by_cart -%}
  {%- comment -%} Kept so the cart's script knows to render this section again when the cart changes {%- endcomment -%}
  <div data-cart-refresh hidden></div>
{%- else -%}
  <div
    class="collection-tiles full-width section-width--{{ section.settings.section_width | default: 'wide' }} color-{{ section.settings.color_scheme.id }}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --tile-ratio: {{ section.settings.tile_ratio }};"
    {% if section.settings.show_only_empty_cart %}
      data-cart-refresh
    {% endif %}
  >
    <div class="collection-tiles__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="collection-tiles__heading" id="CollectionTiles-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul
        class="collection-tiles__list"
        role="list"
        {% if section.settings.heading != blank %}
          aria-labelledby="CollectionTiles-{{ section.id }}"
        {% endif %}
      >
        {%- for block in section.blocks -%}
          {%- liquid
            # A product (when one is picked) wins over the collection; nothing picked = a placeholder tile
            assign tile_url = nil
            assign tile_image = block.settings.image
            assign tile_label = block.settings.label
            assign tile_product = block.settings.product
            if tile_product != blank
              assign tile_url = tile_product.url
              if tile_image == blank
                assign tile_image = tile_product.featured_media.preview_image
              endif
              if tile_label == blank
                assign tile_label = tile_product.title
              endif
            else
              assign tile_collection = block.settings.collection
              if tile_collection != blank
                assign tile_url = tile_collection.url
                if tile_image == blank
                  assign tile_image = tile_collection.featured_image
                endif
                if tile_label == blank
                  assign tile_label = tile_collection.title
                endif
              endif
            endif
          -%}
          <li class="collection-tiles__item" {{ block.shopify_attributes }}>
            <a class="collection-tiles__link" href="{{ tile_url | default: routes.all_products_collection_url }}">
              {%- if tile_image != blank -%}
                {%- comment -%} alt is empty: the name on the bar right below names the link {%- endcomment -%}
                {{
                  tile_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 990px) 33vw, 90vw',
                    alt: '',
                    loading: 'lazy',
                    class: 'collection-tiles__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-tiles__image' }}
              {%- endif -%}
              {%- comment -%} divs, not spans: the price snippet outputs a <div> (a link may hold divs) {%- endcomment -%}
              <div class="collection-tiles__bar">
                <span class="collection-tiles__name">
                  {%- if tile_label != blank -%}
                    {{ tile_label | escape }}
                  {%- else -%}
                    {{ 'sections.collection_tiles.placeholder' | t }}
                  {%- endif -%}
                </span>
                {%- if tile_product != blank -%}
                  <div class="collection-tiles__price">{% render 'price', product: tile_product %}</div>
                {%- else -%}
                  <span class="collection-tiles__cta" aria-hidden="true">
                    {{- 'sections.collection_tiles.shop' | t -}}
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .collection-tiles {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  /* The "Section width" setting (critical.css: --section-width), minus the page margins */
  .collection-tiles__inner {
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .collection-tiles__heading {
    margin-block: 0 var(--space-lg);
    font-size: var(--font-size-h3);
  }

  /* Tiles share the width: 3 tiles = 3 columns; at least 16rem each, so they wrap on smaller screens */
  .collection-tiles__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A photo tile (shape from the "Tile shape" setting) with a frosted glass bar along the bottom */
  .collection-tiles__link {
    position: relative;
    display: block;
    aspect-ratio: var(--tile-ratio, 4 / 3);
    overflow: hidden;
    border-radius: var(--radius-lg);
    color: var(--color-text);
    text-decoration: none;
  }

  .collection-tiles__image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: scale var(--duration-slow) var(--ease-out);
  }

  .collection-tiles__link:hover .collection-tiles__image {
    scale: 1.04;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-tiles__link:hover .collection-tiles__image {
      scale: none;
    }
  }

  .collection-tiles__bar {
    position: absolute;
    inset-inline: var(--space-md);
    inset-block-end: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    padding-inline: 1.25rem;
    border-radius: 1rem;
    /* Frosted glass in the scheme's own background, so its text (the scheme's text colour) stays readable */
    background-color: color-mix(in srgb, var(--color-background) 75%, transparent);
    box-shadow: var(--glass-rim);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .collection-tiles__name {
    font-family: var(--font-heading--family);
    font-size: var(--font-size-body-lg);
  }

  .collection-tiles__cta {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-nav);
    text-transform: uppercase;
  }

  .collection-tiles__cta svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  /* Dark price on the white bar (the price snippet uses the accent colour on product cards) */
  .collection-tiles__price .price__current {
    color: var(--color-text);
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_tiles",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "tile",
      "name": "t:general.tile",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:labels.tile_info"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:labels.product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:labels.tile_image_info"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.tile_label",
          "info": "t:labels.tile_label_info"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Where would you like to start?"
    },
    {
      "type": "select",
      "id": "tile_ratio",
      "label": "t:labels.tile_shape",
      "options": [
        { "value": "4 / 5", "label": "t:options.image_shape.portrait" },
        { "value": "1 / 1", "label": "t:options.image_shape.square" },
        { "value": "4 / 3", "label": "t:options.image_shape.landscape" },
        { "value": "16 / 9", "label": "t:options.image_shape.wide" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "checkbox",
      "id": "show_only_empty_cart",
      "label": "t:labels.product_list_only_empty_cart",
      "info": "t:labels.product_list_only_empty_cart_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:labels.style"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        { "value": "narrow", "label": "t:options.section_width.narrow" },
        { "value": "wide", "label": "t:options.section_width.wide" },
        { "value": "widest", "label": "t:options.section_width.widest" },
        { "value": "full", "label": "t:options.section_width.full" }
      ],
      "default": "wide"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
