{%- comment -%}
  Collection tiles ("Where would you like to start?"): a heading, then photo tiles with a frosted glass
  bar along the bottom. Each "Tile" block points to a collection or a product; the picture and name
  come from there unless the block sets its own. Product tiles show the price, collection tiles "Shop".

  Two styles ("Tile style"):
  - Photo tile: the photo fills the tile, the name on a frosted glass bar.
  - Promo card (Figma collection page, under the grid): a white card with a small heading ("SHOP SALE"),
    the name with an offer pill ("10% OFFER") and a "SHOP ALL ->" link on the left, the cut-out photo on
    the right, over the card's edge. The link's ::after covers the card, so the whole card is one link
    (one Tab stop); its hidden text adds the name ("Shop all: Skincare").

  Usable on any page. On the cart page, "Only when the cart is empty" shows it under the empty bag
  message and hides it while the cart has items; the cart's script renders it again after each change
  (data-cart-refresh), like the Product list.
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-1'
  assign tile_style = section.settings.tile_style | default: 'photo'

  # Eager only as the page's first section. Not the theme's "first 3 sections" rule (section-loading):
  # these tiles usually sit under a long list (the collection grid, the empty cart), far below the
  # first screen, even as the 2nd or 3rd section.
  assign tiles_loading = 'lazy'
  if section.index == 1
    assign tiles_loading = 'eager'
  endif

  # Tiles with something to show: a collection, a product or a name. Empty tiles show only in the editor
  # (as placeholders), and no tile at all = no section on the store (a note in the editor).
  # The ids of the tiles with content, so the count and the render loop use the same test
  assign tile_count = 0
  assign content_ids = ','
  for block in section.blocks
    if block.settings.collection != blank or block.settings.product != blank or block.settings.label != blank
      assign tile_count = tile_count | plus: 1
      assign content_ids = content_ids | append: block.id | append: ','
    endif
  endfor


  # Promo card names: h2 when the section has no heading of its own, else h3 under it
  assign name_tag = 'h2'
  if section.settings.heading != blank
    assign name_tag = 'h3'
  endif

  assign hidden_by_cart = false
  if section.settings.show_only_empty_cart and cart.item_count > 0
    assign hidden_by_cart = true
  endif
-%}

{%- if tile_count == 0 and request.design_mode and hidden_by_cart == false -%}
  <div class="collection-tiles-empty color-{{ scheme_id }}">
    <p>{{ 'sections.collection_tiles.empty' | t }}</p>
  </div>
{%- endif -%}

{%- if hidden_by_cart -%}
  {%- comment -%} Kept so the cart's script knows to render this section again when the cart changes {%- endcomment -%}
  <div data-cart-refresh hidden></div>
{%- elsif tile_count > 0 or request.design_mode -%}
  <div
    class="collection-tiles collection-tiles--{{ tile_style }} collection-tiles--anim-{{ section.settings.photo_animation | default: 'none' }} full-width section-width--{{ section.settings.section_width | default: 'wide' }} color-{{ scheme_id }}"
    style="--photo-speed: {{ section.settings.photo_animation_speed | default: 6 }}s; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --tile-ratio: {{ section.settings.tile_ratio }};{% if section.settings.highlight_color != blank %} --color-accent: {{ section.settings.highlight_color }};{% endif %}"
    {% if section.settings.show_only_empty_cart %}
      data-cart-refresh
    {% endif %}
  >
    <div class="collection-tiles__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="collection-tiles__heading" id="CollectionTiles-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul
        class="collection-tiles__list"
        role="list"
        {% if section.settings.heading != blank %}
          aria-labelledby="CollectionTiles-{{ section.id }}"
        {% endif %}
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_key = ',' | append: block.id | append: ','
            unless content_ids contains block_key or request.design_mode
              continue
            endunless

            # A product (when one is picked) wins over the collection; nothing picked = a placeholder tile
            assign tile_url = nil
            assign tile_image = block.settings.image
            assign tile_label = block.settings.label
            assign tile_product = block.settings.product
            if tile_product != blank
              assign tile_url = tile_product.url
              if tile_image == blank
                assign tile_image = tile_product.featured_media.preview_image
              endif
              if tile_label == blank
                assign tile_label = tile_product.title
              endif
            else
              assign tile_collection = block.settings.collection
              if tile_collection != blank
                assign tile_url = tile_collection.url
                if tile_image == blank
                  assign tile_image = tile_collection.featured_image
                endif
                if tile_label == blank
                  assign tile_label = tile_collection.title
                endif
              endif
            endif
          -%}
          {%- if tile_style == 'promo' -%}
            {%- liquid
              assign tile_name = tile_label
              if tile_name == blank
                assign tile_name = 'sections.collection_tiles.placeholder' | t
              endif
              assign link_text = block.settings.link_label
              if link_text == blank
                assign link_text = 'sections.collection_tiles.shop' | t
              endif

              # The photo's place (Photo group of the block). sizes grows with its Size, so a big photo stays sharp.
              assign photo_scale = block.settings.image_scale | default: 100
              assign photo_desktop = photo_scale | times: 14 | divided_by: 100.0 | ceil
              assign photo_tablet = photo_scale | times: 20 | divided_by: 100.0 | ceil
              assign photo_phone = photo_scale | times: 40 | divided_by: 100.0 | ceil
              capture photo_sizes
                echo '(min-width: 990px) ' | append: photo_desktop | append: 'vw, (min-width: 750px) ' | append: photo_tablet | append: 'vw, ' | append: photo_phone | append: 'vw'
              endcapture
            -%}
            <li class="collection-tiles__item" {{ block.shopify_attributes }}>
              <div
                class="collection-tiles__card"
                style="--photo-rotate: {{ block.settings.image_rotate | default: 0 }}deg; --photo-scale: {{ photo_scale | divided_by: 100.0 }}; --photo-x: {{ block.settings.image_x | default: 0 }}%; --photo-y: {{ block.settings.image_y | default: 0 }}%;"
              >
                <div class="collection-tiles__card-text">
                  {%- if block.settings.eyebrow != blank -%}
                    <p class="collection-tiles__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                  {%- endif -%}
                  {%- comment -%} The offer is next to the heading, not in it: the heading is only the name {%- endcomment -%}
                  <div class="collection-tiles__card-name">
                    <{{ name_tag }} class="collection-tiles__card-title">{{ tile_name | escape }}</{{ name_tag }}>
                    {%- if block.settings.badge != blank -%}
                      <span class="collection-tiles__badge">{{ block.settings.badge | escape }}</span>
                    {%- endif -%}
                  </div>
                  <a class="collection-tiles__card-link" href="{{ tile_url | default: routes.all_products_collection_url }}">
                    {{- link_text | escape -}}
                    <span class="visually-hidden">: {{ tile_name | escape }}</span>
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </a>
                </div>
                {%- if tile_image != blank -%}
                  {{
                    tile_image
                    | image_url: width: 800
                    | image_tag:
                      widths: '200, 300, 400, 600, 800',
                      sizes: photo_sizes,
                      alt: '',
                      loading: tiles_loading,
                      class: 'collection-tiles__cutout'
                  }}
                {%- elsif request.design_mode -%}
                  {{ 'product-1' | placeholder_svg_tag: 'collection-tiles__cutout' }}
                {%- endif -%}
              </div>
            </li>
            {%- continue -%}
          {%- endif -%}
          <li class="collection-tiles__item" {{ block.shopify_attributes }}>
            <a class="collection-tiles__link" href="{{ tile_url | default: routes.all_products_collection_url }}">
              {%- if tile_image != blank -%}
                {%- comment -%} alt is empty: the name on the bar right below names the link {%- endcomment -%}
                {{
                  tile_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 990px) 33vw, 90vw',
                    alt: '',
                    loading: tiles_loading,
                    class: 'collection-tiles__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-tiles__image' }}
              {%- endif -%}
              {%- comment -%} divs, not spans: the price snippet outputs a <div> (a link may hold divs) {%- endcomment -%}
              <div class="collection-tiles__bar">
                <span class="collection-tiles__name">
                  {%- if tile_label != blank -%}
                    {{ tile_label | escape }}
                  {%- else -%}
                    {{ 'sections.collection_tiles.placeholder' | t }}
                  {%- endif -%}
                </span>
                {%- if tile_product != blank -%}
                  <div class="collection-tiles__price">{% render 'price', product: tile_product %}</div>
                {%- else -%}
                  <span class="collection-tiles__cta" aria-hidden="true">
                    {{- 'sections.collection_tiles.shop' | t -}}
                    {{- 'icon-arrow.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .collection-tiles {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  .collection-tiles-empty {
    padding: var(--space-2xl) var(--page-margin);
    text-align: center;
  }

  /* The "Section width" setting (critical.css: --section-width), minus the page margins */
  .collection-tiles__inner {
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .collection-tiles__heading {
    margin-block: 0 var(--space-lg);
    font-size: var(--font-size-h3);
  }

  /* Tiles share the width: 3 tiles = 3 columns; at least 16rem each, so they wrap on smaller screens */
  .collection-tiles__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A photo tile (shape from the "Tile shape" setting) with a frosted glass bar along the bottom */
  .collection-tiles__link {
    position: relative;
    display: block;
    aspect-ratio: var(--tile-ratio, 4 / 3);
    overflow: hidden;
    border-radius: var(--radius-lg);
    color: var(--color-text);
    text-decoration: none;
  }

  .collection-tiles__image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: scale var(--duration-slow) var(--ease-out);
  }

  .collection-tiles__link:hover .collection-tiles__image {
    scale: 1.04;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-tiles__link:hover .collection-tiles__image {
      scale: none;
    }
  }

  .collection-tiles__bar {
    position: absolute;
    inset-inline: var(--space-md);
    inset-block-end: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    padding-inline: 1.25rem;
    border-radius: 1rem;
    /* Frosted glass in the scheme's own background, so its text (the scheme's text colour) stays readable */
    background-color: color-mix(in srgb, var(--color-background) 75%, transparent);
    box-shadow: var(--glass-rim);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .collection-tiles__name {
    font-family: var(--font-heading--family);
    font-size: var(--font-size-body-lg);
  }

  .collection-tiles__cta {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-nav);
    text-transform: uppercase;
  }

  .collection-tiles__cta svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  /* Dark price on the white bar (the price snippet uses the accent colour on product cards) */
  .collection-tiles__price .price__current {
    color: var(--color-text);
    font-weight: 700;
  }
  /*
    ---------- Promo card (Figma) ----------
    Phones 1 per row, tablets 2, desktop 3. A white card (the scheme's raised surface), text on the left,
    the cut-out on the right reaching over the top and bottom edges (overflow stays visible).
    Small heading, offer pill and link in the highlight colour (empty = the scheme's accent).
  */
  .collection-tiles--promo .collection-tiles__list {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
  }

  @media (min-width: 750px) {
    .collection-tiles--promo .collection-tiles__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .collection-tiles--promo .collection-tiles__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }

  .collection-tiles__card {
    position: relative;
    display: flex;
    min-block-size: 12rem;
    padding: var(--space-xl) var(--space-xl) var(--space-lg);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-raised, #ffffff);
    box-shadow: 0 0.75rem 2.5rem #0000000d;
  }

  .collection-tiles__card-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    max-inline-size: 64%;
  }

  .collection-tiles__eyebrow {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .collection-tiles__card-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
  }

  .collection-tiles__card-title {
    margin: 0;
    font-size: var(--font-size-h3);
  }

  .collection-tiles__badge {
    padding: 0.25em 0.8em;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-accent) 14%, var(--color-surface-raised, #ffffff));
    color: var(--color-accent);
    font-family: var(--font-body--family);
    font-size: var(--font-size-caption);
  }

  .collection-tiles__card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: auto;
    padding-block: var(--space-sm) 0.35em;
    border-block-end: 1px solid currentColor;
    color: var(--color-accent);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-decoration: none;
    text-transform: uppercase;
  }

  /* The link covers the whole card: one click target, one Tab stop */
  .collection-tiles__card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .collection-tiles__card-link svg {
    inline-size: 1em;
    block-size: 1em;
    transition: translate var(--duration-fast) var(--ease-out);
  }

  .collection-tiles__card:hover .collection-tiles__card-link svg {
    translate: 0.25em 0;
  }

  /* Focus ring on the whole card; without :has() the link keeps its own ring */
  @supports selector(:has(*)) {
    .collection-tiles__card:has(.collection-tiles__card-link:focus-visible) {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }

    .collection-tiles__card-link:focus-visible {
      outline: none;
    }
  }

  /*
    The cut-out: right side, reaching a little over the top and bottom edges (Figma). The block's Photo
    settings turn, size and move it (rotate / scale / translate, % of its own box), so the text never moves.
    Hover: 4% bigger. "Photo animation" (below) moves it in a slow loop.
  */
  .collection-tiles__cutout {
    position: absolute;
    inset-block: -8%;
    inset-inline-end: 4%;
    inline-size: 36%;
    block-size: 116%;
    object-fit: contain;
    filter: drop-shadow(0 0.75rem 1rem #00000026);
    translate: var(--photo-x, 0%) var(--photo-y, 0%);
    rotate: var(--photo-rotate, 0deg);
    scale: var(--photo-scale, 1);
    transition: scale var(--duration-slow) var(--ease-out);
  }

  .collection-tiles__card:hover .collection-tiles__cutout {
    scale: calc(var(--photo-scale, 1) * 1.04);
  }

  /*
    "Photo animation": the hero decoration's movements (blocks/_hero-decoration.liquid), sized for a
    product photo. Set on the section, so all cards move together. transform only: it adds to the
    x
  */
  @media (prefers-reduced-motion: no-preference) {
    .motion-on .collection-tiles:not(.collection-tiles--anim-none) .collection-tiles__cutout {
      animation-duration: var(--photo-speed, 6s);
      animation-iteration-count: infinite;
      animation-timing-function: ease-in-out;
    }

    .motion-on .collection-tiles--anim-breathe .collection-tiles__cutout { animation-name: tiles-breathe; }
    .motion-on .collection-tiles--anim-float .collection-tiles__cutout { animation-name: tiles-float; }
    .motion-on .collection-tiles--anim-sway .collection-tiles__cutout { animation-name: tiles-sway; }
    .motion-on .collection-tiles--anim-twinkle .collection-tiles__cutout { animation-name: tiles-twinkle; }
    .motion-on .collection-tiles--anim-rock .collection-tiles__cutout { animation-name: tiles-rock; }
    .motion-on .collection-tiles--anim-flash .collection-tiles__cutout { animation-name: tiles-flash; }

    .motion-on .collection-tiles--anim-spin .collection-tiles__cutout {
      animation-name: tiles-spin;
      animation-timing-function: linear;
    }
  }

  @keyframes tiles-breathe {
    50% { transform: scale(1.06); }
  }

  @keyframes tiles-float {
    50% { transform: translateY(-6%); }
  }

  @keyframes tiles-sway {
    0%, 100% { transform: rotate(-4deg); }
    50% { transform: rotate(4deg); }
  }

  @keyframes tiles-twinkle {
    50% { transform: scale(0.94); opacity: 0.35; }
  }

  @keyframes tiles-spin {
    to { transform: rotate(360deg); }
  }

  @keyframes tiles-rock {
    50% { transform: rotate(12deg); }
  }

  /* Appear, turn and disappear: hidden at the start and end, so the loop restarts without a jump */
  @keyframes tiles-flash {
    0% { transform: scale(0.3) rotate(0deg); opacity: 0; }
    15% { transform: scale(1) rotate(30deg); opacity: 1; }
    65% { transform: scale(1) rotate(180deg); opacity: 1; }
    80%, 100% { transform: scale(0.3) rotate(240deg); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-tiles__card-link svg,
    .collection-tiles__cutout {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_tiles",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "tile",
      "name": "t:general.tile",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:labels.collection_tiles_tile_info"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:labels.product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:labels.collection_tiles_image_info"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.tile_label",
          "info": "t:labels.collection_tiles_label_info"
        },
        {
          "type": "header",
          "content": "t:labels.collection_tiles_promo_group"
        },
        {
          "type": "paragraph",
          "content": "t:labels.collection_tiles_promo_info"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:labels.collection_tiles_eyebrow"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "t:labels.collection_tiles_badge"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:labels.collection_tiles_link_label",
          "default": "Shop all"
        },
        {
          "type": "header",
          "content": "t:labels.collection_tiles_photo_group"
        },
        {
          "type": "paragraph",
          "content": "t:labels.collection_tiles_photo_info"
        },
        {
          "type": "range",
          "id": "image_rotate",
          "label": "t:labels.collection_tiles_rotate",
          "min": -45,
          "max": 45,
          "step": 1,
          "unit": "°",
          "default": 0
        },
        {
          "type": "range",
          "id": "image_scale",
          "label": "t:labels.collection_tiles_scale",
          "min": 50,
          "max": 150,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "range",
          "id": "image_x",
          "label": "t:labels.collection_tiles_move_x",
          "min": -30,
          "max": 30,
          "step": 1,
          "unit": "%",
          "default": 0,
          "info": "t:labels.collection_tiles_move_x_info"
        },
        {
          "type": "range",
          "id": "image_y",
          "label": "t:labels.collection_tiles_move_y",
          "min": -30,
          "max": 30,
          "step": 1,
          "unit": "%",
          "default": 0,
          "info": "t:labels.collection_tiles_move_y_info"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Where would you like to start?"
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "select",
      "id": "tile_style",
      "label": "t:labels.collection_tiles_style",
      "info": "t:labels.collection_tiles_style_info",
      "options": [
        {
          "value": "photo",
          "label": "t:options.collection_tiles_style.photo"
        },
        {
          "value": "promo",
          "label": "t:options.collection_tiles_style.promo"
        }
      ],
      "default": "photo"
    },
    {
      "type": "select",
      "id": "tile_ratio",
      "label": "t:labels.collection_tiles_shape",
      "options": [
        {
          "value": "4 / 5",
          "label": "t:options.image_shape.portrait"
        },
        {
          "value": "1 / 1",
          "label": "t:options.image_shape.square"
        },
        {
          "value": "4 / 3",
          "label": "t:options.image_shape.landscape"
        },
        {
          "value": "16 / 9",
          "label": "t:options.image_shape.wide"
        }
      ],
      "default": "4 / 3",
      "visible_if": "{{ section.settings.tile_style == 'photo' }}",
      "info": "t:labels.collection_tiles_shape_info"
    },
    {
