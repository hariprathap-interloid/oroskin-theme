{%- comment -%}
  Product deck (editor name "Product deck", one name everywhere; Figma "New Arrivals", which is the
  default content, not the name, so the section works for any collection): a centred eyebrow ("Just landed") and heading, a small pill on
  the right ("Fresh this week"), then the products of one collection as photo cards. The cards start
  as a tidy stack and fan out into an arc as the section scrolls into view (<product-deck>, --fan
  0 -> 1). The fan itself never moves. One card is active (the first, leftmost one at first): it comes to the
  front IN ITS OWN PLACE, a little bigger, with a round quick-add button and a glass info card (title,
  short text, price, "Buy now"). Hovering (mouse), tapping or tabbing to another card makes that one
  active instead (Figma).

  Short text = the product's Subtitle field (custom.subtitle), else the first words of its description
  (as in Editor's Picks). Without JavaScript, with reduced motion or with animations off: the fan is
  open and the first card is active. Below 1200px the cards sit in rows (Figma mobile: tilted cards,
  3 per row on tablets, 2 on phones, a lone last card centred). The cart button and details card show
  on the open card only, at every width.
{%- endcomment -%}

{%- liquid
  assign deck = section.settings.collection
  assign limit = section.settings.products_to_show
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-1'

  assign count = limit
  if deck != blank and deck.products_count > 0
    assign count = deck.products_count | at_most: limit
  endif
  # Each card's place in the fan: its offset from the middle (7 cards: -3 ... 3; 8 cards: -3.5 ... 3.5).
  # The first (leftmost) card starts active, so the deck reads from the left.
  assign middle = count | minus: 1 | divided_by: 2.0
  assign start = 0

  assign explore_url = section.settings.link
  if explore_url == blank and deck != blank
    assign explore_url = deck.url
  endif

  assign fan = section.settings.fan_on_scroll
  if section.index == 1 or settings.animations_enabled == false
    assign fan = false
  endif

  # Image sizes follow the card width per screen. Large screens: about 22% of the row x Card width,
  # +12% for the open card, but never more than the 40rem card limit (x 1.12 = ~720px) or, with
  # Section width Narrow, 25% of its 1200px row x Card width. Below 1200px (rows): a column (phones
  # 1/2, tablets 1/3).
  assign card_scale = section.settings.card_size | default: 100
  assign large_vw = card_scale | times: 25 | divided_by: 100 | at_most: 45
  assign large_cap = 720
  if section.settings.section_width == 'narrow'
    assign large_cap = card_scale | times: 12 | at_most: 720
  endif
  capture image_sizes
    echo '(min-width: 1200px) min(' | append: large_vw | append: 'vw, ' | append: large_cap | append: 'px), (min-width: 750px) 36vw, 54vw'
  endcapture

  # Rows below 1200px: the number of rows with 2 per row (phones) and 3 per row (tablets)
  assign rows_2 = count | plus: 1 | divided_by: 2
  assign rows_3 = count | plus: 2 | divided_by: 3
-%}

<product-deck
  class="product-deck full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}"
  style="{% if section.settings.highlight_color != blank %}--color-accent: {{ section.settings.highlight_color }}; {% endif %}--half: {{ middle }}; --rows-2: {{ rows_2 }}; --rows-3: {{ rows_3 }}; --card-ratio: {{ section.settings.card_height | divided_by: 100.0 }}; --card-scale: {{ card_scale | divided_by: 100.0 }}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  {% if fan %}
    data-fan
    data-fan-style="{{ section.settings.fan_style }}"
  {% endif %}
>
  <div class="product-deck__inner">
    <div class="product-deck__header">
      <div class="product-deck__titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--center product-deck__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="product-deck__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.pill != blank -%}
        <p class="product-deck__pill">{{ section.settings.pill | escape }}</p>
      {%- endif -%}
    </div>

    <div class="product-deck__stage">
      <ul class="product-deck__list" role="list">
        {%- for i in (1..count) -%}
          {%- liquid
            assign index = forloop.index0
            assign offset = index | minus: middle
            assign distance = offset | abs
            assign product = blank
            if deck != blank and deck.products_count > 0
              assign product = deck.products[index]
            endif

            # Fan: one stack from left to right, the leftmost card on top (10 + count - 1 ... 10)
            assign z = count | minus: index | plus: 9

            # Rows (below 1200px), for 2 and 3 cards per row: the card's row, and its offset from the
            # middle of its row in columns (2 per row: -0.5 / 0.5; 3: -1 / 0 / 1). A row that is not full
            # is centred, so a 7th card alone in its row gets 0. The last row is marked, because its
            # details card opens upwards (no room below the list).
            # 2 per row: column (0 / 1), row, cards in this row, offset = column - (cards in row - 1) / 2
            assign row_2 = index | divided_by: 2
            assign col_2 = index | modulo: 2
            assign in_row_2 = row_2 | times: -2 | plus: count | at_most: 2
            assign half_2 = in_row_2 | minus: 1 | divided_by: 2.0
            assign gx_2 = col_2 | minus: half_2

            # 3 per row: the same
            assign row_3 = index | divided_by: 3
            assign col_3 = index | modulo: 3
            assign in_row_3 = row_3 | times: -3 | plus: count | at_most: 3
            assign half_3 = in_row_3 | minus: 1 | divided_by: 2.0
            assign gx_3 = col_3 | minus: half_3

            assign last_row_2 = rows_2 | minus: 1
            assign last_row_3 = rows_3 | minus: 1
            assign last_row = ''
            if row_2 == last_row_2
              assign last_row = last_row | append: ' 2'
            endif
            if row_3 == last_row_3
              assign last_row = last_row | append: ' 3'
            endif
          -%}
          <li
            class="product-deck__card{% if index == start %} is-active{% endif %}"
            style="--i: {{ index }}; --o: {{ offset }}; --d: {{ distance }}; --z: {{ z }}; --row-2: {{ row_2 }}; --gx-2: {{ gx_2 }}; --row-3: {{ row_3 }}; --gx-3: {{ gx_3 }};"
            {% if last_row != blank %}
              data-last-row="{{ last_row | strip }}"
            {% endif %}
            data-card
          >
            <div class="product-deck__media">
              {%- if product != blank and product.featured_media != blank -%}
                {% render 'image',
                  image: product.featured_media.preview_image,
                  alt: '',
                  class: 'image--cover',
                  sizes: image_sizes
                %}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'product-deck__placeholder' }}
              {%- endif -%}
            </div>

            {%- if section.settings.badge != blank -%}
              <span class="product-deck__badge" aria-hidden="true">{{ section.settings.badge | escape }}</span>
            {%- endif -%}

            {%- comment -%}
              Covers the photo: a tap picks the card, and Tab stops here first, so a keyboard reaches every
              card (focus picks it), then the active card's cart button and links. aria-current marks the
              open card's button (it does not toggle: picking the open card again does nothing).
            {%- endcomment -%}
            {%- liquid
              assign pick_title = 'products.card.placeholder_title' | t
              if product != blank
                assign pick_title = product.title
              endif
            -%}
            <button
              class="product-deck__pick"
              type="button"
              aria-label="{{ 'products.deck.show' | t: title: pick_title }}"
              {% if index == start %}
                aria-current="true"
              {% endif %}
              data-pick
            ></button>

            {%- if product != blank -%}
              {% render 'quick-add', product: product, class: 'product-deck__cart', size: section.settings.cart_size, icon_color: section.settings.cart_icon_color, options: section.settings.cart_options, overlay: section.settings.cart_overlay, id_suffix: forloop.index %}
            {%- endif -%}

            <div class="product-deck__info">
              {%- if product != blank -%}
                {%- liquid
                  assign short_text = product.metafields.custom.subtitle.value
                  if short_text == blank
                    assign short_text = product.description | strip_html | truncatewords: 12
                  endif
                -%}
                <h3 class="product-deck__title">
                  <a class="product-deck__link" href="{{ product.url }}">{{ product.title | escape }}</a>
                </h3>
                {%- if short_text != blank -%}
                  <p class="product-deck__text">{{ short_text | escape }}</p>
                {%- endif -%}
                <div class="product-deck__footer">
                  <div class="product-deck__price">{% render 'price', product: product %}</div>
                  {%- if section.settings.buy_label != blank -%}
                    <a class="button product-deck__buy" href="{{ product.url }}">
                      <span class="product-deck__buy-icon" aria-hidden="true">{{ 'icon-buy.svg' | inline_asset_content }}</span>
                      {{- section.settings.buy_label | escape -}}
                    </a>
                  {%- endif -%}
                </div>
              {%- else -%}
                <h3 class="product-deck__title">{{ 'products.card.placeholder_title' | t }}</h3>
                <div class="product-deck__price">
                  <div class="price"><span class="price__current">{{ 1999 | money }}</span></div>
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if section.settings.link_label != blank and explore_url != blank -%}
      <div class="product-deck__controls">
        {%- comment -%} Shared with the Button block's "Explore (animated)" style {%- endcomment -%}
        {% render 'explore-button', label: section.settings.link_label, url: explore_url %}
      </div>
    {%- endif -%}
  </div>
</product-deck>

{% stylesheet %}
  product-deck {
    display: block;
  }

  .product-deck {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  .product-deck__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1rem + 3vw, 4.5rem);
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  /* Titles in the middle column, the pill in the right one (Figma), so the titles stay centred */
  .product-deck__header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-md);
  }

  .product-deck__titles {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-align: center;
  }

  .product-deck__eyebrow,
  .product-deck__heading,
  .product-deck__pill {
    margin: 0;
  }

  .product-deck__heading {
    font-size: var(--font-size-display);
  }

  /* "New *Arrivals*": italic words in the highlight colour, not slanted */
  .product-deck__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  /* "• Fresh this week": a pale gold pill with a dot */
  .product-deck__pill {
    grid-column: 3;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.45em 1.1em;
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-accent) 18%, var(--color-background));
    color: color-mix(in srgb, var(--color-accent) 70%, var(--color-text));
    font-size: var(--font-size-caption);
  }

  .product-deck__pill::before {
    content: "";
    inline-size: 0.45em;
    block-size: 0.45em;
    border-radius: 50%;
    background-color: currentcolor;
  }

  /*
    The deck. Every card sits in the middle; its place comes from:
    --o    offset from the middle of the deck (7 cards: -3 ... 3), set by Liquid, never changes
    --d    the same without the sign (how far from the middle)
    --half the biggest offset (7 cards: 3)
    --fan  0 = stacked, 1 = fanned out (the script turns it from 0 to 1 while the section scrolls in)
    Fanned: each step moves the card --spread sideways and --turn round, and it drops along an arc (--arc). The
    spread shares ~38% of the width between the steps, so 3 or 8 cards both fill the row.
    Stacked: the cards are only nudged (0.6rem, 3deg), like a pile of photos.
  */
  .product-deck__stage {
    --fan: 1;
    /*
      Width and spread work together, because the outer cards lie on top (Figma): each step is 66% of
      a card, so every inner card keeps about a third of itself visible between its neighbours. The
      width shrinks with more cards so the outermost ones still end inside the row (half x step + half a
      card <= 50%): 6 cards = 22cqi (the Figma ~420px at 1920), 7 = 20cqi, 8 = ~18cqi.
      Card size setting (--card-scale, 1 = that width): bigger cards overlap more instead of pushing the
      outer ones out of the row, so the step is the smaller of 66% of a card and what still fits (the
      outer card is tilted, which makes it ~0.6 of its width wide on each side of its centre, not 0.5).
    */
    --card-w: clamp(12rem, min(22cqi, 50cqi / (var(--half, 3) * 0.66 + 0.55)) * var(--card-scale, 1), 40rem);
    --spread: min(var(--card-w) * 0.66, (50cqi - var(--card-w) * 0.62) / max(var(--half, 3), 0.5));
    /* How far the outermost cards sit below the middle one (Figma: ~100px at 1920) */
    --arc: clamp(2rem, 6cqi, 7.5rem);
    --turn: 5deg;
    position: relative;
    container-type: inline-size;
    /*
      Own stacking layer: the cards' z-index (10-20) only counts inside the deck, so the sticky
      header and its mega menu always stay on top of them
    */
    isolation: isolate;
  }

  .product-deck[data-fan-active] .product-deck__stage {
    --fan: var(--fan-progress, 0);
  }

  .product-deck__list {
    position: relative;
    /*
      Room under the cards for the details card, which hangs well below the front card (Figma), plus
      the arc, so it still fits when an outer (lowest) card is the active one. The details card is about
      the same height at every desktop width, so its room is fixed (phones: below).
    */
    --info-room: 17.5rem;
    block-size: calc(var(--card-w) * var(--card-ratio, 0.7) + var(--info-room) + var(--arc));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
    --y follows an arc, not a V (Figma): with t = distance / biggest distance (0 middle ... 1 outer),
    the drop is half straight and half squared, so the neighbours of the middle card drop a little and
    the outer ones a lot. 6 cards: 12%, 48%, 100% of --arc.
  */
  .product-deck__card {
    --t: calc(var(--d) / max(var(--half, 3), 0.5));
    --x: calc(var(--o) * (var(--spread) * var(--fan) + 0.6rem * (1 - var(--fan))));
    --y: calc((var(--t) + var(--t) * var(--t)) / 2 * var(--arc) * var(--fan));
    --r: calc(var(--o) * (var(--turn) * var(--fan) + 3deg * (1 - var(--fan))));
    position: absolute;
    inset-block-start: var(--space-md);
    inset-inline-start: 50%;
    /*
      One stack from left to right: each card lies on top of the next one, so the left cards cover
      their inner neighbour (Figma: the rose card over the serum card) and the right ones tuck in
      behind the middle card. Leftmost = 10 + count - 1, rightmost = 10 (the active card is 20).
      Liquid writes --z, so no CSS round() is needed (older browsers do not know it).
    */
    z-index: var(--z, 10);
    inline-size: var(--card-w);
    aspect-ratio: 1 / var(--card-ratio, 0.7); /* Card height setting: height / width, 0.7 = the Figma 10 : 7 */
    margin-inline-start: calc(var(--card-w) / -2);
    transform: translate(var(--x), var(--y)) rotate(var(--r));
  }

  /*
    A card growing or shrinking glides (not while scrolling: the script drives that, frame by frame).
    Reduced motion: the card changes size at once.
  */
  @media (prefers-reduced-motion: no-preference) {
    .product-deck[data-moving] .product-deck__card {
      transition: transform 0.45s var(--ease-out);
    }
  }

  /*
    The active card: in its own place and tilt, on top and clearly bigger (Figma: about +12%; rows
    below 1200px: +6%, so a tilted outer card stays inside the page margin)
  */
  .product-deck__card.is-active {
    z-index: 20;
    transform: translate(var(--x), var(--y)) rotate(var(--r)) scale(calc(1 + var(--grow, 0.12) * var(--fan)));
  }

  .product-deck__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: clamp(1rem, 1.6cqi, 1.6rem);
    background-color: var(--color-tint);
    box-shadow: 0 0.75rem 2rem #00000033;
  }

  .product-deck__media .image,
  .product-deck__placeholder {
    inline-size: 100%;
    block-size: 100%;
  }

  /* "New": a gold glass pill, top right */
  .product-deck__badge {
    position: absolute;
    inset-block-start: 7%;
    inset-inline-end: 6%;
    z-index: 2;
    padding: 0.2em 0.85em;
    /*
      Figma Glass (Light -45deg 80%, Frost 100): 1px rim top-left 80% + weaker bottom-right, 35px blur.
      Border = the highlight colour (default #c8a24b, the Figma value). Refraction / Depth / Dispersion /
      Splay are left out, as on every other glass element.
    */
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-accent) 75%, transparent);
    box-shadow:
      0 4px 10px 0 #00000040,
      inset 1px 1px 0 #ffffffcc,
      inset -1px -1px 0 #ffffffbd;
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
    color: #ffffff;
    font-size: var(--font-size-caption);
  }

  /* Covers the card, under the active card's cart button and info card */
  .product-deck__pick {
    position: absolute;
    inset: 0;
    z-index: 3;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: none;
    box-shadow: none;
    cursor: pointer;
  }

  .product-deck__pick:focus-visible {
    outline-offset: 4px;
  }

  /* The overlay behind the button ("Overlay behind the button") is drawn by the quick-add snippet */
  .product-deck__cart {
    position: absolute;
    inset-block-start: 7%;
    inset-inline-start: 5%;
    z-index: 4;
  }

  /*
    The glass info card: hangs low off the bottom of the active card (Figma), centred and 6% narrower than
    the card on each side, so it never pokes out sideways. Hidden (and out of the tab order) on the
    other cards.
    Figma Glass: Frost 100 = the theme's 35px blur, so the product image shows through as a soft tint at
    the top; Light -45deg 80% = a 1px rim on the top-left edges (80%) and a weaker one bottom-right;
    drop shadow 0 4px 15px #00000040. Refraction / Depth / Splay bend the background along the rim
    (SVG filter, Chrome only) and are left out, as on every other glass element.
  */
  .product-deck__info {
    position: absolute;
    inset-block-start: 76%; /* Figma: starts about three quarters down the card and hangs below it */
    /*
      6% in from each side, so it never pokes out past a tilted outer card. On small laptops the card is
      narrow: the padding gets smaller, the price goes above "Buy now" (the footer wraps) and the button
      text stays on one line.
    */
    inset-inline: 6%;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-block: clamp(1rem, 0.5rem + 1.2vw, 2.25rem);
    padding-inline: clamp(0.875rem, 0.25rem + 1vw, 1.75rem);
    border-radius: clamp(0.9rem, 1.4cqi, 1.4rem);
    background-color: color-mix(in srgb, var(--color-background) 40%, transparent);
    box-shadow:
      0 4px 15px 0 #00000040,
      inset 1px 1px 0 #ffffffcc,
      inset -1px -1px 0 #ffffffbd;
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
    color: var(--color-text);
  }

  /*
    Hidden: the cart button and details of every card that is not open, and (before the script runs)
    the open card's while the visitor points at or tabs into another card (see the no-JS rules below)
  */
  .product-deck__card:not(.is-active) :is(.product-deck__cart, .product-deck__info),
  product-deck:not(:defined) .product-deck__list:has(.product-deck__card:not(.is-active):is(:hover, :focus-within)) .is-active :is(.product-deck__cart, .product-deck__info) {
    opacity: 0;
    visibility: hidden;
  }

  /*
    Shown quickly (0.08s wait, 0.25s fade) so it keeps up with the card growing; the old 0.25s wait +
    0.4s fade felt like lag. The info card also rises 0.5rem as it fades in (not with reduced motion).
  */
  .product-deck__card.is-active .product-deck__cart,
  .product-deck__card.is-active .product-deck__info {
    transition:
      opacity 0.25s var(--ease-out) 0.08s,
      transform 0.3s var(--ease-out) 0.08s,
      visibility 0s linear 0.08s;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-deck__card:not(.is-active) .product-deck__info {
      transform: translateY(0.5rem);
    }
  }

  /*
    Before the script runs (or without JavaScript) no card can be picked. Then pointing at a card or
    tabbing into it shows its details, so a visitor can still reach every product, and the first card's
    details hide meanwhile, so only one details card shows.
  */
  product-deck:not(:defined) .product-deck__card:is(:hover, :focus-within) {
    z-index: 21;
  }

  product-deck:not(:defined) .product-deck__card:is(:hover, :focus-within) :is(.product-deck__cart, .product-deck__info) {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .product-deck__title {
    margin: 0;
    font-size: clamp(1.125rem, 0.9rem + 0.6vw, 1.6rem);
  }

  .product-deck__link {
    color: inherit;
    text-decoration: none;
  }

  .product-deck__link:hover {
    text-decoration: underline;
  }

  .product-deck__text {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    color: color-mix(in srgb, var(--color-text) 80%, var(--color-background));
  }

  .product-deck__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .product-deck__price {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* "Buy now": a small gold pill (Figma) */
  .product-deck__buy {
    --color-button: var(--color-accent);
    --color-button-border: var(--color-accent);
    --color-button-text: #ffffff;
    min-block-size: 2.5rem;
    padding-block: 0.4rem;
    padding-inline: clamp(0.75rem, 0.25rem + 0.7vw, 1.1rem);
    white-space: nowrap;
  }

  .product-deck__buy-icon svg {
    display: block;
    inline-size: 1.5em;
    block-size: auto;
  }

  /* "Explore all": snippets/explore-button.liquid (shared with the Button block) */

  .product-deck__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }

  /*
    Rows (below 1200px; Figma mobile): tilted cards in rows,
    3 per row on tablets, 2 on phones. The cards overlap a little at the sides, and each row lies over
    the bottom of the row above (later cards on top). Left cards turn left, right cards turn right, a
    middle card stays straight. A row that is not full is centred (7 cards on a phone: the 7th sits
    alone in the middle). The open card grows in its own place and its details card covers the row
    below, as in the Figma.
    The same --x / --y / --r as the fan, so the animation also works here: --fan 0 = a small stack at
    the top, 1 = the rows. Liquid writes the numbers, so no CSS mod() / round() is needed (older
    browsers, e.g. Samsung Internet before Chromium 125, do not know them):
    --row-2 / --row-3   the card's row with 2 / 3 per row (0, 1, ...)
    --gx-2 / --gx-3     its column's offset from the middle of its row (2 per row: -0.5 / 0.5; 3: -1 / 0 /
                        1; a card alone in its row: 0)
    --rows-2 / --rows-3 the number of rows (on the deck)
    Card = one column wide, the columns 0.9 of a column apart: the cards overlap a little, and the open
    outer card (tilted, +6%) still ends inside the page margin, also with Card height 130%.
    In the last row the details card opens upwards over its own photo (data-last-row), so the list
    only needs a little room below the cards, whatever the length of the text.
  */
  @media (max-width: 1199px) {
    .product-deck__stage {
      --cols: 3;
      --rows: var(--rows-3, 1);
      --col-w: calc(100cqi / var(--cols));
      --card-w: var(--col-w);
      --step-x: calc(var(--col-w) * 0.9);
      --step-y: calc(var(--card-w) * var(--card-ratio, 0.7) * 0.86);
      --turn: 6deg; /* per column step: 3 per row = -6 / 0 / 6deg */
      --grow: 0.06;
    }

    .product-deck__list {
      /* The last row's details card hangs 10% below its card (+6% grow, shadow) */
      --info-room: calc(var(--card-w) * var(--card-ratio, 0.7) * 0.16 + 1rem);
      block-size: calc(
        var(--space-md) + var(--card-w) * var(--card-ratio, 0.7) + (var(--rows) - 1) * var(--step-y) +
          var(--info-room)
      );
    }

    .product-deck__card {
      --row: var(--row-3, 0);
      --gx: var(--gx-3, 0);
      --x: calc(var(--gx) * (var(--step-x) * var(--fan) + 0.6rem * (1 - var(--fan))));
      --y: calc(var(--row) * var(--step-y) * var(--fan));
      --r: calc(var(--gx) * (var(--turn) * var(--fan) + 3deg * (1 - var(--fan))));
    }

    /* Later cards on top (the open card stays on top of all: 20) */
    .product-deck__card:not(.is-active) {
      z-index: calc(10 + var(--i));
    }

    .product-deck__card[data-last-row~="3"] .product-deck__info {
      inset-block: auto -10%;
    }
  }

  /* Phones: the pill under the heading */
  @media (max-width: 749px) {
    .product-deck__header {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .product-deck__titles,
    .product-deck__pill {
      grid-column: 1;
      justify-self: center;
    }

    /* Rows: 2 per row, -6 / 6deg (the column offset is half a step here) */
    .product-deck__stage {
      --cols: 2;
      --rows: var(--rows-2, 1);
      --turn: 12deg;
    }

    .product-deck__card {
      --row: var(--row-2, 0);
      --gx: var(--gx-2, 0);
    }

    /* The last row with 2 per row (first undo the tablet rule, then set this one) */
    .product-deck__card[data-last-row~="3"] .product-deck__info {
      inset-block: 76% auto;
    }

    .product-deck__card[data-last-row~="2"] .product-deck__info {
      inset-block: auto -10%;
    }

    /*
      The details card is centred under its own card, 3% in from each side, so it never goes off the
      screen. The phone card is narrow, so the padding is small. Only the title, price and "Buy now"
      show (Figma mobile).
    */
    .product-deck__info {
      inset-inline: 3%;
      gap: var(--space-xs);
      padding: 0.75rem;
    }

    /* Long prices (a unit price such as "Rs. 15,333.33/100ml") wrap inside the narrow card */
    .product-deck__price {
      min-inline-size: 0;
      font-size: 0.875rem;
      overflow-wrap: anywhere;
    }

    /* "Buy now": smaller lettering on one line, so it fits next to or under the price */
    .product-deck__buy {
      min-block-size: 2.25rem;
      padding-inline: 0.75rem;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      white-space: nowrap;
    }

    .product-deck__title {
      font-size: 1.05rem;
    }

    .product-deck__text {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <product-deck>: makes a card active (class is-active) when the mouse moves onto it, or when it is
   * tapped or reached with Tab; the active card stays until another one is picked. With data-fan, it
   * also moves the cards from a stack to their places (--fan-progress 0 -> 1: the fan from 1200px, the
   * rows below), in one of two ways (setting "Animation > Start of the animation"):
   * - scroll: follows the scroll while the section comes into view (smoothed like the Image banner
   *   scene), and folds back if the visitor scrolls up
   * - auto: plays once by itself (about 1.2s) when the deck is a third on screen, then stays open, also
   *   when the theme editor attaches the section again
   * The cards' places never change: only which one is in front.
   */
  class ProductDeck extends HTMLElement {
    connectedCallback() {
      this.cards = [...this.querySelectorAll('[data-card]')];
      this.list = this.querySelector('.product-deck__list');
      if (this.cards.length < 2) return;

      /*
        Every listener on one AbortController: the theme editor attaches the section again when it
        moves, so connectedCallback runs again. disconnectedCallback removes the old listeners first.
      */
      this.controller = new AbortController();
      const { signal } = this.controller;

      this.cards.forEach((card) => {
        card.addEventListener(
          'pointerenter',
          (event) => {
            if (event.pointerType === 'mouse') this.select(card);
          },
          { signal }
        );
        card.addEventListener('focusin', () => this.select(card), { signal });
        card.querySelector('[data-pick]')?.addEventListener('click', () => this.select(card), { signal });
      });

      if (this.hasAttribute('data-fan') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        if (this.dataset.fanStyle === 'auto') {
          this.startAutoFan();
        } else {
          this.startFan();
        }
      }
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
      this.stopListening();
      clearTimeout(this.movingTimer);
      if (this.playFrame) cancelAnimationFrame(this.playFrame);
    }

    /** "Play once": stacked until a third of the deck is on screen, then fans out by itself and stays */
    startAutoFan() {
      this.setAttribute('data-fan-active', '');
      // Already played (the editor moved the section): stay open, do not play again
      if (this.played) {
        this.current = 1;
        this.paint();
        return;
      }
      this.current = 0;
      this.paint();
      this.observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          this.observer.disconnect(); // once per page view
          this.play();
        },
        { threshold: 0.35 }
      );
      this.observer.observe(this.list);
    }

    /** 0 -> 1 over 1.2s, fast at first and gently settling (ease-out cubic), one step per frame */
    play() {
      this.played = true;
      const duration = 1200;
      const start = performance.now();
      const frame = (now) => {
        const t = Math.min((now - start) / duration, 1);
        this.current = 1 - Math.pow(1 - t, 3);
        this.paint();
        this.playFrame = t < 1 ? requestAnimationFrame(frame) : null;
      };
      this.playFrame = requestAnimationFrame(frame);
    }

    /** The other cards' info and cart button are visibility: hidden (CSS), so Tab skips them */
    select(card) {
      if (card.classList.contains('is-active')) return;
      this.setAttribute('data-moving', '');
      clearTimeout(this.movingTimer);
      this.movingTimer = setTimeout(() => this.removeAttribute('data-moving'), 500);
      this.cards.forEach((item) => {
        item.classList.toggle('is-active', item === card);
        const pick = item.querySelector('[data-pick]');
        if (item === card) {
          pick?.setAttribute('aria-current', 'true');
        } else {
          pick?.removeAttribute('aria-current');
        }
      });
    }

    startFan() {
      this.setAttribute('data-fan-active', '');
      this.current = this.measure();
      this.paint();
      this.run = () => {
        if (!this.frame) this.frame = requestAnimationFrame(() => this.step());
      };
      this.observer = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          window.addEventListener('scroll', this.run, { passive: true });
          window.addEventListener('resize', this.run);
          this.run();
        } else {
          this.stopListening();
          this.current = this.measure();
          this.paint();
        }
      });
      this.observer.observe(this.list);
    }

    stopListening() {
      if (!this.run) return;
      window.removeEventListener('scroll', this.run);
      window.removeEventListener('resize', this.run);
      if (this.frame) cancelAnimationFrame(this.frame);
      this.frame = null;
    }

    /** 0 while the deck's top is at the bottom of the screen, 1 once it has reached 35% from the top */
    measure() {
      const top = this.list.getBoundingClientRect().top;
      const height = window.innerHeight;
      return Math.min(Math.max((height - top) / (height * 0.65), 0), 1);
    }

    /** Each frame the shown progress moves 12% of the way to the real one, until they meet */
    step() {
      this.frame = null;
      const target = this.measure();
      const gap = target - this.current;
      this.current = Math.abs(gap) < 0.0005 ? target : this.current + gap * 0.12;
      this.paint();
      if (this.current !== target) this.run();
    }

    paint() {
      this.style.setProperty('--fan-progress', this.current.toFixed(4));
    }
  }

  if (!customElements.get('product-deck')) {
    customElements.define('product-deck', ProductDeck);
  }
{% endjavascript %}

