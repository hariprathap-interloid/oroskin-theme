{%- comment -%}
  Blog stories (Figma "Stories of Transformation"): an eyebrow, a heading and a "View journal" link
  above story cards. With 4 stories on "Automatic": the Figma mosaic (a wide featured story, two
  stories stacked in the middle, a tall story at the end; Layout "Featured right" mirrors it). Any
  number of stories can be added; with more than 4, or once a story picks its own Shape, a free grid
  takes over (see grid_mode below).

  Where the stories come from (both work together):
  - Blog: the newest articles of the chosen blog fill the places automatically.
  - Story blocks (4 by default, drag to reorder, block 1 = the featured card): each block is one place.
    Pick an Article there to pin that article to the place; leave it empty and the place takes the next
    newest blog article that isn't pinned elsewhere (so nothing shows twice). Custom image and Category
    work for pinned and automatic stories alike.
  - No blocks at all: the 4 newest blog articles, newest first.

  Highlight colour: the eyebrow, the italic words of the heading and the categories (gold in the
  Figma; Scheme 1's own accent is the brand red).
{%- endcomment -%}

{%- liquid
  assign stories_blog = section.settings.blog
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-1'

  # Pinned articles (chosen in a Story block), as "|handle|" marks in one string, so the automatic
  # fill can skip them: contains on "|my-post|" can't match a different post by accident
  assign pinned = '|'
  for block in section.blocks
    if block.settings.article != blank
      assign pinned = pinned | append: block.settings.article.handle | append: '|'
    endif
  endfor
  assign used = '|'

  # View journal: the link setting, else the chosen blog, else the blog of the first pinned article
  # (an article URL is /blogs/<blog-handle>/<article-handle>)
  assign view_all_url = section.settings.link
  if view_all_url == blank and stories_blog != blank
    assign view_all_url = stories_blog.url
  endif
  if view_all_url == blank
    for block in section.blocks
      if block.settings.article != blank
        assign url_parts = block.settings.article.url | split: '/'
        assign view_all_url = '/' | append: url_parts[1] | append: '/' | append: url_parts[2]
        break
      endif
    endfor
  endif

  assign animation = section.settings.animation
  if section.index == 1
    assign animation = 'none'
  endif

  # Card shapes: as long as every Story block is on "Automatic", the Figma mosaic is used (Layout
  # setting). As soon as one block picks its own shape, the grid switches to "custom": a 12-column grid
  # where each card takes its shape's space and the cards pack in order, filling gaps.
  # More than 4 stories don't fit the 4-place mosaic either, so they use the custom grid too.
  assign grid_mode = section.settings.layout
  if section.blocks.size > 4
    assign grid_mode = 'custom'
  endif
  for block in section.blocks
    if block.settings.size != blank and block.settings.size != 'auto'
      assign grid_mode = 'custom'
      break
    endif
  endfor
-%}

<div
  class="blog-stories full-width section-width--{{ section.settings.section_width | default: 'wide' }} color-{{ scheme_id }}"
  style="--color-accent: {{ section.settings.highlight_color }}; --section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="blog-stories__inner">
    <div class="blog-stories__header">
      <div class="blog-stories__titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow blog-stories__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="blog-stories__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and view_all_url != blank -%}
        <a class="button button--text blog-stories__view-all" href="{{ view_all_url }}">
          {{- section.settings.link_label | escape -}}
          <span class="blog-stories__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </a>
      {%- endif -%}
    </div>

    <animate-on-scroll>
      <ul
        class="blog-stories__grid blog-stories__grid--{{ grid_mode }}"
        role="list"
        {% if animation != 'none' %}
          data-animate="{{ animation }}"
        {% endif %}
      >
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              # Pinned article, or else the next newest blog article that isn't pinned or already shown
              assign story = block.settings.article
              if story == blank and stories_blog != blank
                for candidate in stories_blog.articles limit: 50
                  assign mark = '|' | append: candidate.handle | append: '|'
                  if pinned contains mark or used contains mark
                    continue
                  endif
                  assign story = candidate
                  break
                endfor
              endif
              if story != blank
                assign used = used | append: story.handle | append: '|'
              endif

              # "Automatic" shape. In the mosaic: 1 featured, 4 portrait, the others small (the mosaic
              # CSS places them). In the custom grid: the repeating pattern Featured, Small, Portrait,
              # Small, which packs into the same mosaic band every 4 stories, so 8 or 12 stories still
              # look designed.
              assign card_size = block.settings.size
              if card_size == blank or card_size == 'auto'
                if grid_mode == 'custom'
                  assign pattern_place = forloop.index0 | modulo: 4
                  case pattern_place
                    when 0
                      assign card_size = 'featured'
                    when 2
                      assign card_size = 'portrait'
                    else
                      assign card_size = 'small'
                  endcase
                else
                  case forloop.index
                    when 1
                      assign card_size = 'featured'
                    when 4
                      assign card_size = 'portrait'
                    else
                      assign card_size = 'small'
                  endcase
                endif
              endif

              # Zoom point in % (x, y): one of the 9 arrow positions, or blank = the image's focal point
              assign zoom_x = blank
              assign zoom_y = blank
              case block.settings.zoom_point
                when 'top-left'
                  assign zoom_x = 15
                  assign zoom_y = 15
                when 'top'
                  assign zoom_x = 50
                  assign zoom_y = 15
                when 'top-right'
                  assign zoom_x = 85
                  assign zoom_y = 15
                when 'left'
                  assign zoom_x = 15
                  assign zoom_y = 50
                when 'center'
                  assign zoom_x = 50
                  assign zoom_y = 50
                when 'right'
                  assign zoom_x = 85
                  assign zoom_y = 50
                when 'bottom-left'
                  assign zoom_x = 15
                  assign zoom_y = 85
                when 'bottom'
                  assign zoom_x = 50
                  assign zoom_y = 85
                when 'bottom-right'
                  assign zoom_x = 85
                  assign zoom_y = 85
              endcase
            -%}
            {% render 'story-card',
              article: story,
              image: block.settings.image,
              category: block.settings.category,
              pill_label: block.settings.pill_label,
              size: card_size,
              zoom: block.settings.zoom,
              zoom_x: zoom_x,
              zoom_y: zoom_y,
              attributes: block.shopify_attributes
            %}
          {%- endfor -%}
        {%- else -%}
          {%- for story in stories_blog.articles limit: 4 -%}
            {%- liquid
              assign pill = ''
              assign card_size = 'small'
              if forloop.first
                assign pill = 'sections.blog_stories.featured' | t
                assign card_size = 'featured'
              elsif forloop.index == 4
                assign card_size = 'portrait'
              endif
            -%}
            {% render 'story-card', article: story, pill_label: pill, size: card_size %}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </animate-on-scroll>
  </div>
</div>

{% stylesheet %}
  .blog-stories {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  .blog-stories__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 1.5rem + 3vw, 6rem);
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .blog-stories__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .blog-stories__titles {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .blog-stories__eyebrow {
    margin: 0;
  }

  .blog-stories__heading {
    margin: 0;
    font-size: var(--font-size-display);
  }

  /* "*Stories of* Transformation": italic words in the highlight colour, not slanted */
  .blog-stories__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  .blog-stories__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: color-mix(in srgb, var(--color-text) 70%, var(--color-background));
  }

  .blog-stories__arrow svg {
    inline-size: 1em;
    block-size: auto;
  }

  /*
    Mosaic (Figma, 1920px): columns about 10 : 5 : 4, two equal rows.
    Card 1 (featured) = the wide left column, both rows; cards 2 and 3 = middle column, one row each;
    card 4 = right column, both rows. Tablets: 2 columns; phones: one card per row.
  */
  .blog-stories__grid {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-stories__card {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-block-size: 18rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: #1f1f1f;
    color: #ffffff;
  }

  @media (min-width: 750px) {
    .blog-stories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .blog-stories__card--featured {
      grid-row: span 2;
    }

    /* Custom shapes on tablets: two columns, cards pack in order and fill gaps */
    .blog-stories__grid--custom {
      grid-auto-flow: row dense;
    }

    .blog-stories__grid--custom .blog-stories__card--landscape {
      grid-column: span 2;
    }

    .blog-stories__grid--custom .blog-stories__card--portrait {
      grid-row: span 2;
    }
  }

  @media (min-width: 990px) {
    .blog-stories__grid {
      /*
        Each row is at least 15-24rem (growing with the screen) and grows further if a card's text needs
        it (auto), so a card can never be taller than its row and run into the one below.
      */
      grid-template-rows: repeat(2, minmax(clamp(15rem, 17vw, 24rem), auto));
    }

    /* Featured left (Figma): wide featured | 2 stacked | tall */
    .blog-stories__card {
      min-block-size: 0;
    }

    .blog-stories__grid--featured-left {
      grid-template-columns: 10fr 5fr 4fr;
    }

    .blog-stories__grid--featured-left .blog-stories__card:nth-child(1) { grid-area: 1 / 1 / 3 / 2; }
    .blog-stories__grid--featured-left .blog-stories__card:nth-child(2) { grid-area: 1 / 2 / 2 / 3; }
    .blog-stories__grid--featured-left .blog-stories__card:nth-child(3) { grid-area: 2 / 2 / 3 / 3; }
    .blog-stories__grid--featured-left .blog-stories__card:nth-child(4) { grid-area: 1 / 3 / 3 / 4; }

    /* Featured right (mirrored): tall | 2 stacked | wide featured */
    .blog-stories__grid--featured-right {
      grid-template-columns: 4fr 5fr 10fr;
    }

    .blog-stories__grid--featured-right .blog-stories__card:nth-child(1) { grid-area: 1 / 3 / 3 / 4; }
    .blog-stories__grid--featured-right .blog-stories__card:nth-child(2) { grid-area: 1 / 2 / 2 / 3; }
    .blog-stories__grid--featured-right .blog-stories__card:nth-child(3) { grid-area: 2 / 2 / 3 / 3; }
    .blog-stories__grid--featured-right .blog-stories__card:nth-child(4) { grid-area: 1 / 1 / 3 / 2; }

    /*
      Custom (a Story block picked its own shape): 12 columns, rows as tall as the mosaic's rows, as many
      rows as needed. Featured = half the width x 2 rows, Landscape = half x 1, Small = a quarter x 1,
      Portrait = a quarter x 2. "dense" lets a later small card fill a hole left earlier, so e.g.
      Featured, Small, Portrait, Small rebuilds the Figma mosaic.
    */
    .blog-stories__grid--custom {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: minmax(clamp(15rem, 17vw, 24rem), auto);
      grid-auto-flow: row dense;
    }

    .blog-stories__grid--custom .blog-stories__card--featured { grid-column: span 6; grid-row: span 2; }
    .blog-stories__grid--custom .blog-stories__card--landscape { grid-column: span 6; grid-row: auto; }
    .blog-stories__grid--custom .blog-stories__card--small { grid-column: span 3; grid-row: auto; }
    .blog-stories__grid--custom .blog-stories__card--portrait { grid-column: span 3; grid-row: span 2; }
  }

  /* Photo fills the card; a dark fade from the bottom keeps the white text readable */
  .blog-stories__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .blog-stories__media .image,
  .blog-stories__placeholder {
    inline-size: 100%;
    block-size: 100%;
  }

  /*
    Hover (Figma hover state): the photo slowly zooms in (Story block "Hover zoom", 112% by default;
    100% = none) towards its zoom point: the block's own position, else the image's focal point set in
    the image picker, else the centre. The text stays still.
  */
  .blog-stories__media img {
    transform-origin: var(--story-x, 50%) var(--story-y, 50%);
    transition: transform 0.9s var(--ease-out);
  }

  .blog-stories__card:hover .blog-stories__media img,
  .blog-stories__card:has(.blog-stories__link:focus-visible) .blog-stories__media img {
    transform: scale(var(--story-zoom, 1.12));
  }

  .blog-stories__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, #000000d9 0%, #00000066 45%, #00000000 75%);
  }

  .blog-stories__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: clamp(1.25rem, 1rem + 1vw, 2.25rem);
  }

  .blog-stories__category {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  /* Figma: "Featured Story" in a dark glass pill with a thin light edge */
  .blog-stories__pill {
    margin-block-end: var(--space-sm);
    padding: 0.35em 1.25em;
    border: 1px solid #ffffff4d;
    border-radius: var(--radius-pill);
    background-color: #ffffff1f;
    font-size: var(--font-size-body-sm);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
    box-shadow: var(--glass-rim);
  }

  .blog-stories__title {
    margin: 0;
    color: #ffffff;
    font-size: var(--font-size-h3);
  }

  /*
    Featured shape (the first card unless a Story block chooses otherwise): bigger title, pill and
    excerpt. Other shapes don't show a pill or an excerpt; a featured card hides the category when it
    has a pill (Figma). Landscape gets a medium title.
  */
  .blog-stories__card--featured .blog-stories__title {
    font-size: var(--font-size-h1);
  }

  .blog-stories__card--landscape .blog-stories__title {
    font-size: var(--font-size-h2);
  }

  .blog-stories__card:not(.blog-stories__card--featured) :is(.blog-stories__pill, .blog-stories__excerpt),
  .blog-stories__card--featured:has(.blog-stories__pill) .blog-stories__category {
    display: none;
  }

  .blog-stories__excerpt {
    margin: var(--space-sm) 0 0;
    color: #ffffffd9;
    font-size: var(--font-size-body);
  }

  /* The title's link covers the whole card: one click target, one tab stop per story */
  .blog-stories__link {
    color: inherit;
    text-decoration: none;
  }

  .blog-stories__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .blog-stories__link:focus-visible {
    outline: none;
  }

  .blog-stories__card:has(.blog-stories__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /*
    Entrance ("Scroll animation" setting): the grid only triggers (it stays visible); its cards start
    moved and transparent, then glide in one after another (0.12s apart, capped so a long list doesn't
    keep the last cards waiting) when the grid scrolls into view. The selectors repeat [data-animate]
    and :not(.is-visible) to outrank the theme's generic "hide until visible" rule in critical.css,
    which would otherwise move the whole mosaic as one block.
  */
  .blog-stories__grid[data-animate='fade-up'] { --story-from: translateY(2rem); }
  .blog-stories__grid[data-animate='zoom-in'] { --story-from: scale(0.94); }
  .blog-stories__grid[data-animate='slide-top'] { --story-from: translateY(-3rem); }
  .blog-stories__grid[data-animate='slide-bottom'] { --story-from: translateY(3rem); }
  .blog-stories__grid[data-animate='slide-left'] { --story-from: translateX(-4rem); }
  .blog-stories__grid[data-animate='slide-right'] { --story-from: translateX(4rem); }

  .blog-stories__card:nth-child(2) { --card-index: 1; }
  .blog-stories__card:nth-child(3) { --card-index: 2; }
  .blog-stories__card:nth-child(4) { --card-index: 3; }
  .blog-stories__card:nth-child(5) { --card-index: 4; }
  .blog-stories__card:nth-child(n + 6) { --card-index: 5; }

  @media (prefers-reduced-motion: no-preference) {
    .js.animations-on .blog-stories__grid[data-animate],
    .js.animations-on .blog-stories__grid[data-animate]:not(.is-visible) {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .js.animations-on .blog-stories__grid[data-animate] .blog-stories__card {
      transition:
        opacity 0.8s var(--ease-out),
        transform 0.8s var(--ease-out);
      transition-delay: calc(var(--card-index, 0) * 0.12s);
    }

    .js.animations-on .blog-stories__grid[data-animate]:not(.is-visible) .blog-stories__card {
      opacity: 0;
      transform: var(--story-from, none);
    }
  }

  /*
    Theme editor preview: while a Story block is selected (script below), its card stays zoomed in and
    a dot marks the zoom point, so the merchant sees the effect of Zoom amount / Zoom towards straight
    away instead of having to hover. Only in the editor; the live store never gets the class.
  */
  .blog-stories__card.is-zoom-preview .blog-stories__media img {
    transform: scale(var(--story-zoom, 1.12));
  }

  .blog-stories__card.is-zoom-preview .blog-stories__media::before {
    content: "";
    position: absolute;
    inset-block-start: var(--story-y, 50%);
    inset-inline-start: var(--story-x, 50%);
    z-index: 1;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border: 3px solid #ffffff;
    border-radius: 50%;
    background-color: var(--color-accent);
    box-shadow: 0 0 0 1px #00000059, 0 2px 8px #00000066;
    translate: -50% -50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-stories__card:hover .blog-stories__media img {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Theme editor only: while a Story block is selected, keep its card zoomed in with a dot on the zoom
   * point (class is-zoom-preview), so Zoom amount / Zoom towards can be judged without hovering.
   * The editor sends shopify:block:select / shopify:block:deselect to the block's element (the card,
   * which carries block.shopify_attributes), including after a setting change re-renders the section.
   */
  if (window.Shopify?.designMode && !window.oroskinStoryPreview) {
    window.oroskinStoryPreview = true;
    const toggle = (event, on) => {
      const card = event.target.closest?.('.blog-stories__card');
      if (card) card.classList.toggle('is-zoom-preview', on);
    };
    document.addEventListener('shopify:block:select', (event) => toggle(event, true));
    document.addEventListener('shopify:block:deselect', (event) => toggle(event, false));
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.blog_stories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Beauty rituals"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.trending_heading_info",
      "default": "<em>Stories of</em> Transformation"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "View journal"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link",
      "info": "t:labels.blog_stories_link_info"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:labels.blog",
      "info": "t:labels.blog_stories_blog_info"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "featured-left",
          "label": "t:options.stories_layout.featured_left"
        },
        {
          "value": "featured-right",
          "label": "t:options.stories_layout.featured_right"
        }
      ],
