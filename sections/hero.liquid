{%- comment -%}
  Hero (Figma home): one full-width photo, the content on the left (any theme blocks: logo image,
  headings, text, buttons), cut-out product photos placed freely on the right (e.g. on the lattice
  shelves). The vertical brand band on the right edge is the Announcement bar (Position = Right side).

  Two static blocks make the two areas: _hero-content (left, holds theme blocks) and _hero-products
  (right, holds "Product image" blocks). Static = always there, in a fixed place; their children can
  be added, removed and reordered as usual.

  The photo is the page's main image (LCP): the image snippet loads it eagerly with high priority
  when this is the first section, and nothing here animates it, so it paints as early as possible.
{%- endcomment -%}

{%- liquid
  # Colour scheme with a fallback: a saved value can be empty ("") even when the editor shows the
  # default as selected (the editor highlights the default when nothing is stored), so empty = Cream.
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-1'

  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif

  # Phones and tablets: an optional tall Mobile image (plain wall on top for the text, shelves below for the
  # products). With it, the mobile layout below 1024px switches on (class hero--has-mobile) and the products use their
  # Phones settings. --hero-m-ratio = its width / height; --hero-m-start = where the shelves begin (%).
  assign mobile_image = section.settings.mobile_image
  assign mobile_class = ''
  assign mobile_style = ''
  if mobile_image != blank
    assign mobile_class = ' hero--has-mobile'
    assign mobile_style = ' --hero-m-ratio: ' | append: mobile_image.aspect_ratio | append: '; --hero-m-start: ' | append: section.settings.mobile_products_start | append: '; --hero-m-text-width: ' | append: section.settings.mobile_text_width | append: '%;'
  endif

  # Loading for the hero photo (same rules as snippets/image.liquid): first section = eager + high priority
  assign media_loading = 'eager'
  assign media_priority = 'auto'
  if is_first
    assign media_priority = 'high'
  elsif section.index > 3
    assign media_loading = 'lazy'
  endif
-%}

<hero-showcase
  class="hero full-width section-width--{{ section.settings.section_width | default: 'full' }} color-{{ scheme_id }} hero--height-{{ section.settings.height }} hero--x-{{ section.settings.content_x }} hero--y-{{ section.settings.content_y }} hero--scale-{{ section.settings.text_scaling }} hero--spacing-{{ section.settings.content_spacing }}{{ mobile_class }}"
  data-rotate="{{ section.settings.rotate_products }}"
  data-interval="{{ section.settings.rotate_interval | times: 1000 }}"
  data-resume="{{ section.settings.resume_delay | times: 1000 }}"
  style="--hero-overlay: {{ section.settings.overlay_opacity }}%; --hero-content-width: {{ section.settings.content_width }}; --hero-products-start: {{ section.settings.products_start }}%; --hero-pad-top: {{ section.settings.padding_top }}; --hero-pad-bottom: {{ section.settings.padding_bottom }}; --hero-pad-side: 90; --hero-content-gap: calc({{ section.settings.content_gap }} * var(--hero-px));{{ mobile_style }}"
>
  <div class="hero__media">
    {%- if mobile_image != blank -%}
      {%- comment -%}
        <picture>: the browser picks ONE file. Phones and tablets (below 1024px) match the <source> and download
        only the mobile image (in the size their screen needs, from the srcset); larger screens skip it and load
        the <img> (the desktop photo). The <img> carries loading and fetchpriority, which apply to whichever
        file is chosen.
      {%- endcomment -%}
      {%- liquid
        # srcset: 375 / 550 / 750 / 1100 / 1500 / 2000 px wide (only sizes smaller than the file), then the
        # file at its own width. split makes text, plus: 0 turns each piece back into a number to compare.
        assign mobile_widths = '375,550,750,1100,1500,2000' | split: ','
        assign mobile_srcset = ''
        for width_text in mobile_widths
          assign mw = width_text | plus: 0
          if mw < mobile_image.width
            assign mobile_url = mobile_image | image_url: width: mw
            assign mobile_srcset = mobile_srcset | append: mobile_url | append: ' ' | append: mw | append: 'w, '
          endif
        endfor
        assign mobile_full_width = mobile_image.width | at_most: 5760
        assign mobile_url = mobile_image | image_url: width: mobile_full_width
        assign mobile_srcset = mobile_srcset | append: mobile_url | append: ' ' | append: mobile_full_width | append: 'w'
      -%}
      <picture class="image image--cover">
        <source
          media="(max-width: 1023px)"
          srcset="{{ mobile_srcset }}"
          sizes="100vw"
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
        >
        {%- liquid
          assign desktop_image = section.settings.image | default: mobile_image
          echo desktop_image | image_url: width: 3840 | image_tag: widths: '750, 1100, 1500, 1780, 2000, 3000, 3840', sizes: '100vw', loading: media_loading, fetchpriority: media_priority, alt: ''
        -%}
      </picture>
    {%- elsif section.settings.image != blank -%}
      {% render 'image',
        image: section.settings.image,
        class: 'image--cover',
        sizes: '100vw',
        priority: is_first,
        alt: ''
      %}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {%- endif -%}
  </div>

  {%- comment -%}
    The editor lists static blocks in the order they are rendered here: Content, Decorations, Products.
    (Same order for keyboard and screen readers: the text and buttons come first.) Stacking doesn't
    depend on this order: it comes from z-index (content layer 1, active product 2, decoration Layer).
  {%- endcomment -%}
  <div class="hero__inner">
    <div class="hero__content">
      {% content_for 'block', type: '_hero-content', id: 'hero-content' %}
      {% content_for 'block', type: '_hero-decorations', id: 'hero-decorations' %}
    </div>
  </div>

  <div class="hero__products">
    {% content_for 'block', type: '_hero-products', id: 'hero-products' %}
  </div>

  {%- comment -%}
    Pause / play (WCAG 2.2.2: content that moves on its own for more than 5 seconds needs a way to stop
    it). Stops the product rotation and the decoration animations. Hidden until the script finds something
    that actually moves, so it never shows as a button that does nothing.
  {%- endcomment -%}
  <button
    type="button"
    class="hero__pause"
    aria-pressed="false"
    data-label-pause="{{ 'sections.hero.pause' | t }}"
    data-label-play="{{ 'sections.hero.play' | t }}"
    hidden
  >
    <span class="visually-hidden">{{ 'sections.hero.pause' | t }}</span>
    <svg class="hero__pause-icon hero__pause-icon--pause" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="16" height="16"><rect x="3.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/><rect x="9.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/></svg>
    <svg class="hero__pause-icon hero__pause-icon--play" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="16" height="16"><path d="M4.5 2.8v10.4a.8.8 0 0 0 1.2.7l8.4-5.2a.8.8 0 0 0 0-1.4L5.7 2.1a.8.8 0 0 0-1.2.7z" fill="currentColor"/></svg>
  </button>

</hero-showcase>

{% stylesheet %}
  /*
    Layers: the photo fills the section (z 0), an optional overlay tints it for readability, the content
    sits on top on the left. The section's colour scheme sets the text colours (Figma: dark text on the
    light plaster side).
  */
  hero-showcase {
    display: flex;
  }

  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-background);
  }

  .hero--height-full {
    min-block-size: 100svh;
  }

  .hero--height-large {
    min-block-size: 80svh;
  }

  .hero--height-medium {
    min-block-size: 60svh;
  }

  /*
    A top announcement bar sits in normal flow ABOVE the hero (it's in the Header group and scrolls away),
    so it pushes the hero down and the bottom of a full-height hero falls below the screen. Take the bar's
    height off the full-height hero so it fits the first screen exactly. --announcement-size is set on :root
    by the announcement bar section (default 36px). The rule falls away on its own when the bar is closed
    ([hidden]) or set to the right-side band (only announcement-bar--top matches).
    Desktop only (min-width 1024px): below that the hero with a Mobile image is sized from the photo's
    ratio (see .hero--has-mobile), and this must not override that fixed height.
  */
  @media (min-width: 1024px) {
    body:has(.announcement-bar--top:not([hidden]):not(.is-closing)) #MainContent > .shopify-section:first-child .hero--height-full {
      min-block-size: calc(100svh - var(--announcement-size, 2.25rem));
    }

    /*
      When the bar is closed it collapses to nothing and stops matching the rule above, so the hero grows
      back to the full screen. Easing that change keeps it in step with the bar's own collapse.
    */
    @media (prefers-reduced-motion: no-preference) {
      #MainContent > .shopify-section:first-child .hero--height-full {
        transition: min-block-size var(--duration-base, 300ms) var(--ease-out);
      }
    }
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media .image {
    block-size: 100%;
  }

  .hero__placeholder {
    inline-size: 100%;
    block-size: 100%;
    background-color: var(--color-tint-subtle);
    fill: var(--color-tint-border);
  }

  /* Optional tint over the photo, in the scheme's background colour (0 = none, the Figma default) */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: color-mix(in srgb, var(--color-background) var(--hero-overlay), transparent);
    pointer-events: none;
  }

  /*
    Content column, measured from the SCREEN edge, not the page width: the Figma hero is a full-screen
    composition (content ~90px from the left at 1920 = 4.7vw), so on a wide monitor the text stays on
    the plaster side of the photo instead of drifting towards the middle.
  */
  /*
    Sizes in the settings are the sizes at the 1920px Figma frame (plain numbers, so CSS can do maths
    with them). --hero-px turns one of those design pixels into a real length:
    - Fixed: 1px.
    - Scale with screen: the Figma frame fitted to the window (see below), so the whole composition grows
      on a 2560 monitor and shrinks on a laptop, keeping the Figma's proportions. max() keeps a minimum on
      small screens.
  */
  /*
    --hero-bottom-space: the room under the content, shared by the pause button so the two line up: the
    button is centred on the content's last row on every screen (see .hero__pause).
    At least 48px (64px on phones, below), more when "Bottom padding" asks for it.
  */
  .hero {
    --hero-px: 1px;
    --hero-bottom-space: max(var(--space-2xl), calc(var(--hero-pad-bottom) * var(--hero-px)));
  }

  /*
    The Figma frame is 1920 x 1031. Scaling by the smaller of the two ratios (width or height) fits the
    whole composition on screen: a wide-but-short laptop window scales by its height, so the content
    never makes the hero taller than the screen; a tall window scales by its width.
  */
  .hero--scale-screen {
    --hero-px: min(calc(100vw / 1920), calc(100svh / 1031));

    /* The theme's type sizes, redefined for this section as their Figma size x screen ratio */
    --font-size-display-xl: max(3.5rem, calc(108 * var(--hero-px)));
    --font-size-display: max(3rem, calc(96 * var(--hero-px)));
    --font-size-h1: max(2.25rem, calc(60 * var(--hero-px)));
    --font-size-h2: max(1.75rem, calc(40 * var(--hero-px)));
    --font-size-h3: max(1.375rem, calc(26 * var(--hero-px)));
    --font-size-body-lg: max(1.125rem, calc(22 * var(--hero-px)));
    --font-size-body: max(1rem, calc(20 * var(--hero-px)));
    --font-size-body-sm: max(0.9375rem, calc(18 * var(--hero-px)));
    --font-size-caption: max(0.875rem, calc(16 * var(--hero-px)));
    --font-size-label: max(0.875rem, calc(18 * var(--hero-px)));
    --font-size-small: max(0.8125rem, calc(14 * var(--hero-px)));
  }

  /*
    Phones (below 750px, Figma mobile hero at 375px): the 1920-frame maths gives sizes far too small there, and
    the max() floors above are desktop minimums (a 56px display line on a 320px screen). Each size here grows with
    the screen width (vw) between a phone minimum and a tablet maximum. The minimums keep small phones (320px)
    at the 375px Figma size: "Unveil your" (display) 34px, "It is time to" / "Ultimate glow" (h1) 24px, the
    subheading (h3) 17px, the paragraph 15px, buttons 15px. Applies with either Text scaling option.
  */
  @media (max-width: 749px) {
    .hero {
      --font-size-display-xl: clamp(2.375rem, 10vw, 3.25rem);
      --font-size-display: clamp(2.125rem, 9vw, 3rem);
      --font-size-h1: clamp(1.5rem, 6.4vw, 2.25rem);
      --font-size-h2: clamp(1.375rem, 5.4vw, 1.75rem);
      --font-size-h3: clamp(1.0625rem, 4.27vw, 1.375rem);
      --font-size-body-lg: clamp(0.9375rem, 4vw, 1.125rem);
      --font-size-body: clamp(0.9375rem, 3.8vw, 1rem);
      --font-size-body-sm: clamp(0.875rem, 3.6vw, 0.9375rem);
      /* Button text (caption): 15px on phones up to 375px, then up to 16px, so it fills the pill */
      --font-size-caption: clamp(0.9375rem, 4vw, 1rem);
      --font-size-label: clamp(0.9375rem, 4vw, 1rem);
      --font-size-small: clamp(0.75rem, 3.2vw, 0.8125rem);
    }

    /*
      Room at the bottom: 64px under the last row ("New arrivals") on phones, so it and the pause button next
      to it never hug the bottom of the screen (or the browser's toolbar). ".hero" in front of .hero__pause:
      this rule comes before the base one further down, so it needs the extra class to win.
    */
    .hero {
      --hero-bottom-space: max(var(--space-3xl), calc(var(--hero-pad-bottom) * var(--hero-px)));
    }

    .hero .hero__pause {
      inset-block-end: calc(var(--hero-bottom-space) - 0.625rem);
      inset-inline-end: var(--space-md);
    }

    /*
      Buttons: the global pill is 50px tall with 35px sides (desktop Figma). On a phone that left the text
      looking small inside a big pill, so the pill is sized to the text instead: 46px tall, 24px sides.
    */
    .hero .button:not(.button--text) {
      min-block-size: 2.875rem;
      padding-inline: var(--space-lg);
    }
  }

  /*
    The content layer spans the full width over the product area, so it lets the pointer through
    (pointer-events: none) and only the content column takes clicks again: otherwise hovering or
    clicking a product would never reach it.
  */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    inline-size: 100%;
    pointer-events: none;
    padding-block: max(var(--space-2xl), calc(var(--hero-pad-top) * var(--hero-px))) var(--hero-bottom-space);
    padding-inline: max(var(--page-margin), calc(var(--hero-pad-side) * var(--hero-px)));
    /* Section width: Full (default, Figma) = from the screen edge; Wide / Narrow = a centred column */
    max-inline-size: var(--section-width, 100vw);
    margin-inline: auto;
  }

  /* Content position: horizontal (start / center / end) */
  .hero--x-start .hero__inner { justify-content: flex-start; }
  .hero--x-center .hero__inner { justify-content: center; }
  .hero--x-end .hero__inner { justify-content: flex-end; }

  .hero--x-center .hero-content { align-items: center; }
  .hero--x-end .hero-content { align-items: flex-end; }

  /*
    Content spacing. "Gap" = the Content block's fixed gap. The other three spread the blocks over the
    full height of the hero (minus its padding), so the space adapts to each screen's height:
    - between: first block at the top, last at the bottom, equal space in between
    - around: equal space around each block (half-size space at the very top and bottom)
    - evenly: exactly equal space everywhere, top and bottom included
    For that, the content column stretches to the hero's height (vertical position no longer applies).
  */
  .hero:not(.hero--spacing-gap) {
    align-items: stretch;
  }

  .hero:not(.hero--spacing-gap) .hero__content {
    display: flex;
    flex-direction: column;
  }

  .hero:not(.hero--spacing-gap) .hero-content {
    flex: 1;
  }

  .hero--spacing-between .hero-content { justify-content: space-between; }
  .hero--spacing-around .hero-content { justify-content: space-around; }
  .hero--spacing-evenly .hero-content { justify-content: space-evenly; }

  /* Content position: vertical (start / center / end), inside the section's height */
  .hero--y-start { align-items: flex-start; }
  .hero--y-center { align-items: center; }
  .hero--y-end { align-items: flex-end; }

  /*
    The content box: position for the decoration layer (inset 0 = exactly this box), isolation so
    decorations and text stack only against each other (Layer 1-9 behind, text 10, 11-20 in front).
  */
  .hero__content {
    position: relative;
    isolation: isolate;
    pointer-events: auto;
    max-inline-size: calc(var(--hero-content-width) * var(--hero-px));
  }

  /*
    Product area: from "Products area start" to the right edge, full height; products are % inside it.
    (A right-side Announcement bar band keeps its own room: the page leaves its width free.)
  */
  .hero__products {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--hero-products-start);
    inset-inline-end: 0;
  }



  /*
    When the active product changes, only the brush WORD fades out and back in: the script wraps the
    word in .hero-brush-text, so the red brush (drawn by the em's ::before) stays still.
  */
  .hero-brush-text {
    display: inline-block;
    min-inline-size: var(--brush-word-width, auto); /* the widest brush word: the brush keeps one size */
    text-align: center;
    white-space: nowrap; /* one line: a word that wrapped inside the brush would run past it */
    transition: opacity var(--duration-base) var(--ease-out), scale var(--duration-base) var(--ease-out);
  }

  .hero-brush-text.is-swapping {
    opacity: 0;
    scale: 0.9;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-brush-text {
      transition: none;
    }
  }

  /* Pause / play: a small round glass button, bottom right (left of the brand band, when there is one) */
  /*
    Centred on the content's last row. Large screens: the 50px button row, so the 44px button sits 3px above
    the content's bottom. Phones (below): the "New arrivals" link alone on the last line (24px), so 10px below.
  */
  .hero__pause {
    position: absolute;
    inset-block-end: calc(var(--hero-bottom-space) + 0.1875rem);
    inset-inline-end: var(--space-lg);
    z-index: 3;
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin: 0;
    padding: 0;
    border: 1px solid #ffffff;
    border-radius: var(--radius-pill);
    background-color: var(--color-glass-strong);
    box-shadow: var(--shadow-header);
    color: var(--color-text);
    cursor: pointer;
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .hero__pause[hidden] {
    display: none;
  }

  .hero__pause-icon--play,
  .hero__pause[aria-pressed='true'] .hero__pause-icon--pause {
    display: none;
  }

  .hero__pause[aria-pressed='true'] .hero__pause-icon--play {
    display: block;
  }

  /* Paused: decorations freeze where they are (and the rotation stops, in the script) */
  .hero--paused .hero-decoration {
    animation-play-state: paused !important;
  }

  /*
    Smaller screens (no mobile design yet, decision 7): the content spans the width and a light tint
    keeps the text readable over the photo.
  */
  @media (max-width: 989px) {
    .hero::before {
      background-color: color-mix(in srgb, var(--color-background) 55%, transparent);
    }

    .hero__content {
      max-inline-size: none;
    }

    /* Products need the photo's shelves to sit on, so they are hidden where the layout stacks */
    .hero__products {
      display: none;
    }
  }

  /*
    Entrance on page load (pure CSS, starts at first paint: no script to wait for, so it can't leave the
    hero hidden). The background photo never animates, and the products show within 0.2s (one of them
    can be the LCP image, see hero-grow). Only with the theme's animations on (the
    .animations-on class, which is also off in the theme editor) and not with reduced motion.
    - Content rows slide in from the left, one after another.
    - The logo (an Image block in the content) drops in from the top instead.
    - Product images grow from their base like a flower opening: half size -> slightly too big -> settle.
      `transform` adds on top of their translate / rotate, so they keep their place and tilt.
  */
  @media (prefers-reduced-motion: no-preference) {
    .animations-on .hero-content > * {
      animation: hero-in-left 0.8s var(--ease-out) both;
    }

    .animations-on .hero-content > .image-block {
      animation-name: hero-in-top;
    }

    .animations-on .hero-content > :nth-child(2) { animation-delay: 0.12s; }
    .animations-on .hero-content > :nth-child(3) { animation-delay: 0.24s; }
    .animations-on .hero-content > :nth-child(4) { animation-delay: 0.36s; }
    .animations-on .hero-content > :nth-child(5) { animation-delay: 0.48s; }
    .animations-on .hero-content > :nth-child(n + 6) { animation-delay: 0.6s; }

    .animations-on .hero-product {
      transform-origin: 50% 100%;
      animation: hero-grow 1s var(--ease-out) both; /* all products bloom together, straight away */
    }
  }

  @keyframes hero-in-left {
    from {
      opacity: 0;
      transform: translateX(-3rem);
    }
  }

  @keyframes hero-in-top {
    from {
      opacity: 0;
      transform: translateY(-2rem);
    }
  }

  /*
    Starts at half size and fades in over the first 0.2s, so a tiny product is never seen. No delay and a
    short fade: a product image can be the page's LCP element, and the browser only counts an image
    once it is visible, so it must show almost at once.
  */
  @keyframes hero-grow {
    0% {
      opacity: 0;
      transform: scale(0.5);
    }

    20% {
      opacity: 1;
    }

    60% {
      transform: scale(1.06);
    }

    100% {
      transform: none;
    }
  }


  /*
    Phones and tablets with a Mobile image (below 1024px, Figma mobile hero / "product scene showcase"): one
    tall photo, the text over its top, the products on its shelves.
    - The hero is exactly the photo's shape at the screen width (100vw / its width:height ratio): the photo is
      shown whole, never stretched or cropped, on every phone. The section's Height setting doesn't apply here.
    - "Text area height" (mobile_products_start, e.g. 46%) = how much of the top the text may use: the text's
      bottom padding is the rest of the photo + 16px. The products area is the whole photo, so a product at
      68% / 61% always sits on the same shelf.
    - "Text width" (e.g. 100%) = the text column's width.
    - The hero never grows: if the text is taller than its area, the merchant raises Text area height, shortens
      the text or hides the paragraph (Text block: Hide on phones).
    Placed after the 989px rules on purpose: same specificity, so the later rule wins (tint, hidden products).
    Note: a tall photo on a wide tablet makes a tall hero (about 2 screens at 1024px held upright).
  */
  @media (max-width: 1023px) {
    .hero.hero--has-mobile {
      --hero-m-height: calc(100vw / var(--hero-m-ratio));
      align-items: flex-start;
      min-block-size: 0;
      block-size: var(--hero-m-height);
    }

    .hero--has-mobile .hero__content {
      max-inline-size: var(--hero-m-text-width, 100%);
    }

    /* The gap between the content's rows: the 1920-frame maths makes it ~5px here, so a fixed 16px (Figma) */
    .hero--has-mobile .hero-content {
      gap: var(--space-md);
    }

    /* Figma: the logo sits at the top, level with the header's buttons (the header floats over the hero) */
    .hero--has-mobile .hero__inner {
      padding-block-start: var(--space-sm);
    }

    /* A row of buttons that wraps (Explore collection / New arrivals): 16px between the lines, not the desktop 48px */
    .hero--has-mobile .group--horizontal {
      gap: var(--space-md) var(--space-lg);
    }


    /* The Figma mobile hero has no tint: back to the Overlay setting (0 by default) */
    .hero--has-mobile::before {
      background-color: color-mix(in srgb, var(--color-background) var(--hero-overlay), transparent);
    }

    /*
      The text area is a real box: the top "Text area height" (e.g. 46%) of the photo, minus 16px above the
      shelves. The text sits in it by the section's own options, so the setting visibly moves it:
      - Content spacing Between / Around / Evenly: the rows spread over the whole area (logo at the top,
        buttons at its bottom, as in the Figma);
      - Content spacing Gap: the rows stay together, placed by Vertical position (top / center / bottom).
      (box-sizing: border-box, so the height includes the 12px top and 16px bottom padding.)
    */
    .hero--has-mobile .hero__inner {
      box-sizing: border-box;
      block-size: calc(var(--hero-m-height) * var(--hero-m-start) / 100);
      padding-block-end: var(--space-md);
      align-items: flex-start;
    }

    .hero--has-mobile.hero--y-center .hero__inner {
      align-items: center;
    }

    .hero--has-mobile.hero--y-end .hero__inner {
      align-items: flex-end;
    }

    .hero--has-mobile:not(.hero--spacing-gap) .hero__inner {
      align-items: stretch;
    }

    /* The products area = the whole photo (the hero is exactly its shape) */
    .hero--has-mobile .hero__products {
      display: block;
      inset: auto 0 0;
      z-index: 2;
      block-size: var(--hero-m-height);
      pointer-events: none;
    }

    /* Each product's Phones settings (set as variables on the product, see blocks/_hero-product.liquid) */
    .hero--has-mobile .hero-product {
      inset-inline-start: var(--hero-product-mx);
      inset-block-start: var(--hero-product-my);
      inline-size: var(--hero-product-mw);
      pointer-events: auto;
    }

    .hero--has-mobile .hero-product__label {
      inset-inline-start: var(--hero-label-mx);
      inset-block-start: var(--hero-label-my);
      font-size: clamp(1.25rem, 6vw, 1.75rem); /* Figma ~22px at 375px */
    }

    /* Decorations: only those with "Show on phones", at their Phones position and size (real px) */
    .hero--has-mobile .hero-decorations {
      display: block;
    }

    .hero--has-mobile .hero-decoration {
      inset-inline-start: var(--deco-mx);
      inset-block-start: var(--deco-my);
      inline-size: calc(var(--deco-msize) * 1px);
    }

    .hero--has-mobile .hero-decoration:not(.hero-decoration--phone) {
      display: none;
    }

    /* The pause button sits over the shelves, bottom right (the text's bottom space is the shelf area here) */
    .hero--has-mobile .hero__pause {
      inset-block-end: var(--space-md);
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <hero-showcase>: the Figma hero states. Products with a label or brush word take turns being "active":
   * the active one shows its name tag, and the headline's brush word changes to its word ("glow" -> "scent").
   * Start: the product whose brush word matches the headline's own word (e.g. "glow") is active from the
   * first paint, and only products rotate. If no product matches, the first state is the headline's word
   * with no product active.
   *
   * - Rotates every data-interval ms when data-rotate is true, only while the hero is on screen, and never
   *   for visitors who prefer reduced motion.
   * - Hovering or focusing a product shows it straight away and pauses the rotation; when the pointer or
   *   focus leaves, the rotation resumes after data-resume ms (2-3 s by default).
   * - In the theme editor, selecting a product block shows its state.
   * Without JavaScript nothing changes: the default headline shows and the labels stay hidden.
   */
  class HeroShowcase extends HTMLElement {
    connectedCallback() {
      this.setUpPauseButton();
      this.products = [...this.querySelectorAll('[data-hero-product]')];
      const brushEm = this.querySelector('.heading--italic-brush em');
      if (!this.products.length) return;

      // Wrap the brush word in its own span, so the swap fades only the text and the brush stays still
      if (brushEm) {
        this.brush = brushEm.querySelector('.hero-brush-text');
        if (!this.brush) {
          this.brush = document.createElement('span');
          this.brush.className = 'hero-brush-text';
          this.brush.textContent = brushEm.textContent;
          brushEm.replaceChildren(this.brush);
        }
      }

      this.defaultWord = this.brush ? this.brush.textContent : '';
      this.fixBrushWidth();

      /*
        Measure again when the screen width changes (phone / tablet / desktop type sizes and letter spacing
        differ, so a width measured on one screen can be too narrow on another: "glamour" ran past the brush
        at 320px). Debounced: once the resizing stops.
      */
      this.onResize = () => {
        clearTimeout(this.resizeTimer);
        this.resizeTimer = setTimeout(() => this.fixBrushWidth(), 150);
      };
      if (this.brush) window.addEventListener('resize', this.onResize, { passive: true });

      // The product that owns the headline's word ("glow") is the starting state
      const ownWord = this.defaultWord.trim().toLowerCase();
      this.home = this.products.findIndex(
        (product) => (product.dataset.brushWord || '').trim().toLowerCase() === ownWord && ownWord !== ''
      );
      this.state = -2; // nothing shown yet
      this.show(this.home); // -1 = default (no product active) when no product owns the word
      this.interval = Number(this.dataset.interval) || 4000;
      this.resumeDelay = Number(this.dataset.resume) || 2500;
      this.canRotate =
        this.dataset.rotate === 'true' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.products.forEach((product, index) => {
        product.addEventListener('mouseenter', () => this.hold(index));
        product.addEventListener('mouseleave', () => this.release());
        product.addEventListener('focusin', () => this.hold(index));
        product.addEventListener('focusout', () => this.release());
      });

      // Theme editor: selecting a product block previews its state
      this.onBlockSelect = (event) => {
        const index = this.products.findIndex((product) => product.contains(event.target));
        if (index > -1) this.hold(index);
      };
      this.onBlockDeselect = () => this.release();
      document.addEventListener('shopify:block:select', this.onBlockSelect);
      document.addEventListener('shopify:block:deselect', this.onBlockDeselect);

      // Rotate only while the hero is visible
      this.observer = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        if (this.visible && !this.held) this.start();
        else this.stop();
      });
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.stop();
      clearTimeout(this.resumeTimer);
      this.observer?.disconnect();
      clearTimeout(this.resizeTimer);
      window.removeEventListener('resize', this.onResize);
      document.removeEventListener('shopify:block:select', this.onBlockSelect);
      document.removeEventListener('shopify:block:deselect', this.onBlockDeselect);
    }

    /**
     * Pause / play (WCAG 2.2.2). Shown only if something moves: the rotation, or decorations that animate
     * (animations on, no reduced motion). Pausing stops both; playing restarts them.
     */
    setUpPauseButton() {
      this.pauseButton = this.querySelector('.hero__pause');
      if (!this.pauseButton) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const rotates = this.dataset.rotate === 'true' && this.querySelector('[data-hero-product]');
      const decorationsMove =
        document.documentElement.classList.contains('animations-on') &&
        this.querySelector('.hero-decoration:not(.hero-decoration--anim-none)');
      if (reduced || (!rotates && !decorationsMove)) return;

      this.pauseButton.hidden = false;
      this.pauseButton.addEventListener('click', () => {
        this.paused = !this.paused;
        this.pauseButton.setAttribute('aria-pressed', String(this.paused));
        this.pauseButton.querySelector('.visually-hidden').textContent = this.paused
          ? this.pauseButton.dataset.labelPlay
          : this.pauseButton.dataset.labelPause;
        this.classList.toggle('hero--paused', this.paused);
        if (this.paused) this.stop();
        else if (this.visible && !this.held) this.start();
      });
    }

    start() {
      if (!this.canRotate || this.timer || this.paused) return;
      this.timer = setInterval(() => this.show(this.next()), this.interval);
    }

    /**
     * Keeps the brush one size: measures every brush word (the headline's and each product's) in the real
     * font, and gives the word box the widest width, in em so it still scales with the text. Waits for the
     * fonts, because a word measured in the fallback font would have the wrong width.
     */
    async fixBrushWidth() {
      if (!this.brush) return;
      await document.fonts?.ready;
      const words = [this.defaultWord, ...this.products.map((product) => product.dataset.brushWord || '')].filter(Boolean);
      const shown = this.brush.textContent;
      this.brush.style.minInlineSize = '0px';
      this.brush.style.removeProperty('--brush-word-width');
      let widest = 0;
      for (const word of words) {
        this.brush.textContent = word;
        // offsetWidth ignores the swap animation's scale (getBoundingClientRect would include it)
        widest = Math.max(widest, this.brush.offsetWidth);
      }
      this.brush.textContent = shown;
      this.brush.style.minInlineSize = '';
      const fontSize = parseFloat(getComputedStyle(this.brush).fontSize) || 16;
      this.brush.style.setProperty('--brush-word-width', `${(widest / fontSize).toFixed(3)}em`);
    }

    /* Next state: with a "home" product only products rotate; without one, the default state is part of the loop */
    next() {
      if (this.state + 1 < this.products.length) return this.state + 1;
      return this.home > -1 ? 0 : -1;
    }

    stop() {
      clearInterval(this.timer);
      this.timer = null;
    }

    hold(index) {
      this.held = true;
      clearTimeout(this.resumeTimer);
      this.stop();
      this.show(index);
    }

    release() {
      this.held = false;
      clearTimeout(this.resumeTimer);
      this.resumeTimer = setTimeout(() => {
        if (this.held) return;
        if (!this.canRotate || this.paused) this.show(this.home);
        else if (this.visible) this.start();
      }, this.resumeDelay);
    }

    show(index) {
      if (index === this.state) return;
      this.state = index;
      this.products.forEach((product, i) => product.classList.toggle('is-active', i === index));

      if (!this.brush) return;
      const word = (index > -1 && this.products[index].dataset.brushWord) || this.defaultWord;
      if (this.brush.textContent === word) return;
      this.brush.classList.add('is-swapping');
      clearTimeout(this.swapTimer);
      this.swapTimer = setTimeout(() => {
        this.brush.textContent = word;
        this.brush.classList.remove('is-swapping');
      }, 200);
    }
  }

  if (!customElements.get('hero-showcase')) customElements.define('hero-showcase', HeroShowcase);
{% endjavascript %}

