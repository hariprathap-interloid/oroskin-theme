{%- comment -%}
  Hero (Figma home): one full-width photo, the content on the left (any theme blocks: logo image,
  headings, text, buttons), cut-out product photos placed freely on the right (e.g. on the lattice
  shelves) and an optional vertical brand band on the right edge.

  Two static blocks make the two areas: _hero-content (left, holds theme blocks) and _hero-products
  (right, holds "Product image" blocks). Static = always there, in a fixed place; their children can
  be added, removed and reordered as usual.

  The photo is the page's main image (LCP): the image snippet loads it eagerly with high priority
  when this is the first section, and nothing here animates it, so it paints as early as possible.
{%- endcomment -%}

{%- liquid
  # Colour schemes with a fallback: a saved value can be empty ("") even when the editor shows the
  # default as selected (the editor highlights the default when nothing is stored). Without a scheme
  # the band would lose its red background, so empty falls back to the defaults (Cream / Red).
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-1'
  assign band_scheme_id = section.settings.band_color_scheme.id | default: 'scheme-3'

  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif
-%}

<hero-showcase
  class="hero full-width section-width--{{ section.settings.section_width | default: 'full' }} color-{{ scheme_id }} hero--height-{{ section.settings.height }} hero--x-{{ section.settings.content_x }} hero--y-{{ section.settings.content_y }} hero--scale-{{ section.settings.text_scaling }} hero--spacing-{{ section.settings.content_spacing }}"
  data-rotate="{{ section.settings.rotate_products }}"
  data-interval="{{ section.settings.rotate_interval | times: 1000 }}"
  data-resume="{{ section.settings.resume_delay | times: 1000 }}"
  style="--hero-overlay: {{ section.settings.overlay_opacity }}%; --hero-content-width: {{ section.settings.content_width }}; --hero-products-start: {{ section.settings.products_start }}%; --hero-pad-top: {{ section.settings.padding_top }}; --hero-pad-bottom: {{ section.settings.padding_bottom }}; --hero-pad-side: {{ section.settings.padding_side }};"
>
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {% render 'image',
        image: section.settings.image,
        class: 'image--cover',
        sizes: '100vw',
        priority: is_first,
        alt: ''
      %}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {%- endif -%}
  </div>

  <div class="hero__products">
    {% content_for 'block', type: '_hero-products', id: 'hero-products' %}
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      {% content_for 'block', type: '_hero-decorations', id: 'hero-decorations' %}
      {% content_for 'block', type: '_hero-content', id: 'hero-content' %}
    </div>
  </div>

  {%- comment -%}
    Pause / play (WCAG 2.2.2: content that moves on its own for more than 5 seconds needs a way to stop
    it). Stops the product rotation and the decoration animations. Hidden until the script finds something
    that actually moves, so it never shows as a button that does nothing.
  {%- endcomment -%}
  <button
    type="button"
    class="hero__pause"
    aria-pressed="false"
    data-label-pause="{{ 'sections.hero.pause' | t }}"
    data-label-play="{{ 'sections.hero.play' | t }}"
    hidden
  >
    <span class="visually-hidden">{{ 'sections.hero.pause' | t }}</span>
    <svg class="hero__pause-icon hero__pause-icon--pause" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="16" height="16"><rect x="3.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/><rect x="9.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/></svg>
    <svg class="hero__pause-icon hero__pause-icon--play" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="16" height="16"><path d="M4.5 2.8v10.4a.8.8 0 0 0 1.2.7l8.4-5.2a.8.8 0 0 0 0-1.4L5.7 2.1a.8.8 0 0 0-1.2.7z" fill="currentColor"/></svg>
  </button>

  {%- if section.settings.show_band and section.settings.band_text != blank -%}
    {%- comment -%} Decorative brand line; the same words are not needed twice by screen readers {%- endcomment -%}
    <div class="hero__band color-{{ band_scheme_id }}" aria-hidden="true">
      <span class="hero__band-text">{{ section.settings.band_text | escape }}</span>
    </div>
  {%- endif -%}
</hero-showcase>

{% stylesheet %}
  /*
    Layers: the photo fills the section (z 0), an optional overlay tints it for readability, the content
    sits on top on the left. The section's colour scheme sets the text colours (Figma: dark text on the
    light plaster side).
  */
  hero-showcase {
    display: flex;
  }

  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-background);
  }

  .hero--height-full {
    min-block-size: 100svh;
  }

  .hero--height-large {
    min-block-size: 80svh;
  }

  .hero--height-medium {
    min-block-size: 60svh;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media .image {
    block-size: 100%;
  }

  .hero__placeholder {
    inline-size: 100%;
    block-size: 100%;
    background-color: var(--color-tint-subtle);
    fill: var(--color-tint-border);
  }

  /* Optional tint over the photo, in the scheme's background colour (0 = none, the Figma default) */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: color-mix(in srgb, var(--color-background) var(--hero-overlay), transparent);
    pointer-events: none;
  }

  /*
    Content column, measured from the SCREEN edge, not the page width: the Figma hero is a full-screen
    composition (content ~90px from the left at 1920 = 4.7vw), so on a wide monitor the text stays on
    the plaster side of the photo instead of drifting towards the middle.
  */
  /*
    Sizes in the settings are the sizes at the 1920px Figma frame (plain numbers, so CSS can do maths
    with them). --hero-px turns one of those design pixels into a real length:
    - Fixed: 1px.
    - Scale with screen: the Figma frame fitted to the window (see below), so the whole composition grows
      on a 2560 monitor and shrinks on a laptop, keeping the Figma's proportions. max() keeps a minimum on
      small screens.
  */
  .hero {
    --hero-px: 1px;
  }

  /*
    The Figma frame is 1920 x 1031. Scaling by the smaller of the two ratios (width or height) fits the
    whole composition on screen: a wide-but-short laptop window scales by its height, so the content
    never makes the hero taller than the screen; a tall window scales by its width.
  */
  .hero--scale-screen {
    --hero-px: min(calc(100vw / 1920), calc(100svh / 1031));

    /* The theme's type sizes, redefined for this section as their Figma size x screen ratio */
    --font-size-display-xl: max(3.5rem, calc(108 * var(--hero-px)));
    --font-size-display: max(3rem, calc(96 * var(--hero-px)));
    --font-size-h1: max(2.25rem, calc(60 * var(--hero-px)));
    --font-size-h2: max(1.75rem, calc(40 * var(--hero-px)));
    --font-size-h3: max(1.375rem, calc(26 * var(--hero-px)));
    --font-size-body-lg: max(1.125rem, calc(22 * var(--hero-px)));
    --font-size-body: max(1rem, calc(20 * var(--hero-px)));
    --font-size-body-sm: max(0.9375rem, calc(18 * var(--hero-px)));
    --font-size-caption: max(0.875rem, calc(16 * var(--hero-px)));
    --font-size-label: max(0.875rem, calc(18 * var(--hero-px)));
    --font-size-small: max(0.8125rem, calc(14 * var(--hero-px)));
  }

  /*
    The content layer spans the full width over the product area, so it lets the pointer through
    (pointer-events: none) and only the content column takes clicks again: otherwise hovering or
    clicking a product would never reach it.
  */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    inline-size: 100%;
    pointer-events: none;
    padding-block: max(var(--space-2xl), calc(var(--hero-pad-top) * var(--hero-px)))
      max(var(--space-xl), calc(var(--hero-pad-bottom) * var(--hero-px)));
    padding-inline: max(var(--page-margin), calc(var(--hero-pad-side) * var(--hero-px)));
    /* Section width: Full (default, Figma) = from the screen edge; Wide / Narrow = a centred column */
    max-inline-size: var(--section-width, 100vw);
    margin-inline: auto;
  }

  /* Content position: horizontal (start / center / end) */
  .hero--x-start .hero__inner { justify-content: flex-start; }
  .hero--x-center .hero__inner { justify-content: center; }
  .hero--x-end .hero__inner { justify-content: flex-end; }

  .hero--x-center .hero-content { align-items: center; }
  .hero--x-end .hero-content { align-items: flex-end; }

  /*
    Content spacing. "Gap" = the Content block's fixed gap. The other three spread the blocks over the
    full height of the hero (minus its padding), so the space adapts to each screen's height:
    - between: first block at the top, last at the bottom, equal space in between
    - around: equal space around each block (half-size space at the very top and bottom)
    - evenly: exactly equal space everywhere, top and bottom included
    For that, the content column stretches to the hero's height (vertical position no longer applies).
  */
  .hero:not(.hero--spacing-gap) {
    align-items: stretch;
  }

  .hero:not(.hero--spacing-gap) .hero__content {
    display: flex;
    flex-direction: column;
  }

  .hero:not(.hero--spacing-gap) .hero-content {
    flex: 1;
  }

  .hero--spacing-between .hero-content { justify-content: space-between; }
  .hero--spacing-around .hero-content { justify-content: space-around; }
  .hero--spacing-evenly .hero-content { justify-content: space-evenly; }

  /* Content position: vertical (start / center / end), inside the section's height */
  .hero--y-start { align-items: flex-start; }
  .hero--y-center { align-items: center; }
  .hero--y-end { align-items: flex-end; }

  /*
    The content box: position for the decoration layer (inset 0 = exactly this box), isolation so
    decorations and text stack only against each other (Layer 1-9 behind, text 10, 11-20 in front).
  */
  .hero__content {
    position: relative;
    isolation: isolate;
    pointer-events: auto;
    max-inline-size: calc(var(--hero-content-width) * var(--hero-px));
  }

  /* Product area: from "Products area start" to the band, full height; products are % inside it */
  .hero__products {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--hero-products-start);
    inset-inline-end: 2.25rem;
  }

  /*
    Vertical brand band (Figma: a red strip on the right edge, white uppercase text reading top to
    bottom). writing-mode turns the line of text sideways; the band's own colour scheme paints it.
  */
  .hero__band {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.25rem;
  }

  .hero__band-text {
    writing-mode: vertical-rl;
    color: var(--color-text);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.35em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /*
    When the active product changes, only the brush WORD fades out and back in: the script wraps the
    word in .hero-brush-text, so the red brush (drawn by the em's ::before) stays still.
  */
  .hero-brush-text {
    display: inline-block;
    min-inline-size: var(--brush-word-width, auto); /* the widest brush word: the brush keeps one size */
    text-align: center;
    transition: opacity var(--duration-base) var(--ease-out), scale var(--duration-base) var(--ease-out);
  }

  .hero-brush-text.is-swapping {
    opacity: 0;
    scale: 0.9;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-brush-text {
      transition: none;
    }
  }

  /* Pause / play: a small round glass button, bottom right (left of the brand band) */
  .hero__pause {
    position: absolute;
    inset-block-end: var(--space-lg);
    inset-inline-end: calc(2.25rem + var(--space-lg));
    z-index: 3;
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin: 0;
    padding: 0;
    border: 1px solid #ffffff;
    border-radius: var(--radius-pill);
    background-color: var(--color-glass-strong);
    box-shadow: var(--shadow-header);
    color: var(--color-text);
    cursor: pointer;
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .hero__pause[hidden] {
    display: none;
  }

  .hero__pause-icon--play,
  .hero__pause[aria-pressed='true'] .hero__pause-icon--pause {
    display: none;
  }

  .hero__pause[aria-pressed='true'] .hero__pause-icon--play {
    display: block;
  }

  /* Paused: decorations freeze where they are (and the rotation stops, in the script) */
  .hero--paused .hero-decoration {
    animation-play-state: paused !important;
  }

  /*
    Smaller screens (no mobile design yet, decision 7): the content spans the width and a light tint
    keeps the text readable over the photo; the band is hidden (too narrow to read).
  */
  @media (max-width: 989px) {
    .hero::before {
      background-color: color-mix(in srgb, var(--color-background) 55%, transparent);
    }

    .hero__content {
      max-inline-size: none;
    }

    /* Products need the photo's shelves to sit on, so they are hidden where the layout stacks */
    .hero__products,
    .hero__band {
      display: none;
    }
  }

  /*
    Entrance on page load (pure CSS, starts at first paint: no script to wait for, so it can't leave the
    hero hidden). The background photo never animates, and the products show within 0.2s (one of them
    can be the LCP image, see hero-grow). Only with the theme's animations on (the
    .animations-on class, which is also off in the theme editor) and not with reduced motion.
    - Content rows slide in from the left, one after another.
    - The logo (an Image block in the content) drops in from the top instead.
    - Product images grow from their base like a flower opening: half size -> slightly too big -> settle.
      `transform` adds on top of their translate / rotate, so they keep their place and tilt.
  */
  @media (prefers-reduced-motion: no-preference) {
    .animations-on .hero-content > * {
      animation: hero-in-left 0.8s var(--ease-out) both;
    }

    .animations-on .hero-content > .image-block {
      animation-name: hero-in-top;
    }

    .animations-on .hero-content > :nth-child(2) { animation-delay: 0.12s; }
    .animations-on .hero-content > :nth-child(3) { animation-delay: 0.24s; }
    .animations-on .hero-content > :nth-child(4) { animation-delay: 0.36s; }
    .animations-on .hero-content > :nth-child(5) { animation-delay: 0.48s; }
    .animations-on .hero-content > :nth-child(n + 6) { animation-delay: 0.6s; }

    .animations-on .hero-product {
      transform-origin: 50% 100%;
      animation: hero-grow 1s var(--ease-out) both; /* all products bloom together, straight away */
    }
  }

  @keyframes hero-in-left {
    from {
      opacity: 0;
      transform: translateX(-3rem);
    }
  }

  @keyframes hero-in-top {
    from {
      opacity: 0;
      transform: translateY(-2rem);
    }
  }

  /*
    Starts at half size and fades in over the first 0.2s, so a tiny product is never seen. No delay and a
    short fade: a product image can be the page's LCP element, and the browser only counts an image
    once it is visible, so it must show almost at once.
  */
  @keyframes hero-grow {
    0% {
      opacity: 0;
      transform: scale(0.5);
    }

    20% {
      opacity: 1;
    }

    60% {
      transform: scale(1.06);
    }

    100% {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <hero-showcase>: the Figma hero states. Products with a label or brush word take turns being "active":
   * the active one shows its name tag, and the headline's brush word changes to its word ("glow" -> "scent").
   * Start: the product whose brush word matches the headline's own word (e.g. "glow") is active from the
   * first paint, and only products rotate. If no product matches, the first state is the headline's word
   * with no product active.
   *
   * - Rotates every data-interval ms when data-rotate is true, only while the hero is on screen, and never
   *   for visitors who prefer reduced motion.
   * - Hovering or focusing a product shows it straight away and pauses the rotation; when the pointer or
   *   focus leaves, the rotation resumes after data-resume ms (2-3 s by default).
   * - In the theme editor, selecting a product block shows its state.
   * Without JavaScript nothing changes: the default headline shows and the labels stay hidden.
   */
  class HeroShowcase extends HTMLElement {
    connectedCallback() {
      this.setUpPauseButton();
      this.products = [...this.querySelectorAll('[data-hero-product]')];
      const brushEm = this.querySelector('.heading--italic-brush em');
      if (!this.products.length) return;

      // Wrap the brush word in its own span, so the swap fades only the text and the brush stays still
      if (brushEm) {
        this.brush = brushEm.querySelector('.hero-brush-text');
        if (!this.brush) {
          this.brush = document.createElement('span');
          this.brush.className = 'hero-brush-text';
          this.brush.textContent = brushEm.textContent;
          brushEm.replaceChildren(this.brush);
        }
      }

      this.defaultWord = this.brush ? this.brush.textContent : '';
      this.fixBrushWidth();

      // The product that owns the headline's word ("glow") is the starting state
      const ownWord = this.defaultWord.trim().toLowerCase();
      this.home = this.products.findIndex(
        (product) => (product.dataset.brushWord || '').trim().toLowerCase() === ownWord && ownWord !== ''
      );
      this.state = -2; // nothing shown yet
      this.show(this.home); // -1 = default (no product active) when no product owns the word
      this.interval = Number(this.dataset.interval) || 4000;
      this.resumeDelay = Number(this.dataset.resume) || 2500;
      this.canRotate =
        this.dataset.rotate === 'true' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.products.forEach((product, index) => {
        product.addEventListener('mouseenter', () => this.hold(index));
        product.addEventListener('mouseleave', () => this.release());
        product.addEventListener('focusin', () => this.hold(index));
        product.addEventListener('focusout', () => this.release());
      });

      // Theme editor: selecting a product block previews its state
      this.onBlockSelect = (event) => {
        const index = this.products.findIndex((product) => product.contains(event.target));
        if (index > -1) this.hold(index);
      };
      this.onBlockDeselect = () => this.release();
      document.addEventListener('shopify:block:select', this.onBlockSelect);
      document.addEventListener('shopify:block:deselect', this.onBlockDeselect);

      // Rotate only while the hero is visible
      this.observer = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        if (this.visible && !this.held) this.start();
        else this.stop();
      });
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.stop();
      clearTimeout(this.resumeTimer);
      this.observer?.disconnect();
      document.removeEventListener('shopify:block:select', this.onBlockSelect);
      document.removeEventListener('shopify:block:deselect', this.onBlockDeselect);
    }

    /**
     * Pause / play (WCAG 2.2.2). Shown only if something moves: the rotation, or decorations that animate
     * (animations on, no reduced motion). Pausing stops both; playing restarts them.
     */
    setUpPauseButton() {
      this.pauseButton = this.querySelector('.hero__pause');
      if (!this.pauseButton) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const rotates = this.dataset.rotate === 'true' && this.querySelector('[data-hero-product]');
      const decorationsMove =
        document.documentElement.classList.contains('animations-on') &&
        this.querySelector('.hero-decoration:not(.hero-decoration--anim-none)');
      if (reduced || (!rotates && !decorationsMove)) return;

      this.pauseButton.hidden = false;
      this.pauseButton.addEventListener('click', () => {
        this.paused = !this.paused;
        this.pauseButton.setAttribute('aria-pressed', String(this.paused));
        this.pauseButton.querySelector('.visually-hidden').textContent = this.paused
          ? this.pauseButton.dataset.labelPlay
          : this.pauseButton.dataset.labelPause;
        this.classList.toggle('hero--paused', this.paused);
        if (this.paused) this.stop();
        else if (this.visible && !this.held) this.start();
      });
    }

    start() {
      if (!this.canRotate || this.timer || this.paused) return;
      this.timer = setInterval(() => this.show(this.next()), this.interval);
    }

    /**
     * Keeps the brush one size: measures every brush word (the headline's and each product's) in the real
     * font, and gives the word box the widest width, in em so it still scales with the text. Waits for the
     * fonts, because a word measured in the fallback font would have the wrong width.
     */
    async fixBrushWidth() {
      if (!this.brush) return;
      await document.fonts?.ready;
      const words = [this.defaultWord, ...this.products.map((product) => product.dataset.brushWord || '')].filter(Boolean);
      const shown = this.brush.textContent;
      this.brush.style.minInlineSize = '0px';
      let widest = 0;
      for (const word of words) {
        this.brush.textContent = word;
        // offsetWidth ignores the swap animation's scale (getBoundingClientRect would include it)
        widest = Math.max(widest, this.brush.offsetWidth);
      }
      this.brush.textContent = shown;
      this.brush.style.minInlineSize = '';
      const fontSize = parseFloat(getComputedStyle(this.brush).fontSize) || 16;
      this.brush.style.setProperty('--brush-word-width', `${(widest / fontSize).toFixed(3)}em`);
    }

    /* Next state: with a "home" product only products rotate; without one, the default state is part of the loop */
    next() {
      if (this.state + 1 < this.products.length) return this.state + 1;
      return this.home > -1 ? 0 : -1;
    }

    stop() {
      clearInterval(this.timer);
      this.timer = null;
    }

    hold(index) {
      this.held = true;
      clearTimeout(this.resumeTimer);
      this.stop();
      this.show(index);
    }

    release() {
      this.held = false;
      clearTimeout(this.resumeTimer);
      this.resumeTimer = setTimeout(() => {
        if (this.held) return;
        if (!this.canRotate || this.paused) this.show(this.home);
        else if (this.visible) this.start();
      }, this.resumeDelay);
    }

    show(index) {
      if (index === this.state) return;
      this.state = index;
      this.products.forEach((product, i) => product.classList.toggle('is-active', i === index));

      if (!this.brush) return;
      const word = (index > -1 && this.products[index].dataset.brushWord) || this.defaultWord;
      if (this.brush.textContent === word) return;
      this.brush.classList.add('is-swapping');
      clearTimeout(this.swapTimer);
      this.swapTimer = setTimeout(() => {
        this.brush.textContent = word;
        this.brush.classList.remove('is-swapping');
      }, 200);
    }
  }

  if (!customElements.get('hero-showcase')) customElements.define('hero-showcase', HeroShowcase);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.hero",
  "blocks": [
    {
      "type": "_hero-content"
    },
    {
      "type": "_hero-decorations"
    },
    {
      "type": "_hero-products"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:labels.hero_image_info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "info": "t:labels.overlay_opacity_info",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
