{%- comment -%}
  Trending articles (file name blog-trending; M8.2, Figma 3007:81455, under the Blog hero; phone design
  design/inbox/blog-list/Variant14): the "Trending this week" panel with an optional "View all" link and up
  to five numbered article rows, and a video card that plays in place.

  - Layout: from 1200px two columns (video left or right, Video position). Below 1200px (phones and
    tablets) one column: the panel, then the video as a wide, short card. The panel comes first in the HTML
    on all screens, so keyboard and screen readers get the articles first.
  - Video: an uploaded (Shopify-hosted) video first, else a YouTube / Vimeo link. The player is kept in a
    <template> and only added on click, so nothing loads (and nothing plays) until then. No video = no card
    on the store (the editor shows a placeholder with a note).
  - Rows: hand-picked with Trending article blocks. No block with an article: the blog's 5 newest
    articles. "Trending" is the merchant's choice; Shopify has no view counts.
  - Every page of the blog shows the same rows (page 2, topic pages): they read blogs[blog.handle], because
    on a topic page Shopify filters blog.articles by the tag.
  - Sized to the screen like the hero (snippets/screen-scale.liquid). Video slides in, rows fade up 100ms
    apart (stagger in the CSS, so it follows the row's place).
{%- endcomment -%}

{%- liquid
  assign show_section = true
  assign whole_blog = blogs[blog.handle]

  assign animation = section.settings.animation
  if section.index == 1
    assign animation = 'none'
  endif
  assign rows_animation = 'none'
  if animation != 'none'
    assign rows_animation = 'fade-up'
  endif

  # The section can't read its theme blocks' settings (they come back empty), so the blocks are rendered
  # first: an empty Trending article block prints nothing on the store
  capture block_rows
    content_for 'blocks'
  endcapture

  assign rows_html = ''
  if block_rows contains 'class="trending-article'
    assign rows_html = block_rows
  elsif whole_blog.articles_count > 0
    capture rows_html
      for article in whole_blog.articles limit: 5
        render 'trending-article', article: article, show_topic: section.settings.show_meta_topic, speed: section.settings.reading_speed, animation: rows_animation
      endfor
    endcapture
  elsif request.design_mode
    capture rows_html
      for i in (1..5)
        render 'trending-article'
      endfor
    endcapture
  endif

  if rows_html == blank
    assign show_section = false
  endif

  # No row has a views text: the rows drop the views column (no gap between the pill and the arrow)
  assign has_views = false
  if rows_html contains 'trending-article__views'
    assign has_views = true
  endif

  # "View all" only with a link: the blog's own URL would be the page the visitor is already on
  assign show_view_all = false
  if section.settings.link_label != blank and section.settings.link != blank
    assign show_view_all = true
  endif

  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign poster = section.settings.poster
  if poster == blank and video != blank
    assign poster = video.preview_image
  endif
  assign has_video = false
  if video != blank or video_url != blank
    assign has_video = true
  endif

  assign video_title = section.settings.video_title | default: section.settings.video_label
  if video_title != blank
    assign play_label = 'blog.play_video' | t: title: video_title
  else
    assign play_label = 'blog.play_video_plain' | t
    assign video_title = play_label
  endif

  # The card shows on the store only with a video; the editor also shows the empty card with a note
  assign show_video = false
  if section.settings.show_video
    if has_video or request.design_mode
      assign show_video = true
    endif
  endif

  assign video_right = false
  if section.settings.video_position == 'right'
    assign video_right = true
    if animation == 'slide-left'
      assign animation = 'slide-right'
    endif
  endif

  # sizes: from 1200px the video column is 489 / 1765 of the content (about 28%); below, the full content.
  # Content = about 92vw (100vw with Full width), at most 1200px (Narrow) or 1650px (Wide)
  assign base_vw = 92
  if section.settings.section_width == 'full'
    assign base_vw = 100
  endif
  assign column_vw = base_vw | times: 489 | divided_by: 1765
  assign poster_sizes = '(min-width: 1200px) ' | append: column_vw | append: 'vw, ' | append: base_vw | append: 'vw'
  if section.settings.section_width == 'narrow'
    assign poster_sizes = '(min-width: 1200px) 333px, ' | append: base_vw | append: 'vw'
  elsif section.settings.section_width == 'wide'
    assign poster_sizes = '(min-width: 1650px) 458px, ' | append: poster_sizes
  endif
-%}

{%- capture poster_loading -%}{% render 'section-loading' %}{%- endcapture -%}
{%- assign poster_loading = poster_loading | strip -%}

{% render 'screen-scale' %}

{%- if show_section -%}
<div
  class="blog-trending full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ section.settings.color_scheme.id | default: 'scheme-2' }}{% if section.settings.fill_screen %} section--fill-screen{% endif %}{% if section.settings.scale_screen %} section--screen-scale{% endif %}{% if show_video %} blog-trending--has-video{% endif %}{% if video_right %} blog-trending--video-right{% endif %}{% unless has_views %} blog-trending--no-views{% endunless %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --text-boost: {{ section.settings.text_scale | default: 110 | divided_by: 100.0 }}; --video-radius: {{ section.settings.video_radius }}px;"
>
  <animate-on-scroll class="blog-trending__inner">
    {%- comment -%} ---------- Trending panel ---------- {%- endcomment -%}
    <div class="blog-trending__panel">
      {%- if section.settings.heading == blank -%}
        {%- comment -%} The row titles are h3: they need an h2 above them {%- endcomment -%}
        <h2 class="visually-hidden">{{ 'blog.trending.heading_hidden' | t }}</h2>
      {%- endif -%}

      {%- if section.settings.heading != blank or show_view_all -%}
        <div
          class="blog-trending__header"
          {% if rows_animation != 'none' %}
            data-animate="{{ rows_animation }}"
          {% endif %}
        >
          {%- if section.settings.heading != blank -%}
            <h2 class="blog-trending__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if show_view_all -%}
            <a class="blog-trending__view-all" href="{{ section.settings.link }}">
              {{- section.settings.link_label | escape -}}
              <span class="blog-trending__view-all-arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ol class="blog-trending__rows" role="list">
        {{- rows_html -}}
      </ol>
    </div>

    {%- comment -%} ---------- Video card ---------- {%- endcomment -%}
    {%- if show_video -%}
      <div
        class="blog-trending__video"
        {% if animation != 'none' %}
          data-animate="{{ animation }}"
        {% endif %}
      >
        <blog-video class="blog-video{% unless has_video %} blog-video--empty{% endunless %}">
          <div class="blog-video__poster">
            {%- if poster != blank -%}
              {{
                poster
                | image_url: width: 1100
                | image_tag: widths: '400, 600, 800, 1100', sizes: poster_sizes, alt: '', loading: poster_loading
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'blog-video__placeholder' }}
            {%- endif -%}
          </div>

          {%- if has_video -%}
            {%- if section.settings.video_label != blank or section.settings.video_title != blank -%}
              <div class="blog-video__caption">
                {%- if section.settings.video_label != blank -%}
                  <p class="blog-video__label">{{ section.settings.video_label | escape }}</p>
                {%- endif -%}
                {%- if section.settings.video_title != blank -%}
                  <p class="blog-video__title">{{ section.settings.video_title | escape }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <button class="blog-video__play" type="button" aria-label="{{ play_label | escape }}">
              {{- 'icon-play.svg' | inline_asset_content -}}
            </button>

            <template class="blog-video__template">
              {%- if video != blank -%}
                {{ video | video_tag: controls: true, playsinline: true, image_size: '1100x' }}
              {%- elsif video_url.type == 'youtube' -%}
                <iframe
                  src="https://www.youtube-nocookie.com/embed/{{ video_url.id }}?autoplay=1&playsinline=1&rel=0"
                  title="{{ video_title | escape }}"
                  allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                  allowfullscreen
                ></iframe>
              {%- else -%}
                <iframe
                  src="https://player.vimeo.com/video/{{ video_url.id }}?autoplay=1&dnt=1"
                  title="{{ video_title | escape }}"
                  allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                  allowfullscreen
                ></iframe>
              {%- endif -%}
            </template>
          {%- else -%}
            {%- comment -%} Theme editor only: no video yet {%- endcomment -%}
            <p class="blog-video__note">{{ 'blog.trending.video_empty' | t }}</p>
          {%- endif -%}
        </blog-video>
      </div>
    {%- endif -%}
  </animate-on-scroll>
</div>
{%- endif -%}

{% stylesheet %}
  /*
    Figma 1920 frame: video 489 x 859 at x 49, panel 1276 x 859 at x 594 (56px gap), from y 143.
    Sizes are tokens or Figma px x --px (screen-scale), with the Figma px in comments.
  */
  .blog-trending {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  /* Phones and tablets: the panel, then the video (HTML order). Two columns from 1200px */
  .blog-trending__inner {
    display: grid;
    gap: var(--space-lg);
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  @media (min-width: 750px) {
    .blog-trending__inner {
      gap: var(--space-2xl);
    }
  }

  /* The panel is first in the HTML; grid areas put the video on its side */
  @media (min-width: 1200px) {
    .blog-trending--has-video .blog-trending__inner {
      grid-template-columns: minmax(0, 489fr) minmax(0, 1276fr);
      grid-template-areas: "video panel";
      column-gap: max(var(--space-xl), calc(56 * var(--px, 0.0625rem)));
    }

    .blog-trending--has-video.blog-trending--video-right .blog-trending__inner {
      grid-template-columns: minmax(0, 1276fr) minmax(0, 489fr);
      grid-template-areas: "panel video";
    }

    .blog-trending--has-video .blog-trending__panel {
      grid-area: panel;
    }

    .blog-trending__video {
      grid-area: video;
    }
  }

  /* ---------- Video card ---------- */
  .blog-trending__video {
    display: grid;
  }

  /* Below 1200px a wide, short card (phone design: 335 x 152) */
  .blog-video {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 2.2 / 1;
    border-radius: var(--video-radius, var(--radius-lg));
    background-color: #1a1a1a;
    color: #ffffff;
    isolation: isolate;
  }

  /* Phones: a big radius would cut into the short card */
  @media (max-width: 749px) {
    .blog-video {
      border-radius: min(var(--video-radius, 1.5rem), 1.5rem);
    }
  }

  /* Wide screens: as tall as the panel next to it (859px in the Figma) */
  @media (min-width: 1200px) {
    .blog-video {
      aspect-ratio: auto;
      min-block-size: calc(859 * var(--px, 0.0625rem));
    }
  }

  .blog-video__poster,
  .blog-video__poster img,
  .blog-video__placeholder,
  .blog-video > video,
  .blog-video > iframe {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .blog-video__poster img {
    object-fit: cover;
  }

  .blog-video__placeholder {
    fill: #ffffff40;
  }

  /* Dark fade at the bottom, so the white text reads on any photo (black 0 → 80%) */
  .blog-video__poster::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, #000000cc);
  }

  .blog-video__caption {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: 0 calc(37 * var(--px, 0.0625rem)) max(var(--space-xl), calc(42 * var(--px, 0.0625rem)));
    pointer-events: none;
  }

  /* "VIDEO · 12:40" */
  .blog-video__label {
    margin: 0;
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .blog-video__title {
    max-inline-size: 18em;
    margin: var(--space-lg) 0 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size-h3); /* ~26px */
    line-height: 1.3;
  }

  /* Theme editor only: the empty card's note, in the middle */
  .blog-video__note {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    margin: 0;
    padding: var(--space-lg);
    font-size: var(--font-size-body-sm);
    font-style: italic;
    text-align: center;
  }

  /* Phones (design 335 x 152): small text near the edges, the play button above the caption */
  @media (max-width: 749px) {
    .blog-video__caption {
      padding: 0 var(--space-md) var(--space-md);
    }

    .blog-video__label {
      font-size: 0.75rem;
    }

    .blog-video__title {
      max-inline-size: none;
      margin-block-start: var(--space-xs);
      font-size: 0.875rem;
    }
  }

  /* 70px round glass button: white rim, frosted, white play icon */
  .blog-video__play {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    inline-size: max(3.5rem, calc(70 * var(--px, 0.0625rem)));
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid #ffffff;
    border-radius: 50%;
    background-color: #ffffff1a;
    color: #ffffff;
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
    cursor: pointer;
    translate: -50% -50%;
    transition:
      scale var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  /* The triangle's middle is drawn at the middle of its 24px box (assets/icon-play.svg), no nudge */
  .blog-video__play svg {
    display: block;
    inline-size: 45%;
    block-size: auto;
  }

  @media (max-width: 749px) {
    .blog-video__play {
      inset-block-start: 30%;
      inline-size: 2.5rem;
    }
  }

  /* The button works only with the script: hidden without JavaScript and until the element is defined */
  blog-video:not(:defined) .blog-video__play {
    visibility: hidden;
  }

  @media (scripting: none) {
    .blog-video__play {
      display: none;
    }
  }

  .blog-video__play:hover,
  .blog-video__play:focus-visible {
    background-color: #ffffff33;
    scale: 1.08;
  }

  .blog-video__play:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  /* Playing: the player covers the card; poster, text and button go */
  .blog-video.is-playing > :not(video, iframe) {
    display: none;
  }

  .blog-video > video {
    object-fit: contain;
    background-color: #000000;
  }

  .blog-video > iframe {
    border: 0;
  }

  /* ---------- Trending panel ---------- */
  .blog-trending__panel {
    padding: max(var(--space-xl), calc(45 * var(--px, 0.0625rem)));
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    background-color: var(--color-card);
  }

  .blog-trending__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-inline-end: calc(12 * var(--px, 0.0625rem));
  }

  .blog-trending__heading {
    margin: 0;
    font-size: var(--font-size-h2); /* 44px with the Text size boost */
  }

  /* "*Trending* this week": the italic word in the accent colour, upright */
  .blog-trending__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  /* The Figma grey (developer's choice, under 4.5:1 for small text): change --trending-muted in M9 */
  .blog-trending {
    --trending-muted: color-mix(in srgb, var(--color-text) 55%, var(--color-background));
  }

  .blog-trending__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-inline-start: auto; /* stays at the end with no heading */
    color: var(--trending-muted);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-label);
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .blog-trending__view-all:hover {
    color: var(--color-accent);
  }

  .blog-trending__view-all-arrow svg {
    display: block;
    inline-size: 1.1em;
    block-size: auto;
    transition: translate var(--duration-fast) var(--ease-out);
  }

  .blog-trending__view-all:hover .blog-trending__view-all-arrow svg {
    translate: 0.25em 0;
  }

  /* Rows 24px apart, ~50px under the header; the counter numbers them 01, 02… */
  .blog-trending__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: max(var(--space-xl), calc(50 * var(--px, 0.0625rem))) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: trending-row;
  }

  /* The Figma zig-zag: every second row starts ~45px further in (12px on phones) */
  .blog-trending__rows > :nth-child(even) {
    margin-inline-start: max(var(--space-sm), calc(45 * var(--px, 0.0625rem)));
  }

  /* Phones (Variant14): the rows near the panel edges, close together */
  @media (max-width: 749px) {
    .blog-trending__panel {
      padding: var(--space-md) var(--space-xs) var(--space-xs);
    }

    .blog-trending__header {
      padding-inline: var(--space-xs);
    }

    .blog-trending__rows {
      gap: var(--space-xs);
      margin-block-start: var(--space-md);
    }
  }

  /* No row has a views text: no views column (else a gap between the pill and the arrow) */
  .blog-trending--no-views .trending-article {
    grid-template-columns: max(3rem, calc(72 * var(--px, 0.0625rem))) minmax(0, 1fr) auto auto;
    grid-template-areas: "number text tag arrow";
  }

  @media (max-width: 749px) {
    .blog-trending--no-views .trending-article {
      grid-template-columns: 1.75rem minmax(0, 1fr) auto auto;
      grid-template-areas: "number text tag arrow";
    }

    .blog-trending--no-views .trending-article__arrow {
      align-self: center;
    }
  }

  /* Rows fade up one after another, 100ms apart */
  .blog-trending__rows > :nth-child(2) {
    --animate-delay: 100ms;
  }

  .blog-trending__rows > :nth-child(3) {
    --animate-delay: 200ms;
  }

  .blog-trending__rows > :nth-child(4) {
    --animate-delay: 300ms;
  }

  .blog-trending__rows > :nth-child(5) {
    --animate-delay: 400ms;
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <blog-video>: plays the Trending articles video in place. The player waits in a <template> (so the
   * page loads no video and no YouTube / Vimeo frame); a click on the play button puts it in the card,
   * starts it and moves the focus to it. The listener is on one AbortController: the theme editor
   * attaches a moved section again (connectedCallback runs again), and two listeners added two players.
   */
  class BlogVideo extends HTMLElement {
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      this.querySelector('.blog-video__play')?.addEventListener('click', () => this.play(), {
        signal: this.controller.signal,
      });
    }

    disconnectedCallback() {
      this.controller?.abort();
    }

    play() {
      if (this.classList.contains('is-playing')) return;
      const template = this.querySelector('.blog-video__template');
      const player = template?.content.firstElementChild?.cloneNode(true);
      if (!player) return;

      this.append(player);
      this.classList.add('is-playing');
      if (player instanceof HTMLVideoElement) player.play().catch(() => {});
      player.focus();
    }
  }

  if (!customElements.get('blog-video')) {
    customElements.define('blog-video', BlogVideo);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.blog_trending",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "blog"
    ]
  },
  "blocks": [
    {
      "type": "_trending-article"
    }
  ],
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.italic_accent_info",
      "default": "<em>Trending</em> this week"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link",
      "info": "t:labels.trending_blog_link_info"
    },
    {
      "type": "header",
      "content": "t:labels.trending_rows",
      "info": "t:labels.trending_rows_info"
    },
    {
      "type": "checkbox",
      "id": "show_meta_topic",
      "label": "t:labels.show_meta_topic",
      "info": "t:labels.show_meta_topic_info",
      "default": false
    },
    {
      "type": "range",
      "id": "reading_speed",
      "label": "t:labels.reading_speed",
      "info": "t:labels.reading_speed_info",
      "min": 150,
      "max": 300,
      "step": 10,
      "unit": "wpm",
      "default": 200
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.section_width.narrow"
        },
        {
          "value": "wide",
          "label": "t:options.section_width.wide"
        },
        {
          "value": "widest",
          "label": "t:options.section_width.widest"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "widest"
    },
