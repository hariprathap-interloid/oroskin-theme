{%- comment -%}
  Collection list (/collections), M5.7. No Figma frame. Columns: phones 1, tablets 2, small laptops
  (990-1199px) at most 3, from 1200px "Columns on desktop". Every collection of the shop is listed
  automatically (the `collections` object, alphabetical), split into pages (snippets/pagination.liquid).

  Two choices for the merchant:
  - Header: a centred title (eyebrow + serif title, like the search page) or a banner with a photo, a title,
    a short text and the breadcrumb (Home › Collections).
  - Layout of the collections (one card markup, the look comes from the CSS):
    tiles   = photo with a frosted glass bar on it (the theme's Collection tiles look)
    cards   = photo, then a separate bar under it with the name and the count
    overlay = the name centred in white on a darkened photo
    bento   = tiles in mixed sizes: a big tile, then small ones, the big one on alternating sides
{%- endcomment -%}

{%- liquid
  # scheme-2 = the schema default (the template can save an empty value)
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'
  assign layout = section.settings.layout | default: 'tiles'
  assign heading_default = 'collections.list_heading' | t

  # Columns per screen: phones 1, tablets (750-989px) 2, small laptops (990-1199px) at most 3,
  # from 1200px "Columns on desktop". Bento always has 3 columns from 990px.
  assign columns = section.settings.columns_desktop | default: 3
  if layout == 'bento'
    assign columns = 3
  endif
  assign columns_laptop = columns | at_most: 3

  # Photo sizes: the content column is about 92vw of the screen (100vw with Full width), at most
  # 1200px (Narrow) or 1650px (Wide). Each number on its own line: in one long filter chain,
  # divided_by would apply to the text.
  assign base_vw = 92
  if section.settings.section_width == 'full'
    assign base_vw = 100
  endif
  assign max_px = 0
  if section.settings.section_width == 'narrow'
    assign max_px = 1200
  elsif section.settings.section_width == 'wide'
    assign max_px = 1650
  endif

  assign desktop_vw = base_vw | divided_by: columns
  assign laptop_vw = base_vw | divided_by: columns_laptop
  assign tablet_vw = base_vw | divided_by: 2
  assign card_sizes = ''
  if max_px > 0
    assign desktop_px = max_px | divided_by: columns
    assign card_sizes = '(min-width: ' | append: max_px | append: 'px) ' | append: desktop_px | append: 'px, '
  endif
  assign card_sizes = card_sizes | append: '(min-width: 1200px) ' | append: desktop_vw | append: 'vw, '
  assign card_sizes = card_sizes | append: '(min-width: 990px) ' | append: laptop_vw | append: 'vw, '
  assign card_sizes = card_sizes | append: '(min-width: 750px) ' | append: tablet_vw | append: 'vw, '
  assign card_sizes = card_sizes | append: base_vw | append: 'vw'

  # Bento big cards: 2 of 3 columns from 990px, the full width below
  assign big_vw = base_vw | times: 2 | divided_by: 3
  assign big_sizes = ''
  if max_px > 0
    assign big_px = max_px | times: 2 | divided_by: 3
    assign big_sizes = '(min-width: ' | append: max_px | append: 'px) ' | append: big_px | append: 'px, '
  endif
  assign big_sizes = big_sizes | append: '(min-width: 990px) ' | append: big_vw | append: 'vw, ' | append: base_vw | append: 'vw'

  # Banner: the full content column
  assign banner_sizes = base_vw | append: 'vw'
  if max_px > 0
    assign banner_sizes = '(min-width: ' | append: max_px | append: 'px) ' | append: max_px | append: 'px, ' | append: banner_sizes
  endif

  # The theme's eager / lazy rule; high priority only when this is the page's first section
  capture image_loading
    render 'section-loading'
  endcapture
  assign image_loading = image_loading | strip

  # Animation. This section is nearly always the page's first section, so the theme's rule "no
  # animation in section 1" is applied per card: in section 1 the first row (on the first screen)
  # shows at once and the later rows come in on scroll.
  assign animation = section.settings.animation | default: 'none'
  assign still_cards = 0
  if section.index == 1
    assign still_cards = columns
  endif
-%}

<div
  class="collections-page full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --tile-ratio: {{ section.settings.tile_ratio }}; --columns: {{ columns }}; --columns-laptop: {{ columns_laptop }}; --card-radius: {{ section.settings.card_radius }}px;"
>
  <div class="collections-page__inner">
    {%- if section.settings.header_style == 'banner' -%}
      <header class="collections-hero{% if section.settings.banner_image == blank %} collections-hero--plain{% endif %}">
        {%- if section.settings.banner_image != blank -%}
          {%- comment -%} The page's largest picture, decorative (alt empty) {%- endcomment -%}
          {%- if section.index == 1 -%}
            {{
              section.settings.banner_image
              | image_url: width: 2400
              | image_tag:
                widths: '800, 1200, 1600, 2000, 2400',
                sizes: banner_sizes,
                alt: '',
                loading: image_loading,
                fetchpriority: 'high',
                class: 'collections-hero__image'
            }}
          {%- else -%}
            {{
              section.settings.banner_image
              | image_url: width: 2400
              | image_tag:
                widths: '800, 1200, 1600, 2000, 2400',
                sizes: banner_sizes,
                alt: '',
                loading: image_loading,
                class: 'collections-hero__image'
            }}
          {%- endif -%}
        {%- endif -%}
        <div class="collections-hero__content">
          <h1 class="collections-hero__title">{{ section.settings.heading | default: heading_default }}</h1>
          {%- if section.settings.text != blank -%}
            <p class="collections-hero__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      </header>

      {%- if section.settings.show_breadcrumb -%}
        <nav class="collections-page__breadcrumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
          <ol role="list">
            <li><a href="{{ routes.root_url }}">{{ 'accessibility.home' | t }}</a></li>
            <li><span aria-current="page">{{ 'collections.title' | t }}</span></li>
          </ol>
        </nav>
      {%- endif -%}
    {%- else -%}
      <header class="collections-page__header">
        <p class="collections-page__eyebrow">{{ 'collections.title' | t }}</p>
        <h1 class="collections-page__title">{{ section.settings.heading | default: heading_default }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="collections-page__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%}
      paginate only takes the collections list as Shopify gives it, and Liquid can't remove the empty ones
      before the pages are cut. So a hidden empty collection still takes a place: that page shows one card
      fewer. The real fix is in the admin (the setting's info says so): a collection that isn't on the
      Online Store sales channel isn't in `collections` at all.
    {%- endcomment -%}
    {%- paginate collections by section.settings.per_page -%}
      {%- liquid
        # How many collections on this page will show (empty ones are skipped unless the setting says so)
        assign shown = 0
        for item in collections
          if item.all_products_count > 0 or section.settings.show_empty
            assign shown = shown | plus: 1
          endif
        endfor
      -%}

      {%- if shown > 0 -%}
        {%- comment -%}
          position = the card's place among the cards actually drawn (1, 2, 3…). Skipped empty collections
          don't count, so it matches the CSS :nth-child() that picks the bento's big cards.
        {%- endcomment -%}
        {%- assign position = 0 -%}
        {%- comment -%}
          data-columns-*: the column counts, so the CSS can give each card in a row its own delay
          (CSS can't read a number from a variable in :nth-child())
        {%- endcomment -%}
        <animate-on-scroll>
        <ul
          class="collections-grid collections-grid--{{ layout }}"
          role="list"
          data-columns-laptop="{{ columns_laptop }}"
          data-columns-desktop="{{ columns }}"
        >
          {%- for item in collections -%}
            {%- if item.all_products_count > 0 or section.settings.show_empty -%}
              {%- liquid
                assign position = position | plus: 1

                # The first row may be on the first screen (only without a banner): the section's eager /
                # lazy rule for those photos, lazy for the others
                assign tile_loading = 'lazy'
                if position <= columns
                  unless section.settings.header_style == 'banner'
                    assign tile_loading = image_loading
                  endunless
                endif

                # Bento: the 1st and 7th of every 12 cards are big
                assign tile_sizes = card_sizes
                if layout == 'bento'
                  assign cycle_place = position | modulo: 12
                  if cycle_place == 1 or cycle_place == 7
                    assign tile_sizes = big_sizes
                  endif
                endif
              -%}
              <li
                class="collections-grid__item"
                {% if animation != 'none' and position > still_cards %}
                  data-animate="{{ animation }}"
                {% endif %}
              >
                <a class="collections-card" href="{{ item.url }}">
                  <div class="collections-card__media">
                    {%- if item.featured_image != blank -%}
                      {%- comment -%} alt is empty: the name on the card names the link {%- endcomment -%}
                      {{
                        item.featured_image
                        | image_url: width: 1600
                        | image_tag:
                          widths: '400, 600, 800, 1200, 1600',
                          sizes: tile_sizes,
                          alt: '',
                          loading: tile_loading,
                          class: 'collections-card__image'
                      }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'collections-card__image' }}
                    {%- endif -%}
                  </div>
                  <div class="collections-card__bar">
                    <span class="collections-card__name">{{ item.title | escape }}</span>
                    <span class="collections-card__count">
                      {%- if layout == 'cards' -%}
                        {%- comment -%} Cards: just the number (reference: "Headphones 7"), the words for screen readers {%- endcomment -%}
                        <span aria-hidden="true">{{ item.all_products_count }}</span>
                        <span class="visually-hidden">{{ 'collections.products_count' | t: count: item.all_products_count }}</span>
                      {%- else -%}
                        {{- 'collections.products_count' | t: count: item.all_products_count -}}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      {%- endif -%}
                    </span>
                  </div>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        </animate-on-scroll>
      {%- else -%}
        <p class="collections-page__empty">{{ 'collections.list_empty' | t }}</p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .collections-page {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  .collections-page__inner {
    display: grid;
    gap: var(--space-2xl);
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  /* Header "Centred title": a short red rule + uppercase eyebrow, then the serif title (like search) */
  .collections-page__header {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .collections-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
    color: var(--color-accent);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .collections-page__eyebrow::before {
    content: '';
    inline-size: 4.125rem; /* 66px, the theme's eyebrow rule */
    block-size: 2px;
    background-color: currentColor;
  }

  .collections-page__title {
    margin: 0;
    font-size: var(--font-size-h1);
    line-height: var(--line-height-heading);
  }

  .collections-page__text {
    max-inline-size: 40rem;
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 80%, var(--color-background));
    font-size: var(--font-size-body);
  }

  /*
    Header "Banner with image": a rounded panel with the photo filling it and the words on the left. The
    background colour fades in from the left over the photo, so the text stays readable on any picture.
  */
  .collections-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-block-size: clamp(16rem, 28vw, 27rem);
    overflow: hidden;
    border-radius: var(--card-radius, var(--radius-lg));
    isolation: isolate;
  }

  .collections-hero__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .collections-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-background) 85%, transparent) 0%,
      color-mix(in srgb, var(--color-background) 55%, transparent) 45%,
      transparent 75%
    );
  }

  .collections-hero--plain {
    background-color: color-mix(in srgb, var(--color-accent) 6%, var(--color-background));
  }

  .collections-hero__content {
    display: grid;
    gap: var(--space-md);
    max-inline-size: 34rem;
    padding: var(--space-2xl) clamp(var(--space-lg), 5vw, 6rem);
  }

  .collections-hero__title {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--font-size-display);
    line-height: var(--line-height-heading);
  }

  .collections-hero__text {
    margin: 0;
    font-size: var(--font-size-body-lg);
  }

  /* Breadcrumb under the banner: Home | Collections */
  .collections-page__breadcrumb {
    margin-block-start: calc(var(--space-lg) * -1); /* closer to the banner than the grid gap */
    font-size: var(--font-size-small);
  }

  .collections-page__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collections-page__breadcrumb li + li::before {
    content: '|';
    margin-inline-end: var(--space-sm);
    color: color-mix(in srgb, var(--color-text) 40%, var(--color-background));
  }

  .collections-page__breadcrumb a {
    color: color-mix(in srgb, var(--color-text) 75%, var(--color-background));
    text-decoration: none;
  }

  .collections-page__breadcrumb a:hover {
    color: var(--color-accent);
  }

  .collections-page__breadcrumb [aria-current] {
    font-weight: var(--font-weight-medium);
  }

  /*
    The grid: phones 1 column, tablets 2, small laptops (990-1199px) --columns-laptop (at most 3),
    from 1200px "Columns on desktop". These rules come before the bento rules, which replace them.
  */
  .collections-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .collections-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .collections-grid > :nth-child(2n) {
      --col: 1;
    }
  }

  @media (min-width: 990px) {
    .collections-grid {
      grid-template-columns: repeat(var(--columns-laptop, 3), minmax(0, 1fr));
    }

    .collections-grid[data-columns-laptop='3'] > :nth-child(3n + 1) {
      --col: 0;
    }

    .collections-grid[data-columns-laptop='3'] > :nth-child(3n + 2) {
      --col: 1;
    }

    .collections-grid[data-columns-laptop='3'] > :nth-child(3n) {
      --col: 2;
    }
  }

  @media (min-width: 1200px) {
    .collections-grid {
      grid-template-columns: repeat(var(--columns, 3), minmax(0, 1fr));
    }

    .collections-grid[data-columns-desktop='4'] > :nth-child(4n + 1) {
      --col: 0;
    }

    .collections-grid[data-columns-desktop='4'] > :nth-child(4n + 2) {
      --col: 1;
    }

    .collections-grid[data-columns-desktop='4'] > :nth-child(4n + 3) {
      --col: 2;
    }

    .collections-grid[data-columns-desktop='4'] > :nth-child(4n) {
      --col: 3;
    }
  }

  /* Animation: the cards of one row come in one after the other (--col = the card's column, 0 = first) */
  .collections-grid__item {
    --animate-delay: calc(var(--col, 0) * 100ms);
  }

  /* One card: the photo, then the bar (where the bar sits depends on the layout) */
  .collections-card {
    position: relative;
    display: flex;
    flex-direction: column;
    block-size: 100%;
    color: var(--color-text);
    text-decoration: none;
  }

  /* "Corner radius" setting (default 50px = --radius-lg); the banner uses it too */
  .collections-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--card-radius, var(--radius-lg));
    background-color: color-mix(in srgb, var(--color-accent) 6%, var(--color-background));
  }

  .collections-card__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: scale var(--duration-slow) var(--ease-out);
  }

  /* Hover zoom only with a real hover (a tap on a touch screen can leave it zoomed) */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .collections-card:hover .collections-card__image {
      scale: 1.04;
    }
  }

  /* The focus ring follows the card's corners */
  .collections-card:focus-visible {
    border-radius: var(--card-radius, var(--radius-lg));
  }

  .collections-card__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .collections-card__name {
    font-family: var(--font-heading--family);
    font-size: var(--font-size-body-lg);
  }

  .collections-card__count {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-accent);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-nav);
    text-transform: uppercase;
  }

  .collections-card__count svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  /* --- Tiles and bento: the bar is frosted glass on the photo --- */
  .collections-grid--tiles .collections-card__media,
  .collections-grid--bento .collections-card__media {
    position: absolute;
    inset: 0;
  }

  .collections-grid--tiles .collections-card {
    aspect-ratio: var(--tile-ratio, 4 / 5);
  }

  .collections-grid--tiles .collections-card__bar,
  .collections-grid--bento .collections-card__bar {
    position: absolute;
    inset-inline: var(--space-md);
    inset-block-end: var(--space-md);
    padding-block: var(--space-md);
    padding-inline: 1.25rem;
    border-radius: 1rem;
    /*
      Glass in the scheme's own background (white glass on light schemes, red glass on red). No backdrop
      blur: these cards scroll under the header, and a blur there makes a dark band on phones.
    */
    background-color: color-mix(in srgb, var(--color-background) 85%, transparent);
    box-shadow: var(--glass-rim);
  }

  /* --- Cards: the photo, then a separate light bar under it (name left, number right) --- */
  .collections-grid--cards .collections-card {
    gap: var(--space-sm);
  }

  .collections-grid--cards .collections-card__media {
    aspect-ratio: var(--tile-ratio, 1);
  }

  .collections-grid--cards .collections-card__bar {
    padding: var(--space-md) 1.25rem;
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, var(--color-text) 4%, var(--color-background));
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .collections-grid--cards .collections-card:hover .collections-card__bar {
    background-color: color-mix(in srgb, var(--color-accent) 8%, var(--color-background));
  }

  .collections-grid--cards .collections-card__name {
    font-family: var(--font-body--family);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
  }

  .collections-grid--cards .collections-card__count {
    color: color-mix(in srgb, var(--color-text) 75%, var(--color-background));
    font-size: var(--font-size-body-sm);
    letter-spacing: 0;
  }

  /* --- Overlay: the photo darkened, the name centred in white on it --- */
  .collections-grid--overlay .collections-card {
    aspect-ratio: var(--tile-ratio, 4 / 3);
  }

  .collections-grid--overlay .collections-card__media {
    position: absolute;
    inset: 0;
  }

  /*
    Readable on any photo: 55% black makes even a pure white photo #737373, and white text on that is
    4.7:1 (WCAG AA for the small count too). A soft shadow under the text separates it a little more.
  */
  .collections-grid--overlay .collections-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: #0000008c;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .collections-grid--overlay .collections-card:hover .collections-card__media::after {
    background-color: #000000a6;
  }

  .collections-grid--overlay .collections-card__bar {
    position: absolute;
    inset: 0;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-lg);
    color: #ffffff;
    text-align: center;
    text-shadow: 0 1px 2px #00000066, 0 0 12px #00000066;
  }

  .collections-grid--overlay .collections-card__name {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-heading);
  }

  .collections-grid--overlay .collections-card__count {
    color: #ffffff;
    font-weight: var(--font-weight-medium);
  }

  /*
    --- Bento: 3 columns, a repeating group of 12 cards over 6 rows: a big 2x2 card on the left with 2 small
    ones beside it and 3 under, then the same with the big card on the right. "dense" lets the small cards
    fill the gaps. 750-989px: 2 columns, big cards 2 wide. Phones: one column like the other layouts.
  */
  .collections-grid--bento .collections-card {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 750px) {
    .collections-grid--bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(12rem, 24vw, 18rem);
      grid-auto-flow: dense;
    }

    .collections-grid--bento .collections-card {
      aspect-ratio: auto;
    }

    .collections-grid--bento .collections-grid__item:nth-child(12n + 1),
    .collections-grid--bento .collections-grid__item:nth-child(12n + 7) {
      grid-column: span 2;
    }
  }

  @media (min-width: 990px) {
    .collections-grid--bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: clamp(12rem, 18vw, 21rem);
    }

    .collections-grid--bento .collections-grid__item:nth-child(12n + 1) {
      grid-column: 1 / span 2;
      grid-row: span 2;
    }

    .collections-grid--bento .collections-grid__item:nth-child(12n + 7) {
      grid-column: 2 / span 2;
      grid-row: span 2;
    }

    .collections-grid--bento .collections-grid__item:is(:nth-child(12n + 1), :nth-child(12n + 7)) .collections-card__name {
      font-size: var(--font-size-h3);
    }
  }

  .collections-page__empty {
    margin: 0;
    text-align: center;
    color: color-mix(in srgb, var(--color-text) 80%, var(--color-background));
  }
{% endstylesheet %}

