{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<h1 class="page__title">{{ page.title }}</h1>

<div class="rte">
  {{ page.content }}
</div>

{% stylesheet %}
  /* padding, not margin: Skeleton's reset removes the top margin of a first child */
  .page__title {
    padding-block-start: var(--space-section);
    margin-block-end: var(--space-xl);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
