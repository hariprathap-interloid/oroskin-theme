{%- comment -%}
  Collection product grid (M5.2, Figma "Collection"). The page title is in the Collection banner section
  (M5.1); "Show the collection title" here is the fallback for a template without the banner.

  Two layouts:
  - Bento (Figma): a 4-column grid of tiles in different sizes. The Figma page is 22 tiles in a fixed
    pattern over 12 grid rows; the pattern repeats every 22 products. Each tile's place is worked out
    here in Liquid (grid column + row) and handed to CSS as variables. The rows are sized in "Figma
    pixels" (the Figma grid is 1831px wide), so the whole pattern scales with the page width.
  - Even grid: equal tiles, 2-5 per row, in the chosen shape.
  Phones and tablets (below 990px) always get the even grid, 2 per row.

  Both use the product card's tile style (snippets/product-card.liquid, style: 'tile').
  An empty collection shows a short message and a link to the whole shop.
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-1'
  assign layout = section.settings.layout | default: 'bento'

  # The Figma pattern, one entry per tile: column-column span-row-row span (rows 1-12 of a cycle).
  # Rows 1-5 = the first band (8 tiles), 6-9 = the second (8), 10-12 = the third (6).
  assign bento_pattern = '1-2-1-1,3-1-1-2,4-1-1-2,1-1-2-2,2-1-2-3,3-2-3-3,1-1-4-2,2-1-5-1,1-1-6-3,2-2-6-1,4-1-6-2,2-1-7-2,3-1-7-2,4-1-8-2,1-2-9-1,3-1-9-1,1-1-10-2,2-1-10-1,3-2-10-2,2-1-11-2,3-2-12-1,1-1-12-1' | split: ','

  # The Figma bands only close into a clean rectangle when every tile is there (8, 8 and 6 tiles). The
  # 1-7 products left over after the last full band get a small "tail" pattern that always closes:
  # entry N (separated by |) is the layout for N leftover tiles, on 1 row (1-4 tiles) or 2 rows (5-7).
  #   1: one small tile (a lone full-width tile looked stretched)
  #   2: two wide tiles         3: wide + 2 small         4: 4 small
  #   5: tall, wide, tall + 2 small under the wide      6: wide + 2 small, then 2 small + wide
  #   7: tall + 3 small, then 3 small
  assign tail_patterns = '|1-1-1-1|1-2-1-1;3-2-1-1|1-2-1-1;3-1-1-1;4-1-1-1|1-1-1-1;2-1-1-1;3-1-1-1;4-1-1-1|1-1-1-2;2-2-1-1;4-1-1-2;2-1-2-1;3-1-2-1|1-2-1-1;3-1-1-1;4-1-1-1;1-1-2-1;2-1-2-1;3-2-2-1|1-1-1-2;2-1-1-1;3-1-1-1;4-1-1-1;2-1-2-1;3-1-2-1;4-1-2-1' | split: '|'

  # Row heights in Figma pixels: one full cycle (12 rows), the first band alone (5 rows), the first two
  # bands (9 rows). Tail rows are 400px, so a tail tile is about the Figma's wide-tile height.
  assign cycle_rows = '399,220,54,221,382,399,204,70,728,309,204,399'
  assign band_a_rows = '399,220,54,221,382'
  assign band_ab_rows = '399,220,54,221,382,399,204,70,728'
-%}

<div
  class="collection-section full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --grid-columns: {{ section.settings.columns_desktop }};"
>
  {%- comment -%}
    <results-view> (script below) reloads the results in place when the sort or the filters change, or an
    active-filter pill is removed: Section Rendering API, then it swaps every [data-results-part] by id.
  {%- endcomment -%}
  <results-view class="collection-section__inner" data-section-id="{{ section.id }}">
    {%- if section.settings.show_title -%}
      <h1 class="collection-section__title">{{ collection.title | escape }}</h1>
    {%- endif -%}

    {%- comment -%}
      Toolbar (M5.3, Figma: pills left, count + SORT right).
      - Pills: one per link of the chosen menu, each with its collection's product count. "All" first.
      - Count + sort: hidden on an empty collection (nothing to count or sort).
      Sorting reloads only the results (Section Rendering API, see <collection-sort> below); without
      JavaScript the form's Apply button reloads the page with ?sort_by=...
    {%- endcomment -%}
    {%- liquid
      assign pills_menu = section.settings.pills_menu
      assign show_pills = false
      if section.settings.show_pills and pills_menu != blank
        assign show_pills = true
      endif

      # all_products_count ignores filters: a filter that matches nothing must keep the toolbar
      # (the count says "0 products" and the Filters button lets the visitor undo it).
      assign show_tools = false
      if collection.all_products_count > 0
        if section.settings.show_count or section.settings.show_sort
          assign show_tools = true
        endif
      endif

      # Filters (M5.4): the list comes from the Search & Discovery app (empty if the merchant turned them all off)
      assign show_filters = false
      if section.settings.show_filters and collection.filters.size > 0
        if collection.all_products_count > 0
          assign show_filters = true
        endif
      endif

      # Is any filter applied? (Decides the chips and which empty message to show.)
      assign filters_active = false
      for filter in collection.filters
        if filter.active_values.size > 0
          assign filters_active = true
        elsif filter.min_value.value != nil or filter.max_value.value != nil
          assign filters_active = true
        endif
      endfor

      # "Clear all": the collection with no filters, keeping the visitor's sort
      assign clear_url = collection.url
      if collection.sort_by != blank
        assign clear_url = clear_url | append: '?sort_by=' | append: collection.sort_by
      endif
    -%}
    {%- if show_pills or show_tools or show_filters -%}
      <div class="collection-toolbar">
        <div class="collection-toolbar__start">
        {%- if show_filters -%}
          {%- render 'filter-drawer',
            filters: collection.filters,
            results_url: collection.url,
            section_id: section.id,
            clear_url: clear_url
          -%}
        {%- endif -%}

        {%- if show_pills -%}
          <nav
            class="collection-pills {{ section.settings.pill_image_animation }}"
            style="--pill-image-size: {{ section.settings.pill_image_size }}px;"
            aria-label="{{ 'collections.categories' | t }}">
            <ul class="collection-pills__list" role="list">
              {%- if section.settings.show_all_pill -%}
                {%- liquid
                  assign all_count = collections.all.all_products_count
                  # "All" isn't a real collection with a metafield, so its cut-out is a section setting
                  assign all_image = section.settings.all_pill_image
                  assign all_cutout = true
                  if all_image == blank
                    assign all_image = collections.all.featured_image
                    assign all_cutout = false
                  endif
                -%}
                <li>
                  <a
                    class="collection-pill{% if collection.handle == 'all' %} collection-pill--active{% endif %}"
                    href="{{ routes.all_products_collection_url }}"
                    {% if collection.handle == 'all' %}
                      aria-current="page"
                    {% endif %}
                  >
                    {%- if all_image != blank -%}
                      <span
                        class="collection-pill__media{% if all_cutout %} collection-pill__media--cutout{% endif %}"
                        aria-hidden="true"
                      >
                        {{- all_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', widths: '160, 300', sizes: '160px' -}}
                      </span>
                    {%- endif -%}
                    {{- 'collections.all' | t -}}
                    <span class="collection-pill__count" aria-hidden="true">{{ all_count }}</span>
                    <span class="visually-hidden">{{ 'collections.products_count' | t: count: all_count }}</span>
                  </a>
                </li>
              {%- endif -%}

              {%- for link in pills_menu.links -%}
                {%- liquid
                  # The number: the linked collection's total (all_products_count ignores filters, so
                  # it stays the same while the visitor filters this page). Other link types get none.
                  assign pill_count = nil
                  # The hover image: the collection's "Pill image" metafield (a cut-out PNG),
                  # or else its own image (or first product's) shown as a small rounded photo.
                  assign pill_image = nil
                  assign pill_cutout = false
                  case link.type
                    when 'collection_link'
                      assign pill_count = link.object.all_products_count
                      assign pill_image = link.object.metafields.custom.pill_image.value
                      if pill_image != blank
                        assign pill_cutout = true
                      else
                        assign pill_image = link.object.featured_image
                      endif
                    when 'catalog_link'
                      assign pill_count = collections.all.all_products_count
                      assign pill_image = collections.all.featured_image
                  endcase
                -%}
                <li>
                  <a
                    class="collection-pill{% if link.current %} collection-pill--active{% endif %}"
                    href="{{ link.url }}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {%- if pill_image != blank -%}
                      <span
                        class="collection-pill__media{% if pill_cutout %} collection-pill__media--cutout{% endif %}"
                        aria-hidden="true"
                      >
                        {{- pill_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', widths: '160, 300', sizes: '160px' -}}
                      </span>
                    {%- endif -%}
                    {{- link.title | escape -}}
                    {%- if pill_count != nil -%}
                      <span class="collection-pill__count" aria-hidden="true">{{ pill_count }}</span>
                      <span class="visually-hidden">{{ 'collections.products_count' | t: count: pill_count }}</span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
        </div>

        {%- if show_tools -%}
          <div class="collection-toolbar__end">
            {%- if section.settings.show_count -%}
              {%- comment -%} products_count = what the visitor sees now (after filters, M5.4) {%- endcomment -%}
              <p
                class="collection-toolbar__count"
                id="CollectionCount-{{ section.id }}"
                aria-live="polite"
                data-results-text
              >
                {{- 'collections.products_count' | t: count: collection.products_count -}}
              </p>
            {%- endif -%}

            {%- if section.settings.show_sort -%}
              {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
              {%- comment -%}
                data-results-form: <results-view> reads this form (with the filter form) to build the URL.
                data-results-autoload: a change here loads the results straight away.
              {%- endcomment -%}
              <div class="collection-sort">
                <form action="{{ collection.url }}" method="get" data-results-form data-results-autoload>
                  <label class="collection-sort__label" for="SortBy-{{ section.id }}">{{ 'collections.sort_by' | t }}</label>
                  <span class="collection-sort__field">
                    <select
                      class="collection-sort__select"
                      id="SortBy-{{ section.id }}"
                      name="sort_by"
                      data-default="{{ collection.default_sort_by }}"
                    >
                      {%- for option in collection.sort_options -%}
                        <option value="{{ option.value }}"{% if option.value == current_sort %} selected{% endif %}>
                          {{- option.name | escape -}}
                        </option>
                      {%- endfor -%}
                    </select>
                    {{ 'icon-chevron.svg' | inline_asset_content }}
                  </span>
                  <noscript>
                    <button type="submit" class="button button--secondary collection-sort__apply">
                      {{- 'collections.apply' | t -}}
                    </button>
                  </noscript>
                </form>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      The part the sort and the filters swap in place. tabindex -1: after a pill is removed (its link is
      gone), focus moves here so keyboard users aren't dropped at the top of the page.
    {%- endcomment -%}
    <div
      class="collection-results"
      id="CollectionResults-{{ section.id }}"
      tabindex="-1"
      data-results-part
    >
    {%- if filters_active -%}
      {%- render 'active-filters', filters: collection.filters, clear_url: clear_url -%}
    {%- endif -%}

    {%- if collection.products_count == 0 and filters_active -%}
      {%- comment -%} Filters that match nothing: say so and offer the way back (not the "empty collection" message) {%- endcomment -%}
      <div class="collection-empty">
        <div class="collection-empty__strip">
          <span class="collection-empty__icon" aria-hidden="true">{{ 'icon-filter.svg' | inline_asset_content }}</span>
          <div class="collection-empty__message">
            <h2 class="collection-empty__title">{{ 'collections.no_match_title' | t }}</h2>
            <p class="collection-empty__text">{{ 'collections.no_match_text' | t }}</p>
          </div>
          <div class="collection-empty__actions">
            <a class="button" href="{{ clear_url }}" data-results-link>{{ 'collections.clear_filters' | t }}</a>
          </div>
        </div>
      </div>
    {%- elsif collection.products_count == 0 -%}
      {%- comment -%}
        Empty collection, the same pattern as the empty bag (cart, design C): a slim glass strip with the
        message and the way out, then a few suggestions from the "Suggested products" collection.
        The banner above drops its sentence and large image on an empty collection (collection-banner.liquid).
      {%- endcomment -%}
      <div class="collection-empty">
        <div class="collection-empty__strip">
          <span class="collection-empty__icon" aria-hidden="true">{{ 'icon-sparkle.svg' | inline_asset_content }}</span>
          <div class="collection-empty__message">
            <h2 class="collection-empty__title">{{ 'collections.empty_title' | t }}</h2>
            <p class="collection-empty__text">{{ 'collections.empty_text' | t }}</p>
          </div>
          <div class="collection-empty__actions">
            <a class="button button--text" href="{{ routes.root_url }}">{{ 'collections.back_home' | t }}</a>
            <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'collections.continue_shopping' | t }}</a>
          </div>
        </div>

        {%- assign suggestions = section.settings.empty_collection -%}
        {%- if suggestions != blank and suggestions.products_count > 0 -%}
          <div class="collection-empty__picks">
            <h2 class="collection-empty__picks-title">{{ section.settings.empty_heading }}</h2>
            <ul class="collection-grid collection-grid--grid" role="list" style="--grid-columns: 4;">
              {%- for product in suggestions.products limit: 4 -%}
                <li class="collection-grid__item">
                  {%- render 'product-card',
                    product: product,
                    style: 'tile',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                    heading_tag: 'h3',
                    show_details: section.settings.show_details,
                    show_rating: section.settings.show_rating,
                    show_description: section.settings.show_description,
                    cart_options: section.settings.cart_options
                  -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- liquid
          # Bento plan for THIS page (inside paginate, collection.products is only this page's products).
          # Example, 30 per page: 1 full cycle (22) + band A (8) = 30, no tail.
          # Example, 7 products: no full band, so all 7 use tail pattern 7.
          # Example, 13 products: band A (8) + tail pattern 5.
          assign page_count = collection.products.size
          assign full_cycles = page_count | divided_by: 22
          assign rest = page_count | modulo: 22

          assign band_tiles = 0
          assign band_rows = 0
          if rest >= 16
            assign band_tiles = 16
            assign band_rows = 9
          elsif rest >= 8
            assign band_tiles = 8
            assign band_rows = 5
          endif

          assign tail_count = rest | minus: band_tiles
          assign figma_count = full_cycles | times: 22 | plus: band_tiles
          assign tail_start_row = full_cycles | times: 12 | plus: band_rows
          assign tail = tail_patterns[tail_count] | split: ';'

          # The grid's row list, e.g. "399,220,...,400" -> calc(var(--u) * 399) calc(var(--u) * 220) ...
          assign row_list = ''
          if full_cycles > 0
            for i in (1..full_cycles)
              assign row_list = row_list | append: cycle_rows | append: ','
            endfor
          endif
          if band_tiles == 8
            assign row_list = row_list | append: band_a_rows | append: ','
          elsif band_tiles == 16
            assign row_list = row_list | append: band_ab_rows | append: ','
          endif
          if tail_count > 0
            assign row_list = row_list | append: '400,'
          endif
          if tail_count > 4
            assign row_list = row_list | append: '400,'
          endif

          assign row_heights = row_list | split: ','
          capture bento_rows
            for height in row_heights
              echo 'calc(var(--u) * ' | append: height | append: ') '
            endfor
          endcapture
        -%}
        <div class="collection-grid-wrap">
          <ul
            class="collection-grid collection-grid--{{ layout }} collection-grid--{{ section.settings.image_ratio | default: 'portrait' }}"
            role="list"
            {% if layout == 'bento' %}
              style="--bento-rows: {{ bento_rows | strip }};"
            {% endif %}
          >
            {%- for product in collection.products -%}
              {%- liquid
                # Only the first row's photos load straight away; the rest load as they scroll near
                assign loading = 'lazy'
                if forloop.index <= 4
                  assign loading = 'eager'
                endif

                # Bento: this tile's place.
                # - Figma tiles: pos = where it falls in the 22-tile pattern, cycle = which repeat of
                #   the pattern (each repeat starts 12 rows lower).
                # - Tail tiles (the leftovers): t = which leftover, placed below the last full band.
                assign tile_style = ''
                # Photo width: 1 per row on phones (100vw), 2 on tablets (50vw), bento / grid on desktop
                assign sizes = '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw'
                if layout == 'bento'
                  if forloop.index0 < figma_count
                    assign pos = forloop.index0 | modulo: 22
                    assign cycle = forloop.index0 | divided_by: 22
                    assign place = bento_pattern[pos] | split: '-'
                    assign row_offset = cycle | times: 12
                  else
                    assign t = forloop.index0 | minus: figma_count
                    assign place = tail[t] | split: '-'
                    assign row_offset = tail_start_row
                  endif
                  assign row = place[2] | plus: row_offset
                  assign tile_style = '--col: ' | append: place[0] | append: ' / span ' | append: place[1] | append: '; --row: ' | append: row | append: ' / span ' | append: place[3] | append: ';'
                  # The bento starts at 1200px (3 even columns from 990px). Wider tiles need a bigger
                  # photo: 2 of 4 columns = half the screen, 4 = all of it
                  assign sizes = '(min-width: 1200px) 25vw, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
                  if place[1] == '2'
                    assign sizes = '(min-width: 1200px) 50vw, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
                  elsif place[1] == '4'
                    assign sizes = '(min-width: 1200px) 100vw, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
                  endif
                endif
              -%}
              <li class="collection-grid__item" {% if tile_style != blank %}style="{{ tile_style }}"{% endif %}>
                {%- render 'product-card',
                  product: product,
                  style: 'tile',
                  sizes: sizes,
                  loading: loading,
                  heading_tag: 'h2',
                  show_details: section.settings.show_details,
                  show_rating: section.settings.show_rating,
                  show_description: section.settings.show_description,
                  cart_options: section.settings.cart_options
                -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- comment -%} Restyled in M5.5 (Figma pill + "Page X of Y") {%- endcomment -%}
        {%- if paginate.pages > 1 -%}
          <nav class="collection-pagination" aria-label="{{ 'accessibility.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
    </div>
  </results-view>
</div>

{% stylesheet %}
  .collection-section {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  .collection-section__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .collection-section__title {
    margin: 0;
  }

  /*
    Toolbar (Figma, ~50px tall): category pills on the left, "30 products" | SORT on the right.
    Phones: the pills scroll sideways in their own row, count and sort below.
  */
  .collection-toolbar {
    position: relative;
    z-index: 2; /* a pill's hover image may reach over the banner above and the grid below */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
  }

  /* Left side: Filters, then the pills (Figma gap 44px) */
  .collection-toolbar__start {
    display: flex;
    align-items: center;
    gap: var(--space-2xl);
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .collection-pills {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  /* Results and active-filter pills, stacked; the focus target after a pill is removed shows no ring */
  .collection-results {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .collection-results:focus {
    outline: none;
  }

  .collection-pills__list {
    display: flex;
    margin: 0;
    padding: 0.25rem; /* room for the focus ring and shadow inside the scroll box */
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  /* The side padding is the gap between a divider and the hover glass (Figma ~10px) */
  .collection-pills__list > li {
    position: relative;
    flex: none;
    padding-inline: var(--space-xs);
    scroll-snap-align: start;
  }

  /* Figma: plain text links with a short divider between them */
  .collection-pills__list > li + li::before {
    content: '';
    position: absolute;
    inset-block: 20%;
    inset-inline-start: 0;
    border-inline-start: 1px solid color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  /*
    A text link (Figma ~50px tall) that becomes a glass pill on hover; the count is the small
    raised red number ("Fragrance 12"). Three layers, back to front: the hover image, the glass
    (::after), the text. The glass is a pseudo-element rather than the link's own background so
    it can sit over the image and frost it.
  */
  .collection-pill {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: flex-start;
    gap: 0.2em;
    padding: 0.85rem var(--space-lg);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .collection-pill::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    border-radius: inherit;
    background-color: var(--color-glass);
    box-shadow: var(--shadow-header);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  /* Hovered pill on top of its neighbours (and the dividers), so nothing covers its image */
  .collection-pill:hover,
  .collection-pill:focus-visible {
    z-index: 1;
  }

  .collection-pill:hover::after,
  .collection-pill:focus-visible::after {
    opacity: 1;
  }

  /* The page you're on: red text (the Figma frame shows no active style; aria-current tells screen readers) */
  .collection-pill--active {
    color: var(--color-primary);
  }

  .collection-pill__count {
    color: var(--color-primary);
    font-size: 0.65em;
    font-variant-numeric: tabular-nums;
  }

  /*
    The hover image rises from behind the pill and grows (Figma hover frames). Only on
    devices with a mouse and room for it: on phones the pills scroll, which would clip it,
    and display: none also stops the lazy image from downloading there.
  */
  .collection-pill__media {
    display: none;
  }

  @media (hover: hover) and (min-width: 750px) {
    .collection-pills__list {
      flex-wrap: wrap;
      overflow: visible; /* a scroll box would clip the image */
    }

    .collection-pill__media {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 50%;
      z-index: -1;
      display: block;
      /* "Pill image size" = the cut-out's height; a rounded photo is a bit smaller */
      inline-size: calc(var(--pill-image-size, 180px) * 0.6);
      block-size: calc(var(--pill-image-size, 180px) * 0.7);
      border-radius: var(--radius-sm);
      overflow: hidden;
      opacity: 0;
      translate: -50% -40%;
      scale: 0.4;
      transform-origin: 50% 100%;
      pointer-events: none;
      transition:
        opacity var(--duration-base) var(--ease-out),
        translate var(--duration-normal) var(--ease-out),
        scale var(--duration-normal) var(--ease-out);
    }

    /* A cut-out PNG: bigger, no rounded box, the bottle stands behind the glass */
    .collection-pill__media--cutout {
      inline-size: calc(var(--pill-image-size, 180px) * 0.85);
      block-size: var(--pill-image-size, 180px);
      border-radius: 0;
    }

    .collection-pill__media img {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }

    .collection-pill__media--cutout img {
      object-fit: contain;
    }

    /* "Pill image animation": the start state differs, the end state (below) is shared */
    .collection-pills--image-scale .collection-pill__media {
      translate: -50% -60%; /* already in place, only grows from its centre */
      transform-origin: 50% 50%;
    }

    .collection-pills--image-fade .collection-pill__media {
      translate: -50% -60%;
      scale: 1;
    }

    .collection-pill:hover .collection-pill__media,
    .collection-pill:focus-visible .collection-pill__media {
      opacity: 1;
      translate: -50% -60%;
      scale: 1;
    }
  }

  /* Reduced motion: the image fades in where it ends up, without rising or growing */
  @media (prefers-reduced-motion: reduce) {
    .collection-pill__media {
      translate: -50% -60%;
      scale: 1;
    }
  }

  .collection-toolbar__end {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-inline-start: auto;
  }

  /* Figma "30 Products": small and grey (75% mix keeps it above 4.5:1) */
  .collection-toolbar__count {
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 75%, var(--color-background));
    font-size: var(--font-size-small);
    white-space: nowrap;
  }

  /* SORT: a real <select> dressed as the Figma outlined pill. The label sits inside the pill. */
  .collection-sort form {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-inline: var(--space-lg) var(--space-md);
    border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    border-radius: var(--radius-pill);
    background-color: var(--color-glass);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .collection-sort__label {
    color: var(--color-primary);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .collection-sort__field {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /* margin 0: critical.css spaces a control that follows a label (the magnifier lesson from M7.7) */
  .collection-sort .collection-sort__select {
    inline-size: auto;
    min-block-size: 2.75rem;
    margin: 0;
    padding-block: 0;
    padding-inline: 0 1.75rem;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-size: var(--font-size-body-sm);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .collection-sort .collection-sort__select:focus-visible {
    outline: none;
  }

  /* The ring goes round the whole pill when the select has keyboard focus */
  .collection-sort form:has(.collection-sort__select:focus-visible) {
    outline: 2px solid var(--color-accent); /* the theme's focus ring (critical.css) */
    outline-offset: 2px;
  }

  .collection-sort__field svg {
    position: absolute;
    inset-inline-end: 0.5rem;
    inline-size: 0.625rem;
    block-size: 0.625rem;
    pointer-events: none;
  }

  .collection-sort__apply {
    min-block-size: 2.25rem;
    margin: 0;
    padding-inline: var(--space-md);
  }

  /* While a new sort loads, the old results fade a little */
  .collection-results[aria-busy='true'] {
    opacity: 0.5;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  @media (max-width: 749px) {
    /* Phones: Filters + the scrolling pills share the first row, count and sort the second */
    .collection-toolbar__start {
      flex: 1 1 100%;
      gap: var(--space-md);
    }

    .collection-pills {
      flex: 1 1 auto;
    }

    .collection-toolbar__end {
      flex: 1 1 100%;
      justify-content: space-between;
      margin-inline-start: 0;
    }
  }

  /* The wrapper is the size container: the bento rows below are measured against its width (cqi) */
  .collection-grid-wrap {
    container-type: inline-size;
  }

  /* Phones: one tile per row; tablets (750px+): 2 per row. Every tile 4:5 */
  .collection-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-grid__item {
    aspect-ratio: 4 / 5;
    min-inline-size: 0;
  }

  @media (min-width: 750px) {
    .collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 990px) {
    /* Even grid: the chosen number of columns and tile shape */
    .collection-grid--grid {
      grid-template-columns: repeat(var(--grid-columns, 4), minmax(0, 1fr));
      gap: var(--space-xl);
    }

    .collection-grid--grid.collection-grid--square .collection-grid__item {
      aspect-ratio: 1;
    }

    .collection-grid--grid.collection-grid--landscape .collection-grid__item {
      aspect-ratio: 4 / 3;
    }
  }

  /*
    Small laptops (990-1199px): the bento's rows scale with the width, so its short tiles got too low for
    the info strip. Here it's an even 3-column grid instead; the bento starts at 1200px.
  */
  @media (min-width: 990px) and (max-width: 1199px) {
    .collection-grid--bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }

  @media (min-width: 1200px) {
    /*
      Bento. --u = one Figma pixel at the current width (Figma grid: 1831px wide, 4 columns, 35px gaps).
      --bento-rows (built in the Liquid above) lists the height of every row on this page: the Figma
      bands that are full, then the tail rows. Every tile is placed by its own --col / --row, so the
      tiles get their height from the rows they span, not from a shape.
    */
    .collection-grid--bento {
      --u: calc(100cqi / 1831);

      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: var(--bento-rows);
      gap: calc(var(--u) * 35);
    }

    .collection-grid--bento .collection-grid__item {
      grid-column: var(--col);
      grid-row: var(--row);
      aspect-ratio: auto;
    }
  }

  /*
    Empty collection: the empty bag's glass strip (icon, message, buttons on one line), then suggestions.
  */
  .collection-empty {
    display: grid;
    gap: var(--space-3xl);
  }

  .collection-empty__strip {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    padding-inline: var(--space-xl);
    border-radius: var(--radius-lg);
    background-color: var(--color-glass-strong);
    box-shadow: var(--glass-shadow), var(--glass-rim);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .collection-empty__icon {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-accent) 18%, transparent);
    color: var(--color-primary);
  }

  .collection-empty__icon svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  .collection-empty__message {
    display: grid;
    flex: 1;
    gap: var(--space-2xs);
    min-inline-size: 0;
  }

  .collection-empty__title,
  .collection-empty__text,
  .collection-empty__picks-title {
    margin: 0;
  }

  .collection-empty__title {
    font-size: var(--font-size-h3);
  }

  .collection-empty__text {
    color: color-mix(in srgb, var(--color-text) 80%, var(--color-background));
  }

  .collection-empty__actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
  }

  .collection-empty__actions > * {
    white-space: nowrap;
  }

  .collection-empty__picks {
    display: grid;
    gap: var(--space-xl);
  }

  .collection-empty__picks-title {
    font-size: var(--font-size-h2);
  }

  .collection-empty__picks-title em {
    color: var(--color-primary);
  }

  /* Phones: the strip stacks, like the empty bag */
  @media (max-width: 749px) {
    .collection-empty__strip {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-lg);
    }

    .collection-empty__actions {
      flex-wrap: wrap;
    }
  }

  .collection-pagination {
    display: flex;
    justify-content: center;
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <results-view>: reloads only this section's results, not the whole page, when the visitor
   * - changes the sort (a form with data-results-autoload),
   * - applies filters (<filter-drawer> sends a 'results:load' event),
   * - removes an active filter or clears them all (links with data-results-link),
   * - goes Back / Forward.
   *
   * The URL is built from every form with data-results-form (sort + filters), so the two always combine:
   * /collections/skincare?filter.p.vendor=Oroskin&sort_by=price-ascending
   * Section Rendering API: that URL + &section_id=<id> returns just this section's HTML, already filtered and
   * sorted by Shopify. Every [data-results-part] is replaced by the new one with the same id; a
   * [data-results-text] only gets its text changed (the count, so its aria-live announces it).
   * The URL goes in the address bar, so the page can be shared and reloaded, and pagination keeps the choices.
   * If anything fails, it falls back to a normal page load of the URL.
   */
  class ResultsView extends HTMLElement {
    connectedCallback() {
      this.sectionId = this.dataset.sectionId;

      this.addEventListener('results:load', () => this.load(this.buildUrl(), true));

      this.addEventListener('change', (event) => {
        if (event.target.form?.hasAttribute('data-results-autoload')) this.load(this.buildUrl(), true);
      });

      this.addEventListener('submit', (event) => {
        if (!event.target.hasAttribute('data-results-autoload')) return;
        event.preventDefault();
        this.load(this.buildUrl(), true);
      });

      this.addEventListener('click', (event) => {
        const link = event.target.closest('a[data-results-link]');
        if (!link) return;
        event.preventDefault();
        this.load(link.href, true);
      });

      this.onPopState = () => this.load(window.location.href, false);
      window.addEventListener('popstate', this.onPopState);
    }

    disconnectedCallback() {
      window.removeEventListener('popstate', this.onPopState);
      this.controller?.abort();
    }

    // Every non-empty field of the sort and filter forms (an empty price box means "no limit"; the
    // collection's own default sort needs no parameter); a new choice always starts again at page 1,
    // so the page number is left out
    buildUrl() {
      const forms = this.querySelectorAll('form[data-results-form]');
      const defaultSort = this.querySelector('select[name="sort_by"]')?.dataset.default;
      const params = new URLSearchParams();
      forms.forEach((form) => {
        for (const [key, value] of new FormData(form)) {
          if (value === '' || (key === 'sort_by' && value === defaultSort)) continue;
          params.append(key, value);
        }
      });
      const action = forms[0]?.action || window.location.pathname;
      return `${action}?${params}`;
    }

    async load(url, addToHistory) {
      this.controller?.abort();
      this.controller = new AbortController();

      const results = document.getElementById(`CollectionResults-${this.sectionId}`);
      const hadFocus = results?.contains(document.activeElement);
      results?.setAttribute('aria-busy', 'true');

      try {
        const sectionUrl = new URL(url, window.location.origin);
        sectionUrl.searchParams.set('section_id', this.sectionId);
        const response = await fetch(sectionUrl, { signal: this.controller.signal });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');

        this.querySelectorAll('[data-results-part]').forEach((part) => {
          const fresh = html.getElementById(part.id);
          if (fresh) part.replaceWith(fresh);
        });

        this.querySelectorAll('[data-results-text]').forEach((part) => {
          const fresh = html.getElementById(part.id);
          if (fresh) part.textContent = fresh.textContent;
        });

        if (addToHistory) window.history.pushState({}, '', url);

        // Back / Forward: the sort select isn't replaced, so set it to match the URL
        const select = this.querySelector('select[name="sort_by"]');
        if (select && !addToHistory) {
          select.value = new URL(url, window.location.origin).searchParams.get('sort_by') || select.dataset.default;
        }

        // The clicked pill or "Clear all" was inside the old results: put focus on the new ones
        if (hadFocus) document.getElementById(`CollectionResults-${this.sectionId}`)?.focus();
      } catch (error) {
        if (error.name === 'AbortError') return;
        window.location.href = url;
      } finally {
        results?.removeAttribute('aria-busy');
      }
    }
  }

  if (!customElements.get('results-view')) customElements.define('results-view', ResultsView);
{% endjavascript %}

