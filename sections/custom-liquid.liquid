{%- comment -%}
  Custom Liquid section: a full section the merchant can add to any page and fill with their own
  Liquid / HTML (an app embed, a map, a booking widget...). Color scheme, Section width and top/bottom
  spacing make it sit in the design like any other section.

  The code is rendered one time into code_html. When the result is empty (no code, or code that writes
  only spaces), the live store gets no section at all; the theme editor shows a dashed note instead.
{%- endcomment -%}

{%- capture code_html -%}{{ section.settings.custom_liquid }}{%- endcapture -%}
{%- assign code_html = code_html | strip -%}

{%- if code_html != blank or request.design_mode -%}
  {%- comment -%}
    The outer box spans the whole page (full-width), so the scheme's background runs edge to edge. The
    inner box keeps the code to var(--section-width) (the Section width setting) minus the page margins.
  {%- endcomment -%}
  <div
    class="custom-liquid-section full-width section-width--{{ section.settings.section_width | default: 'wide' }} color-{{ section.settings.color_scheme.id | default: 'scheme-1' }}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="custom-liquid-section__content">
      {%- if code_html != blank -%}
        {{ code_html }}
      {%- else -%}
        <p class="custom-liquid-section__empty">{{ 'sections.custom_liquid.editor_empty' | t }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .custom-liquid-section {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  /*
    The box itself has no overflow (overflow-x: auto would also make overflow-y auto: it cut focus
    rings, shadows and dropdowns, and broke position: sticky inside). Only wide content is held:
    - a table or <pre> scrolls sideways in its own box (display: block keeps the table's rows and cells);
    - a long URL or word breaks (overflow-wrap: break-word, not anywhere: anywhere would let a table
      shrink and break its words instead of scrolling, and squeeze flex / grid widgets);
    - a box with a fixed width at the top level (style="width: 1200px") is made no wider than the box;
    - iframes, videos and images are no wider than the box.
    <main> has overflow-x: clip, so the page never scrolls sideways.
  */
  .custom-liquid-section__content {
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
    overflow-wrap: break-word;
  }

  .custom-liquid-section__content > *,
  .custom-liquid-section__content :is(iframe, video, img) {
    max-inline-size: 100%;
  }

  .custom-liquid-section__content :is(table, pre) {
    display: block;
    max-inline-size: 100%;
    overflow-x: auto;
  }

  .custom-liquid-section__empty {
    margin: 0;
    padding: var(--space-xl);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
  }

  /* Phones: half the section padding, as the other sections */
  @media (max-width: 749px) {
    .custom-liquid-section {
      padding-block: calc(var(--section-padding-top) / 2) calc(var(--section-padding-bottom) / 2);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_liquid",
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:labels.custom_liquid",
      "info": "t:labels.custom_liquid_section_info"
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.section_width.narrow"
        },
        {
          "value": "wide",
          "label": "t:options.section_width.wide"
        },
        {
          "value": "widest",
          "label": "t:options.section_width.widest"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "wide"
    },
    {
      "type": "header",
      "content": "t:labels.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "t:general.custom_liquid" }]
}
{% endschema %}
