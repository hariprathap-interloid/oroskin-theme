{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-images">
  {% for image in product.images %}
    {% render 'image', class: 'product-image', image: image %}
  {% endfor %}
</div>

<div class="product-info">
  <h1>{{ product.title }}</h1>
  {% render 'price', product: product, variant: product.selected_or_first_available_variant %}
  <p>{{ product.description }}</p>
</div>

<div class="product-form">
  {% form 'product', product %}
    {% assign current_variant = product.selected_or_first_available_variant %}

    {%- comment -%}
      Temporary stock fix until the M6 product page: sold-out variants are marked and can't be picked
      (a disabled <option>), so they can't reach the cart and fail at checkout. When nothing is
      available, the buttons say "Sold out" and are disabled. selected_or_first_available_variant
      already starts on an available variant.
    {%- endcomment -%}
    <select name="id">
      {% for variant in product.variants %}
        <option
          value="{{ variant.id }}"
          {% if variant == current_variant %}
            selected="selected"
          {% endif %}
          {% unless variant.available %}
            disabled
          {% endunless %}
        >
          {{ variant.title }} - {{ variant.price | money }}
          {%- unless variant.available %} ({{ 'products.sold_out' | t }}){% endunless %}
        </option>
      {% endfor %}
    </select>

    <input type="text" name="quantity" min="1" value="1">

    {%- if current_variant.available -%}
      <button type="submit">{{ 'products.add_to_cart' | t }}</button>
      {{ form | payment_button }}
    {%- else -%}
      <button type="submit" disabled>{{ 'products.sold_out' | t }}</button>
    {%- endif -%}
  {% endform %}
</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
