  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 10,
  "blocks": [
    {
      "type": "announcement",
      "name": "t:general.announcement",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:labels.text",
          "info": "t:labels.announcement_text_info",
          "default": "Free shipping on orders over $75"
