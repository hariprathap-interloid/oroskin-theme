{%- comment -%}
  Announcement bar (Header group, every page). Short messages, each with an optional link.
  - Position "Above the header": a full-width bar above the header pill; it scrolls away, the pill stays sticky.
  - Position "Right side": the vertical band from the Figma home hero (red strip, uppercase text reading top to
    bottom), fixed to the right edge of the screen, one screen tall (100svh). Optionally it slides out once the
    page scrolls down and comes back only at the top of the page.
    Large screens only: below 990px it is a bar above the header.
  - Movement: Static (first message only), Slideshow (one at a time, arrows, optional autoplay) or Marquee.
    Anything that moves has a pause button (WCAG 2.2.2) and never moves with reduced motion. The marquee moves
    whenever Marquee is chosen (not tied to the theme's "Enable animations"), except in the theme editor.
  - Close button: hides the bar until the messages change (localStorage, keyed by a fingerprint of the
    messages, so a new announcement always shows again). The inline script after the bar
    hides it before the first paint, so nothing jumps. Ignored in the theme editor.
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-3'
  assign position = section.settings.position | default: 'top'
  assign mode = section.settings.mode | default: 'static'

  # messages_key joins every shown message (text + links); its md5 fingerprint names the "closed" note, so
  # editing a message or its link gives a new name and the bar shows again for visitors who closed it.
  assign count = 0
  assign messages_key = ''
  for block in section.blocks
    if block.settings.text != blank
      assign count = count | plus: 1
      assign messages_key = messages_key | append: block.settings.text | append: block.settings.link | append: block.settings.link_label
    endif
  endfor
  assign close_key = messages_key | md5 | slice: 0, 8 | prepend: 'announcement-closed-'

  if count < 2 and mode == 'slideshow'
    assign mode = 'static'
  endif

  assign moves = false
  if mode == 'marquee'
    assign moves = true
  elsif mode == 'slideshow' and section.settings.autoplay
    assign moves = true
  endif
-%}

{%- if count > 0 -%}
  {%- comment -%} On :root: the page's right-side gap (body) has to know the band's width {%- endcomment -%}
  {% style %}
    :root {
      --announcement-size: {{ section.settings.bar_size | default: 36 }}px;
      --announcement-text: {{ section.settings.text_size | default: 14 }}px;
    }
  {% endstyle %}
  <announcement-bar
    class="announcement-bar full-width color-{{ scheme_id }} announcement-bar--{{ position }} announcement-bar--{{ mode }} announcement-bar--{{ section.settings.text_style | default: 'uppercase' }} announcement-bar--marquee-{{ section.settings.direction | default: 'left' }} announcement-bar--align-{{ section.settings.text_align | default: 'center' }} announcement-bar--font-{{ section.settings.font | default: 'body' }} announcement-bar--spacing-{{ section.settings.letter_spacing | default: 'auto' }}"
    role="region"
    aria-label="{{ 'sections.announcement_bar.label' | t }}"
    data-mode="{{ mode }}"
    data-autoplay="{{ moves }}"
    data-tuck="{% if position == 'right' and section.settings.hide_on_scroll %}true{% else %}false{% endif %}"
    data-interval="{{ section.settings.interval | times: 1000 }}"
    data-close-key="{{ close_key }}"
    data-speed="{{ section.settings.speed }}"
  >
    <div class="announcement-bar__inner">
      {%- if mode == 'slideshow' and section.settings.show_arrows -%}
        <button type="button" class="announcement-bar__button announcement-bar__prev" data-step="-1">
          <span class="visually-hidden">{{ 'sections.announcement_bar.previous' | t }}</span>
          <svg class="announcement-bar__arrow" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="16" height="16"><path d="M13 8H3m4-4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {%- endif -%}

      {%- case mode -%}
        {%- when 'marquee' -%}
          {%- comment -%}
            Two copies of the messages.
            1) The real line: every message in one row with a dot between them, built like the Static line, so
               it scrolls along the bar, follows Text alignment and carries the editor attributes (select a
               message in the theme editor). Screen readers and the keyboard use it. Everyone sees it whenever
               the marquee doesn't move (theme editor, reduced motion, no JavaScript), and it swaps in for the
               moving strip while it has keyboard focus, so the focus ring is visible.
            2) The moving strip: hidden from screen readers, its links out of the Tab order. It holds one set of
               messages; the script copies them until one half covers the bar.
          {%- endcomment -%}
          <div class="announcement-bar__messages">
            <p class="announcement-bar__message announcement-bar__scroller announcement-bar__marquee-line" tabindex="0">
              <span class="announcement-bar__text">
                {%- assign printed = false -%}
                {%- for block in section.blocks -%}
                  {%- if block.settings.text != blank -%}
                    {%- if printed -%}
                      <span class="announcement-bar__separator" aria-hidden="true">•</span>
                    {%- endif -%}
                    <span class="announcement-bar__part" {{ block.shopify_attributes }}>
                      {%- render 'announcement-message', block: block -%}
                    </span>
                    {%- assign printed = true -%}
                  {%- endif -%}
                {%- endfor -%}
              </span>
            </p>
          </div>
          <div class="announcement-bar__viewport" aria-hidden="true">
            <div class="announcement-bar__track">
              <div class="announcement-bar__half">
                {%- for block in section.blocks -%}
                  {%- if block.settings.text != blank -%}
                    <span class="announcement-bar__item">
                      {%- render 'announcement-message', block: block, hidden_copy: true -%}
                    </span>
                    <span class="announcement-bar__separator">•</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>

        {%- comment -%}
          Static and Slideshow share one message line: <p class="announcement-bar__scroller">. On phones a
          long message stays on one line and this line scrolls sideways (swipe), with fades on the side that
          still has text. tabindex: keyboard users can focus it (and scroll it with the arrow keys); the focus
          ring is drawn on the inner text span, so it hugs the message. Hidden slides (visibility: hidden) are
          skipped by Tab. No aria-label: the parent <announcement-bar role="region"> already names it.
        {%- endcomment -%}
        {%- when 'slideshow' -%}
          <div class="announcement-bar__messages" aria-live="{% if moves %}off{% else %}polite{% endif %}">
            {%- assign index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <p
                  class="announcement-bar__message announcement-bar__scroller{% if index == 0 %} is-active{% endif %}"
                  tabindex="0"
                  {{ block.shopify_attributes }}
                >
                  <span class="announcement-bar__text">
                    {%- render 'announcement-message', block: block -%}
                  </span>
                </p>
                {%- assign index = index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

        {%- else -%}
          <div class="announcement-bar__messages">
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <p class="announcement-bar__message announcement-bar__scroller is-active" tabindex="0" {{ block.shopify_attributes }}>
                  <span class="announcement-bar__text">
                    {%- render 'announcement-message', block: block -%}
                  </span>
                </p>
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
      {%- endcase -%}

      {%- if mode == 'slideshow' and section.settings.show_arrows -%}
        <button type="button" class="announcement-bar__button announcement-bar__next" data-step="1">
          <span class="visually-hidden">{{ 'sections.announcement_bar.next' | t }}</span>
          <svg class="announcement-bar__arrow" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="16" height="16"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {%- endif -%}

      {%- if moves -%}
        <button
          type="button"
          class="announcement-bar__button announcement-bar__pause"
          data-label-pause="{{ 'sections.announcement_bar.pause' | t }}"
          data-label-play="{{ 'sections.announcement_bar.play' | t }}"
          hidden
        >
          <span class="visually-hidden">{{ 'sections.announcement_bar.pause' | t }}</span>
          <svg class="announcement-bar__icon--pause" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="12" height="12"><rect x="3.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/><rect x="9.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/></svg>
          <svg class="announcement-bar__icon--play" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="12" height="12"><path d="M4.5 2.8v10.4a.8.8 0 0 0 1.2.7l8.4-5.2a.8.8 0 0 0 0-1.4L5.7 2.1a.8.8 0 0 0-1.2.7z" fill="currentColor"/></svg>
        </button>
      {%- endif -%}

      {%- if section.settings.show_close -%}
        <button type="button" class="announcement-bar__button announcement-bar__close">
          <span class="visually-hidden">{{ 'sections.announcement_bar.close' | t }}</span>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="12" height="12"><path d="m4 4 8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      {%- endif -%}
    </div>
  </announcement-bar>

  {%- if section.settings.show_close -%}
    {%- comment -%} Runs while the page is still being read, before the first paint: a closed bar never shows {%- endcomment -%}
    <script>
      (function (bar) {
        try {
          if (!(window.Shopify && Shopify.designMode) && localStorage.getItem(bar.dataset.closeKey) === '1') {
            bar.hidden = true;
          }
        } catch (error) {}
      })(document.currentScript.previousElementSibling);
    </script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  /*
    The Header group wraps each of its sections in .shopify-section-group-header-group. Only the header's
    wrapper is sticky (header.liquid); this one stays in the page flow, so the bar scrolls away.
  */
  .announcement-bar {
    display: block;
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .announcement-bar[hidden] {
    display: none;
  }

  /*
    Close: the script fixes the bar's height, then animates it (and the opacity) to zero, so the bar
    collapses instead of vanishing. block-size + opacity are set inline by the script; this only supplies
    the easing. The full-height hero grows back in step (see hero.liquid). Instant with reduced motion.
  */
  .announcement-bar.is-closing {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .announcement-bar {
      transition:
        block-size var(--duration-base, 300ms) var(--ease-out),
        opacity var(--duration-base, 300ms) var(--ease-out);
    }
  }

  .announcement-bar__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-block-size: var(--announcement-size, 2.25rem);
    padding-inline: var(--page-margin);
    font-size: var(--announcement-text, var(--font-size-small));
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
  }

  /*
    Horizontal bar: the message area fills the row by default, and Text alignment places the text inside it.
    (Slideshow instead lets the arrows hug the text — see below.) The pause and close buttons are taken out
    of the flow and pinned to the two ends, so neither shifts the text. Whenever either button is present,
    both ends reserve the same room, so the message stays centred with one button or two.
  */
  .announcement-bar__messages {
    flex: 1;
  }

  .announcement-bar--top .announcement-bar__inner:is(:has(.announcement-bar__close), :has(.announcement-bar__pause)) {
    padding-inline: calc(var(--page-margin) + 1.5rem + var(--space-sm));
  }

  .announcement-bar--font-heading .announcement-bar__inner {
    font-family: var(--font-heading--family);
  }

  /* Arrows follow the text size */
  .announcement-bar__arrow {
    inline-size: 1.15em;
    block-size: 1.15em;
  }

  .announcement-bar--uppercase .announcement-bar__inner {
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .announcement-bar__message {
    margin: 0;
    text-align: center;
  }

  /* Text alignment: along the bar (left / right above the header, top / bottom in the band) */
  .announcement-bar--align-start .announcement-bar__inner {
    justify-content: flex-start;
  }

  .announcement-bar--align-end .announcement-bar__inner {
    justify-content: flex-end;
  }

  .announcement-bar--align-start .announcement-bar__message {
    text-align: start;
  }

  .announcement-bar--align-end .announcement-bar__message {
    text-align: end;
  }

  .announcement-bar__link-label {
    margin-inline-start: 0.5em;
  }

  .announcement-bar__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .announcement-bar__link:hover {
    text-decoration-thickness: 2px;
  }

  /* Slideshow: every message in the same grid cell, so the bar keeps the tallest one's size (no jumps) */
  .announcement-bar--slideshow .announcement-bar__messages {
    display: grid;
    min-inline-size: 0;
    /* Don't stretch: the box shrinks to the message so the arrows sit right beside the text, centred as a group */
    flex: 0 1 auto;
  }

  .announcement-bar--slideshow .announcement-bar__message {
    grid-area: 1 / 1;
  }

  .announcement-bar--slideshow .announcement-bar__message:not(.is-active) {
    visibility: hidden;
    opacity: 0;
  }

  .animations-on .announcement-bar--slideshow .announcement-bar__message {
    transition:
      opacity var(--duration-base) var(--ease-out),
      visibility var(--duration-base);
  }

  /* Small round buttons: arrows, pause / play, close (24px targets, WCAG 2.5.8) */
  .announcement-bar__button {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: transparent;
    color: inherit;
    cursor: pointer;
  }

  .announcement-bar__button:hover {
    background-color: color-mix(in srgb, var(--color-text) 15%, transparent);
  }

  .announcement-bar__button[hidden] {
    display: none;
  }

  .announcement-bar__close {
    position: absolute;
    inset-inline-end: var(--page-margin);
  }

  /*
    Top bar: pause/play is pinned to the start end and close to the other, both out of the flow, and centred
    vertically so they sit right whatever the bar's height.
  */
  .announcement-bar--top .announcement-bar__pause {
    position: absolute;
    inset-inline-start: var(--page-margin);
  }

  .announcement-bar--top .announcement-bar__close,
  .announcement-bar--top .announcement-bar__pause {
    inset-block: 0;
    margin-block: auto;
  }

  /* Play icon only while paused, pause icon only while playing (driven by .is-paused on the host element) */
  .announcement-bar:not(.is-paused) .announcement-bar__icon--play,
  .announcement-bar.is-paused .announcement-bar__icon--pause {
    display: none;
  }

  /*
    Marquee. The script adds is-moving when the strip may move: not in the theme editor, and the visitor
    hasn't asked for reduced motion. (The theme's "Enable animations" setting doesn't matter: choosing
    Marquee is the merchant's own choice.)
    - Not moving: the strip is hidden and the real line shows (one line, scrolls, follows Text alignment).
    - Moving: the strip shows and the real line is visually hidden (screen readers still read it). When the
      keyboard reaches the real line, it swaps in for the strip, so the focus ring can be seen.
    The track slides by one half, then starts over; the halves are the same, so no seam shows.
  */
  .announcement-bar__viewport {
    display: none;
    overflow: hidden;
    min-inline-size: 0;
    flex: 1;
    padding-block: 0.3em; /* room for the link underline (offset 0.35em), which overflow: hidden would cut off */
  }

  .announcement-bar--marquee.is-moving:not(:has(.announcement-bar__marquee-line:focus-within)) .announcement-bar__viewport {
    display: block;
  }

  .announcement-bar--marquee.is-moving:not(:has(.announcement-bar__marquee-line:focus-within)) .announcement-bar__messages {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Real line: a dot between messages, with room on both sides */
  .announcement-bar__marquee-line .announcement-bar__separator {
    padding-inline: 1em;
  }

  .announcement-bar__track,
  .announcement-bar__half {
    display: flex;
    align-items: center;
    inline-size: max-content;
  }

  .announcement-bar__item,
  .announcement-bar__separator {
    flex-shrink: 0;
    padding-inline-end: 2em;
    white-space: nowrap;
  }

  /* Letter spacing: Automatic = from Text style (uppercase is spaced, wider in the band). The class is doubled so a
     chosen value also beats the band's uppercase rule further down. */
  .announcement-bar.announcement-bar.announcement-bar--spacing-normal .announcement-bar__inner {
    letter-spacing: 0;
  }

  .announcement-bar.announcement-bar.announcement-bar--spacing-wide .announcement-bar__inner {
    letter-spacing: 0.1em;
  }

  .announcement-bar.announcement-bar.announcement-bar--spacing-extra .announcement-bar__inner {
    letter-spacing: 0.3em;
  }

  /*
    Horizontal bar on phones (below 750px): the text follows the screen width instead of the fixed Text size,
    and the letter spacing shrinks with it, so a short message stays on one line. Text size is the upper
    limit: min() takes the smaller of the setting and 3.4% of the screen width (11px on a 320px phone,
    ~13px at 375px), never below 11px. A message that still doesn't fit stays on one line and scrolls
    sideways, as on every screen size (Static and Slideshow); Marquee keeps any length on one line by moving.
    Letter spacing Automatic only: a spacing the merchant picked by hand is kept.
  */
  @media (max-width: 749px) {
    .announcement-bar__inner {
      font-size: max(0.6875rem, min(var(--announcement-text, 0.875rem), 3.4vw));
      padding-block: var(--space-2xs);
    }

    /* Phones: tighter icon room so the message keeps more width */
    .announcement-bar--top .announcement-bar__inner:is(:has(.announcement-bar__close), :has(.announcement-bar__pause)) {
      padding-inline: calc(var(--space-xs) + 1.5rem);
    }

    .announcement-bar--top .announcement-bar__close {
      inset-inline-end: var(--space-2xs);
    }

    .announcement-bar--top .announcement-bar__pause {
      inset-inline-start: var(--space-2xs);
    }

    .announcement-bar--uppercase.announcement-bar--spacing-auto .announcement-bar__inner {
      letter-spacing: 0.08em;
    }
  }

  /*
    Static and Slideshow, every screen size: a long message stays on ONE line and its line scrolls sideways
    (swipe, trackpad, Shift + mouse wheel, or the arrow keys once focused) instead of wrapping. Each message
    line (.announcement-bar__scroller) is the scroll box and its text span grows past it (max-content).
    When it fits, the text follows the Text alignment setting via the auto margins; when it is too long the
    margins collapse to 0, so it reads from its start. The scrollbar is hidden; a soft fade marks whichever
    side still has text off screen. The script toggles has-overflow-start / -end on the line, so once you
    reach an end that end is fully shown. A little block padding leaves room for the focus ring.
    Slideshow: the arrows hug a short message; a long one fills the room between them and scrolls.
    The right-side band scrolls the same way, but up and down (its text runs top to bottom).
  */
  .announcement-bar--slideshow .announcement-bar__messages {
    grid-template-columns: minmax(0, 1fr); /* each line is the box's width, so it can scroll */
  }

  .announcement-bar__scroller {
    overflow-x: auto;
    padding-block: 0.25rem;
    scrollbar-width: none; /* Firefox: hide the bar; the fades are the cue */
  }

  .announcement-bar__scroller::-webkit-scrollbar {
    display: none; /* Chrome / Safari */
  }

  .announcement-bar__scroller.has-overflow-start.has-overflow-end {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
    mask-image: linear-gradient(to right, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
  }

  .announcement-bar__scroller.has-overflow-end:not(.has-overflow-start) {
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
  }

  .announcement-bar__scroller.has-overflow-start:not(.has-overflow-end) {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 2.5rem);
    mask-image: linear-gradient(to right, transparent, #000 2.5rem);
  }

  .announcement-bar__scroller .announcement-bar__text {
    display: block;
    inline-size: max-content;
    margin-inline: auto; /* centre (default); the auto margins place a message that fits */
    white-space: nowrap;
  }

  /* Follow the Text alignment setting when the message fits (ignored once it overflows and scrolls) */
  .announcement-bar--align-start .announcement-bar__scroller .announcement-bar__text {
    margin-inline: 0 auto;
  }

  .announcement-bar--align-end .announcement-bar__scroller .announcement-bar__text {
    margin-inline: auto 0;
  }

  /*
    Keyboard focus: the ring is drawn on the text span, not the full-width scroll box, so it hugs the
    message. outline-offset gives the gap ("padding") between the text and the ring; the pill radius rounds
    it. currentColor keeps it visible on any colour scheme (e.g. the red band).
  */
  .announcement-bar__text {
    display: inline-block;
    border-radius: var(--radius-pill);
  }

  .announcement-bar__scroller:focus-visible {
    outline: none;
  }

  .announcement-bar__scroller:focus-visible .announcement-bar__text {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .announcement-bar--marquee.is-moving .announcement-bar__track {
      animation: announcement-slide-x var(--announcement-duration, 40s) linear infinite;
    }

    .announcement-bar--marquee-right.is-moving .announcement-bar__track {
      animation-direction: reverse;
    }

    /*
      Paused while the mouse is over it or by the pause button. Not on keyboard focus: focus on the message
      already swaps in the still line, and pausing on focus kept it stopped after pressing play (the button
      keeps focus).
    */
    .announcement-bar--marquee.is-moving:is(:hover, .is-paused) .announcement-bar__track {
      animation-play-state: paused;
    }
  }

  @keyframes announcement-slide-x {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes announcement-slide-y {
    to {
      transform: translateY(-50%);
    }
  }

  /*
    Right side (large screens): the vertical band (Figma home hero, 36px). writing-mode turns the whole row
    sideways, so the same flex layout runs top to bottom; arrows turn to point up and down, and the marquee
    moves vertically ("Left" = up).
  */
  @media (min-width: 990px) {
    /*
      Fixed to the right edge of the screen, one screen tall, so it is always whole while the page scrolls.
      "Slide away while scrolling down": the script adds is-tucked once the page has scrolled down and removes it
      only back at the top; the band slides out to the right and back (instant with reduced motion).
    */
    .announcement-bar--right {
      position: fixed;
      inset-block-start: 0;
      inset-inline-end: 0;
      z-index: 15; /* under the sticky header (20) */
      inline-size: var(--announcement-size, 2.25rem);
      block-size: 100svh;
    }

    .announcement-bar--right.is-tucked {
      translate: 100% 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .announcement-bar--right {
        transition:
          translate var(--duration-slow, 0.5s) var(--ease-out),
          opacity var(--duration-base, 300ms) var(--ease-out);
      }
    }

    /*
      Arrows stay right next to the message (one compact group, like the bar above the header); Text alignment
      places the group at the top, middle or bottom of the band.
      The page keeps the band's width free on the right, so the band never covers content (full-width
      sections included): body padding narrows everything that is laid out inside it.
    */
    .announcement-bar--right .announcement-bar__messages {
      flex: 0 1 auto;
    }

    /*
      The page leaves the band's width free only while the band is showing: once it slides out
      (is-tucked), the gap closes with it, so no empty strip stays on the right.
    */
    body:has(.announcement-bar--right:not([hidden]):not(.is-tucked)) {
      padding-inline-end: var(--announcement-size, 2.25rem);
    }

    @media (prefers-reduced-motion: no-preference) {
      body:has(.announcement-bar--right) {
        transition: padding-inline-end var(--duration-slow, 0.5s) var(--ease-out);
      }
    }

    .announcement-bar--right .announcement-bar__inner {
      writing-mode: vertical-rl;
      /*
        Physical sizes on purpose: with vertical writing, "block" means across and "inline" means down, so
        block-size: 100% only set the width and the row stayed as short as its content (alignment had no room).
      */
      inline-size: auto;
      block-size: auto;
      width: 100%;
      height: 100%;
      min-block-size: 0;
      padding-inline: var(--space-sm);
    }

    .announcement-bar--right.announcement-bar--uppercase .announcement-bar__inner {
      letter-spacing: 0.35em;
    }

    /* One line only: a long message is cut at the band's end instead of wrapping into a second column */
    .announcement-bar--right .announcement-bar__messages {
      overflow: hidden;
      min-inline-size: 0;
    }

    .announcement-bar--right .announcement-bar__message {
      white-space: nowrap;
    }

    /*
      The band reads top to bottom, so a long message scrolls up and down along the band (mouse wheel,
      trackpad, or the arrow keys once focused) instead of sideways, and the fades sit at the top / bottom.
      (Text alignment still places a message that fits: top, middle or bottom of the band.)
    */
    .announcement-bar--right .announcement-bar__scroller {
      overflow-x: hidden;
      overflow-y: auto;
    }

    .announcement-bar--right .announcement-bar__scroller.has-overflow-start.has-overflow-end {
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
    }

    .announcement-bar--right .announcement-bar__scroller.has-overflow-end:not(.has-overflow-start) {
      -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 2.5rem), transparent);
      mask-image: linear-gradient(to bottom, #000 calc(100% - 2.5rem), transparent);
    }

    .announcement-bar--right .announcement-bar__scroller.has-overflow-start:not(.has-overflow-end) {
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 2.5rem);
      mask-image: linear-gradient(to bottom, transparent, #000 2.5rem);
    }

    .announcement-bar--right .announcement-bar__arrow {
      rotate: 90deg;
    }

    .announcement-bar--right .announcement-bar__close {
      inset-inline-end: auto;
      inset-inline-start: var(--space-sm);
    }

    /*
      With a close button (at the top), both ends keep the button's room plus a gap, like the bar above the
      header: the text never runs under the button and stays centred in the band.
    */
    /* Pause / play: at the bottom end of the band, the close button's counterpart at the top */
    .announcement-bar--right .announcement-bar__pause {
      position: absolute;
      inset-inline-end: var(--space-sm);
    }

    .announcement-bar--right .announcement-bar__inner:is(:has(.announcement-bar__close), :has(.announcement-bar__pause)) {
      padding-inline: calc(var(--space-sm) + 1.5rem + var(--space-md));
    }

    @media (prefers-reduced-motion: no-preference) {
      .announcement-bar--right.announcement-bar--marquee.is-moving .announcement-bar__track {
        animation-name: announcement-slide-y;
      }
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <announcement-bar>
   * - Close: hides the bar and remembers it for the visit (not in the theme editor).
   * - Slideshow: arrows, autoplay (paused on hover / focus and by the pause button). Screen readers hear the
   *   new message only when the visitor changed it (aria-live polite), not every few seconds.
   * - Marquee: shows the pause button when it really moves.
   * Listeners are removed when the editor re-renders the section (AbortController).
   */
  class AnnouncementBar extends HTMLElement {
    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.motion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
      this.designMode = Boolean(window.Shopify && Shopify.designMode);

      this.querySelector('.announcement-bar__close')?.addEventListener('click', () => this.close(), { signal });
      if (this.dataset.tuck === 'true') this.setUpTuck(signal);

      this.pauseButton = this.querySelector('.announcement-bar__pause');
      this.pauseButton?.addEventListener('click', () => this.togglePause(), { signal });

      if (this.dataset.mode === 'slideshow') this.setUpSlideshow(signal);
      if (this.dataset.mode === 'marquee') this.setUpMarquee(signal);
      this.setUpScroll(signal);
    }

    disconnectedCallback() {
      this.controller?.abort();
      clearInterval(this.timer);
      clearTimeout(this.closeFallback);
      this.resizeObserver?.disconnect();
      this.marqueeObserver?.disconnect();
    }

    /*
      Marquee: moves only outside the theme editor and when the visitor hasn't asked for reduced motion
      (re-checked if that preference changes while the page is open). While moving, the strip gets enough
      copies of the messages that one half covers the bar (no gap at the loop point), and the loop time comes
      from the Speed setting in pixels per second, so short and long messages move at the same pace. The
      pause button shows only while it really moves. In the editor, selecting a message scrolls the real
      line to it.
    */
    setUpMarquee(signal) {
      this.viewport = this.querySelector('.announcement-bar__viewport');
      this.track = this.viewport?.querySelector('.announcement-bar__track');
      if (!this.track) return;
      this.unit = [...this.track.querySelector('.announcement-bar__half').children].map((node) => node.cloneNode(true));

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const apply = () => {
        const moving = !this.designMode && !reduced.matches;
        this.classList.toggle('is-moving', moving);
        if (this.pauseButton) this.pauseButton.hidden = !moving;
        if (moving) this.buildMarquee();
      };
      reduced.addEventListener('change', apply, { signal });

      // Rebuild when the strip's room changes (window resize, band height, or the strip showing again after
      // the keyboard leaves the real line). At most once per frame.
      let pending = false;
      this.marqueeObserver = new ResizeObserver(() => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(() => {
          pending = false;
          if (!this.classList.contains('is-moving')) return;
          const size = this.measure(this.viewport);
          if (size > 0 && size !== this.marqueeSize) this.buildMarquee();
        });
      });
      this.marqueeObserver.observe(this.viewport);

      // The web font changes the messages' width once it has loaded
      document.fonts?.ready.then(() => {
        if (this.classList.contains('is-moving')) this.buildMarquee();
      });

      document.addEventListener(
        'shopify:block:select',
        (event) => {
          const part = [...this.querySelectorAll('.announcement-bar__part')].find(
            (element) => element === event.target || element.contains(event.target)
          );
          part?.scrollIntoView({ block: 'nearest', inline: 'center' });
        },
        { signal }
      );

      apply();
    }

    // Size along the text: width in the bar above the header, height in the right-side band (vertical)
    measure(element) {
      const rect = element.getBoundingClientRect();
      return getComputedStyle(element).writingMode.startsWith('vertical') ? rect.height : rect.width;
    }

    buildMarquee() {
      const target = this.measure(this.viewport);
      if (target === 0) return; // the strip is hidden right now (keyboard on the real line)
      this.marqueeSize = target;
      const half = document.createElement('div');
      half.className = 'announcement-bar__half';
      this.track.replaceChildren(half);
      let copies = 0;
      do {
        this.unit.forEach((node) => half.append(node.cloneNode(true)));
        copies += 1;
      } while (this.measure(half) < target && copies < 50);
      this.track.append(half.cloneNode(true));
      const speed = Number(this.dataset.speed) || 50; // pixels per second
      this.style.setProperty('--announcement-duration', (this.measure(half) / speed).toFixed(2) + 's');
    }

    /*
      Static and Slideshow, every screen size: each message line scrolls sideways when the message is too long. Mark
      which side of a line still has text off screen (has-overflow-start / -end on the line) so the
      stylesheet fades only that side, and drops the fade once an end is reached.
      In a slideshow, a swipe restarts the autoplay timer, so the slide doesn't change mid-swipe.
    */
    setUpScroll(signal) {
      const scrollers = [...this.querySelectorAll('.announcement-bar__scroller')];
      if (!scrollers.length) return;
      const update = (scroller) => {
        // The right-side band writes top to bottom (vertical writing mode), so it scrolls vertically
        const vertical = getComputedStyle(scroller).writingMode.startsWith('vertical');
        const max = vertical
          ? scroller.scrollHeight - scroller.clientHeight
          : scroller.scrollWidth - scroller.clientWidth;
        const position = vertical ? scroller.scrollTop : scroller.scrollLeft;
        scroller.classList.toggle('has-overflow-start', position > 1);
        scroller.classList.toggle('has-overflow-end', position < max - 1);
      };
      // Watch each line and its text: when the web font swaps in, the text's width changes, not the line's
      this.resizeObserver = new ResizeObserver((entries) => {
        entries.forEach((entry) => update(entry.target.closest('.announcement-bar__scroller')));
      });
      scrollers.forEach((scroller) => {
        let ticking = false;
        scroller.addEventListener(
          'scroll',
          () => {
            if (this.dataset.mode === 'slideshow') this.restart();
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              ticking = false;
              update(scroller);
            });
          },
          { passive: true, signal }
        );
        this.resizeObserver.observe(scroller);
        if (scroller.firstElementChild) this.resizeObserver.observe(scroller.firstElementChild);
        update(scroller);
      });
    }

    /*
      Right-side band: slides out once the page has scrolled down, and comes back only at the top of the page
      (not in the middle when scrolling up), or while it has keyboard focus.
    */
    setUpTuck(signal) {
      const large = window.matchMedia('(min-width: 990px)');
      let ticking = false;
      const update = () => {
        ticking = false;
        const atTop = window.scrollY < 80;
        const show = !large.matches || atTop || this.contains(document.activeElement);
        this.classList.toggle('is-tucked', !show);
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true, signal }
      );
      this.addEventListener('focusin', () => this.classList.remove('is-tucked'), { signal });
    }

    close() {
      // Stop the slideshow timer so it isn't left cycling a hidden bar (or restarted by mouseleave)
      clearInterval(this.timer);
      this.userPaused = true;

      // Remember it first, so a closed bar stays closed even if the animation is cut short
      if (!this.designMode) {
        try {
          localStorage.setItem(this.dataset.closeKey, '1');
          // Forget notes for older messages, so they don't pile up
          Object.keys(localStorage)
            .filter((key) => key.startsWith('announcement-closed') && key !== this.dataset.closeKey)
            .forEach((key) => localStorage.removeItem(key));
        } catch (error) {
          // Storage blocked: the bar comes back on the next page
        }
      }

      // Theme editor or reduced motion: just hide it, no animation
      if (this.designMode || !this.motion) {
        this.hidden = true;
        return;
      }

      const finish = (event) => {
        if (event && event.target !== this) return;
        this.hidden = true;
        this.removeEventListener('transitionend', finish);
        clearTimeout(this.closeFallback);
      };

      this.classList.add('is-closing');
      // Top bar: collapse its height so the page (and the hero) closes the gap smoothly. The right-side
      // band keeps its height and only fades (collapsing a full-height fixed band would look wrong).
      if (this.classList.contains('announcement-bar--top')) {
        this.style.blockSize = `${this.offsetHeight}px`;
        void this.offsetHeight; // commit that height before animating to 0
        this.style.blockSize = '0';
      }
      this.style.opacity = '0';

      this.addEventListener('transitionend', finish);
      this.closeFallback = setTimeout(finish, 600); // safety if transitionend never fires
    }

    setUpSlideshow(signal) {
      this.messages = [...this.querySelectorAll('.announcement-bar__message')];
      this.current = 0;
      this.region = this.querySelector('.announcement-bar__messages');

      this.querySelectorAll('[data-step]').forEach((button) => {
        button.addEventListener(
          'click',
          () => {
            this.region.setAttribute('aria-live', 'polite');
            this.show(this.current + Number(button.dataset.step));
            this.restart();
          },
          { signal }
        );
      });

      // Theme editor: selecting a message's block shows it and pauses autoplay; deselecting resumes it.
      // A separate flag (not userPaused) so it never touches the pause button's own state.
      const findMessage = (event) =>
        this.messages.findIndex((message) => message.contains(event.target) || message === event.target);
      document.addEventListener(
        'shopify:block:select',
        (event) => {
          const index = findMessage(event);
          if (index === -1) return;
          this.editorPaused = true;
          clearInterval(this.timer);
          this.show(index);
        },
        { signal }
      );
      document.addEventListener(
        'shopify:block:deselect',
        (event) => {
          if (findMessage(event) === -1) return;
          this.editorPaused = false;
          this.restart();
        },
        { signal }
      );

      if (this.dataset.autoplay !== 'true' || !this.motion || this.messages.length < 2) {
        this.region.setAttribute('aria-live', 'polite');
        return;
      }

      if (this.pauseButton) this.pauseButton.hidden = false;
      // Hover and focus each pause on their own, so leaving one doesn't resume while the other still holds
      this.hoverPaused = false;
      this.focusPaused = false;
      this.addEventListener('mouseenter', () => { this.hoverPaused = true; this.restart(); }, { signal });
      this.addEventListener('mouseleave', () => { this.hoverPaused = false; this.restart(); }, { signal });
      this.addEventListener('focusin', () => { this.focusPaused = true; this.restart(); }, { signal });
      this.addEventListener('focusout', (event) => {
        if (!this.contains(event.relatedTarget)) {
          this.focusPaused = false;
          this.restart();
        }
      }, { signal });
      this.restart();
    }

    show(index) {
      const count = this.messages.length;
      this.current = (index + count) % count;
      this.messages.forEach((message, i) => message.classList.toggle('is-active', i === this.current));
      // A slide that was swiped earlier starts again from the beginning of its message
      const active = this.messages[this.current];
      if (active && (active.scrollLeft !== 0 || active.scrollTop !== 0)) active.scrollTo(0, 0);
    }

    restart() {
      clearInterval(this.timer);
      if (this.dataset.mode !== 'slideshow' || this.dataset.autoplay !== 'true' || !this.motion) return;
      if (this.userPaused || this.hoverPaused || this.focusPaused || this.editorPaused) return;
      this.timer = setInterval(() => {
        // Auto-advance is silent to screen readers; only a change the visitor makes is announced (polite)
        this.region?.setAttribute('aria-live', 'off');
        this.show(this.current + 1);
      }, Number(this.dataset.interval) || 5000);
    }

    togglePause() {
      this.userPaused = !this.userPaused;
      this.classList.toggle('is-paused', this.userPaused);
      this.pauseButton.querySelector('.visually-hidden').textContent = this.userPaused
        ? this.pauseButton.dataset.labelPlay
        : this.pauseButton.dataset.labelPause;
      this.region?.setAttribute('aria-live', this.userPaused ? 'polite' : 'off');
      this.restart();
    }
  }

  if (!customElements.get('announcement-bar')) customElements.define('announcement-bar', AnnouncementBar);
{% endjavascript %}

{% schema %}
