{%- comment -%}
  Blog hero (M8.2, Figma 3007:81466 desktop, design/inbox/blog-list/Property 1=Variant13.png phones):
  breadcrumb, then the intro (eyebrow with a rule on both sides, the H1 with a red second line, the
  intro text, three counters: Articles, Authors, Topics) and up to four floating stat cards in a
  zig-zag, with faded book / award outlines and soft rose glows behind them.

  - Below 1440px (phones, tablets, small laptops): the phone design. Centred intro, counters in one
    row, cards 2 per row in the zig-zag. From 1440px: intro left, cards right (the Figma desktop).
  - Every page of the blog looks the same (page 2, topic pages): only the Article list changes.
  - Counters: the typed value when filled in, otherwise counted from the whole blog: articles =
    articles_count, topics = the number of tags, authors = the different author names among the
    50 newest articles (Liquid reads at most 50 articles here). Shopify has no "authors" number.
    They read blogs[blog.handle], not blog: on a topic page Shopify filters blog.articles and
    blog.articles_count by the tag (3 instead of 17), blogs[handle] gives the whole blog.
  - The first section of the page, so no scroll animation (project rule); the cards may float slowly
    instead (needs "Reveal sections on scroll", off with reduced motion).
  - Sized to the screen like the hero (snippets/screen-scale.liquid), with the section's settings.
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'

  assign animation = section.settings.animation
  if section.index == 1
    assign animation = 'none'
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = blog.title | escape
  endif

  assign whole_blog = blogs[blog.handle]

  assign articles_value = section.settings.articles_value
  if articles_value == blank
    assign articles_value = whole_blog.articles_count
  endif

  assign authors_value = section.settings.authors_value
  if authors_value == blank
    assign authors_value = whole_blog.articles | map: 'author' | uniq | size
  endif

  assign topics_value = section.settings.topics_value
  if topics_value == blank
    assign topics_value = whole_blog.all_tags.size
  endif

  assign counter_count = 0
  if articles_value != blank and articles_value != 0
    assign counter_count = counter_count | plus: 1
  endif
  if authors_value != blank and authors_value != 0
    assign counter_count = counter_count | plus: 1
  endif
  if topics_value != blank and topics_value != 0
    assign counter_count = counter_count | plus: 1
  endif

  # Cards show when at least one Stat card writes something (an empty card writes nothing on the
  # store, a note in the editor). The section can't read its theme blocks' settings
  # (section.blocks gives empty settings), so the blocks are rendered first and their HTML checked.
  assign show_cards = false
  capture cards_html
    content_for 'blocks'
  endcapture
  if cards_html contains 'class="blog-stat-card'
    assign show_cards = true
  endif

  assign section_width = section.settings.section_width | default: 'widest'
  assign hero_classes = 'section-width--' | append: section_width
  if section.settings.fill_screen
    assign hero_classes = hero_classes | append: ' section--fill-screen'
  endif
  if section.settings.scale_screen
    assign hero_classes = hero_classes | append: ' section--screen-scale'
  endif
  if section.settings.float_cards
    assign hero_classes = hero_classes | append: ' blog-hero--float'
  endif
-%}

{% render 'screen-scale' %}

<div
  class="blog-hero full-width {{ hero_classes }} color-{{ scheme_id }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --text-boost: {{ section.settings.text_scale | default: 110 | divided_by: 100.0 }}; --counters: {{ counter_count | at_least: 1 }};"
>
  <animate-on-scroll class="blog-hero__inner">
    {%- if section.settings.show_breadcrumb -%}
      {% render 'breadcrumb', current: blog.title, class: 'blog-hero__breadcrumb' %}
    {%- endif -%}

    <div class="blog-hero__grid{% if show_cards %} blog-hero__grid--split{% endif %}">
      <div
        class="blog-hero__intro"
        {% if animation != 'none' %}
          data-animate="{{ animation }}"
        {% endif %}
      >
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow blog-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h1 class="blog-hero__heading">{{ heading }}</h1>

        {%- if section.settings.text != blank -%}
          <div class="blog-hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if counter_count > 0 -%}
          <dl class="blog-hero__counters">
            {%- if articles_value != blank and articles_value != 0 -%}
              <div class="blog-hero__counter">
                <dt>{{ section.settings.articles_label | escape }}</dt>
                <dd>{{ articles_value }}</dd>
              </div>
            {%- endif -%}
            {%- if authors_value != blank and authors_value != 0 -%}
              <div class="blog-hero__counter">
                <dt>{{ section.settings.authors_label | escape }}</dt>
                <dd>{{ authors_value }}</dd>
              </div>
            {%- endif -%}
            {%- if topics_value != blank and topics_value != 0 -%}
              <div class="blog-hero__counter">
                <dt>{{ section.settings.topics_label | escape }}</dt>
                <dd>{{ topics_value }}</dd>
              </div>
            {%- endif -%}
          </dl>
        {%- endif -%}
      </div>

      {%- if show_cards -%}
        <div class="blog-hero__collage">
          {%- comment -%} The Figma's faded outlines (assets/deco-*.svg, accent), breathing slowly {%- endcomment -%}
          <span class="blog-hero__deco blog-hero__deco--book" aria-hidden="true">
            {{- 'deco-book.svg' | inline_asset_content -}}
          </span>
          <span class="blog-hero__deco blog-hero__deco--award" aria-hidden="true">
            {{- 'deco-award.svg' | inline_asset_content -}}
          </span>
          <span class="blog-hero__deco blog-hero__deco--heart" aria-hidden="true">
            {{- 'deco-heart.svg' | inline_asset_content -}}
          </span>
          <div class="blog-hero__cards">
            {{- cards_html -}}
          </div>
          {%- comment -%} The outlines breathe and the cards float without end: a pause button (WCAG 2.2.2) {%- endcomment -%}
          {%- render 'motion-pause',
            label: 'blog.hero_pause',
            target: '.blog-hero__collage',
            class: 'blog-hero__pause'
          -%}
        </div>
      {%- endif -%}
    </div>
  </animate-on-scroll>
</div>

{% stylesheet %}
  /*
    Figma 1920 frame: text column x 49-590 (541px), collage x 745-1797 (1052 x 634, from y 257),
    155px apart. Phone frame (375px): centred intro, cards 2 per row. Sizes are tokens or Figma px x
    --px (screen-scale), with the Figma px in comments.
  */
  .blog-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  /*
    Soft rose glows behind everything, at the Figma's seven spots (% of the 1920 x 1031 frame): five
    small ones under and between the cards, two big ones at the top-right and bottom-right corners.
  */
  .blog-hero::before {
    --glow: color-mix(in srgb, var(--color-accent) 6%, transparent);
    --glow-big: color-mix(in srgb, var(--color-accent) 7%, transparent);
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(circle 9rem at 37.5% 19.7%, var(--glow), transparent),
      radial-gradient(circle 9rem at 56% 39%, var(--glow), transparent),
      radial-gradient(circle 9rem at 67% 25%, var(--glow), transparent),
      radial-gradient(circle 9rem at 70% 54.6%, var(--glow), transparent),
      radial-gradient(circle 9rem at 50% 71.5%, var(--glow), transparent),
      radial-gradient(circle 16rem at 92% 22%, var(--glow-big), transparent),
      radial-gradient(circle 16rem at 91.7% 89.5%, var(--glow-big), transparent);
    pointer-events: none;
  }

  .blog-hero__inner {
    position: relative;
    z-index: 1;
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .blog-hero__breadcrumb {
    margin-block-end: var(--space-2xl); /* breadcrumb → eyebrow: ~65px (phones ~30px) */
  }

  /* Below 1440px (the phone design): the centred intro, then the cards */
  .blog-hero__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  /* ---------- Intro ---------- */
  .blog-hero__intro {
    text-align: center;
  }

  /* A rule on both sides of the label (Figma "—— BEAUTY INTELLIGENCE ——"); the rules get shorter
     before the label goes onto two lines */
  .blog-hero__eyebrow {
    justify-content: center;
  }

  /* The rules start at 0 and take only the free space (66px at most), so the label keeps its line */
  .blog-hero__eyebrow::before,
  .blog-hero__eyebrow::after {
    content: "";
    flex: 1 1 0;
    min-inline-size: 1rem;
    max-inline-size: 66px;
    inline-size: auto;
    block-size: 2px;
    background-color: currentcolor;
  }

  .blog-hero__heading {
    margin-block-start: var(--space-xl); /* eyebrow → H1: ~41px */
  }

  /* The red second line: made italic in the editor, shown upright, on its own line */
  .blog-hero__heading em {
    display: block;
    font-style: normal;
    color: var(--color-accent);
  }

  .blog-hero__text {
    /* 550 Figma px, but never narrower than 34rem: on a small screen --px is tiny (500px wide = 0.26) */
    max-inline-size: max(34.375rem, calc(550 * var(--px, 0.0625rem)));
    margin: var(--space-2xl) auto 0; /* ~58px */
    font-size: var(--font-size-body-sm); /* 18px */
    line-height: 1.6; /* 29px lines */
  }

  .blog-hero__text p + p {
    margin-block-start: var(--space-xl); /* ~37px between the two paragraphs */
  }

  /* Counters: one row of equal columns, number on top, label under it (the <dt> label comes first
     in the HTML for screen readers) */
  .blog-hero__counters {
    display: grid;
    grid-template-columns: repeat(var(--counters, 3), minmax(0, 1fr));
    gap: var(--space-md);
    max-inline-size: 36rem;
    margin: var(--space-2xl) auto 0;
  }

  .blog-hero__counter {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
  }

  .blog-hero__counter dd {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: max(2.5rem, calc(56 * var(--px, 0.0625rem)));
    font-variant-numeric: oldstyle-nums;
    line-height: 1.1;
  }

  .blog-hero__counter dt {
    margin-block-start: var(--space-md);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  /* ---------- Cards ---------- */

  /*
    The zig-zag at all sizes: 2 columns, the 2nd card lower, the 2nd row moved to the inline end
    (Figma desktop: cards at (0, 0), (49.9%, 7.7%), (16.2%, 56%), (66.5%, 69.7%), 33.7% wide; phones
    the same shape, smaller). In normal flow, so a taller card (long text, Text size) pushes the next
    row down and never covers it. Sizes in cqi = % of the collage width.
  */
  .blog-hero__collage {
    position: relative;
    container: blog-hero-cards / inline-size;
    inline-size: 100%;
    max-inline-size: 48rem;
    margin-inline: auto;
  }

  .blog-hero__cards {
    --cards-gap: 4cqi; /* phones: 14px of 343 */
    --cards-shift: 4.5cqi; /* row 2 moves 16px to the end */
    --cards-drop: min(10cqi, 3.5rem); /* card 2: 35px lower */
    --cards-drop-2: 1.5cqi; /* card 4: 5px lower than card 3 */
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    column-gap: var(--cards-gap);
    row-gap: 4.5cqi;
    margin-block-end: 8cqi; /* room for the award outline under the cards */
    padding-inline-end: var(--cards-shift);
  }

  .blog-hero__cards > :nth-child(2) {
    margin-block-start: var(--cards-drop);
  }

  .blog-hero__cards > :nth-child(4) {
    margin-block-start: var(--cards-drop-2);
  }

  /* The card block is position: relative, so this only moves it */
  .blog-hero__cards > :nth-child(n + 3) {
    inset-inline-start: var(--cards-shift);
  }

  /* Faded outline icons behind the cards (phones: book at the left between the rows, award under
     the last card) */
  .blog-hero__deco {
    position: absolute;
    display: block;
    color: var(--color-accent);
    pointer-events: none;
  }

  .blog-hero__deco svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .blog-hero__deco--book {
    inset-block-start: 45%;
    inset-inline-start: -2.5%;
    inline-size: 11cqi;
  }

  .blog-hero__deco--award {
    inset-block-start: calc(100% - 9cqi);
    inset-inline-start: 70%;
    inline-size: 8cqi;
  }

  .blog-hero__deco--heart {
    display: none;
  }

  @media (max-width: 749px) {
    .blog-hero__breadcrumb {
      margin-block-end: var(--space-xl);
    }

    .blog-hero__heading {
      margin-block-start: var(--space-lg);
    }

    .blog-hero__text {
      margin-block-start: var(--space-lg);
    }

    .blog-hero__counters {
      gap: var(--space-xs);
      margin-block-start: var(--space-xl);
    }

    .blog-hero__counter dd {
      font-size: 1.875rem; /* ~30px */
    }

    .blog-hero__counter dt {
      margin-block-start: var(--space-sm);
      font-size: 0.75rem;
    }
  }

  /* From 1440px with cards: the Figma desktop, intro left and cards right */
  @media (min-width: 1440px) {
    .blog-hero__grid--split {
      /* The text column keeps 28rem, so the H1 stays on two lines */
      grid-template-columns: minmax(min(28rem, 100%), 541fr) minmax(0, 1052fr);
      column-gap: calc(155 * var(--px, 0.0625rem));
    }

    .blog-hero__grid--split .blog-hero__intro {
      text-align: start;
    }

    .blog-hero__grid--split .blog-hero__eyebrow {
      justify-content: flex-start;
    }

    .blog-hero__grid--split .blog-hero__eyebrow::before,
    .blog-hero__grid--split .blog-hero__eyebrow::after {
      flex: none;
      inline-size: 66px;
      max-inline-size: none;
    }

    .blog-hero__grid--split .blog-hero__text {
      margin-inline: 0;
    }

    /* Counters: from the left edge, spread over the text column (Figma x 49 / 271 / 491 in 541px) */
    .blog-hero__grid--split .blog-hero__counters {
      grid-template-columns: repeat(var(--counters, 3), auto);
      justify-content: space-between;
      gap: var(--space-xl);
      margin: max(var(--space-2xl), calc(100 * var(--px, 0.0625rem))) 0 0;
    }

    .blog-hero__grid--split .blog-hero__counter {
      align-items: flex-start;
    }

    .blog-hero__grid--split .blog-hero__collage {
      max-inline-size: none;
    }

    .blog-hero__grid--split .blog-hero__cards {
      --cards-gap: 16.2cqi;
      --cards-shift: 16.2cqi;
      --cards-drop: 4.6cqi; /* 49px of 1052 */
      --cards-drop-2: 8.3cqi; /* 87px */
      row-gap: 10.5cqi; /* 111px */
      margin-block-end: 0;
    }

    /* Book 97 x 78 at (5, 240), award 63 x 83 at (623, 565) in the collage (Figma); the heart
       isn't in the final frame, so it fills the empty space beside the second card */
    .blog-hero__grid--split .blog-hero__deco--book {
      inset-block-start: 37.9%;
      inset-inline-start: 0.5%;
      inline-size: 9.2cqi;
    }

    .blog-hero__grid--split .blog-hero__deco--award {
      inset-block-start: 89.1%;
      inset-inline-start: 59.2%;
      inline-size: 6cqi;
    }

    .blog-hero__grid--split .blog-hero__deco--heart {
      display: block;
      inset-block-start: 24%;
      inset-inline-start: 89%;
      inline-size: 7.7cqi;
    }
  }

  /* Slow float and breathing: looping movements, so only with "Reveal sections on scroll" on
     (.motion-on) and when the visitor allows motion */
  @media (prefers-reduced-motion: no-preference) {
    .motion-on .blog-hero--float .blog-hero__cards > * {
      animation: blog-hero-float 7s ease-in-out infinite;
    }

    .motion-on .blog-hero--float .blog-hero__cards > :nth-child(2) {
      animation-duration: 8s;
      animation-delay: -2s;
    }

    .motion-on .blog-hero--float .blog-hero__cards > :nth-child(3) {
      animation-duration: 6.5s;
      animation-delay: -4s;
    }

    .motion-on .blog-hero--float .blog-hero__cards > :nth-child(4) {
      animation-duration: 7.5s;
      animation-delay: -1s;
    }

    .motion-on .blog-hero__deco {
      animation: blog-hero-breathe 5s ease-in-out infinite;
    }

    .motion-on .blog-hero__deco--award {
      animation-duration: 6s;
      animation-delay: -2s;
    }

    .motion-on .blog-hero__deco--heart {
      animation-duration: 5.5s;
      animation-delay: -3.5s;
    }
  }

  /* Breathing: grows a little and gets a touch stronger, then back */
  /* Pause button for the float and breathing (snippets/motion-pause.liquid): bottom corner of the collage */
  .blog-hero__pause {
    position: absolute;
    inset-block-end: -1rem; /* phones: clear of the last row of cards (card 3 ends ~11px above the collage's end) */
    inset-inline-start: 0;
    z-index: 2;
  }

  @keyframes blog-hero-breathe {
    0%,
    100% {
      scale: 1;
      opacity: 0.75;
    }

    50% {
      scale: 1.08;
      opacity: 1;
    }
  }

  @keyframes blog-hero-float {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -0.625rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog_hero",
  "tag": "section",
  "enabled_on": {
    "templates": ["blog"]
  },
  "blocks": [
    {
      "type": "_blog-stat-card"
    }
  ],
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:labels.show_breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Our blog"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.blog_hero_heading_info",
      "default": "Introduce your <em>blog</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "info": "t:labels.blog_hero_text_info",
      "default": "<p>Use this text to tell readers what your blog is about and what they can find here.</p><p>Add a second paragraph for more details, such as the topics you write about and how often you post new articles.</p>"
    },
    {
      "type": "header",
      "content": "t:labels.stat_cards",
      "info": "t:labels.blog_hero_cards_info"
    },
    {
      "type": "checkbox",
      "id": "float_cards",
      "label": "t:labels.float_cards",
      "info": "t:labels.float_cards_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.layout",
      "info": "t:labels.blog_hero_layout_info"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.section_width.narrow"
        },
        {
          "value": "wide",
          "label": "t:options.section_width.wide"
        },
        {
          "value": "widest",
          "label": "t:options.section_width.widest"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "widest"
    },
    {
      "type": "checkbox",
      "id": "fill_screen",
      "label": "t:labels.fill_screen",
      "info": "t:labels.fill_screen_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "scale_screen",
      "label": "t:labels.scale_screen",
      "info": "t:labels.scale_screen_info",
      "default": true
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "t:labels.text_scale",
      "info": "t:labels.text_scale_info",
      "min": 100,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 110,
      "visible_if": "{{ section.settings.scale_screen }}"
    },
    {
      "type": "header",
      "content": "t:labels.counters",
      "info": "t:labels.counters_info"
    },
    {
      "type": "text",
      "id": "articles_label",
      "label": "t:labels.articles_label",
      "default": "Articles"
    },
    {
      "type": "text",
      "id": "articles_value",
      "label": "t:labels.articles_value",
      "info": "t:labels.articles_value_info"
    },
    {
      "type": "text",
      "id": "authors_label",
      "label": "t:labels.authors_label",
      "default": "Authors"
    },
    {
      "type": "text",
      "id": "authors_value",
      "label": "t:labels.authors_value",
      "info": "t:labels.authors_value_info"
    },
    {
      "type": "text",
      "id": "topics_label",
      "label": "t:labels.topics_label",
      "default": "Topics"
    },
    {
      "type": "text",
      "id": "topics_value",
      "label": "t:labels.topics_value",
      "info": "t:labels.topics_value_info"
    },
    {
      "type": "header",
      "content": "t:labels.animation_header"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:labels.animation",
      "info": "t:labels.blog_hero_animation_info",
      "options": [
        {
          "value": "none",
          "label": "t:options.animation.none"
        },
        {
          "value": "fade-up",
          "label": "t:options.animation.fade_up"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "header",
      "content": "t:labels.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
