    },
    {
      "type": "select",
      "id": "image_animation",
      "label": "t:labels.image_animation",
      "options": [
        {
          "value": "none",
          "label": "t:options.animation.none"
        },
        {
          "value": "fade-up",
          "label": "t:options.animation.fade_up"
        },
        {
          "value": "zoom-in",
          "label": "t:options.animation.zoom_in"
        },
        {
          "value": "slide-top",
          "label": "t:options.animation.slide_top"
        },
        {
          "value": "slide-bottom",
          "label": "t:options.animation.slide_bottom"
        },
        {
          "value": "slide-left",
          "label": "t:options.animation.slide_left"
        },
        {
          "value": "slide-right",
          "label": "t:options.animation.slide_right"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "header",
      "content": "t:labels.background_image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.image",
      "info": "t:labels.trending_background_info"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "label": "t:labels.image_opacity",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:labels.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-5"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:labels.rows_animation",
      "info": "t:labels.animation_info",
      "options": [
        {
          "value": "none",
          "label": "t:options.animation.none"
        },
        {
          "value": "fade-up",
          "label": "t:options.animation.fade_up"
        },
        {
          "value": "zoom-in",
          "label": "t:options.animation.zoom_in"
        },
        {
          "value": "slide-top",
          "label": "t:options.animation.slide_top"
        },
        {
          "value": "slide-bottom",
          "label": "t:options.animation.slide_bottom"
        },
        {
          "value": "slide-left",
          "label": "t:options.animation.slide_left"
        },
        {
          "value": "slide-right",
          "label": "t:options.animation.slide_right"
        }
      ],
      "default": "slide-left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
