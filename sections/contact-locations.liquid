{%- comment -%}
  Contact locations (M8.1, Figma 170:108823; phones: design/inbox/contactpage/contact-mobile/
  Property 1=Variant14.png): the office cards and the social cards.
  - From 1440px: two columns. Left: "Visit our office", "Our global locations" and a panel of office
    cards. Right, a little lower: the centred "Find us online", "Connect on social" and the social
    cards in rows of 3 (a last row that is not full is centred, Figma 3 + 2).
  - Below 1440px (phone design, also tablets and small laptops): the social part first, then the
    offices. Social cards 3 per row, office cards 2 per row (a last one alone is centred); below 375px
    one per row.

  Each part's cards live in their own static block (Locations panel, Social cards), because a
  section's {% content_for 'blocks' %} outputs all its blocks in one place; static blocks let the
  merchant add and reorder cards in each part separately.
  The blocks are captured first: a part with no card is left out on the store (the theme editor shows
  it with a note). No card at all: no section on the store.
  No heading: a hidden h2 keeps the h3 card titles under a heading.
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'

  assign animation = section.settings.animation
  if section.index == 1
    assign animation = 'none'
  endif
-%}
{%- capture offices_html -%}{% content_for 'block', type: '_location-list', id: 'locations' %}{%- endcapture -%}
{%- capture social_html -%}{% content_for 'block', type: '_social-list', id: 'social' %}{%- endcapture -%}
{%- liquid
  assign show_offices = request.design_mode
  if offices_html contains 'class="location-card'
    assign show_offices = true
  endif
  assign show_social = request.design_mode
  if social_html contains 'class="social-card'
    assign show_social = true
  endif
-%}

{% render 'screen-scale' %}

{%- if show_offices or show_social -%}
  <div
    class="contact-locations full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}{% if section.settings.fill_screen %} section--fill-screen{% endif %}{% if section.settings.scale_screen %} section--screen-scale{% endif %}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;{% if section.settings.scale_screen %} --text-boost: {{ section.settings.text_scale | default: 110 | divided_by: 100.0 }};{% endif %}"
  >
    <animate-on-scroll class="contact-locations__inner">
      {%- if show_social -%}
        <div class="contact-locations__social">
          {%- if section.settings.social_eyebrow != blank or section.settings.social_heading != blank -%}
            <div
              class="contact-locations__titles contact-locations__titles--social"
              {% if animation != 'none' %}
                data-animate="fade-up"
              {% endif %}
            >
              {%- if section.settings.social_eyebrow != blank -%}
                <p class="eyebrow eyebrow--center">{{ section.settings.social_eyebrow | escape }}</p>
              {%- endif -%}
              {%- if section.settings.social_heading != blank -%}
                <h2 class="contact-locations__heading">{{ section.settings.social_heading }}</h2>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if section.settings.social_heading == blank -%}
            {%- assign hidden_heading = 'contact.locations.social_heading_hidden' | t -%}
            <h2 class="visually-hidden">{{ section.settings.social_eyebrow | default: hidden_heading | escape }}</h2>
          {%- endif -%}

          {{ social_html }}
        </div>
      {%- endif -%}

      {%- if show_offices -%}
        <div class="contact-locations__offices">
          {%- if section.settings.locations_eyebrow != blank or section.settings.locations_heading != blank -%}
            <div
              class="contact-locations__titles"
              {% if animation != 'none' %}
                data-animate="slide-left"
              {% endif %}
            >
              {%- if section.settings.locations_eyebrow != blank -%}
                <p class="eyebrow">{{ section.settings.locations_eyebrow | escape }}</p>
              {%- endif -%}
              {%- if section.settings.locations_heading != blank -%}
                <h2 class="contact-locations__heading">{{ section.settings.locations_heading }}</h2>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if section.settings.locations_heading == blank -%}
            {%- assign hidden_heading = 'contact.locations.heading_hidden' | t -%}
            <h2 class="visually-hidden">{{ section.settings.locations_eyebrow | default: hidden_heading | escape }}</h2>
          {%- endif -%}

          {{ offices_html }}
        </div>
      {%- endif -%}
    </animate-on-scroll>
  </div>
{%- endif -%}

{% stylesheet %}
  .contact-locations {
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  /* Below 1440px: social, then offices. Two columns from 1440px (Figma 546 + 64 + 1212) */
  .contact-locations__inner {
    display: grid;
    gap: var(--space-3xl);
    align-items: start;
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  @media (min-width: 1440px) {
    .contact-locations__inner {
      grid-template-columns: minmax(0, 546fr) minmax(0, 1212fr);
    }

    .contact-locations__offices {
      grid-column: 1;
      grid-row: 1;
    }

    /* The social column starts 68px lower than the offices (Figma eyebrows at y 162 and 230) */
    .contact-locations__social {
      grid-column: 2;
      grid-row: 1;
      padding-block-start: var(--space-3xl);
    }

    /*
      Figma: the social heading is centred at x 1209, ~56px left of the cards' middle (1265). The
      right padding shifts the centre left by half of it: 9.25% of 1212px ≈ 112px → 56px.
    */
    .contact-locations__titles--social {
      padding-inline-end: 9.25%;
    }
  }

  /* Red words (optional): made italic in the editor, shown upright in the accent colour */
  .contact-locations__heading {
    margin-block-start: var(--space-2xl); /* eyebrow → heading: ~42px (Figma 37 / 37) */
    font-size: var(--font-size-h2); /* 40px */
  }

  .contact-locations__heading em {
    font-style: normal;
    color: var(--color-accent);
  }

  .contact-locations__titles {
    margin-block-end: var(--space-lg); /* heading → offices panel: 22px */
  }

  .contact-locations__titles--social {
    margin-block-end: var(--space-2xl); /* heading → social cards: 55px */
    text-align: center;
  }

  /* The rules start at 0 and take only the free space (66px at most), so the label keeps its line */
  .contact-locations__titles--social .eyebrow::before,
  .contact-locations__titles--social .eyebrow::after {
    flex: 1 1 0;
    min-inline-size: 1rem;
    max-inline-size: 66px;
    inline-size: auto;
  }

  @media (max-width: 749px) {
    .contact-locations__inner {
      gap: var(--space-2xl);
    }

    .contact-locations__heading {
      margin-block-start: var(--space-sm);
    }

    .contact-locations__titles--social {
      margin-block-end: var(--space-lg);
    }
  }
{% endstylesheet %}

