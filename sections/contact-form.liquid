{%- comment -%}
  Contact (M8.1, Figma 170:108449 "Contact us", top of the page; phones: design/inbox/contactpage/
  contact-mobile/Property 1=contact.png): breadcrumb, then the intro and the form.
  Intro: eyebrow, H1 with red words, intro text, a round photo with a glass stat circle ("97%
  Satisfaction rate") over its edge and a "Live support" box with a pulsing dot. Form: the "Send a
  message" panel with Shopify's contact form.

  Layouts:
  - from 1200px: two columns (intro | form), the photo left of the circle, the box under the circle
  - 375–1199px (phone design, also tablets): one column; the box on the left, the circle and the photo
    on the right; the form fields 2 per row
  - below 375px: the photo and the circle on one row, the box under them, 1 field per row

  - Contact form: {% form 'contact' %} sends every field named contact[...] to the store's email
    (Settings > Notifications > Staff notifications > Contact form). contact[email] is required by
    Shopify; contact[body] is the message. The other names (First name, Topic...) are the headings
    the merchant sees in that email, so they come from the locale file and follow the shop language.
  - Errors: the script turns off the browser's own bubbles (novalidate) and writes a styled message
    under each field. Without JavaScript the browser's own check stays. After Shopify sends the page
    back with an error, the script puts back what the visitor typed (sessionStorage).
  - Topics: one comma-separated text setting, shown as pill-shaped radio buttons (none pre-selected).
  - Heading and text left empty: the page's own title and content (Admin > Online Store > Pages).
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'

  assign animation = section.settings.animation
  if section.index == 1
    assign animation = 'none'
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title | escape
  endif

  assign intro = section.settings.text
  if intro == blank
    assign intro = page.content
  endif

  assign breadcrumb_title = page.title | default: heading | strip_html

  assign topics = section.settings.topics | split: ','

  # ids: unique per section, so the page could hold two forms
  assign form_id = 'ContactForm-' | append: section.id
  assign error_id = form_id | append: '-error'
  assign success_id = form_id | append: '-success'

  # Field names = the headings in the merchant's email (assigned first: no filters inside attributes)
  assign name_first = 'contact.form.first_name' | t
  assign name_last = 'contact.form.last_name' | t
  assign name_topic = 'contact.form.topic' | t
  assign name_order = 'contact.form.order_number' | t
  # Not 'Subject': Shopify's staff email treats a field called Subject specially and printed its own
  # template text ("New customer message on %{creation_date}") as that field's heading
  assign name_subject = 'contact.form.subject_field' | t

  # Logged-in customers get their name filled in (the email is set inside the form, where `form` exists)
  assign value_first = customer.first_name
  assign value_last = customer.last_name

  assign has_stat = false
  if section.settings.stat_value != blank or section.settings.stat_label != blank
    assign has_stat = true
  endif

  assign has_support = false
  if section.settings.support_title != blank or section.settings.support_hours != blank
    assign has_support = true
  endif

  # The photo shows a placeholder in the theme editor only; on the live store an empty photo is left out
  assign show_photo = false
  if section.settings.image != blank or request.design_mode
    assign show_photo = true
  endif
-%}
{%- capture photo_loading -%}{%- render 'section-loading' -%}{%- endcapture -%}
{%- assign photo_loading = photo_loading | strip -%}

{% render 'screen-scale' %}

<div
  class="contact full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}{% if section.settings.fill_screen %} section--fill-screen{% endif %}{% if section.settings.scale_screen %} section--screen-scale{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;{% if section.settings.scale_screen %} --text-boost: {{ section.settings.text_scale | default: 110 | divided_by: 100.0 }};{% endif %}"
>
  <animate-on-scroll class="contact__inner">
    {%- if section.settings.show_breadcrumb -%}
      {% render 'breadcrumb', current: breadcrumb_title, class: 'contact__breadcrumb' %}
    {%- endif -%}

    <div class="contact__grid">
      <div
        class="contact__intro"
        {% if animation != 'none' %}
          data-animate="{{ animation }}"
        {% endif %}
      >
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow contact__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h1 class="contact__heading">{{ heading }}</h1>

        {%- if intro != blank -%}
          <div class="contact__text rte">{{ intro }}</div>
        {%- endif -%}

        {%- if show_photo or has_stat or has_support -%}
          <div class="contact__media{% unless show_photo %} contact__media--no-photo{% endunless %}">
            {%- if show_photo -%}
              {%- comment -%}
                Decorative: the heading and text say what the page is. Not the LCP (the H1 is), so no high
                priority. Sizes: 42% of the intro column from 1200px (about 20vw), else a fixed circle.
              {%- endcomment -%}
              {% render 'image',
                image: section.settings.image,
                class: 'contact__photo image--cover',
                alt: '',
                width: 960,
                height: 960,
                crop: 'center',
                sizes: '(min-width: 1200px) min(20vw, 36rem), (min-width: 750px) 12rem, (min-width: 375px) 6rem, 9rem',
                widths: '120, 200, 320, 480, 640, 960',
                loading: photo_loading
              %}
            {%- endif -%}

            {%- if has_stat -%}
              <p class="contact__stat">
                {%- if section.settings.stat_value != blank -%}
                  <span class="contact__stat-value">{{ section.settings.stat_value | escape }}</span>
                {%- endif -%}
                {%- if section.settings.stat_label != blank -%}
                  <span class="contact__stat-label">{{ section.settings.stat_label | escape }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}

            {%- if has_support -%}
              <div class="contact__support">
                {% render 'status-dot' %}
                <p class="contact__support-text">
                  {%- if section.settings.support_title != blank -%}
                    <span class="contact__support-title">{{ section.settings.support_title | escape }}</span>
                  {%- endif -%}
                  {%- if section.settings.support_hours != blank -%}
                    <span class="contact__support-hours">{{ section.settings.support_hours | escape }}</span>
                  {%- endif -%}
                </p>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <contact-form
        class="contact-form"
        {% if animation != 'none' %}
          data-animate="{{ animation }}"
          style="--animate-delay: 150ms;"
        {% endif %}
      >
        {%- if section.settings.form_heading != blank -%}
          <h2 class="h3 contact-form__title">{{ section.settings.form_heading | escape }}</h2>
        {%- endif -%}

        {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
          {%- comment -%} After an error, keep what the visitor typed; otherwise a logged-in customer's email {%- endcomment -%}
          {%- assign value_email = form.email | default: customer.email -%}
          {%- comment -%}
            After sending, Shopify reloads the page at this form (#id) with a success or error message.
            The script moves focus to that message, so screen readers announce it.
          {%- endcomment -%}
          {%- if form.posted_successfully? -%}
            <p
              class="form-message form-message--success contact-form__message"
              id="{{ success_id }}"
              tabindex="-1"
              data-focus-after-submit
            >
              {{- 'contact.form.success' | t -}}
            </p>
          {%- elsif form.errors -%}
            <div
              class="form-message form-message--error contact-form__message"
              id="{{ error_id }}"
              tabindex="-1"
              data-focus-after-submit
            >
              {{- form.errors | default_errors -}}
            </div>
          {%- endif -%}

          {%- if topics.size > 0 -%}
            <fieldset class="contact-form__topics">
              <legend class="contact-form__label">{{ 'contact.form.topic' | t }}</legend>
              <div class="contact-form__pills">
                {%- for topic in topics -%}
                  {%- assign topic_label = topic | strip -%}
                  {%- if topic_label != blank -%}
                    {%- assign topic_id = form_id | append: '-topic-' | append: forloop.index -%}
                    <input
                      class="visually-hidden contact-form__pill-input"
                      type="radio"
                      id="{{ topic_id }}"
                      name="contact[{{ name_topic }}]"
                      value="{{ topic_label | escape }}"
                    >
                    <label class="contact-form__pill" for="{{ topic_id }}">{{ topic_label | escape }}</label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          {%- comment -%}
            Each required field has a hidden error line under it. The script fills it from its
            data-missing / data-format text and links it to the field (aria-describedby).
          {%- endcomment -%}
          <div class="contact-form__fields">
            <div class="contact-form__field">
              <label class="contact-form__label" for="{{ form_id }}-first-name">{{ 'contact.form.first_name' | t }}</label>
              <input
                class="contact-form__input"
                type="text"
                id="{{ form_id }}-first-name"
                name="contact[{{ name_first }}]"
                value="{{ value_first | escape }}"
                placeholder="{{ 'contact.form.first_name_placeholder' | t }}"
                autocomplete="given-name"
                required
                data-validate
              >
              <p class="contact-form__error" id="{{ form_id }}-first-name-error" data-missing="{{ 'contact.form.error_first_name' | t | escape }}" hidden></p>
            </div>

            <div class="contact-form__field">
              <label class="contact-form__label" for="{{ form_id }}-last-name">{{ 'contact.form.last_name' | t }}</label>
              <input
                class="contact-form__input"
                type="text"
                id="{{ form_id }}-last-name"
                name="contact[{{ name_last }}]"
                value="{{ value_last | escape }}"
                placeholder="{{ 'contact.form.last_name_placeholder' | t }}"
                autocomplete="family-name"
                required
                data-validate
              >
              <p class="contact-form__error" id="{{ form_id }}-last-name-error" data-missing="{{ 'contact.form.error_last_name' | t | escape }}" hidden></p>
            </div>

            <div class="contact-form__field">
              <label class="contact-form__label" for="{{ form_id }}-email">{{ 'contact.form.email' | t }}</label>
              <input
                class="contact-form__input"
                type="email"
                id="{{ form_id }}-email"
                name="contact[email]"
                value="{{ value_email | escape }}"
                placeholder="{{ 'contact.form.email_placeholder' | t }}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                data-validate
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="{{ error_id }}"
                  data-server-error="{{ error_id }}"
                {% endif %}
              >
              <p
                class="contact-form__error"
                id="{{ form_id }}-email-error"
                data-missing="{{ 'contact.form.error_email' | t | escape }}"
                data-format="{{ 'contact.form.error_email_format' | t | escape }}"
                hidden
              ></p>
            </div>

            {%- if section.settings.show_order_number -%}
              <div class="contact-form__field">
                <label class="contact-form__label" for="{{ form_id }}-order">{{ 'contact.form.order_number_label' | t }}</label>
                <input
                  class="contact-form__input"
                  type="text"
                  id="{{ form_id }}-order"
                  name="contact[{{ name_order }}]"
                  placeholder="{{ 'contact.form.order_number_placeholder' | t }}"
                  autocomplete="off"
                >
              </div>
            {%- endif -%}

            <div class="contact-form__field contact-form__field--full">
              <label class="contact-form__label" for="{{ form_id }}-subject">{{ 'contact.form.subject' | t }}</label>
              <input
                class="contact-form__input"
                type="text"
                id="{{ form_id }}-subject"
                name="contact[{{ name_subject }}]"
                placeholder="{{ 'contact.form.subject_placeholder' | t }}"
                required
                data-validate
              >
              <p class="contact-form__error" id="{{ form_id }}-subject-error" data-missing="{{ 'contact.form.error_subject' | t | escape }}" hidden></p>
            </div>

            <div class="contact-form__field contact-form__field--full">
              <label class="contact-form__label" for="{{ form_id }}-message">{{ 'contact.form.message' | t }}</label>
              <textarea
                class="contact-form__input contact-form__textarea"
                id="{{ form_id }}-message"
                name="contact[body]"
                rows="4"
                placeholder="{{ 'contact.form.message_placeholder' | t }}"
                required
                data-validate
              >
                {{- form.body | escape -}}
              </textarea>
              <p class="contact-form__error" id="{{ form_id }}-message-error" data-missing="{{ 'contact.form.error_message' | t | escape }}" hidden></p>
            </div>
          </div>

          {%- assign submit_label = 'contact.form.send' | t -%}
          {% render 'explore-button', label: submit_label, tag: 'button', class: 'contact-form__submit' %}
        {%- endform -%}
      </contact-form>
    </div>
  </animate-on-scroll>
</div>

{% stylesheet %}
  /*
    Figma 1920 frame: content from x 49 to 1870, the intro column 886px and the form panel 899px with
    a 36px gap, both starting at the eyebrow (y 212). Sizes below are tokens with the Figma px next to them.
  */
  /*
    --px = one Figma pixel. With "Scale with the screen" the screen-scale class sets it from the screen
    width and height; without it, from the width only and never more than 1px, so the Figma sizes
    shrink on phones (with no value they fell back to 1px = the 1920px sizes).
  */
  .contact {
    --px: min(calc(100vw / 1920), 0.0625rem);
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
  }

  .contact.section--screen-scale {
    --px: min(calc(100vw / 1920), calc(100svh / 1031));
  }

  .contact__inner {
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .contact__breadcrumb {
    margin-block-end: var(--space-2xl); /* breadcrumb → eyebrow: 45px */
  }

  /* Phones and tablets: intro, then the form. Two columns from 1200px */
  .contact__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }

  @media (min-width: 1200px) {
    .contact__grid {
      grid-template-columns: minmax(0, 886fr) minmax(0, 899fr);
      gap: var(--space-xl); /* 36px */
    }
  }

  /* ---------- Intro ---------- */
  .contact__heading {
    margin-block-start: var(--space-2xl); /* eyebrow → H1: 42px */
  }

  /* Red words: made italic in the editor, shown upright in the accent colour (Figma "Always.") */
  .contact__heading em {
    font-style: normal;
    color: var(--color-accent);
  }

  .contact__text {
    margin-block-start: var(--space-xl); /* 33px */
    font-size: var(--font-size-body-lg); /* 22px, 35px lines */
    line-height: var(--line-height-body);
  }

  /* The Figma line length (857px) only on desktop: --px is small on phones (it made the text 174px wide) */
  @media (min-width: 1200px) {
    .contact__text {
      max-inline-size: max(36rem, calc(857 * var(--px, 0.0625rem)));
    }
  }

  /*
    Photo, stat circle and support box (desktop, from 1200px): two columns, the photo and the rest,
    30px apart. The stat circle starts back inside the photo column, so it covers the photo's right
    edge by 15.7% of the photo (Figma: photo 44-362, circle 312-518 = 50px of 318), and sits a little
    higher than the photo. The support box is under the circle and fills the rest of the column; its
    bottom lines up with the photo's bottom.
    The photo is 42cqi = 42% of the intro column (.contact__intro is a container).
  */
  .contact__intro {
    container-type: inline-size;
  }

  .contact__media {
    display: grid;
    margin-block-start: var(--space-2xl); /* 41px */
  }

  /* Two classes: the image snippet's .image / .image--cover set a height and load after this file */
  .contact__media .contact__photo {
    /* A fixed square, not aspect-ratio: the image inside would otherwise stretch it taller */
    inline-size: var(--contact-photo);
    block-size: var(--contact-photo);
    border-radius: 50%;
    overflow: hidden;
  }

  .contact__photo img,
  .contact__photo svg {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Frosted circle: the photo shows through it, blurred. Text sizes follow the circle (cqi). */
  .contact__stat {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    inline-size: var(--contact-stat);
    aspect-ratio: 1;
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, #ffffff);
    border-radius: 50%;
    background-color: var(--color-glass-strong);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
    color: var(--color-accent);
    text-align: center;
    container-type: inline-size;
  }

  .contact__stat-value {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    /*
      36% of the circle (74px in a 206px one). The Figma's 96px is Canela's narrow old-style digits;
      Newsreader's are wider, so at 96px "97%" ran past the circle's edges.
    */
    font-size: 36cqi;
    font-variant-numeric: oldstyle-nums;
    line-height: 1;
    /*
      Exact centring: the full width of the circle, centred; text-box trims the empty space the font
      keeps above and below the letters (old-style "97" is short, so it looked low in its line box).
      Browsers without text-box just keep the normal line box.
    */
    display: block;
    inline-size: 100%;
    text-align: center;
    text-box: trim-both cap alphabetic;
  }

  /* Whole words only: "SATISFACTION" is long, so the label may use most of the circle's width */
  .contact__stat-label {
    max-inline-size: 88%;
    overflow-wrap: normal;
    text-wrap: balance;
    margin-block-start: 4cqi;
    font-size: max(0.5rem, 8.7cqi); /* 18px in the 206px circle */
    font-weight: var(--font-weight-medium);
    line-height: 1.5;
    letter-spacing: var(--contact-stat-spacing, var(--letter-spacing-nav));
    text-transform: uppercase;
    /* Letter spacing also adds space after the last letter; the same space on the left re-centres it */
    padding-inline-start: var(--contact-stat-spacing, var(--letter-spacing-nav));
  }

  .contact__support {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-lg) var(--space-2xl) var(--space-lg) var(--space-lg);
    border: 1px solid var(--color-tint-border);
    border-radius: var(--radius-md);
    background-color: var(--color-tint-subtle);
  }

  .contact__support-text {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    font-size: var(--font-size-body-lg); /* 22px, 35px lines */
    line-height: var(--line-height-body);
  }

  .contact__support-title {
    font-weight: var(--font-weight-medium);
  }

  /* Below 375px: the photo and the circle on one row, the support box full width under them */
  @media (max-width: 374px) {
    .contact__media {
      --contact-photo: 9rem;
      --contact-stat: 6rem;
      grid-template-columns: var(--contact-photo) minmax(0, 1fr);
      row-gap: var(--space-md);
      margin-block-start: var(--space-lg);
    }

    .contact__media .contact__photo {
      grid-column: 1;
      grid-row: 1;
    }

    .contact__stat {
      grid-column: 2;
      grid-row: 1;
      margin-inline-start: calc(var(--contact-photo) * -0.2);
    }

    .contact__support {
      grid-column: 1 / -1;
    }
  }

  /*
    375–1199px (phone design, also tablets): the support box on the left, the circle and the photo on
    the right; the circle covers the photo's left edge and sits a little higher.
  */
  @media (min-width: 375px) and (max-width: 1199px) {
    .contact__media {
      --contact-photo: 6rem;
      --contact-stat: 4.75rem;
      --contact-stat-overlap: 0.3;
      --contact-stat-spacing: 0.04em;
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      column-gap: var(--space-sm);
      margin-block-start: var(--space-lg);
    }

    .contact__media .contact__photo {
      grid-column: 3;
      grid-row: 1;
      margin-block-start: calc(var(--contact-stat) * 0.25);
    }

    .contact__stat {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      margin-inline-end: calc(var(--contact-photo) * var(--contact-stat-overlap) * -1 - var(--space-sm));
    }

    .contact__support {
      grid-column: 1;
      grid-row: 1;
      gap: var(--space-xs);
      padding: var(--space-sm);
      border-radius: var(--radius-sm);
    }

    .contact__support-text {
      gap: 0;
      font-size: var(--font-size-small);
      line-height: 1.5;
    }
  }

  @media (min-width: 750px) and (max-width: 1199px) {
    .contact__media {
      --contact-photo: 12rem;
      --contact-stat: 9rem;
      --contact-stat-overlap: 0.22;
      --contact-stat-spacing: var(--letter-spacing-nav);
      column-gap: var(--space-lg);
      margin-block-start: var(--space-xl);
    }

    .contact__support {
      gap: var(--space-md);
      padding: var(--space-md) var(--space-lg);
    }

    .contact__support-text {
      font-size: var(--font-size-body);
    }
  }

  @media (min-width: 1200px) {
    .contact__media {
      --contact-photo: clamp(11rem, 42cqi, max(36rem, calc(560 * var(--px, 0.0625rem))));
      --contact-stat: calc(var(--contact-photo) * 0.648); /* 206px */
      grid-template-columns: var(--contact-photo) minmax(0, 1fr);
      column-gap: var(--space-xl); /* 30px */
    }

    .contact__media .contact__photo {
      grid-column: 1;
      grid-row: 1 / span 2;
      align-self: start;
      margin-block-start: calc(var(--contact-stat) * 0.136); /* 28px below the circle's top */
    }

    .contact__stat {
      grid-column: 2;
      grid-row: 1;
      margin-inline-start: calc(var(--contact-photo) * -0.157 - var(--space-xl)); /* over the photo's last 15.7% */
    }

    /* The margin keeps at least 32px under the circle */
    .contact__support {
      grid-column: 2;
      grid-row: 2;
      align-self: end;
      margin-block-start: var(--space-xl);
    }

    /* No photo: the circle and the box stack in one column, starting at the left */
    .contact__media--no-photo {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact__media--no-photo .contact__stat {
      grid-column: 1;
      margin-inline-start: 0;
    }

    .contact__media--no-photo .contact__support {
      grid-column: 1;
    }
  }

  /* Phones: less space between the parts (phone design) */
  @media (max-width: 749px) {
    .contact__breadcrumb {
      margin-block-end: var(--space-lg);
    }

    .contact__heading {
      margin-block-start: var(--space-sm);
    }

    .contact__text {
      margin-block-start: var(--space-md);
    }

    .contact__grid {
      gap: var(--space-lg);
    }
  }

  /* ---------- Form panel ---------- */
  .contact-form {
    display: block;
    padding: var(--space-md);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    background-color: var(--color-card);
    box-shadow: var(--shadow-card);
    container-type: inline-size;
  }

  @media (min-width: 750px) {
    .contact-form {
      padding: var(--space-xl);
    }
  }

  /* 34px top, 66px sides (Figma) from 1440px; less on small laptops, so the fields stay 2 per row */
  @media (min-width: 1440px) {
    .contact-form {
      padding: var(--space-xl) var(--space-3xl);
    }
  }

  /*
    Spacing with margins on our own elements, not gap on the form: Shopify's bot protection can inject
    an empty <div class="h-captcha"> into the form, and gap would add space around it too.
  */
  .contact-form__form > * {
    margin-block: 0;
  }

  .contact-form__message,
  .contact-form__topics {
    margin-block-end: var(--space-xl); /* 37px */
  }

  /* Shopify's answer after sending: a tinted box (red for an error, green for sent) */
  .contact-form__message {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid color-mix(in srgb, currentcolor 35%, transparent);
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, currentcolor 8%, transparent);
    font-weight: var(--font-weight-medium);
  }

  .contact-form__message .errors {
    margin: 0;
  }

  .contact-form__title {
    margin-block-end: var(--space-xl);
  }

  /* Small uppercase field captions (Figma "FIRST NAME", "TOPIC") */
  .contact-form__label {
    padding: 0;
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-nav);
    text-transform: uppercase;
  }

  .contact-form__topics {
    margin-inline: 0;
    padding: 0;
    border: 0;
  }

  .contact-form__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md); /* 17px */
    margin-block-start: var(--space-sm); /* 13px */
  }

  /* margin 0: the global form rule (label + input) would push each topic pill down */
  .contact-form__pills > * {
    margin: 0;
  }

  .contact-form__pill {
    display: inline-flex;
    align-items: center;
    min-block-size: max(2.5625rem, calc(41 * var(--px, 0.0625rem))); /* 41px */
    padding-inline: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-size: var(--font-size-body-sm);
    font-weight: inherit;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .contact-form__pill:hover,
  .contact-form__pill-input:checked + .contact-form__pill {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* The radio itself is hidden, so its keyboard focus ring is drawn on the pill */
  .contact-form__pill-input:focus-visible + .contact-form__pill {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /*
    One column in a very narrow panel (320px phones), two from 18rem of panel width (phone design:
    First / Last name and Email / Order number side by side). Figma 340 + 64 + 340 at 1920.
  */
  .contact-form__fields {
    display: grid;
    gap: var(--space-lg) var(--space-lg);
  }

  @container (min-width: 18rem) {
    .contact-form__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-form__field--full {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1440px) {
    .contact-form__fields {
      column-gap: var(--space-3xl);
    }
  }

  .contact-form__field {
    display: grid;
    align-content: start;
    gap: var(--space-2xs); /* label → field: 5px */
  }

  .contact-form__field > * {
    margin: 0;
  }

  /*
    Side by side fields share their rows (subgrid): when one label takes two lines ("ORDER NUMBER
    (OPTIONAL)" on a phone), the two inputs still start on the same line. Rows: label, input, error.
  */
  @supports (grid-template-rows: subgrid) {
    .contact-form__fields {
      row-gap: 0;
    }

    .contact-form__field {
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: var(--space-2xs);
      margin-block-end: var(--space-lg);
    }

    .contact-form__field > .contact-form__label {
      align-self: end;
    }

    .contact-form__field:last-child {
      margin-block-end: 0;
    }
  }

  /*
    Two classes on purpose: critical.css styles input[type='text'] (0,1,1), which beats one class.
    The pale Figma border is kept in one place (--contact-field-border) for the M9 contrast decision.
  */
  .contact-form .contact-form__input {
    --contact-field-border: var(--color-border);
    min-block-size: max(3.125rem, calc(50 * var(--px, 0.0625rem))); /* 50px */
    padding-inline: var(--space-lg);
    border-color: var(--contact-field-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-card);
    font-size: var(--font-size-caption);
  }

  .contact-form .contact-form__input:hover {
    border-color: color-mix(in srgb, var(--color-text) 40%, var(--color-background));
  }

  .contact-form .contact-form__input:focus-visible {
    border-color: var(--color-accent);
  }

  .contact-form .contact-form__input[aria-invalid='true'] {
    border-color: var(--color-error);
    background-color: color-mix(in srgb, var(--color-error) 4%, var(--color-card));
  }

  .contact-form .contact-form__textarea {
    min-block-size: max(6.625rem, calc(106 * var(--px, 0.0625rem))); /* 106px */
    padding-block: var(--space-md);
  }

  /* The theme's own error line (in place of the browser's bubble): a round "!" and the text */
  .contact-form__error {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
    color: var(--color-error);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
  }

  .contact-form__error[hidden] {
    display: none;
  }

  .contact-form__error::before {
    content: "!" / "";
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 1.1em;
    block-size: 1.1em;
    margin-block-start: 0.15em;
    border-radius: 50%;
    background-color: var(--color-error);
    color: #ffffff;
    font-size: 0.85em;
    line-height: 1;
  }

  /*
    Full width, so the paper plane must fly further than on a small pill to leave the button: the
    button is its own size container and the plane flies half its width (it starts near the middle).
  */
  .contact-form .contact-form__submit {
    --explore-fly: 55cqi;
    container-type: inline-size;
    inline-size: 100%;
    min-block-size: max(3.125rem, calc(56 * var(--px, 0.0625rem)));
    margin-block-start: var(--space-xl); /* 38px */
  }

  /* Phones (phone design): a compact panel, small captions, pills and fields */
  @media (max-width: 749px) {
    .contact-form__title {
      margin-block-end: var(--space-md);
      font-size: var(--font-size-body);
    }

    .contact-form__message,
    .contact-form__topics {
      margin-block-end: var(--space-lg);
    }

    .contact-form__label {
      font-size: 0.6875rem;
    }

    .contact-form__pills {
      gap: var(--space-xs);
      margin-block-start: var(--space-xs);
    }

    .contact-form__pill {
      min-block-size: 2rem;
      padding-inline: var(--space-xs);
      font-size: var(--font-size-small);
    }

    .contact-form__fields {
      column-gap: var(--space-sm);
    }

    @supports (grid-template-rows: subgrid) {
      .contact-form__field {
        margin-block-end: var(--space-md);
      }

      .contact-form__field:last-child {
        margin-block-end: 0;
      }
    }

    .contact-form .contact-form__input {
      min-block-size: 2.5rem;
      padding-inline: var(--space-sm);
      font-size: var(--font-size-small);
    }

    .contact-form .contact-form__textarea {
      min-block-size: 5rem;
      padding-block: var(--space-sm);
    }

    .contact-form .contact-form__submit {
      min-block-size: 2.75rem;
      margin-block-start: var(--space-lg);
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <contact-form>: the theme's own error lines in place of the browser's bubbles, and the typed
   * fields kept after Shopify sends the page back with an error.
   * - novalidate is set here, so without JavaScript the browser's own check stays.
   * - Submit: every required field is checked; each problem shows under its field (aria-invalid +
   *   aria-describedby) and focus goes to the first one. A marked field is checked again while the
   *   visitor types or leaves it, so the message goes away when it is correct.
   * - A valid submit saves the fields in sessionStorage; when the page comes back with an error they
   *   are put back (Shopify keeps only the email and the message). A sent message clears them.
   * - After sending, focus moves to Shopify's message one time (never on a normal page load, and
   *   without the autofocus attribute: Theme Store rule).
   */
  class ContactForm extends HTMLElement {
    connectedCallback() {
      this.form = this.querySelector('form');
      if (!this.form) return;

      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;

      this.form.noValidate = true;
      this.storageKey = `oroskin-contact:${this.form.id}`;

      // Only one time: the editor can move the section, and that connects the element again
      if (!this.started) {
        this.started = true;
        this.restore();
        this.querySelector('[data-focus-after-submit]')?.focus({ preventScroll: true });
      }

      this.form.addEventListener('submit', (event) => this.onSubmit(event), { signal });
      this.form.addEventListener('input', (event) => this.recheck(event), { signal });
      this.form.addEventListener('focusout', (event) => this.recheck(event), { signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
    }

    get fields() {
      return [...this.form.querySelectorAll('[data-validate]')];
    }

    problem(field) {
      const value = field.value.trim();
      if (field.required && !value) return 'missing';
      if (field.type === 'email' && value && field.validity.typeMismatch) return 'format';
      return null;
    }

    show(field, problem) {
      const line = document.getElementById(`${field.id}-error`);
      if (!line) return;
      const ids = (field.getAttribute('aria-describedby') || '').split(' ').filter((id) => id && id !== line.id);

      if (problem) {
        line.textContent = line.dataset[problem] || line.dataset.missing;
        line.hidden = false;
        field.setAttribute('aria-invalid', 'true');
        ids.push(line.id);
      } else {
        line.hidden = true;
        line.textContent = '';
        field.removeAttribute('aria-invalid');
        // Shopify's own error (Liquid links it after a server email error) no longer describes a correct field
        const server = field.dataset.serverError;
        if (server) {
          const index = ids.indexOf(server);
          if (index !== -1) ids.splice(index, 1);
          delete field.dataset.serverError;
        }
      }

      if (ids.length) field.setAttribute('aria-describedby', ids.join(' '));
      else field.removeAttribute('aria-describedby');
    }

    onSubmit(event) {
      const wrong = [];
      for (const field of this.fields) {
        const problem = this.problem(field);
        this.show(field, problem);
        if (problem) wrong.push(field);
      }

      if (wrong.length) {
        event.preventDefault();
        wrong[0].focus();
        return;
      }

      this.save();
    }

    recheck(event) {
      const field = event.target.closest?.('[data-validate]');
      if (field?.getAttribute('aria-invalid') === 'true') this.show(field, this.problem(field));
    }

    save() {
      const data = {};
      for (const element of this.form.elements) {
        if (!element.name?.startsWith('contact[')) continue;
        if (element.type === 'radio') {
          if (element.checked) data[element.name] = element.value;
        } else {
          data[element.name] = element.value;
        }
      }
      try {
        sessionStorage.setItem(this.storageKey, JSON.stringify(data));
      } catch (error) {
        // Storage can be blocked (private mode): the form still sends
      }
    }

    restore() {
      let data = null;
      try {
        if (this.querySelector('.form-message--error')) data = JSON.parse(sessionStorage.getItem(this.storageKey) || 'null');
        sessionStorage.removeItem(this.storageKey);
      } catch (error) {
        return;
      }
      if (!data) return;

      for (const element of this.form.elements) {
        if (!(element.name in data)) continue;
        if (element.type === 'radio') element.checked = element.value === data[element.name];
        else if (!element.value) element.value = data[element.name];
      }
    }
  }

  if (!customElements.get('contact-form')) customElements.define('contact-form', ContactForm);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.contact_form",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "checkbox",
