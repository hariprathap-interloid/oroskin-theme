{%- comment -%}
  Password page (M8.7, no Figma: the M5 pages' style). While the store is password protected
  (Online Store > Preferences), visitors land here. Theme Store: the logo or shop name, the store's
  password message (shop.password_message, set in Preferences) and the password form. A centred
  card on a soft background, with a link for the store owner to sign in to the admin.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'
-%}

<div class="password-page full-width color-{{ scheme_id }}">
  <div class="password-page__card">
    {%- comment -%} The logo as in the header: the image and the logo text together (or the shop name) {%- endcomment -%}
    {%- liquid
      assign has_logo_text = false
      if settings.logo_text != blank or settings.logo_text_accent != blank
        assign has_logo_text = true
      endif
      assign logo_alt = shop.name
      if has_logo_text
        assign logo_alt = ''
      endif
    -%}
    <p class="password-page__logo">
      {%- if settings.logo != blank -%}
        {%- assign logo_width_2x = settings.logo_width | times: 2 -%}
        {%- assign logo_sizes = settings.logo_width | append: 'px' -%}
        {{ settings.logo | image_url: width: logo_width_2x | image_tag: alt: logo_alt, sizes: logo_sizes, class: 'password-page__logo-image', loading: 'eager' }}
      {%- endif -%}
      {%- if has_logo_text -%}
        <span class="password-page__logo-text">
          {{- settings.logo_text | escape -}}
          {%- if settings.logo_text_accent != blank -%}<em>{{ settings.logo_text_accent | escape }}</em>{%- endif -%}
        </span>
      {%- elsif settings.logo == blank -%}
        <span class="password-page__logo-text">{{ shop.name | escape }}</span>
      {%- endif -%}
    </p>

    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow eyebrow--center password-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="password-page__heading">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading }}
      {%- else -%}
        {{ 'password.title' | t }}
      {%- endif -%}
    </h1>

    {%- if shop.password_message != blank -%}
      <p class="password-page__message">{{ shop.password_message | escape }}</p>
    {%- endif -%}

    {% form 'storefront_password', class: 'password-page__form' %}
      {%- if form.errors -%}
        <p class="password-page__error" role="alert" id="PasswordError">{{ 'password.wrong' | t }}</p>
      {%- endif -%}
      <label class="visually-hidden" for="PasswordInput">{{ 'password.password' | t }}</label>
      <div class="password-page__field">
        <input
          class="password-page__input"
          type="password"
          name="password"
          id="PasswordInput"
          placeholder="{{ 'password.password' | t | escape }}"
          autocomplete="current-password"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="PasswordError"
          {% endif %}
        >
        <button type="submit" class="button password-page__submit">{{ 'password.enter' | t }}</button>
      </div>
    {% endform %}

    <p class="password-page__owner">
      {{ 'password.owner' | t }}
      <a href="/admin">{{ 'password.owner_link' | t }}</a>
    </p>
  </div>

  <p class="password-page__powered">{{ powered_by_link }}</p>
</div>

{% stylesheet %}
  /*
    No Figma frame: the M5 look on a full screen: a soft accent background, a white card (radius,
    the card shadow) centred, the logo, a centred eyebrow, a heading-font h1 with an accent word,
    the message, one pill field with the button inside, a quiet owner link.
  */
  .password-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    min-block-size: 100svh;
    box-sizing: border-box;
    padding: var(--space-xl) var(--page-margin);
    background:
      radial-gradient(60% 50% at 20% 10%, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent 70%),
      radial-gradient(50% 40% at 85% 90%, color-mix(in srgb, var(--color-accent) 6%, transparent), transparent 70%),
      var(--color-background);
    color: var(--color-text);
  }

  .password-page__card {
    inline-size: min(100%, 36rem);
    box-sizing: border-box;
    padding: clamp(2rem, 1rem + 4vw, 3.5rem);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    background-color: var(--color-background);
    box-shadow: 0 20px 60px 0 #0000000f;
    text-align: center;
  }

  .password-page__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    margin: 0;
  }

  .password-page__logo-image {
    display: block;
    inline-size: auto;
    max-inline-size: 4rem;
    block-size: 3rem;
    object-fit: contain;
  }

  .password-page__logo-text {
    font-family: var(--font-heading--family);
    font-size: 2rem;
  }

  .password-page__logo-text em {
    color: var(--color-accent);
  }

  .password-page__eyebrow {
    margin-block-start: var(--space-xl);
  }

  .password-page__heading {
    margin: var(--space-md) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .password-page__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  .password-page__message {
    margin: var(--space-md) 0 0;
    font-size: var(--font-size-body);
    line-height: 1.7;
  }

  .password-page__form {
    margin-block-start: var(--space-xl);
  }

  .password-page__error {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
    font-size: var(--font-size-caption);
  }

  /* One pill: the field with the button inside (as the search fields) */
  /*
    A fixed-height pill; the field and the button fill it with the same 6px all round, so the button
    is always centred (no shadow inside the pill: it made the button look lower).
  */
  .password-page__field {
    display: flex;
    align-items: stretch;
    gap: var(--space-xs);
    block-size: 3.5rem;
    box-sizing: border-box;
    padding: 0.375rem 0.375rem 0.375rem var(--space-lg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-card);
  }

  .password-page__field:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .password-page .password-page__input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font-size: var(--font-size-body);
  }

  .password-page .password-page__input:focus-visible {
    outline: none;
  }

  .password-page .password-page__submit {
    flex: none;
    min-block-size: 0;
    margin: 0;
    padding-block: 0;
    padding-inline: var(--space-lg);
    box-shadow: none;
  }

  .password-page__owner {
    margin: var(--space-lg) 0 0;
    font-size: var(--font-size-caption);
  }

  .password-page__owner a {
    color: var(--color-accent);
  }

  .password-page__powered {
    margin: 0;
    font-size: var(--font-size-small);
  }

  .password-page__powered a {
    color: inherit;
  }

  @media (max-width: 479px) {
    .password-page__field {
      flex-direction: column;
      block-size: auto;
      padding: var(--space-sm);
      border-radius: var(--radius-md);
    }

    .password-page .password-page__input {
      min-block-size: 2.75rem;
      padding-inline: var(--space-sm);
    }

    .password-page .password-page__submit {
      min-block-size: 2.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "tag": "section",
  "class": "password-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Opening soon"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.password_heading_info",
      "default": "Something beautiful is <em>on its way.</em>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
