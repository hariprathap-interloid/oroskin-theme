{%- comment -%}
  About timeline (M8.4 part 4, design/briefs/about-us.md §4.4, exports "Default-3" to "Default-6",
  mobile "Variant45-3", "Variant46-2", "Variant47-2", "Variant48-1"): "Our journey" / "Seven years,
  slowly." and one Milestone block per step on a vertical rail.

  While the visitor scrolls, the rail fills in the accent colour down to a reading line (60% down
  the screen); milestones above that line are "reached" (full colour), the ones below stay faded
  until the line gets to them (Default-4). The script only runs with animations on and motion
  allowed; otherwise (and without JS) the whole rail is filled and every milestone in full colour.

  The blocks are rendered first and their HTML checked (a section can't read its theme blocks'
  settings): an empty Milestone renders nothing on the store; no milestone = no section on the
  store (the editor shows a note).
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'

  capture blocks_html
    content_for 'blocks'
  endcapture
  assign has_milestones = false
  if blocks_html contains 'class="milestone"'
    assign has_milestones = true
  endif
-%}

{% render 'screen-scale' %}

{%- if has_milestones or request.design_mode -%}
  <about-timeline
    class="about-timeline full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}{% if section.settings.scale_screen %} section--screen-scale{% endif %}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;{% if section.settings.scale_screen %} --text-boost: {{ section.settings.text_scale | default: 110 | divided_by: 100.0 }};{% endif %}"
  >
    <div class="about-timeline__inner">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <header class="about-timeline__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="about-timeline__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </header>
      {%- endif -%}
      {%- if section.settings.heading == blank -%}
        {%- comment -%} The milestone titles are h3: they need an h2 above them {%- endcomment -%}
        <h2 class="visually-hidden">{{ 'about.timeline_heading_hidden' | t }}</h2>
      {%- endif -%}

      {%- unless has_milestones -%}
        <p class="about-timeline__empty">{{ 'about.timeline_empty' | t }}</p>
      {%- endunless -%}

      {%- if blocks_html != blank -%}
        <div class="about-timeline__list">
          <span class="about-timeline__rail" aria-hidden="true">
            <span class="about-timeline__fill"></span>
          </span>
          {{ blocks_html }}
        </div>
      {%- endif -%}
    </div>
  </about-timeline>
{%- endif -%}

{% stylesheet %}
  /*
    Figma 1920 (Default-3): eyebrow y 155 (centred, rules both sides), heading ~66px y 210–275
    ("*Seven years*, slowly.": the accent words upright); first milestone ~85px under the heading.
    --rail-x / --content-x: the rail at x 237 and the content at x 301 (from the page's x 48).
  */
  .about-timeline {
    /* One Figma pixel; with "Scale with the screen" also limited by the screen height */
    --px: min(calc(100vw / 1920), 0.0625rem);

    display: block;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    background-color: var(--color-background);
  }

  .about-timeline.section--screen-scale {
    --px: min(calc(100vw / 1920), calc(100svh / 1031));
  }

  .about-timeline__inner {
    --rail-x: max(1.25rem, calc(189 * var(--px)));
    --content-x: max(3.5rem, calc(253 * var(--px)));

    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .about-timeline__header {
    margin-block-end: max(var(--space-xl), calc(45 * var(--px)));
    text-align: center;
  }

  .about-timeline__heading {
    margin: max(var(--space-lg), calc(40 * var(--px))) 0 0;
    font-size: max(2rem, calc(66 * var(--px)));
    line-height: 1.1;
  }

  /* Italic words: the accent colour, upright (as in the Figma) */
  .about-timeline__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  /*
    Without the script, each milestone draws its own rail piece (::before, from its top to its
    end). The last one stops a little under its marker (Default-4). The milestones are the list's
    children ("tag": null); "1 of .milestone" skips an editor note after the last one.
  */
  .about-timeline__list > .milestone:nth-last-child(1 of .milestone)::before {
    inset-block-end: auto;
    block-size: calc(var(--milestone-pad-top) + 4.5rem);
  }

  /*
    With the script (data-ready), one rail for the whole list replaces the milestones' own pieces:
    a pale track and the accent fill, like a progress bar. The script sets --rail-top /
    --rail-length (px, from just above the first marker to just past the last one) and --fill-px,
    easing it so the fill glides instead of jumping with the wheel. When the visitor stops scrolling
    partway through (is-waiting), a light sweeps down the fill three times as a hint to scroll on;
    scrolling hides it at once. It never loops for long (WCAG 2.2.2).
    --rail-lead: how far the rail starts above the first marker (px: the script reads it).
  */
  .about-timeline__list {
    --rail-lead: 0px;

    position: relative;
  }

  .about-timeline__rail {
    display: none;
  }

  .about-timeline[data-ready] .about-timeline__rail {
    position: absolute;
    z-index: 0;
    display: block;
    inset-block-start: var(--rail-top, 0px);
    inset-inline-start: calc(var(--rail-x) - 1px);
    inline-size: 2px;
    block-size: var(--rail-length, 0px);
    background-color: color-mix(in srgb, var(--color-accent) 15%, transparent);
    pointer-events: none;
  }

  /* The fill covers the whole rail and is cut to --fill-px (so the sweep isn't stretched) */
  .about-timeline__fill {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: var(--color-accent);
    clip-path: inset(0 0 calc(100% - var(--fill-px, 0px)) 0);
  }

  .about-timeline__fill::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      #ffffff00 0,
      color-mix(in srgb, var(--color-background) 70%, transparent) 4rem,
      #ffffff00 8rem
    );
    background-size: 100% 16rem;
    opacity: 0;
  }

  /* Three sweeps, fading in and out, then it rests (restarts the next time the visitor pauses) */
  .about-timeline__list.is-waiting .about-timeline__fill::after {
    animation:
      about-timeline-sweep 1.2s linear 3,
      about-timeline-sweep-fade 3.6s ease-in-out forwards;
  }

  @keyframes about-timeline-sweep {
    to {
      background-position: 0 16rem;
    }
  }

  @keyframes about-timeline-sweep-fade {
    15%,
    80% {
      opacity: 1;
    }

    to {
      opacity: 0;
    }
  }

  .about-timeline__empty {
    margin: 0 0 var(--space-lg);
    font-style: italic;
    text-align: center;
  }

  /*
    Phones and tablets (Variant45-3 at 375px, tablets the same layout a little bigger): the rail
    near the left edge, the content next to it, the year at the right. The rail starts ~20px above
    the first marker (Variant45-3).
  */
  @media (max-width: 1199px) {
    .about-timeline__inner {
      --rail-x: 0.5rem;
      --content-x: 2.5rem;
    }

    .about-timeline__list {
      --rail-lead: 20px;
    }

    .about-timeline__header {
      margin-block-end: var(--space-2xl);
    }

    .about-timeline__heading {
      margin-block-start: var(--space-md);
      font-size: 2.25rem;
    }
  }

  @media (max-width: 749px) {
    .about-timeline__inner {
      --rail-x: 0.375rem;
      --content-x: 1.875rem;
    }

    .about-timeline__header {
      margin-block-end: var(--space-xl);
    }

    .about-timeline__heading {
      font-size: 1.625rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <about-timeline>: fills the rail while the visitor scrolls.
   *
   * The reading line is 60% down the screen. measure() places one rail from just above the first
   * marker (--rail-lead) to just past the last one and notes where each marker sits on it (px from
   * the list's top: these don't change while scrolling). Each frame, the target is how much of the
   * rail lies above the reading line; the drawn fill moves a share of the way there (easing), so it
   * glides instead of jumping with each wheel step. A milestone is reached (full colour) once the
   * fill gets to its marker, so markers light up as the line arrives.
   * Off (nothing happens, so all is full colour): animations off (also in the theme editor) or
   * reduced motion. A change of the reduced-motion setting while on the page stops (stop()) or
   * starts (start()) it. Listeners are on AbortControllers: one for the element (the editor
   * re-attaches a moved section, so connectedCallback can run again), one for the running effect.
   */
  class AboutTimeline extends HTMLElement {
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;

      this.list = this.querySelector('.about-timeline__list');
      this.milestones = [...this.querySelectorAll('.milestone')];
      const animations = document.documentElement.classList.contains('animations-on');
      if (!this.list || !this.milestones.length || !animations) return;

      this.motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
      this.motion.addEventListener('change', () => (this.motion.matches ? this.start() : this.stop()), { signal });
      if (this.motion.matches) this.start();
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.stop();
    }

    start() {
      if (this.running) return;
      this.running = new AbortController();
      const { signal } = this.running;

      this.drawn = 0;
      this.onScroll = () => this.requestTick();

      this.visibility = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        if (entry.isIntersecting) {
          window.addEventListener('scroll', this.onScroll, { passive: true, signal });
          this.requestTick();
        } else {
          window.removeEventListener('scroll', this.onScroll);
          this.setWaiting(false);
        }
      });

      // Text reflow (resize, fonts loading) moves the markers: measure again
      this.resizer = new ResizeObserver(() => {
        this.measure();
        this.requestTick();
      });

      this.setAttribute('data-ready', '');
      this.measure();
      this.resizer.observe(this.list);
      this.visibility.observe(this);
    }

    /** Back to the still state: full rail, every milestone in full colour, no sweep */
    stop() {
      if (!this.running) return;
      this.running.abort();
      this.running = null;
      this.visibility?.disconnect();
      this.resizer?.disconnect();
      if (this.frame) cancelAnimationFrame(this.frame);
      this.frame = null;
      clearTimeout(this.waitTimer);
      this.visible = false;
      this.removeAttribute('data-ready');
      this.list.classList.remove('is-waiting');
      this.milestones.forEach((milestone) => milestone.classList.remove('is-reached'));
    }

    // The hint shows only after the visitor has paused for a moment, partway through the rail
    setWaiting(waiting) {
      clearTimeout(this.waitTimer);
      if (!waiting) {
        this.list.classList.remove('is-waiting');
        return;
      }
      this.waitTimer = setTimeout(() => {
        const partway = this.drawn > 0 && this.drawn < this.railLength;
        this.list.classList.toggle('is-waiting', Boolean(this.visible) && partway);
      }, 800);
    }

    measure() {
      const listTop = this.list.getBoundingClientRect().top;
      this.markers = this.milestones.map((milestone) => {
        const marker = milestone.querySelector('.milestone__marker');
        const box = (marker || milestone).getBoundingClientRect();
        return { milestone, size: box.height, middle: box.top + box.height / 2 - listTop };
      });

      const lead = parseFloat(getComputedStyle(this.list).getPropertyValue('--rail-lead')) || 0;
      const first = this.markers[0];
      const last = this.markers[this.markers.length - 1];
      this.railTop = Math.max(first.middle - lead, 0);
      this.railLength = last.middle + last.size * 2 - this.railTop;
      this.list.style.setProperty('--rail-top', `${this.railTop}px`);
      this.list.style.setProperty('--rail-length', `${this.railLength}px`);
    }

    requestTick() {
      if (this.frame || !this.running) return;
      this.frame = requestAnimationFrame(() => {
        this.frame = null;
        this.tick();
      });
    }

    tick() {
      const line = window.innerHeight * 0.6;
      const railStart = this.list.getBoundingClientRect().top + this.railTop;
      const target = Math.min(Math.max(line - railStart, 0), this.railLength);

      // Move 15% of the remaining distance each frame; snap when it's under half a pixel
      const gap = target - this.drawn;
      this.drawn = Math.abs(gap) < 0.5 ? target : this.drawn + gap * 0.15;

      this.list.style.setProperty('--fill-px', `${this.drawn.toFixed(1)}px`);

      const reached = this.railTop + this.drawn;
      this.markers.forEach(({ milestone, middle }) => {
        milestone.classList.toggle('is-reached', middle <= reached + 0.5);
      });

      if (this.drawn !== target) {
        this.setWaiting(false);
        this.requestTick();
      } else {
        this.setWaiting(true);
      }
    }
  }

  if (!customElements.get('about-timeline')) customElements.define('about-timeline', AboutTimeline);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.about_timeline",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "blocks": [{ "type": "_milestone" }],
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Our journey"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.italic_accent_info",
      "default": "<em>Our story</em>, step by step."
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.section_width.narrow"
        },
        {
          "value": "wide",
          "label": "t:options.section_width.wide"
        },
        {
          "value": "widest",
          "label": "t:options.section_width.widest"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "widest"
    },
    {
      "type": "checkbox",
      "id": "scale_screen",
      "label": "t:labels.scale_screen",
      "info": "t:labels.about_scale_screen_info",
      "default": true
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "t:labels.text_scale",
      "info": "t:labels.about_text_scale_info",
      "min": 100,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 110,
      "visible_if": "{{ section.settings.scale_screen }}"
    },
    {
      "type": "header",
      "content": "t:labels.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "t:general.about_timeline",
      "blocks": [
        {
          "type": "_milestone",
          "settings": {
            "year": "Year",
            "pill": "The beginning",
            "title": "Describe this milestone",
            "stat_value": "100",
            "stat_label": "Describe what this number shows"
          }
        },
        {
          "type": "_milestone",
          "settings": {
            "year": "Year",
            "pill": "The next step",
            "title": "Add your next milestone",
            "stat_value": "100+",
            "stat_label": "Describe what this number shows"
          }
        },
        {
          "type": "_milestone",
          "settings": {
            "year": "Year",
            "pill": "Today",
            "title": "Add a recent milestone",
            "stat_value": "100%",
            "stat_label": "Describe what this number shows"
          }
        }
      ]
    }
  ]
}
{% endschema %}
