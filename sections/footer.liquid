{%- liquid
  # Logo: same global settings as the header (Theme settings -> Logo). The footer is far below the fold,
  # so the image is lazy-loaded here (the header's copy is eager).
  if settings.logo != blank
    assign logo_width_2x = settings.logo_width | times: 2
    assign logo_widths = settings.logo_width | append: ', ' | append: logo_width_2x
    assign logo_sizes = settings.logo_width | append: 'px'
  endif

  assign has_logo_text = false
  if settings.logo_text != blank or settings.logo_text_accent != blank
    assign has_logo_text = true
  endif
  assign logo_alt = shop.name
  if has_logo_text
    assign logo_alt = ''
  endif

  # Text logo size factor: long names get smaller (the same rule as the header)
  capture logo_text_scale
    render 'logo-text-scale'
  endcapture
  assign logo_text_scale = logo_text_scale | strip

  # Copyright: the sentence lives in the locale file, the year and shop name are passed in.
  # No | escape on the name: t already escapes its output (keys without _html), escaping twice
  # would turn "Bob & Co" into "Bob &amp;amp; Co".
  assign current_year = 'now' | date: '%Y'

  # One column per top-level item of the footer menu (Shop, Company, Support...).
  # At least 1 so the CSS never gets repeat(0, ...).
  assign menu_count = section.settings.menu.links.size | default: 0
  assign column_count = menu_count | at_least: 1

  # Desktop tracks (1200px+), measured at 1920: brand 2fr | the menu (1fr per column, one <nav>) | newsletter
  # 1.5fr. Built here so a missing menu or newsletter leaves no empty track.
  assign desktop_tracks = 'minmax(0, 2fr)'
  if menu_count > 0
    assign desktop_tracks = desktop_tracks | append: ' minmax(0, ' | append: menu_count | append: 'fr)'
  endif
  if section.settings.show_newsletter
    assign desktop_tracks = desktop_tracks | append: ' minmax(0, 1.5fr)'
  endif

  # Dark background (red, dark schemes; color_brightness: 0 = black, 255 = white): the white glass would
  # make a mid-grey panel with poor contrast, so .footer--dark uses a dark glass (CSS below), and the link
  # grey takes more of the text colour to stay at 4.5:1.
  assign link_mix = 70
  assign footer_tone = ''
  assign scheme_brightness = section.settings.color_scheme.settings.background | color_brightness
  if scheme_brightness < 128
    assign link_mix = 85
    assign footer_tone = ' footer--dark'
  endif

  # Wordmark size: the word must fit the panel, also for a long shop name or capitals. Its width is
  # estimated in em: capitals 0.72, spaces 0.28, other characters 0.42 ("OroSkin" = 3.54em estimated,
  # 3.22em measured). 100 / that width, in cqi (% of the panel's inner width), fills about 90%; at 1920
  # this is ~490px, the Figma's ~500px, and min() in the CSS keeps 500px as the largest size.
  # A for loop stops after 50 items, so characters after the 50th count as 0.5em.
  if has_logo_text
    assign wordmark_text = settings.logo_text | append: settings.logo_text_accent
  else
    assign wordmark_text = shop.name
  endif
  assign wordmark_chars = wordmark_text | split: ''
  assign wordmark_em = 0.0
  for wordmark_char in wordmark_chars limit: 50
    assign wordmark_char_lower = wordmark_char | downcase
    if wordmark_char == ' '
      assign wordmark_em = wordmark_em | plus: 0.28
    elsif wordmark_char != wordmark_char_lower
      assign wordmark_em = wordmark_em | plus: 0.72
    else
      assign wordmark_em = wordmark_em | plus: 0.42
    endif
  endfor
  assign wordmark_extra = wordmark_chars.size | minus: 50 | at_least: 0 | times: 0.5
  assign wordmark_em = wordmark_em | plus: wordmark_extra | at_least: 1
  assign wordmark_size = 100.0 | divided_by: wordmark_em | round: 2
-%}

<footer
  class="footer full-width color-{{ section.settings.color_scheme.id }}{{ footer_tone }}"
  style="--logo-width: {{ settings.logo_width }}px; --logo-text-size: {{ settings.logo_text_size }}px; --logo-text-scale: {{ logo_text_scale }}; --footer-columns: {{ column_count }}; --footer-tracks: {{ desktop_tracks }}; --footer-link-mix: {{ link_mix }}%; --wordmark-size: {{ wordmark_size }}cqi; --nav-underline: url('{{ 'nav-underline.svg' | asset_url }}');"
>
  <div class="footer__panel">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href="{{ routes.root_url }}">
          {%- if settings.logo != blank -%}
            {{
              settings.logo
              | image_url: width: logo_width_2x
              | image_tag:
                class: 'footer__logo-image',
                widths: logo_widths,
                sizes: logo_sizes,
                loading: 'lazy',
                alt: logo_alt
            }}
          {%- endif -%}
          {%- if has_logo_text -%}
            <span class="footer__logo-text logo-text-fit">
              {{- settings.logo_text | escape -}}
              {%- if settings.logo_text_accent != blank -%}<em>{{ settings.logo_text_accent | escape }}</em>{%- endif -%}
            </span>
          {%- elsif settings.logo == blank -%}
            <span class="footer__logo-text logo-text-fit">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>

        {%- if section.settings.tagline != blank -%}
          <div class="footer__tagline">{{ section.settings.tagline }}</div>
        {%- endif -%}

        {% render 'social-icons' %}
      </div>

      {%- comment -%}
        One nested menu builds all the columns: each top-level item ("Shop") is a column heading and
        its sub-items ("All Products", "Skincare"...) are the links underneath. A top-level item with no
        sub-items becomes a column with just that one link, so nothing the merchant adds disappears.
        One <nav> around all the columns, so screen reader users can jump to the footer menu.
      {%- endcomment -%}
      {%- if menu_count > 0 -%}
      <nav class="footer__nav" aria-label="{{ 'footer.menu' | t }}">
      {%- for column in section.settings.menu.links -%}
        <div class="footer__column">
          {%- if column.links.size > 0 -%}
            <h2 class="footer__heading">{{ column.title | escape }}</h2>
            <ul class="footer__links" role="list">
              {%- for link in column.links -%}
                <li>
                  <a
                    class="footer__link"
                    href="{{ link.url }}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <ul class="footer__links" role="list">
              <li>
                <a
                  class="footer__link"
                  href="{{ column.url }}"
                  {% if column.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- column.title | escape -}}
                </a>
              </li>
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
      </nav>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="footer__column footer__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="footer__heading">{{ section.settings.newsletter_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <div class="footer__newsletter-text">{{ section.settings.newsletter_text }}</div>
          {%- endif -%}
          {% render 'newsletter-form', id_prefix: 'footer' %}
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      {%- comment -%}
        powered_by_link is Shopify's own "Powered by Shopify" link. The Theme Store wants it left as it is;
        it already carries rel="nofollow" (search engines shouldn't treat it as a vote for shopify.com).
      {%- endcomment -%}
      <p class="footer__copyright">
        {{- 'footer.copyright' | t: year: current_year, shop: shop.name }}
        {{ powered_by_link -}}
      </p>

      <div class="footer__utilities">
        {% render 'localization-form', id_prefix: 'footer' %}

        {%- comment -%}
          Follow on Shop: Shopify's branded button that lets a customer follow the store in the Shop app.
          Only when the store supports it (Shop Pay on, store in a supported region) and the setting is on.
          The Theme Store forbids changing its colours, so it gets no styling here except its position.
        {%- endcomment -%}
        {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
          <div class="footer__follow-on-shop">
            {{ shop | login_button: action: 'follow' }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          {%- comment -%}
            Each payment icon is an <svg role="img"> with a <title> ("Visa"), so it already has a name.
            The list gets a hidden heading so screen readers hear what the icons are about.
          {%- endcomment -%}
          <div class="footer__payment">
            <span class="visually-hidden" id="FooterPaymentLabel">{{ 'footer.payment_methods' | t }}</span>
            <ul class="footer__payment-list" role="list" aria-labelledby="FooterPaymentLabel">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.legal_menu.links.size > 0 -%}
        <nav class="footer__legal" aria-label="{{ 'footer.legal_menu' | t }}">
          <ul class="footer__legal-list" role="list">
            {%- for link in section.settings.legal_menu.links -%}
              <li>
                <a
                  class="footer__link"
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- if section.settings.show_wordmark -%}
      {%- comment -%}
        Decorative giant wordmark, cut off by the bottom of the panel. aria-hidden: a screen reader has
        already heard the shop name in the logo, it shouldn't hear it again as a huge word.
        The letters are CSS content (::before / ::after from the data attributes), not text in the HTML:
        WCAG does not ask contrast for pure decoration, but contrast checkers (Lighthouse / axe) test every
        text node and would fail the faded 20% letters. Generated content is not tested.
      {%- endcomment -%}
      {%- liquid
        if has_logo_text
          assign wordmark_word = settings.logo_text
          assign wordmark_accent = settings.logo_text_accent
        else
          assign wordmark_word = shop.name
          assign wordmark_accent = ''
        endif
      -%}
      <div class="footer__wordmark-area">
        <p class="footer__wordmark" aria-hidden="true">
          <span
            class="footer__wordmark-text"
            data-word="{{ wordmark_word | escape }}"
            data-accent="{{ wordmark_accent | escape }}"
          ></span>
        </p>
        {%- comment -%} The word floats without end: a pause button (WCAG 2.2.2), outside the aria-hidden word {%- endcomment -%}
        {%- render 'motion-pause',
          label: 'sections.footer.wordmark_pause',
          target: '.footer__wordmark-area',
          class: 'footer__wordmark-pause'
        -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  /*
    Only .footer__* classes here, no element selectors like "footer a": those beat BEM classes on
    specificity (the header had that bug in M2.2).

    Sizes measured from the design screenshot at 1920 wide (design/figma/components/footer/screenshot.png):
    panel 1822 x 806, 50px from each side, radius 50px, 50px inner padding, ~45px below it.
    The section's colour scheme class paints the strip around the panel; the panel is a glass card.
  */
  .footer {
    /*
      Link grey: the Figma's #787878 is only 4.2:1 on cream (body text needs 4.5:1). Mixing the scheme's
      text into its background gives the same soft grey look at 6:1 on cream, and it follows every colour
      scheme. --footer-link-mix (70% or 85%) is set in the Liquid above from the background's brightness.
    */
    --footer-link-color: color-mix(in srgb, var(--color-text) var(--footer-link-mix, 70%), var(--color-background));

    padding-block: var(--space-section) var(--space-2xl);
  }

  /*
    Dark background (.footer--dark, set in the Liquid from the scheme's brightness). The theme's white glass
    (25% white) turns a dark background into a mid grey, where the accent headings, the social icons and
    the email text fall under 4.5:1. Here the glass is a light veil of the text colour instead, and the
    social buttons, the email field and the country / language pills use the scheme's raised surface
    (snippets/css-variables.liquid), so they show clearly on the panel. Light schemes keep the white glass.
  */
  .footer--dark {
    --color-glass: color-mix(in srgb, var(--color-text) 8%, transparent);
    --color-glass-strong: var(--color-surface-raised);
  }

  /* The pickers' pill uses --color-glass at rest (snippets/localization-form): on dark, the raised surface too */
  .footer--dark .localization__toggle {
    background-color: var(--color-surface-raised);
  }

  /*
    Full width: the "full-width" class on <footer> (critical.css) lets it span the whole viewport instead
    of Skeleton's page-width column. The panel is then centred with margin-inline: auto and is as wide as
    the viewport minus the Figma's edge gap (16px on phones -> 50px at 1920, so 1822px wide at 1920).

    No overflow: hidden on the panel: it would also cut off the country/language list, which opens
    upwards from the bottom row. The wordmark clips itself instead (below).
  */
  .footer__panel {
    --footer-edge: clamp(var(--space-md), 2.6vw, 3.125rem);

    position: relative;
    container-type: inline-size; /* the wordmark's size is a share of the panel's width (cqi) */
    inline-size: calc(100% - var(--footer-edge) * 2);
    margin-inline: auto;
    padding-block-start: clamp(var(--space-2xl), 3.4vw, var(--space-3xl)); /* -> 64px */
    padding-inline: clamp(var(--space-lg), 2.6vw, 3.125rem); /* -> 50px */
    border-radius: var(--radius-lg);
    background-color: var(--color-glass);
    box-shadow: var(--shadow-collection), var(--shadow-glass-edge);
    /*
      No backdrop-filter here: nothing scrolls behind the panel (it sits on the section's flat colour), so a
      blur changes nothing you can see. It also caused a dark band on phones: when the panel's top goes
      past the top of the screen, the blur has no pixels there and fills them with dark, and the header's
      own blur then shows that band. (Like the header pill, the panel is still a see-through glass colour.)
    */
  }

  /*
    Top row. Phones and tablets: one column (brand, then the menu, then the newsletter).
    Desktop (1200px+), measured at 1920: brand ~490px, each menu ~245px, newsletter ~370px, 32px gaps, so
    2fr | 1fr per menu column | 1.5fr; --footer-tracks is built in the Liquid (no empty track).
  */
  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl) var(--space-xl);
  }

  /* The menu columns: 2 per row on phones, all in one row from 750px */
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xl) var(--space-xl);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xl); /* logo -> tagline -> social icons, ~48px apart */
  }

  .footer__logo {
    display: inline-flex;
    max-inline-size: 100%; /* a long logo text stays in the brand column (cut with …) */
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text);
    text-decoration: none;
  }

  .footer__logo-image {
    flex-shrink: 0;
    inline-size: var(--logo-width);
    max-block-size: 4rem;
    block-size: auto;
    object-fit: contain;
  }

  .footer__logo-text {
    font-family: var(--font-logo--family);
    font-weight: var(--font-logo--weight);
    font-size: calc(var(--logo-text-size) * var(--logo-text-scale, 1));
    line-height: 1;
  }

  .footer__logo-text em {
    font-style: italic;
  }

  .footer__logo-text em {
    color: var(--color-accent);
  }

  /* Tagline: body font, full text colour, 22px (Figma), about 450px wide */
  .footer__tagline {
    max-inline-size: 28rem;
    color: var(--color-text);
    font-size: var(--font-size-body-lg);
    line-height: 1.45;
  }

  .footer__tagline > :first-child,
  .footer__newsletter-text > :first-child {
    margin-block-start: 0;
  }

  .footer__tagline > :last-child,
  .footer__newsletter-text > :last-child {
    margin-block-end: 0;
  }

  /* Column heading: the Figma's red uppercase label, ~40px above the first link */
  .footer__heading {
    margin-block: 0 2.5rem;
    color: var(--color-accent);
    font-family: var(--font-body--family);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .footer__links,
  .footer__legal-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__links {
    display: grid;
    gap: 1.25rem; /* 20px between links (53px from line to line in the Figma) */
  }

  /* Links: heading (serif) font in the softer grey, accent colour on hover and for the current page */
  .footer__link {
    color: var(--footer-link-color);
    font-family: var(--font-heading--family);
    font-size: var(--font-size-body);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__link:hover,
  .footer__link[aria-current='page'] {
    color: var(--color-accent);
  }

  /*
    Column links: the header's hand-drawn underline (assets/nav-underline.svg) appears on hover, keyboard
    focus and the current page. Same technique as the header: an empty ::after box painted in currentColor
    (so it's red with the text) and cut to the SVG's shape with a CSS mask. --nav-underline is set on
    <footer> in the Liquid above, because asset_url can't run inside this stylesheet.
    It draws in from the left (scaleX 0 -> 1); with reduced motion it simply appears.
  */
  .footer__links .footer__link {
    position: relative;
    display: inline-block;
  }

  /*
    One size for every link (it used to be 65% of each word, stretched: "About" and "Blog" got different
    swooshes): the SVG's own proportions (97:16, "contain"), starting at the word's left edge (Figma)
  */
  .footer__links .footer__link::after {
    content: '';
    position: absolute;
    inset-inline-start: -0.1em;
    inset-block-start: calc(100% + 0.2rem);
    inline-size: 3.5rem;
    aspect-ratio: 97 / 16;
    background-color: currentcolor;
    mask: var(--nav-underline) left center / contain no-repeat;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .footer__links .footer__link:hover::after,
  .footer__links .footer__link:focus-visible::after,
  .footer__links .footer__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__links .footer__link::after {
      transition: none;
    }
  }

  /* Figma: ~58px from the newsletter text down to the email field */
  .footer__newsletter .newsletter-form {
    margin-block-start: 3.5rem;
  }

  .footer__newsletter-text {
    max-inline-size: 24rem;
    color: var(--footer-link-color);
    font-family: var(--font-heading--family);
    font-size: var(--font-size-body);
    line-height: 1.35;
  }

  /* Bottom row: 1px divider, then copyright | pickers + payment icons | legal links */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
    margin-block-start: 3.5rem; /* ~55px under the last link */
    padding-block: var(--space-lg);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--font-size-caption);
  }

  .footer__copyright {
    margin: 0;
    color: var(--color-text);
  }

  .footer__utilities {
    display: flex;
    flex-wrap: wrap;
    min-inline-size: 0;
    max-inline-size: 100%; /* phones: the stacked row is never wider than the panel (long country names) */
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }

  .footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__payment-icon {
    display: block;
  }

  /* Only placed in the row: the button's own colours and look are Shopify's and must not change */
  .footer__follow-on-shop {
    display: flex;
    align-items: center;
  }

  /* "Powered by Shopify" sits after the copyright in the same colour */
  .footer__copyright a {
    color: inherit;
  }

  .footer__legal-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .footer__legal-list .footer__link {
    color: var(--color-text);
    font-family: var(--font-body--family);
    font-size: var(--font-size-caption);
  }

  .footer__legal-list .footer__link:hover,
  .footer__legal-list .footer__link[aria-current='page'] {
    color: var(--color-accent);
  }

  /*
    The Figma's small light dot between legal links. Drawn by CSS (an empty box with a round
    background), so screen readers don't read anything out.
  */
  .footer__legal-list li + li::before {
    content: '';
    display: inline-block;
    inline-size: 5px;
    block-size: 5px;
    margin-inline: 1.25rem;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-text) 25%, transparent);
    vertical-align: middle;
  }

  /*
    Giant wordmark (Figma: ~500px at 1920 wide, spanning most of the panel). Its box is only 0.72em
    tall and clips what overflows, so the bottom of the letters is cut off flush with the panel's
    bottom edge (the panel has no bottom padding). The negative top margin tucks the empty space above
    the letters under the bottom row, like the Figma. The clip also stops a sideways scroll on phones.
    Faded (Figma, measured): ~20% grey for the first word, ~20% of the accent for the italic word.
    Decorative only (aria-hidden), so it has no contrast requirement.
  */
  .footer__wordmark {
    block-size: 0.72em;
    overflow: hidden;
    margin-block: -0.08em 0;
    color: color-mix(in srgb, var(--color-text) 20%, transparent);
    font-family: var(--font-logo--family);
    font-weight: var(--font-logo--weight);
    font-size: min(31.25rem, var(--wordmark-size, 26cqi)); /* fits the panel; 500px at most */
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  /* The letters (see the markup): the logo text, then the accent word in italic */
  .footer__wordmark-text::before {
    content: attr(data-word);
  }

  .footer__wordmark-text::after {
    content: attr(data-accent);
    color: color-mix(in srgb, var(--color-accent) 20%, transparent);
    font-style: italic;
  }

  /*
    The whole word floats: it sinks a little further into the bottom edge and rises back, in a slow
    loop (only down from its resting place: the box clips at the top too, so moving up would cut the
    tops of the letters). transform only, so it costs no layout. With the theme's "Enable animations"
    setting on (.motion-on: also in the theme editor) and motion allowed. It moves without end, so the
    pause button (snippets/motion-pause.liquid) stops it (WCAG 2.2.2).
  */
  .footer__wordmark-text {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .motion-on .footer__wordmark-text {
      animation: footer-wordmark-float 7s ease-in-out infinite;
    }
  }

  @keyframes footer-wordmark-float {
    50% {
      transform: translateY(0.14em);
    }
  }

  /* The pause button sits on the word, at the end of the panel */
  .footer__wordmark-area {
    position: relative;
  }

  .footer__wordmark-pause {
    position: absolute;
    inset-block-end: var(--space-md);
    inset-inline-end: 0;
  }

  /*
    Phones (below 750px, no Figma design: the developer chose this reflow): less space between the parts,
    so the footer is not too long; the bottom row stacks.
  */
  @media (max-width: 749px) {
    .footer__brand {
      gap: var(--space-lg);
    }

    .footer__heading {
      margin-block-end: var(--space-lg);
    }

    .footer__links {
      gap: var(--space-md);
    }

    .footer__newsletter .newsletter-form {
      margin-block-start: var(--space-lg);
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      margin-block-start: var(--space-2xl);
    }
  }

  /*
    Tablets: as many menu columns in a row as fit at 9rem (144px) each (3 at 750px), the others wrap, so
    a menu with many items never gets very narrow columns. Desktop: all in one row (--footer-columns).
  */
  @media (min-width: 750px) and (max-width: 1199px) {
    .footer__nav {
      grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    }
  }

  @media (min-width: 1200px) {
    .footer__nav {
      grid-template-columns: repeat(var(--footer-columns), minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .footer__top {
      grid-template-columns: var(--footer-tracks);
    }
  }
{% endstylesheet %}

