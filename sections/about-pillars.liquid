{%- comment -%}
  About pillars (M8.4 part 3, design/briefs/about-us.md §4.3, exports "Default-2", "Default-12",
  "Default-13", mobile "Variant45-2", "Variant46-1", "Variant47-1"): Mission / Vision / Promise as
  slides that change while the visitor scrolls, next to two columns of photos.

  - Slides: one Pillar block each (blocks/_pillar.liquid). With the script, the section is one
    screen tall per slide and its panel is sticky: scrolling through it changes the slide (01 / 03,
    the progress bars) instead of moving the page. Without JS, or when the tallest slide and the
    photos do not fit one screen (the script checks), the slides simply stack.
  - Photos: one shared set (Photo 1–8, section settings), split over two columns (odd photos left,
    even right), as in the exports where the same photos move between slides. While scrolling the
    left column moves up and the right one down: smoothly with "Photos drift while scrolling",
    one step per slide without it (and for visitors who reduce motion). Below 990px the columns
    are two rows that slide sideways.
  - The script writes --progress (0 → 1) on the section; the CSS turns it into the column moves.
  - The blocks are rendered first and their HTML checked (a section can't read its theme blocks'
    settings): an empty Pillar renders nothing on the store, so it is not a slide; no slide = no
    section on the store. Each slide carries data-pillar, so the count is right in the editor too
    (where an empty Pillar shows as a slide with a note).
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'

  capture blocks_html
    content_for 'blocks'
  endcapture
  assign slide_count = blocks_html | split: 'data-pillar' | size | minus: 1 | at_least: 0

  assign photos = ''
  for i in (1..8)
    assign photo_key = 'image_' | append: i
    if section.settings[photo_key] != blank
      assign photos = photos | append: photo_key | append: ','
    endif
  endfor
  assign photo_keys = photos | split: ','

  assign has_photos = false
  if photo_keys.size > 0 or request.design_mode
    assign has_photos = true
  endif

  # Photo widths from 990px: the photo side is 807 / 1820 of the content, each column about half of
  # it (less the gaps), so a photo is about 22% of the content width
  case section.settings.section_width
    when 'full'
      assign desktop_size = '21vw'
    when 'wide'
      assign desktop_size = 'min(20vw, 370px)'
    when 'narrow'
      assign desktop_size = 'min(20vw, 245px)'
    else
      assign desktop_size = '20vw'
  endcase
-%}

{%- comment -%}
  Eager only as the page's first section: on the About us page this section comes after the hero and
  the chapters (several screens), so section-loading's "first 3 sections" rule loaded all photos at once.
{%- endcomment -%}
{%- liquid
  assign image_loading = 'lazy'
  if section.index == 1
    assign image_loading = 'eager'
  endif
-%}

{% render 'screen-scale' %}

{%- if slide_count > 0 or request.design_mode -%}
  <about-pillars
    class="about-pillars full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}{% if section.settings.scale_screen %} section--screen-scale{% endif %}"
    style="--slides: {{ slide_count | at_least: 1 }};{% if section.settings.scale_screen %} --text-boost: {{ section.settings.text_scale | default: 110 | divided_by: 100.0 }};{% endif %}"
    {% if section.settings.drift %}
      data-drift
    {% endif %}
  >
    <div class="about-pillars__panel">
      <div class="about-pillars__inner{% if has_photos %} about-pillars__inner--photos{% endif %}">
        <div class="about-pillars__story">
          {%- if slide_count > 1 -%}
            <div class="about-pillars__progress" aria-hidden="true">
              {%- for i in (1..slide_count) -%}
                <span class="about-pillars__bar{% if forloop.first %} is-active{% endif %}"></span>
              {%- endfor -%}
              <span class="about-pillars__count">
                <span class="about-pillars__count-current">01</span> /
                {% if slide_count < 10 %}0{% endif %}{{ slide_count -}}
              </span>
            </div>
          {%- endif -%}

          {%- if slide_count > 0 -%}
            <div class="about-pillars__slides">
              {{ blocks_html }}
            </div>
          {%- else -%}
            <p class="about-pillars__empty">{{ 'about.pillars_empty' | t }}</p>
          {%- endif -%}
        </div>

        {%- if has_photos -%}
          <div class="about-pillars__photos" aria-hidden="true">
            {%- for column in (1..2) -%}
              <div class="about-pillars__column about-pillars__column--{{ column }}">
                {%- if photo_keys.size > 0 -%}
                  {%- for photo_key in photo_keys -%}
                    {%- liquid
                      # Odd photos (1st, 3rd…) go left, even ones right
                      assign photo_column = 2
                      assign odd = forloop.index | modulo: 2
                      if odd == 1
                        assign photo_column = 1
                      endif
                    -%}
                    {%- if photo_column == column -%}
                      {%- liquid
                        # Below 990px the photos are a row 7.25rem (116px) tall: the width follows the photo's shape
                        assign photo = section.settings[photo_key]
                        assign row_width = photo.aspect_ratio | times: 116 | ceil
                        assign photo_sizes = '(min-width: 990px) ' | append: desktop_size | append: ', ' | append: row_width | append: 'px'
                      -%}
                      {% render 'image',
                        image: photo,
                        class: 'about-pillars__photo',
                        alt: '',
                        sizes: photo_sizes,
                        widths: '180, 240, 360, 480, 640, 800',
                        loading: image_loading
                      %}
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- comment -%} Editor only: a hint of the photo columns until photos are chosen {%- endcomment -%}
                  {%- for i in (1..3) -%}
                    <div class="about-pillars__photo about-pillars__photo--placeholder">
                      {{ 'lifestyle-1' | placeholder_svg_tag }}
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </about-pillars>
{%- endif -%}

{% stylesheet %}
  /*
    Figma 1920 (Default-2): text column x 55–815; progress y 197 (3 bars: active 66px accent,
    others ~30px accent 20%, then "01 / 03"); photos from y 155 to the screen's bottom, columns
    x 1068 (396 wide) and x 1488 (387 wide), gap 24, square corners, a white fade over the last
    ~200px; the right column starts higher. Sizes: Figma px x --px with rem floors, or tokens.
  */
  .about-pillars {
    /* One Figma pixel; with "Scale with the screen" also limited by the screen height */
    --px: min(calc(100vw / 1920), 0.0625rem);
    --progress: 0;
    --drift-distance: 35%;

    display: block;
    counter-reset: pillar;
    background-color: var(--color-background);
  }

  .about-pillars.section--screen-scale {
    --px: min(calc(100vw / 1920), calc(100svh / 1031));
  }

  .about-pillars__inner {
    display: grid;
    gap: var(--space-2xl);
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  /* Two columns only with photos (no empty photo column) */
  @media (min-width: 990px) {
    .about-pillars__inner--photos {
      grid-template-columns: minmax(0, 1013fr) minmax(0, 807fr);
      column-gap: var(--space-xl);
    }
  }

  .about-pillars__story {
    padding-block: max(6.5rem, calc(185 * var(--px))) var(--space-2xl);
  }

  /* ---------- Progress (only while the panel is pinned: it means nothing on stacked slides) ---------- */
  .about-pillars__progress {
    display: flex;
    align-items: center;
    gap: max(var(--space-md), calc(17 * var(--px)));
    margin-block-end: max(var(--space-xl), calc(60 * var(--px)));
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-label);
  }

  .about-pillars:not([data-ready]) .about-pillars__progress {
    display: none;
  }

  .about-pillars__bar {
    inline-size: max(1.25rem, calc(30 * var(--px)));
    block-size: 2px;
    background-color: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .about-pillars__bar.is-active {
    inline-size: max(2.5rem, calc(66 * var(--px)));
    background-color: var(--color-accent);
  }

  .about-pillars__count {
    margin-inline-start: max(var(--space-md), calc(15 * var(--px)));
    white-space: nowrap;
  }

  .about-pillars__slides > * + * {
    margin-block-start: var(--space-3xl);
  }

  .about-pillars__empty {
    margin: 0;
    font-style: italic;
  }

  /* ---------- Photos ---------- */
  .about-pillars__photos {
    display: grid;
    grid-template-columns: minmax(0, 396fr) minmax(0, 387fr);
    align-items: start;
    position: relative;
    gap: max(var(--space-md), calc(24 * var(--px)));
    overflow: hidden;
  }

  /*
    The fade across the bottom of the screen (Figma "image 680": full width, 195px tall, from
    y 836 to the frame's bottom, over the photos and the text side alike): clear at the top left,
    the background at the bottom right. It uses the scheme's background, so it's white on the
    white scheme and still blends into any other scheme.
  */
  .about-pillars__panel {
    position: relative;
  }

  .about-pillars__panel::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    block-size: max(7rem, calc(195 * var(--px))); /* 195px at 1920 */
    /*
      In a wide, short band the slanted gradient is already partly white along its top edge on the
      right, which drew a hard line (like a box). This mask fades the band in from its top, so it
      has no edge and melts into the photos like an overlay.
    */
    -webkit-mask-image: linear-gradient(to bottom, #00000000, #000000 70%);
    mask-image: linear-gradient(to bottom, #00000000, #000000 70%);
    background: linear-gradient(
      163.39deg,
      color-mix(in srgb, var(--color-background) 0%, transparent) 11.49%,
      var(--color-background) 96.29%
    );
    pointer-events: none;
  }

  .about-pillars__column {
    display: grid;
    gap: inherit;
  }

  .about-pillars__photo,
  .about-pillars__photo img {
    display: block;
    inline-size: 100%;
  }

  .about-pillars__photo--placeholder {
    aspect-ratio: 4 / 5;
    background-color: var(--color-tint-subtle);
  }

  .about-pillars__photo--placeholder svg {
    inline-size: 100%;
    block-size: 100%;
    fill: var(--color-tint-border);
  }

  /*
    ---------- Pinned (data-ready: the script runs and the content fits one screen) ----------
    The section is one screen tall per slide; its panel sticks to the top for the whole way, so the
    visitor scrolls "through" it. Slides lie on top of each other, the current one shows.
  */
  .about-pillars[data-ready] {
    block-size: calc(var(--slides) * 100svh);
  }

  .about-pillars[data-ready] .about-pillars__panel {
    position: sticky;
    inset-block-start: 0;
    block-size: 100svh;
    overflow: hidden;
  }

  @media (min-width: 990px) {
    .about-pillars[data-ready] .about-pillars__inner {
      block-size: 100%;
    }

    .about-pillars[data-ready] .about-pillars__photos {
      align-self: stretch;
      margin-block-start: max(6rem, calc(155 * var(--px)));
    }

    /* The left column moves up, the right one (starting higher) moves down */
    .about-pillars[data-ready] .about-pillars__column--1 {
      translate: 0 calc(var(--progress) * var(--drift-distance) * -1);
    }

    .about-pillars[data-ready] .about-pillars__column--2 {
      translate: 0 calc((var(--progress) - 1) * var(--drift-distance));
    }
  }

  /* The slides are the Pillar blocks themselves ("tag": null: no Shopify wrapper), stacked in one cell */
  .about-pillars[data-ready] .about-pillars__slides {
    display: grid;
  }

  .about-pillars[data-ready] .about-pillars__slides > * {
    grid-area: 1 / 1;
    margin: 0;
  }

  /*
    The slide change, line by line (label, heading, text, checklist):
    - waiting slides: invisible, already placed where they will come from (--enter-from: below when
      scrolling down, above when scrolling back; the script sets it), no transition, so they jump
      there unseen;
    - the leaving slide (is-leaving): fades out quickly, moving the other way;
    - the new slide (is-active): its lines rise into place one after another, starting once the old
      one has mostly gone, so the two texts never overlap in a muddle.
    --motion: 0 for visitors who reduce motion: then it's a plain, quick fade.
  */
  .about-pillars {
    --enter-from: 2rem;
    --motion: 1;
  }

  .about-pillars[data-ready] .pillar {
    pointer-events: none;
  }

  .about-pillars[data-ready] .pillar.is-active {
    pointer-events: auto;
  }

  .about-pillars[data-ready] .pillar > * {
    opacity: 0;
    translate: 0 calc(var(--enter-from) * var(--motion));
  }

  .about-pillars[data-ready] .pillar.is-leaving > * {
    translate: 0 calc(var(--enter-from) * var(--motion) * -0.5);
    transition:
      opacity 280ms ease-in,
      translate 380ms ease-in;
  }

  .about-pillars[data-ready] .pillar.is-active > * {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 600ms var(--ease-out) calc(220ms + var(--line, 0) * 90ms),
      translate 900ms var(--ease-out) calc(220ms + var(--line, 0) * 90ms);
  }

  .about-pillars[data-ready] .pillar > :nth-child(2) {
    --line: 1;
  }

  .about-pillars[data-ready] .pillar > :nth-child(3) {
    --line: 2;
  }

  .about-pillars[data-ready] .pillar > :nth-child(n + 4) {
    --line: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-pillars {
      --motion: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-pillars__bar {
      transition:
        inline-size var(--duration-slow) var(--ease-out),
        background-color var(--duration-slow) var(--ease-out);
    }

    /* One step per slide (no drift): the columns glide to their new place */
    .about-pillars[data-ready]:not([data-drift-on]) .about-pillars__column {
      transition: translate 1s var(--ease-out);
    }
  }

  /*
    ---------- Phones and tablets (Variant45-2, 46-1, 47-1) ----------
    The text, then the photos as two rows sliding sideways while the slide changes: row 1 starts
    7.5rem in from the screen edge on the first slide and moves left; row 2 starts cut off at the
    left and ends 7.5rem in on the last slide (--row-indent, --row-travel: 6rem per step of three
    slides). The rows reach the screen edges (negative page margins).
  */
  @media (max-width: 989px) {
    .about-pillars {
      --row-indent: 7.5rem;
      --row-travel: 12rem;
      --dir: 1;
    }

    /* translate is physical: mirror the moves on right-to-left pages */
    .about-pillars:dir(rtl) {
      --dir: -1;
    }

    .about-pillars[data-ready] .about-pillars__panel {
      display: flex;
      flex-direction: column;
    }

    .about-pillars__inner {
      gap: var(--space-lg);
    }

    .about-pillars__story {
      padding-block: 6rem 0;
    }

    .about-pillars__photos {
      grid-template-columns: none;
      margin-inline: calc(var(--page-margin) * -1);
    }

    .about-pillars__column {
      display: flex;
      inline-size: max-content;
    }

    .about-pillars__photo,
    .about-pillars__photo img {
      inline-size: auto;
      block-size: 7.25rem;
    }

    .about-pillars__photo img {
      aspect-ratio: auto;
      object-fit: cover;
    }

    .about-pillars__photo--placeholder {
      aspect-ratio: 1;
    }

    .about-pillars[data-ready] .about-pillars__column--1 {
      translate: calc((var(--row-indent) - var(--progress) * var(--row-travel)) * var(--dir)) 0;
    }

    .about-pillars[data-ready] .about-pillars__column--2 {
      translate: calc((var(--row-indent) - (1 - var(--progress)) * var(--row-travel)) * var(--dir)) 0;
    }
  }

  /* Phones (Variant45-2): small progress text */
  @media (max-width: 749px) {
    .about-pillars__progress {
      gap: var(--space-sm);
      margin-block-end: var(--space-lg);
      font-size: 0.625rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <about-pillars>: turns scrolling through the (tall) section into slide changes.
   *
   * fit() decides if the panel can be pinned: it applies the pinned layout (data-ready) and checks
   * that the panel's content (the tallest slide and the photos) fits one screen. If not, it removes
   * data-ready again in the same step (before paint), so the slides stack as without JS. It runs on
   * connect, on resize and when the web fonts have loaded (text gets taller).
   *
   * While pinned, update() runs at most once per frame while the section is on screen (an
   * IntersectionObserver adds and removes the scroll listener). It measures how far the visitor is
   * through the section (0 at its top, 1 at its end), shows slide floor(progress x slides), and
   * writes --progress:
   * - "Photos drift while scrolling" on (data-drift) and motion allowed: the exact progress, so the
   *   photo columns follow the scroll smoothly (data-drift-on);
   * - otherwise one step per slide (0, 0.5, 1 for three slides): the columns glide once per slide.
   * Keyboard focus in a slide that doesn't show, and selecting a Pillar block in the theme editor,
   * scroll to that slide. Every listener is on one AbortController (the editor re-attaches a moved
   * section, so connectedCallback can run again).
   */
  class AboutPillars extends HTMLElement {
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;

      this.slides = [...this.querySelectorAll('.pillar')];
      if (!this.slides.length) return;

      this.panel = this.querySelector('.about-pillars__panel');
      this.bars = [...this.querySelectorAll('.about-pillars__bar')];
      this.counter = this.querySelector('.about-pillars__count-current');
      this.current = -1;

      // Smooth drift only with motion allowed; follow a change of the visitor's setting
      this.motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
      this.setDrift();
      this.motion.addEventListener(
        'change',
        () => {
          this.setDrift();
          this.update();
        },
        { signal }
      );

      this.onScroll = () => {
        if (this.frame) return;
        this.frame = requestAnimationFrame(() => {
          this.frame = null;
          this.update();
        });
      };

      this.visibility = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          window.addEventListener('scroll', this.onScroll, { passive: true, signal });
          this.update();
        } else {
          window.removeEventListener('scroll', this.onScroll);
        }
      });

      // Pin again or stack after a resize, and once the web fonts have loaded
      this.onResize = () => {
        if (this.fitFrame) return;
        this.fitFrame = requestAnimationFrame(() => {
          this.fitFrame = null;
          this.fit();
          this.update();
        });
      };
      window.addEventListener('resize', this.onResize, { signal });
      document.fonts?.ready.then(() => {
        if (!signal.aborted) this.onResize();
      });

      this.fit();
      this.activate(0);
      this.visibility.observe(this);

      this.addEventListener('shopify:block:select', (event) => this.scrollToSlide(event.target), { signal });

      // A link in a slide that doesn't show gets keyboard focus: bring its slide in
      this.addEventListener(
        'focusin',
        (event) => {
          if (!this.pinned) return;
          const slide = event.target.closest?.('.pillar');
          if (slide && slide !== this.slides[this.current]) this.scrollToSlide(slide);
        },
        { signal }
      );
    }

    disconnectedCallback() {
      this.controller?.abort();
      clearTimeout(this.leaveTimer);
      this.visibility?.disconnect();
      if (this.frame) cancelAnimationFrame(this.frame);
      if (this.fitFrame) cancelAnimationFrame(this.fitFrame);
      this.frame = null;
      this.fitFrame = null;
    }

    setDrift() {
      this.drift = this.hasAttribute('data-drift') && this.motion.matches;
      this.toggleAttribute('data-drift-on', this.drift);
    }

    /**
     * Pinned only when the content fits one screen. Always measured in the pinned layout (the
     * stacked slides are taller, so measuring them would flip it back and forth).
     */
    fit() {
      this.setAttribute('data-ready', '');
      this.pinned = this.panel.scrollHeight <= this.panel.clientHeight + 1;
      this.toggleAttribute('data-ready', this.pinned);
    }

    /** 0 at the section's top, 1 once its end reaches the bottom of the screen */
    progress() {
      const rect = this.getBoundingClientRect();
      const travel = rect.height - window.innerHeight;
      if (travel <= 0) return 0;
      return Math.min(Math.max(-rect.top / travel, 0), 1);
    }

    update() {
      if (!this.pinned) return;
      const count = this.slides.length;
      const progress = this.progress();
      const index = Math.min(Math.floor(progress * count), count - 1);
      const step = count > 1 ? index / (count - 1) : 0;

      this.style.setProperty('--progress', String(this.drift ? progress : step));
      this.activate(index);
    }

    activate(index) {
      if (index === this.current) return;
      const previous = this.current;
      this.current = index;

      // Scrolling down: the new lines come up from below; back up: down from above
      this.style.setProperty('--enter-from', index < previous ? '-2rem' : '2rem');

      clearTimeout(this.leaveTimer);
      this.slides.forEach((slide, i) => {
        slide.classList.toggle('is-leaving', i === previous);
        slide.classList.toggle('is-active', i === index);
      });
      // The leaving slide is gone after ~400ms: back to "waiting", unseen
      this.leaveTimer = setTimeout(() => {
        this.slides.forEach((slide) => slide.classList.remove('is-leaving'));
      }, 450);
      this.bars.forEach((bar, i) => bar.classList.toggle('is-active', i === index));
      if (this.counter) this.counter.textContent = String(index + 1).padStart(2, '0');
    }

    scrollToSlide(target) {
      const slide = target.closest?.('.pillar');
      const index = this.slides.indexOf(slide);
      if (index < 0) return;

      // Stacked: the slide is in the page flow
      if (!this.pinned) {
        slide.scrollIntoView({ block: 'nearest' });
        return;
      }

      const top = this.getBoundingClientRect().top + window.scrollY;
      const travel = this.offsetHeight - window.innerHeight;
      window.scrollTo({ top: top + (travel * (index + 0.5)) / this.slides.length });
    }
  }

  if (!customElements.get('about-pillars')) customElements.define('about-pillars', AboutPillars);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.about_pillars",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "blocks": [{ "type": "_pillar" }],
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "paragraph",
      "content": "t:labels.about_pillars_help"
    },
    {
      "type": "header",
      "content": "t:labels.pillars_photos"
    },
    {
      "type": "paragraph",
      "content": "t:labels.pillars_photos_info"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "t:labels.photo_1"
    },
    {
