{%- comment -%}
  Returns hero (M8.6 part 2, design/briefs/policies.md, Figma 1:18125 "returns"): breadcrumb, a round
  badge ("60 / days"), the eyebrow "Returns & refunds", "No questions. Not one." and the intro.
  The page's first section: no scroll animation.
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'
  assign title = page.title | default: section.settings.eyebrow
-%}

{% render 'screen-scale' %}

<div
  class="returns-hero full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}{% if section.settings.scale_screen %} section--screen-scale{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --text-boost: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};"
>
  <div class="returns-hero__inner">
    {%- if section.settings.show_breadcrumb -%}
      {% render 'breadcrumb', current: title, class: 'returns-hero__breadcrumb' %}
    {%- endif -%}

    <div class="returns-hero__grid">
      {%- if section.settings.badge_number != blank -%}
        <div class="returns-hero__badge">
          <span class="returns-hero__badge-number">{{ section.settings.badge_number | escape }}</span>
          {%- if section.settings.badge_label != blank -%}
            <span class="returns-hero__badge-label">{{ section.settings.badge_label | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="returns-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="returns-hero__heading">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            {{ title | escape }}
          {%- endif -%}
        </h1>
        {%- if section.settings.text != blank -%}
          <div class="returns-hero__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /*
    Figma 1920 (1:18125): breadcrumb y 134; badge circle 223 x 223 at x 276 y 231 (fill accent ~7%,
    1px pale ring, soft shadow), "60" heading font ~115px accent, "DAYS" label accent; text column
    from x 593 (eyebrow y 212, heading ~64px y 278, 629 wide; intro ~20 / 35 under it); the badge
    column is 135–593 (458 wide), the badge centred in it at the right.
  */
  .returns-hero {
    display: block;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    background-color: var(--color-background);
  }

  .returns-hero__inner {
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .returns-hero__grid {
    display: grid;
    grid-template-columns: max(12rem, calc(458 * var(--px, 0.0625rem))) minmax(0, 1fr);
    align-items: start;
    margin-block-start: max(var(--space-xl), calc(45 * var(--px, 0.0625rem)));
  }

  .returns-hero__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    justify-self: center;
    inline-size: max(9rem, calc(223 * var(--px, 0.0625rem)));
    aspect-ratio: 1;
    box-sizing: border-box;
    margin-block-start: max(0rem, calc(19 * var(--px, 0.0625rem)));
    border: 1px solid color-mix(in srgb, var(--color-accent) 15%, transparent);
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-accent) 7%, var(--color-background));
    box-shadow: 0 12px 34px 0 color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }

  .returns-hero__badge-number {
    font-family: var(--font-heading--family);
    font-size: max(4rem, calc(115 * var(--px, 0.0625rem)));
    line-height: 0.95;
  }

  .returns-hero__badge-label {
    margin-block-start: var(--space-sm);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .returns-hero__heading {
    margin: max(var(--space-lg), calc(42 * var(--px, 0.0625rem))) 0 0;
    font-size: max(2.25rem, calc(64 * var(--px, 0.0625rem)));
    font-weight: 400;
    line-height: 1.1;
  }

  .returns-hero__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  .returns-hero__text {
    max-inline-size: max(20rem, calc(640 * var(--px, 0.0625rem)));
    margin-block-start: max(var(--space-lg), calc(40 * var(--px, 0.0625rem)));
    font-size: var(--font-size-body);
    line-height: 1.75;
  }

  .returns-hero__text > * {
    margin: 0;
  }

  /* Phones and small tablets: the badge above the text, a little smaller */
  @media (max-width: 989px) {
    .returns-hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .returns-hero__badge {
      justify-self: start;
      inline-size: 8.5rem;
      margin: 0;
    }

    .returns-hero__badge-number {
      font-size: 3.5rem;
    }

    .returns-hero__badge-label {
      margin-block-start: var(--space-xs);
    }
  }

  @media (max-width: 749px) {
    .returns-hero__text {
      font-size: var(--font-size-body-sm);
      line-height: 1.7;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.returns_hero",
  "tag": "section",
  "class": "returns-hero-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:labels.show_breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_number",
      "label": "t:labels.returns_badge_number",
      "info": "t:labels.returns_badge_number_info",
      "default": "60"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "t:labels.returns_badge_label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Returns & refunds"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.italic_accent_info",
      "default": "No questions. Not <em>one.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>If a formula is not right for your skin we collect it from your door and refund in full — even if the bottle is half empty. Skin is personal; a return is not a failure.</p>"
    },
    {
      "type": "header",
      "content": "t:labels.style"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.section_width.narrow"
        },
        {
          "value": "wide",
          "label": "t:options.section_width.wide"
        },
        {
          "value": "widest",
          "label": "t:options.section_width.widest"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "widest"
    },
    {
      "type": "checkbox",
      "id": "scale_screen",
      "label": "t:labels.scale_screen",
      "info": "t:labels.scale_screen_info",
      "default": true
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "t:labels.text_scale",
      "info": "t:labels.text_scale_info",
      "min": 100,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.scale_screen }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:general.returns_hero"
    }
  ]
}
{% endschema %}
