{%- comment -%}
  Overview (M6.6, Figma PDP "Product details 6"): "THE OBJECT" eyebrow and a big heading with accent
  words (left); a paragraph and spec rows (Texture / Finish / Format / Origin, middle); an image with
  hotspots (right); then a large quote with an accent phrase and a 2 x 2 grid of figures (98% FELT SKIN
  SOFTER…).
  - Content: the Figma text is the demo. Every text and image field can be connected to a product
    metafield in the theme editor ("Connect dynamic source"), so each product shows its own words;
    an empty field hides its part.
  - Hotspots: red dots at a position on the image (x / y in %). Hover, keyboard focus or a tap shows a
    small frosted card with a title in the accent colour and a short text (the brief, answer 14). The
    script puts the card on the side of the dot with more room, inside the image (below or above the
    dot when neither side has room, e.g. on phones). No image on the store = no image column, no dots.
  - The tabs link here with the Link name setting (#overview).
  - Figma sizes use --px (one Figma pixel: the screen width / 1920, at most 1px), so they get smaller
    with the screen; most have a minimum (max(…)).
  The blocks are the section's own (spec row, hotspot, figure), drawn where they belong by their type.
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'
  assign anchor = section.settings.anchor | handleize | default: 'overview'
  assign specs = section.blocks | where: 'type', 'spec'
  assign hotspots = section.blocks | where: 'type', 'hotspot'
  assign figures = section.blocks | where: 'type', 'figure'

  # Only parts with content are drawn (an empty part must not keep an empty column)
  assign spec_count = 0
  for block in specs
    if block.settings.label != blank and block.settings.value != blank
      assign spec_count = spec_count | plus: 1
    endif
  endfor
  assign figure_count = 0
  for block in figures
    if block.settings.value != blank
      assign figure_count = figure_count | plus: 1
    endif
  endfor

  assign has_intro = false
  if section.settings.eyebrow != blank or section.settings.heading != blank
    assign has_intro = true
  endif
  assign has_body = false
  if section.settings.text != blank or spec_count > 0
    assign has_body = true
  endif
  # No image: no image column on the store (the dots need the image); the editor shows a placeholder
  assign has_media = false
  if section.settings.image != blank or request.design_mode
    assign has_media = true
  endif

  # Desktop columns (Figma 680 : 528 : 611) for the parts that are there; tablets: heading + text
  # side by side, the image full width under them
  assign top_columns = ''
  assign text_parts = 0
  if has_intro
    assign top_columns = top_columns | append: ' minmax(0, 680fr)'
    assign text_parts = text_parts | plus: 1
  endif
  if has_body
    assign top_columns = top_columns | append: ' minmax(0, 528fr)'
    assign text_parts = text_parts | plus: 1
  endif
  if has_media
    assign top_columns = top_columns | append: ' minmax(0, 611fr)'
  endif
  assign top_columns = top_columns | strip

  # The image from 1200px: its fr share of the content width (widest ~92vw, full ~96vw, wide = at most
  # the 1650px page width); +1 rounds up. Below 1200px: the full content width
  assign fr_total = 611
  if has_intro
    assign fr_total = fr_total | plus: 680
  endif
  if has_body
    assign fr_total = fr_total | plus: 528
  endif
  assign section_vw = 92
  if section.settings.section_width == 'full'
    assign section_vw = 96
  endif
  assign media_vw = section_vw | times: 611 | divided_by: fr_total | plus: 1
  if section.settings.section_width == 'wide'
    assign media_px = 1650 | times: 611 | divided_by: fr_total | plus: 1
    assign media_sizes = '(min-width: 1200px) min(' | append: media_vw | append: 'vw, ' | append: media_px | append: 'px), 94vw'
  else
    assign media_sizes = '(min-width: 1200px) ' | append: media_vw | append: 'vw, 94vw'
  endif
-%}

{%- capture image_loading -%}{% render 'section-loading' %}{%- endcapture -%}
{%- assign image_loading = image_loading | strip -%}

{%- if top_columns != blank or section.settings.quote != blank or figure_count > 0 -%}
<product-overview
  id="{{ anchor }}"
  class="product-overview full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="product-overview__inner">
    {%- if top_columns != blank -%}
    <div
      class="product-overview__top"
      style="--top-columns: {{ top_columns }}; --top-columns-tablet: repeat({{ text_parts | at_least: 1 }}, minmax(0, 1fr));"
    >
      {%- if has_intro -%}
        <div class="product-overview__intro" data-tab-item>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow product-overview__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="product-overview__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if has_body -%}
        <div class="product-overview__body" data-tab-item>
          {%- if section.settings.text != blank -%}
            <div class="product-overview__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if spec_count > 0 -%}
            <dl class="product-overview__specs">
              {%- for block in specs -%}
                {%- if block.settings.label != blank and block.settings.value != blank -%}
                  <div class="product-overview__spec" {{ block.shopify_attributes }}>
                    <dt>{{ block.settings.label | escape }}</dt>
                    <dd>{{ block.settings.value | escape }}</dd>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </dl>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if has_media -%}
      <div class="product-overview__media" data-tab-item>
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              loading: image_loading,
              widths: '500, 800, 1100, 1400, 1800',
              sizes: media_sizes,
              class: 'product-overview__image'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'product-overview__image product-overview__placeholder' }}
        {%- endif -%}

        {%- for block in hotspots -%}
          {%- liquid
            # An empty hotspot: nothing on the store; in the editor a dot with a note, so the block can be found
            assign spot_empty = false
            if block.settings.title == blank and block.settings.text == blank
              assign spot_empty = true
              unless request.design_mode
                continue
              endunless
            endif
          -%}
          {%- liquid
            assign spot_id = 'Hotspot-' | append: block.id
            # Without JS (or before it runs): the card goes on the side away from the nearer edge
            assign spot_side = 'right'
            if block.settings.x > 50
              assign spot_side = 'left'
            endif
          -%}
          <div
            class="product-overview__hotspot product-overview__hotspot--{{ spot_side }}"
            style="--spot-x: {{ block.settings.x }}%; --spot-y: {{ block.settings.y }}%;"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="product-overview__dot"
              aria-expanded="false"
              aria-controls="{{ spot_id }}"
              data-hotspot
            >
              <span class="visually-hidden">{{ block.settings.title | default: block.settings.text | escape }}</span>
            </button>
            <div class="product-overview__card" id="{{ spot_id }}">
              {%- if spot_empty -%}
                <p class="product-overview__card-text">{{ 'products.overview.hotspot_empty' | t }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <p class="product-overview__card-title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="product-overview__card-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
    {%- endif -%}

    {%- if section.settings.quote != blank or figure_count > 0 -%}
      {%- comment -%} <animate-on-scroll> reveals the [data-animate] quote (without it the quote would stay hidden) {%- endcomment -%}
      <animate-on-scroll class="product-overview__bottom">
        {%- if section.settings.quote != blank -%}
          <blockquote class="product-overview__quote" data-animate="fade-up" data-tab-item>
            <p>{{ section.settings.quote }}</p>
          </blockquote>
        {%- endif -%}
        {%- if figure_count > 0 -%}
          <dl class="product-overview__figures" data-tab-item>
            {%- for block in figures -%}
              {%- if block.settings.value != blank -%}
                <div class="product-overview__figure" {{ block.shopify_attributes }}>
                  <dt class="product-overview__figure-label">{{ block.settings.label | escape }}</dt>
                  <dd class="product-overview__figure-value">{{ block.settings.value | escape }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}
      </animate-on-scroll>
    {%- endif -%}
  </div>
</product-overview>
{%- endif -%}

{% stylesheet %}
  /*
    Figma 1920 ("Product details 6"): eyebrow y 213; heading x 50–475, ~70px, 3 lines, accent words;
    text x 730–1185 ~22px; spec rows under it: label caps ~15px wide spacing (x 730), value ~18px
    (x 870), ~38px apart; image x 1259–1870 (611 x 437, square corners), 3 red dots ~12px with a white
    ring. Quote x 285–1080, the accent font ~56px, the accent phrase red; figures 2 x 2 x 1297–1830:
    value ~24px medium, label caps ~15px, a hairline under the first row.
  */
  .product-overview {
    /* One Figma pixel: the screen width / 1920, never more than 1px (the Figma sizes are the largest) */
    --px: min(calc(100vw / 1920), 0.0625rem);
    display: block;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    background-color: var(--color-background);
  }

  .product-overview__inner {
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .product-overview__top {
    display: grid;
    /* Built in Liquid from the parts that are there (Figma 680 : 528 : 611) */
    grid-template-columns: var(--top-columns);
    align-items: start;
    gap: max(var(--space-lg), calc(50 * var(--px, 0.0625rem)));
  }

  .product-overview__eyebrow {
    margin: 0 0 var(--space-lg);
  }

  .product-overview__heading {
    margin: 0;
    max-inline-size: 11ch;
    font-size: var(--font-size-h1);
    font-weight: 400;
    line-height: 1.1;
  }

  .product-overview__heading em,
  .product-overview__quote em {
    color: var(--color-accent);
    font-style: normal;
  }

  .product-overview__body {
    padding-block-start: max(var(--space-lg), calc(80 * var(--px, 0.0625rem)));
  }

  .product-overview__text {
    font-size: var(--font-size-body-lg);
    line-height: 1.65;
  }

  .product-overview__specs {
    display: grid;
    gap: var(--space-md);
    margin: max(var(--space-lg), calc(40 * var(--px, 0.0625rem))) 0 0;
  }

  .product-overview__spec {
    display: grid;
    grid-template-columns: minmax(6rem, 140fr) minmax(0, 315fr);
    align-items: baseline;
    gap: var(--space-md);
  }

  .product-overview__spec dt {
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .product-overview__spec dd {
    margin: 0;
    font-size: var(--font-size-body-sm);
  }

  .product-overview__media {
    position: relative;
    aspect-ratio: 611 / 437;
    background-color: var(--color-tint, color-mix(in srgb, var(--color-text) 5%, var(--color-background)));
  }

  .product-overview__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .product-overview__placeholder {
    fill: color-mix(in srgb, var(--color-text) 30%, transparent);
  }

  /* Hotspots: a red dot with a white ring; a pulse ring draws the eye (not with reduced motion) */
  /* Physical left / top: the image is not mirrored in RTL, so x = 0% is always its left edge */
  .product-overview__hotspot {
    position: absolute;
    top: var(--spot-y);
    left: var(--spot-x);
    translate: -50% -50%;
  }

  .product-overview__dot {
    position: relative;
    display: block;
    inline-size: 2.75rem; /* the touch target; the visible dot is drawn smaller */
    block-size: 2.75rem;
    min-block-size: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    box-shadow: none;
    cursor: pointer;
  }

  .product-overview__dot::before {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    inline-size: 0.875rem;
    block-size: 0.875rem;
    border: 2px solid #ffffff;
    border-radius: 50%;
    background-color: var(--color-accent);
    box-shadow: 0 2px 6px #00000040;
    translate: -50% -50%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-overview__dot::after {
      content: "";
      position: absolute;
      inset: 50% auto auto 50%;
      inline-size: 0.875rem;
      block-size: 0.875rem;
      border-radius: 50%;
      background-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
      translate: -50% -50%;
      animation: product-hotspot-pulse 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes product-hotspot-pulse {
    to {
      opacity: 0;
      scale: 3;
    }
  }

  .product-overview__dot:hover,
  .product-overview__dot:focus-visible {
    background: none;
  }

  .product-overview__dot:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: -6px;
  }

  /* The card: a frosted glass box beside the dot (left of it when the dot is near the right edge) */
  .product-overview__card {
    position: absolute;
    z-index: 2;
    inset-block-start: 50%;
    inline-size: max(13rem, calc(240 * var(--px, 0.0625rem)));
    padding: var(--space-sm) var(--space-md);
    border: 1px solid #ffffff59;
    border-radius: max(0.625rem, calc(12 * var(--px, 0.0625rem)));
    background-color: #ffffff33;
    box-shadow: 0 8px 30px #0000002e;
    color: #ffffff;
    opacity: 0;
    pointer-events: none;
    translate: 0 -50%;
    visibility: hidden;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      visibility 0s linear var(--duration-fast);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .product-overview__hotspot--right .product-overview__card {
    left: calc(100% + 0.25rem);
  }

  .product-overview__hotspot--left .product-overview__card {
    right: calc(100% + 0.25rem);
  }

  /* Each hotspot is its own layer (translate): the one with an open card comes to the front, so the
     other dots don't show over its card */
  .product-overview__hotspot:hover,
  .product-overview__hotspot:focus-within {
    z-index: 3;
  }

  .product-overview__hotspot:has([aria-expanded="true"]) {
    z-index: 3;
  }

  /*
    Placed by the script (data-placed): left / top from the hotspot's box, so the card stays inside the
    image. Physical left / top: the script measures the screen, which is the same in RTL.
  */
  .product-overview__hotspot[data-placed] .product-overview__card {
    inset: auto;
    left: var(--card-left);
    top: var(--card-top);
    max-inline-size: var(--card-max, none);
    translate: none;
  }

  .product-overview__hotspot:hover .product-overview__card,
  .product-overview__dot:focus-visible + .product-overview__card,
  .product-overview__dot[aria-expanded="true"] + .product-overview__card {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      visibility 0s;
  }

  /* Escape closes a card shown by hover or focus too (WCAG 1.4.13), until the pointer or focus leaves */
  .product-overview__hotspot[data-dismissed] .product-overview__card {
    opacity: 0;
    visibility: hidden;
  }

  .product-overview__card p {
    margin: 0;
  }

  .product-overview__card-title {
    margin-block-end: 0.2em;
    color: var(--color-accent);
    font-family: var(--font-heading--family);
    font-size: var(--font-size-body-lg);
    line-height: 1.2;
    text-shadow: 0 0 12px #ffffffb3;
  }

  .product-overview__card-text {
    font-size: var(--font-size-small);
    line-height: 1.5;
    text-shadow: 0 1px 4px #00000059;
  }

  /* Bottom row: the quote (centre-left) and the figures (right) */
  .product-overview__bottom {
    display: grid;
    grid-template-columns: minmax(0, 1210fr) minmax(0, 611fr);
    align-items: start;
    gap: max(var(--space-lg), calc(50 * var(--px, 0.0625rem)));
    margin-block-start: max(var(--space-2xl, 4rem), calc(70 * var(--px, 0.0625rem)));
  }

  .product-overview__quote {
    margin: 0;
    padding-inline-start: calc(235 * var(--px, 0.0625rem));
  }

  .product-overview__quote p {
    margin: 0;
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: max(2rem, calc(56 * var(--px, 0.0625rem)));
    line-height: 1.2;
  }

  /* The quote marks, drawn by CSS so the merchant types only the words */
  .product-overview__quote p::before {
    content: "“ ";
  }

  .product-overview__quote p::after {
    content: " ”";
  }

  .product-overview__figures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 max(var(--space-lg), calc(80 * var(--px, 0.0625rem)));
    margin: 0;
  }

  /*
    In a <dl> the label (<dt>) must come before its value (<dd>), so the HTML reads "Felt skin softer:
    98%"; column-reverse shows the value on top, as in the Figma
  */
  .product-overview__figure {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-xs);
    padding-block: var(--space-md);
  }

  /* A hairline under the first row, only when there is a second row (3+ figures) */
  .product-overview__figures:has(> :nth-child(3)) > .product-overview__figure:nth-child(-n + 2) {
    border-block-end: 1px solid var(--color-card-border);
  }

  .product-overview__figure-value {
    margin: 0;
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-medium);
  }

  .product-overview__figure-label {
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  /* Tablets: heading + text side by side, the image full width under them, then quote and figures */
  @media (max-width: 1199px) {
    .product-overview__top {
      grid-template-columns: var(--top-columns-tablet);
    }

    .product-overview__media {
      grid-column: 1 / -1;
    }

    .product-overview__bottom {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-overview__quote {
      padding-inline-start: 0;
    }
  }

  /* Phones (brief: the Overview drops the spec rows and the quote): one column */
  @media (max-width: 749px) {
    .product-overview__top {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-overview__body {
      padding-block-start: 0;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <product-overview>: a tap or Enter on a hotspot opens its card (hover and focus open it with CSS);
   * another tap, Escape or a click elsewhere closes it. One card open at a time. Before a card shows,
   * place() puts it beside the dot, on the side with more room, inside the image (below or above the
   * dot when neither side has room).
   */
  class ProductOverview extends HTMLElement {
    connectedCallback() {
      // All listeners through one signal, removed when the element leaves the page (the tabs' pinned
      // track moves it, which runs connectedCallback again: without this a tap opened and closed a card)
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.media = this.querySelector('.product-overview__media');

      this.addEventListener(
        'click',
        (event) => {
          const dot = event.target.closest('[data-hotspot]');
          if (!dot) return;
          const open = dot.getAttribute('aria-expanded') === 'true';
          this.closeAll();
          dot.parentElement.removeAttribute('data-dismissed'); // a click after Escape opens the card again
          if (!open) this.place(dot.parentElement);
          dot.setAttribute('aria-expanded', String(!open));
        },
        { signal }
      );
      // Hover (mouse and pen: a touch tap is the click above) and keyboard focus show a card too
      this.addEventListener(
        'pointerover',
        (event) => {
          const hotspot = event.target.closest('.product-overview__hotspot');
          if (!hotspot || event.pointerType === 'touch' || hotspot.contains(event.relatedTarget)) return;
          if (!hotspot.querySelector('[aria-expanded="true"]')) this.closeAll(); // one card at a time
          this.place(hotspot);
        },
        { signal }
      );
      this.addEventListener('focusin', (event) => this.place(event.target.closest('.product-overview__hotspot')), {
        signal,
      });
      // A card closed with Escape stays closed until the pointer or focus leaves its hotspot
      ['pointerout', 'focusout'].forEach((type) => {
        this.addEventListener(
          type,
          (event) => {
            const hotspot = event.target.closest('.product-overview__hotspot');
            if (hotspot && !hotspot.contains(event.relatedTarget)) hotspot.removeAttribute('data-dismissed');
          },
          { signal }
        );
      });
      document.addEventListener(
        'click',
        (event) => {
          if (!event.target.closest('[data-hotspot]')) this.closeAll();
        },
        { signal }
      );
      // On the document: a hover card must close with Escape also when the focus is somewhere else. An
      // Escape for another dialog (lightbox, search, drawer) or with no card shown does nothing here
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'Escape' || event.defaultPrevented) return;
          if (!this.contains(event.target) && event.target.closest?.('dialog, [aria-modal="true"]')) return;
          const shown = this.shownHotspots();
          if (!shown.length) return;
          this.closeAll();
          shown.forEach((hotspot) => {
            if (hotspot.matches(':hover') || hotspot.querySelector(':focus-visible')) hotspot.setAttribute('data-dismissed', '');
          });
        },
        { signal }
      );
      // A resize or a turned phone changes the image: place the shown cards again
      if (this.media) {
        this.resizeObserver = new ResizeObserver(() => this.shownHotspots().forEach((hotspot) => this.place(hotspot)));
        this.resizeObserver.observe(this.media);
      }
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.resizeObserver?.disconnect();
    }

    /** The hotspots with a card on screen: opened with a tap or Enter, or shown by hover or focus */
    shownHotspots() {
      return [...this.querySelectorAll('.product-overview__hotspot')].filter(
        (hotspot) =>
          !hotspot.hasAttribute('data-dismissed') &&
          (hotspot.matches(':hover') || hotspot.querySelector(':focus-visible, [aria-expanded="true"]'))
      );
    }

    closeAll() {
      this.querySelectorAll('[data-hotspot][aria-expanded="true"]').forEach((dot) => dot.setAttribute('aria-expanded', 'false'));
    }

    /**
     * Puts the card beside the dot on the side with more room; when the card doesn't fit beside it, under
     * the dot (over it near the bottom), centred and kept inside the image, never wider than the image.
     */
    place(hotspot) {
      if (!hotspot || !this.media) return;
      const card = hotspot.querySelector('.product-overview__card');
      const area = this.media.getBoundingClientRect();
      const spot = hotspot.getBoundingClientRect();
      const edge = 8; // room kept to the image's edge
      const gap = 4;
      hotspot.style.setProperty('--card-max', `${Math.max(0, area.width - edge * 2)}px`);
      hotspot.setAttribute('data-placed', ''); // first: the max width applies before the card is measured
      const width = card.offsetWidth;
      const height = card.offsetHeight;
      const roomLeft = spot.left - area.left - gap;
      const roomRight = area.right - spot.right - gap;
      let x;
      let y;
      if (Math.max(roomLeft, roomRight) >= width + edge) {
        x = roomRight >= roomLeft ? spot.right + gap : spot.left - gap - width;
        y = spot.top + spot.height / 2 - height / 2;
      } else {
        x = spot.left + spot.width / 2 - width / 2;
        const below = area.bottom - spot.bottom;
        const above = spot.top - area.top;
        y = below >= height + edge || below >= above ? spot.bottom : spot.top - height;
      }
      x = Math.min(Math.max(x, area.left + edge), area.right - edge - width);
      y = Math.max(Math.min(y, area.bottom - edge - height), area.top + edge);
      hotspot.style.setProperty('--card-left', `${Math.round(x - spot.left)}px`);
      hotspot.style.setProperty('--card-top', `${Math.round(y - spot.top)}px`);
    }
  }

  if (!customElements.get('product-overview')) customElements.define('product-overview', ProductOverview);
{% endjavascript %}

