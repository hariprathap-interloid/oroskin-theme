{%- comment -%}
  About values (M8.4 part 6, design/briefs/about-us.md §4.6, exports "Default-9" (desktop),
  "Variant49" / "Variant50" (phone)): "What we stand for" / "Our core Values" and one Value card
  block per value, numbered 01, 02… by a CSS counter.
  Desktop: 3 columns; with "Feature the first card" the first card is two rows tall, but only when
  it has a photo and there are 3 or more cards (else it would be a tall, empty card).
  Phones and tablets: 2 columns; with "Feature the first card" the first card takes the full width
  (photo beside the text). A lone card in the last row is centred.
  No heading = a hidden h2, so the cards' h3 titles never come straight after the page's h1.
  The cards fade up one after another (Scroll animation); never in the page's first section.

  The Value card blocks are captured first: an empty card draws nothing on the store, so the
  section shows on the store only when at least one card drew a .value-card (in the theme editor
  it always shows, with a note when no card shows).
{%- endcomment -%}

{%- liquid
  capture blocks_html
    content_for 'blocks'
  endcapture

  assign has_cards = false
  if blocks_html contains 'class="value-card'
    assign has_cards = true
  endif

  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'
-%}

{% render 'screen-scale' %}

{%- if has_cards or request.design_mode -%}
  {%- comment -%}
    The cards' numbers use the heading font at a thin weight (200) and the titles at semibold (600):
    the page only loads regular and bold, so this section loads those two weights itself
    (font_modify returns nothing when the chosen font has no such cut, and the nearest one is used).
  {%- endcomment -%}
  {% style %}
    {{ settings.type_heading_font | font_modify: 'weight', '200' | font_face: font_display: 'swap' }}
    {{ settings.type_heading_font | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}
  {% endstyle %}

  <div
    class="about-values full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}{% if section.settings.scale_screen %} section--screen-scale{% endif %}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;{% if section.settings.scale_screen %} --text-boost: {{ section.settings.text_scale | default: 110 | divided_by: 100.0 }};{% endif %}"
  >
    <div class="about-values__inner">
      <header class="about-values__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="about-values__heading">{{ section.settings.heading }}</h2>
        {%- else -%}
          <h2 class="visually-hidden">{{ 'about.values_heading_hidden' | t }}</h2>
        {%- endif -%}
      </header>

      {%- if blocks_html != blank -%}
        <animate-on-scroll
          class="about-values__list{% if section.settings.feature_first %} about-values__list--feature{% endif %}"
        >
          {{- blocks_html -}}
        </animate-on-scroll>
      {%- endif -%}

      {%- unless has_cards -%}
        <p class="about-values__empty">{{ 'about.values_empty' | t }}</p>
      {%- endunless -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /*
    Figma 1920 (Default-9): eyebrow y 148, heading ~66px y 205–265 ("Our Core *Values*", accent
    upright); cards from y 306: 3 columns 538 wide (x 103 / 691 / 1279, gap ~50), 2 rows ~326
    tall with a ~48 gap; card 01 spans both rows.
  */
  .about-values {
    --px: min(calc(100vw / 1920), 0.0625rem);

    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    background-color: var(--color-background);
  }

  .about-values.section--screen-scale {
    --px: min(calc(100vw / 1920), calc(100svh / 1031));
  }

  .about-values__inner {
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .about-values__header {
    margin-block-end: max(var(--space-xl), calc(40 * var(--px)));
    text-align: center;
  }

  /* Only a hidden h2: no space under an empty header */
  .about-values__header:not(:has(:not(.visually-hidden))) {
    margin-block-end: 0;
  }

  .about-values__heading {
    margin: max(var(--space-lg), calc(40 * var(--px))) 0 0;
    font-size: max(2rem, calc(66 * var(--px)));
    line-height: 1.15;
  }

  .about-values__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  /* The cards are the list's direct children (the blocks have no Shopify wrapper) */
  .about-values__list {
    counter-reset: value-card;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: minmax(max(16rem, calc(326 * var(--px))), auto);
    gap: max(var(--space-xl), calc(48 * var(--px))) max(var(--space-xl), calc(50 * var(--px)));
  }

  /* Two rows tall only with a photo to fill it and at least 2 more cards beside it */
  .about-values__list--feature > .value-card--media:first-child:nth-last-child(n + 3) {
    grid-row: span 2;
  }

  /* The cards fade up one after another, by column */
  .about-values__list > :nth-child(3n + 2) {
    --animate-delay: 100ms;
  }

  .about-values__list > :nth-child(3n + 3) {
    --animate-delay: 200ms;
  }

  .about-values__empty,
  .about-values__note {
    margin: 0;
    font-style: italic;
    text-align: center;
  }

  /* Phones and tablets (Variant49 / 50): 2 columns; the featured card full width */
  @media (max-width: 1199px) {
    .about-values__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      gap: var(--space-md);
    }

    .about-values__list--feature > :first-child {
      grid-column: 1 / -1;
    }

    /*
      A lone card in the last row: centred, one column wide. With the featured card, the others
      start at child 2, so the lone one is an even child; without it, an odd child.
    */
    .about-values__list--feature > :last-child:nth-child(even):not(:first-child),
    .about-values__list:not(.about-values__list--feature) > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      inline-size: calc(50% - var(--space-md) / 2);
    }

    /* Delays by column: column 2 = the odd children after the featured card, else the even ones */
    .about-values__list > :nth-child(n) {
      --animate-delay: 0ms;
    }

    .about-values__list--feature > :nth-child(odd):not(:first-child),
    .about-values__list:not(.about-values__list--feature) > :nth-child(even) {
      --animate-delay: 100ms;
    }
  }

  @media (max-width: 749px) {
    .about-values__list {
      gap: 0.75rem;
    }

    .about-values__list--feature > :last-child:nth-child(even):not(:first-child),
    .about-values__list:not(.about-values__list--feature) > :last-child:nth-child(odd) {
      inline-size: calc(50% - 0.375rem);
    }

    .about-values__heading {
      margin-block-start: var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_values",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "blocks": [{ "type": "_value-card" }],
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "What we stand for"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.italic_accent_info",
      "default": "Our core <em>Values</em>"
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.section_width.narrow"
        },
        {
          "value": "wide",
          "label": "t:options.section_width.wide"
        },
        {
          "value": "widest",
          "label": "t:options.section_width.widest"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "widest"
    },
    {
      "type": "checkbox",
      "id": "scale_screen",
      "label": "t:labels.scale_screen",
      "info": "t:labels.about_scale_screen_info",
      "default": true
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "t:labels.text_scale",
      "info": "t:labels.about_text_scale_info",
      "min": 100,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 110,
      "visible_if": "{{ section.settings.scale_screen }}"
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "t:labels.values_feature_first",
      "info": "t:labels.about_values_feature_first_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.animation_header"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:labels.animation",
      "info": "t:labels.animation_info",
      "options": [
        {
          "value": "none",
          "label": "t:options.animation.none"
        },
        {
          "value": "fade-up",
          "label": "t:options.animation.fade_up"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "header",
      "content": "t:labels.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "t:general.about_values",
      "blocks": [
        {
          "type": "_value-card",
          "settings": {
            "icon": "diamond",
            "title": "Uncompromising curation"
          }
        },
        {
          "type": "_value-card",
          "settings": {
            "icon": "lashes",
            "title": "Conscious beauty",
            "text": "<p>Sustainability is not a trend: it's our responsibility.</p>"
          }
        },
        {
          "type": "_value-card",
          "settings": {
            "icon": "heart-bold",
            "title": "Client above all",
            "text": "<p>Every decision is made with one person in mind: the client who trusts us with their ritual.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
