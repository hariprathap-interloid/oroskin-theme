{%- comment -%}
  About team (M8.4 part 5, design/briefs/about-us.md §4.5, exports "Default-7", "Default-8",
  "image.png" (hover), "leaders" (phone)): "The visionaries" / "Meet the minds behind OroSkin", an
  intro, two hand-drawn arrows, one Team member block per person, and the vertical "OUR EXPERTS"
  word down the left edge (decoration, slides in when the section enters).
  Heading: Italic = accent, Bold = the brush underline (as in the hero). No heading = a hidden h2,
  so the cards' h3 names never come straight after the page's h1.
  The cards fade up one after another (Scroll animation); never in the page's first section.

  The Team member blocks are captured first: an empty person draws nothing on the store, so the
  section shows on the store only when at least one card drew a .team-member (in the theme editor
  it always shows, with a note when no card shows).
  <about-team-list> opens and closes the cards' quotes (one open at a time, Escape closes).
{%- endcomment -%}

{%- liquid
  capture blocks_html
    content_for 'blocks'
  endcapture

  assign has_cards = false
  if blocks_html contains 'class="team-member'
    assign has_cards = true
  endif

  assign animation = section.settings.animation | default: 'fade-up'
  if section.index == 1
    assign animation = 'none'
  endif

  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'
  assign brush_url = 'brush-underline.svg' | asset_url
-%}

{% render 'screen-scale' %}

{%- if has_cards or request.design_mode -%}
  <div
    class="about-team full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}{% if section.settings.scale_screen %} section--screen-scale{% endif %}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;{% if section.settings.scale_screen %} --text-boost: {{ section.settings.text_scale | default: 110 | divided_by: 100.0 }};{% endif %} --brush-underline: url('{{ brush_url }}');"
  >
    <animate-on-scroll>
      {%- if section.settings.side_word != blank -%}
        {%- comment -%} The letters are CSS content (data-word): contrast checkers skip the decoration {%- endcomment -%}
        <div
          class="about-team__side"
          {% if animation != 'none' %}
            data-animate="slide-left"
          {% endif %}
          aria-hidden="true"
        >
          <div class="about-team__side-word" data-word="{{ section.settings.side_word | escape }}"></div>
        </div>
      {%- endif -%}

      <div class="about-team__inner">
        <header class="about-team__header">
          {%- if section.settings.show_arrows -%}
            <span class="about-team__arrow about-team__arrow--left" aria-hidden="true">
              {{- 'deco-arrow-left.svg' | inline_asset_content -}}
            </span>
            <span class="about-team__arrow about-team__arrow--right" aria-hidden="true">
              {{- 'deco-arrow-right.svg' | inline_asset_content -}}
            </span>
          {%- endif -%}

          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="about-team__heading">{{ section.settings.heading }}</h2>
          {%- else -%}
            <h2 class="visually-hidden">{{ 'about.team_heading_hidden' | t }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="about-team__text">{{ section.settings.text }}</div>
          {%- endif -%}
        </header>

        {%- if blocks_html != blank -%}
          <about-team-list class="about-team__list">
            {{- blocks_html -}}
          </about-team-list>
        {%- endif -%}

        {%- unless has_cards -%}
          <p class="about-team__empty">{{ 'about.team_empty' | t }}</p>
        {%- endunless -%}
      </div>
    </animate-on-scroll>
  </div>
{%- endif -%}

{% javascript %}
  /*
    The cards' buttons: open / close a person's quote (and social buttons). One card open at a time,
    Escape closes. The buttons are hidden in the markup (they do nothing without this script) and
    shown here. In the theme editor, selecting a Team member block opens its card.
  */
  if (!customElements.get('about-team-list')) {
    customElements.define(
      'about-team-list',
      class AboutTeamList extends HTMLElement {
        connectedCallback() {
          this.controller?.abort();
          this.controller = new AbortController();
          const { signal } = this.controller;

          this.querySelectorAll('[data-member-toggle][hidden]').forEach((button) => button.removeAttribute('hidden'));

          this.addEventListener(
            'click',
            (event) => {
              const button = event.target.closest('[data-member-toggle]');
              if (!button || !this.contains(button)) return;
              this.toggle(button.closest('.team-member'), button.getAttribute('aria-expanded') !== 'true');
            },
            { signal }
          );

          document.addEventListener(
            'keydown',
            (event) => {
              if (event.key !== 'Escape' || event.defaultPrevented) return;
              const open = this.querySelector('.team-member.is-open');
              if (!open) return;
              this.toggle(open, false);
              // Focus inside the closed card (a social button) goes back to the card's button
              if (open.contains(document.activeElement)) open.querySelector('[data-member-toggle]')?.focus();
            },
            { signal }
          );

          document.addEventListener(
            'shopify:block:select',
            (event) => {
              const card = event.target.closest?.('.team-member');
              if (card && this.contains(card)) this.toggle(card, true);
            },
            { signal }
          );

          document.addEventListener(
            'shopify:block:deselect',
            (event) => {
              const card = event.target.closest?.('.team-member');
              if (card && this.contains(card)) this.toggle(card, false);
            },
            { signal }
          );
        }

        disconnectedCallback() {
          this.controller?.abort();
        }

        toggle(card, open) {
          if (!card) return;
          if (open) {
            this.querySelectorAll('.team-member.is-open').forEach((other) => {
              if (other !== card) this.toggle(other, false);
            });
          }
          card.classList.toggle('is-open', open);
          card.querySelector('[data-member-toggle]')?.setAttribute('aria-expanded', String(open));
        }
      }
    );
  }
{% endjavascript %}

{% stylesheet %}
  /*
    Figma 1920 (Default-8): eyebrow y 148, heading ~66px y 205–265 (brush under "OroSkin"), intro
    ~19px / 29px centred, max ~880, y 310–360; arrows ~90x110 at x 380 y 285 and x 1600 y 325;
    3 cards x 279 / 795 / 1311, 393 wide, gap 123, photos from y 487; "OUR EXPERTS" ~150px at
    x 10–110, reading bottom to top, pale fill and a pale accent outline.
    Phones and tablets ("leaders", answer 12): 2 columns, the odd last card centred below.
  */
  .about-team {
    --px: min(calc(100vw / 1920), 0.0625rem);

    position: relative;
    overflow: hidden;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    background-color: var(--color-background);
  }

  .about-team.section--screen-scale {
    --px: min(calc(100vw / 1920), calc(100svh / 1031));
  }

  /* The vertical word: the wrapper slides in (data-animate), the word inside is turned */
  .about-team__side {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: max(0.25rem, calc(10 * var(--px)));
    pointer-events: none;
  }

  .about-team__side-word {
    color: color-mix(in srgb, var(--color-accent) 7%, var(--color-background));
    font-family: var(--font-body--family);
    font-size: max(4.5rem, calc(150 * var(--px)));
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    writing-mode: vertical-rl;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-accent) 22%, transparent);
    transform: rotate(180deg);
  }

  .about-team__side-word::before {
    content: attr(data-word);
  }

  .about-team__inner {
    position: relative;
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .about-team__header {
    position: relative;
    margin-block-end: max(var(--space-2xl), calc(110 * var(--px)));
    text-align: center;
  }

  .about-team__heading {
    margin: max(var(--space-lg), calc(40 * var(--px))) 0 0;
    font-size: max(2rem, calc(66 * var(--px)));
    line-height: 1.15;
  }

  .about-team__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  /* Bold = the hand-drawn brush under the word (as in the hero), in the heading's weight */
  .about-team__heading strong {
    position: relative;
    font-weight: inherit;
  }

  .about-team__heading strong::after {
    content: "";
    position: absolute;
    /* Figma: the brush is ~220x35 under a ~230px word at 66px, so about half the font size tall */
    inset-inline: -10% -3%;
    inset-block-end: -0.42em;
    block-size: 0.45em;
    background-color: var(--color-accent);
    -webkit-mask: var(--brush-underline) center / 100% 100% no-repeat;
    mask: var(--brush-underline) center / 100% 100% no-repeat;
    pointer-events: none;
  }

  .about-team__text {
    max-inline-size: max(30rem, calc(880 * var(--px)));
    margin: max(var(--space-lg), calc(40 * var(--px))) auto 0;
    font-size: var(--font-size-body);
    line-height: 1.55;
  }

  .about-team__text > * {
    margin: 0;
  }

  .about-team__arrow {
    position: absolute;
    color: var(--color-text);
    pointer-events: none;
  }

  .about-team__arrow svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .about-team__arrow--left {
    inset-block-start: max(7rem, calc(137 * var(--px)));
    inset-inline-start: calc(245 * var(--px));
    inline-size: max(3.5rem, calc(86 * var(--px)));
  }

  .about-team__arrow--right {
    inset-block-start: max(9rem, calc(177 * var(--px)));
    inset-inline-end: calc(82 * var(--px));
    inline-size: max(4rem, calc(103 * var(--px)));
  }

  /*
    Breathing: both arrows grow a little and shrink back, slowly and together. They start with the
    page (same stylesheet, same clock), so they stay in sync. A looping movement that never hides
    content: .motion-on ("Enable animations", also in the theme editor) and motion allowed.
  */
  @media (prefers-reduced-motion: no-preference) {
    .motion-on .about-team__arrow svg {
      animation: about-team-breathe 4s ease-in-out infinite;
    }
  }

  @keyframes about-team-breathe {
    0%,
    100% {
      transform: scale(0.92);
    }

    50% {
      transform: scale(1.08);
    }
  }

  /* The cards are the list's direct children (the blocks have no Shopify wrapper) */
  .about-team__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 393fr));
    gap: max(var(--space-2xl), calc(80 * var(--px))) max(var(--space-2xl), calc(123 * var(--px)));
    max-inline-size: calc(1425 * var(--px));
    margin-inline: auto;
  }

  /* The cards fade up one after another, by column */
  .about-team__list > :nth-child(3n + 2) {
    --animate-delay: 100ms;
  }

  .about-team__list > :nth-child(3n + 3) {
    --animate-delay: 200ms;
  }

  .about-team__empty,
  .about-team__note {
    margin: 0;
    font-style: italic;
    text-align: center;
  }

  .about-team__empty {
    margin-block-start: var(--space-lg);
  }

  @media (max-width: 1199px) {
    .about-team__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl) var(--space-md);
      max-inline-size: 48rem;
    }

    /* The odd last card: centred under the others, one column wide */
    .about-team__list > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      inline-size: calc(50% - var(--space-md) / 2);
    }

    .about-team__list > :nth-child(n) {
      --animate-delay: 0ms;
    }

    .about-team__list > :nth-child(2n) {
      --animate-delay: 100ms;
    }

    .about-team__arrow {
      display: none;
    }
  }

  /* Phones ("leaders"): heading ~26px, the side word ~45px letters, partly off the left edge, from ~110px down */
  @media (max-width: 749px) {
    .about-team__side {
      inset-block-start: 6.875rem;
      inset-inline-start: -0.5rem;
    }

    .about-team__side-word {
      font-size: 4rem;
    }

    /*
      The slide-in starts 1.5rem to the left (not the theme's 4rem): from the edge, 4rem put the whole
      word off the screen, so the scroll observer never saw it and it never slid in.
    */
    @media (prefers-reduced-motion: no-preference) {
      .js.animations-on .about-team__side[data-animate]:not(.is-visible) {
        transform: translateX(-1.5rem);
      }
    }

    .about-team__header {
      margin-block-end: var(--space-2xl);
    }

    .about-team__heading {
      margin-block-start: var(--space-md);
      font-size: 1.625rem;
    }

    .about-team__text {
      margin-block-start: var(--space-lg);
      font-size: var(--font-size-body-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about_team",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "blocks": [{ "type": "_team-member" }],
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "The visionaries"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.about_heading_info",
      "default": "Meet the minds <em>behind <strong>OroSkin</strong></em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Three individuals from three different worlds — fashion, science, and technology — united by the belief that luxury beauty deserves a platform as extraordinary as the products themselves.</p>"
    },
    {
      "type": "text",
      "id": "side_word",
      "label": "t:labels.team_side_word",
      "info": "t:labels.team_side_word_info",
      "default": "Our experts"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:labels.team_show_arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "info": "t:labels.section_width_info",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.section_width.narrow"
        },
        {
          "value": "wide",
          "label": "t:options.section_width.wide"
        },
        {
          "value": "widest",
          "label": "t:options.section_width.widest"
        },
        {
          "value": "full",
          "label": "t:options.section_width.full"
        }
      ],
      "default": "widest"
    },
    {
      "type": "checkbox",
      "id": "scale_screen",
      "label": "t:labels.scale_screen",
      "info": "t:labels.about_scale_screen_info",
      "default": true
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "t:labels.text_scale",
      "info": "t:labels.about_text_scale_info",
      "min": 100,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 110,
      "visible_if": "{{ section.settings.scale_screen }}"
    },
    {
      "type": "header",
      "content": "t:labels.animation_header"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "t:labels.animation",
      "info": "t:labels.animation_info",
      "options": [
        {
          "value": "none",
          "label": "t:options.animation.none"
        },
        {
          "value": "fade-up",
          "label": "t:options.animation.fade_up"
        }
      ],
      "default": "fade-up"
    },
    {
      "type": "header",
      "content": "t:labels.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "t:general.about_team",
      "blocks": [
        {
          "type": "_team-member",
          "settings": {
            "role_word": "Founder",
            "name": "Elise Beaumont",
            "role": "Founder & creative director"
          }
        },
        {
          "type": "_team-member",
          "settings": {
            "role_word": "Co-founder",
            "name": "Ananya Sharma",
            "role": "Co-founder & formulator"
          }
        },
        {
          "type": "_team-member",
          "settings": {
            "role_word": "Co-founder",
            "name": "Sophia Marie",
            "role": "Co-founder & chemist"
          }
        }
      ]
    }
  ]
}
{% endschema %}
