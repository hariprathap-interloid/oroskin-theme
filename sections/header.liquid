{%- liquid
  # Logo: request the image at 2× the display width so it stays sharp on high-density screens
  if settings.logo != blank
    assign logo_width_2x = settings.logo_width | times: 2
    assign logo_widths = settings.logo_width | append: ', ' | append: logo_width_2x
    assign logo_sizes = settings.logo_width | append: 'px'
  endif
-%}

<header
  class="header color-{{ section.settings.color_scheme.id }}"
  style="--logo-width: {{ settings.logo_width }}px; --nav-underline: url('{{ 'nav-underline.svg' | asset_url }}'); --mega-columns: {{ section.settings.mega_menu_columns }};"
>
  <div class="header__bar">
    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: logo_width_2x
          | image_tag:
            class: 'header__logo-image',
            widths: logo_widths,
            sizes: logo_sizes,
            loading: 'eager',
            alt: shop.name
        }}
      {%- else -%}
        <span class="header__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="header__menu" aria-label="{{ 'accessibility.main_menu' | t }}">
      {% render 'header-menu',
        links: section.settings.menu.links,
        panel_width: section.settings.mega_menu_width,
        panel_scheme: section.settings.mega_menu_color_scheme,
        image_fit: section.settings.mega_menu_image_fit,
        image_ratio: section.settings.mega_menu_image_ratio,
        cards: section.blocks,
        shop_all_show: section.settings.mega_menu_shop_all_show,
        shop_all_label: section.settings.mega_menu_shop_all_label,
        shop_all_link: section.settings.mega_menu_shop_all_link
      %}
    </nav>

    <div class="header__actions">
      <a class="header__icon-button" href="{{ routes.search_url }}">
        {{ 'icon-search.svg' | inline_asset_content }}
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
      </a>

      <a class="header__icon-button" href="{{ routes.cart_url }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span class="visually-hidden">{{ 'header.cart_count' | t: count: cart.item_count }}</span>
        {%- if cart.item_count > 0 -%}
          <span class="header__count" aria-hidden="true">
            {%- if cart.item_count < 100 -%}{{ cart.item_count }}{%- else -%}99+{%- endif -%}
          </span>
        {%- endif -%}
      </a>

      {%- comment -%}
        Customer accounts are Shopify's own pages (decision 6). <shopify-account> is Shopify's web component:
        signed in, it shows the customer's avatar and an account menu; signed out, it shows whatever we put
        in its "signed-out-avatar" slot, here the Figma's red LOGIN pill.
      {%- endcomment -%}
      {%- if shop.customer_accounts_enabled -%}
        <shopify-account class="header__account" menu="{{ section.settings.customer_account_menu }}">
          <span slot="signed-out-avatar" class="button header__login">
            {{ 'icon-account.svg' | inline_asset_content | remove: 'slot="signed-out-avatar"' }}
            {{- 'header.login' | t -}}
          </span>
        </shopify-account>
      {%- endif -%}
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    padding-block: var(--space-lg);
  }

  .header__bar {
    position: relative; /* the mega menu panel is positioned against the whole bar */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex: none;
    min-block-size: 1.5rem;
    color: var(--color-text);
    text-decoration: none;
  }

  /* Wide, square and tall logos: fixed width, height follows, but never taller than 4rem */
  .header__logo-image {
    inline-size: var(--logo-width);
    block-size: auto;
    max-block-size: 4rem;
    object-fit: contain;
  }

  .header__shop-name {
    font-family: var(--font-heading--family);
    font-size: var(--font-size-h3);
    line-height: 1;
  }

  .header__menu,
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  /* Header actions (Figma): round glass icon buttons, then the red LOGIN pill */
  .header {
    --icon-size: 1.25rem;
  }

  .header__icon-button {
    position: relative;
    display: inline-grid;
    place-items: center;
    inline-size: 3.125rem; /* 50px, Figma "Liquid Glass Button" */
    block-size: 3.125rem;
    padding: var(--space-xs);
    border-radius: var(--radius-pill);
    background-color: var(--color-glass);
    box-shadow: var(--shadow-header);
    color: var(--color-text);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .header__icon-button:hover {
    background-color: var(--color-glass-strong);
    color: var(--color-accent);
  }

  .header__icon-button svg {
    inline-size: var(--icon-size);
    block-size: var(--icon-size);
  }

  /* Item count bubble on the cart (Figma: small red circle, top right) */
  .header__count {
    position: absolute;
    inset-block-start: -0.125rem;
    inset-inline-end: -0.125rem;
    display: inline-grid;
    place-items: center;
    min-inline-size: 1.25rem;
    block-size: 1.25rem;
    padding-inline: 0.3rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary);
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .header__account {
    display: inline-flex;
  }

  .header__login {
    gap: var(--space-xs);
    padding-inline: var(--space-xl);
  }

  .header__login svg {
    inline-size: var(--icon-size);
    block-size: var(--icon-size);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "blocks": [
    {
      "type": "mega_menu_card",
      "name": "t:general.menu_card",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:labels.menu_card_help"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.card_link",
          "info": "t:labels.card_link_info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.card_title",
          "info": "t:labels.card_title_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:labels.card_image_info"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.description",
          "info": "t:labels.card_text_info"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "header",
      "content": "t:labels.mega_menu"
    },
    {
      "type": "select",
      "id": "mega_menu_width",
      "label": "t:labels.mega_menu_width",
      "options": [
        { "value": "bar", "label": "t:options.mega_menu_width.bar" },
        { "value": "screen", "label": "t:options.mega_menu_width.screen" }
      ],
      "default": "bar"
    },
    {
      "type": "range",
      "id": "mega_menu_columns",
      "label": "t:labels.mega_menu_columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mega_menu_image_ratio",
      "label": "t:labels.mega_menu_image_ratio",
      "options": [
        { "value": "landscape", "label": "t:options.image_ratio.landscape" },
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "mega_menu_image_fit",
      "label": "t:labels.mega_menu_image_fit",
      "options": [
        { "value": "cover", "label": "t:options.image_fit.cover" },
        { "value": "contain", "label": "t:options.image_fit.contain" }
      ],
      "default": "cover"
    },
    {
      "type": "color_scheme",
      "id": "mega_menu_color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:labels.shop_all_group"
    },
    {
      "type": "checkbox",
      "id": "mega_menu_shop_all_show",
      "label": "t:labels.shop_all_show",
      "default": true
    },
    {
      "type": "text",
      "id": "mega_menu_shop_all_label",
      "label": "t:labels.shop_all_label",
      "info": "t:labels.shop_all_label_info",
      "visible_if": "{{ section.settings.mega_menu_shop_all_show }}"
    },
    {
      "type": "url",
      "id": "mega_menu_shop_all_link",
      "label": "t:labels.shop_all_link",
      "info": "t:labels.shop_all_link_info",
      "visible_if": "{{ section.settings.mega_menu_shop_all_show }}"
    }
  ]
}
{% endschema %}
