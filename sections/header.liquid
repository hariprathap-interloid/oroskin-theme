{%- liquid
  # Logo: request the image at 2× the display width so it stays sharp on high-density screens
  if settings.logo != blank
    assign logo_width_2x = settings.logo_width | times: 2
    assign logo_widths = settings.logo_width | append: ', ' | append: logo_width_2x
    assign logo_sizes = settings.logo_width | append: 'px'
  endif
-%}

{%- liquid
  # Transparent header: floats over the first section and shows only the action buttons until the visitor
  # scrolls (or tabs into it). Setting: off / homepage only / every page.
  assign transparent = false
  case section.settings.transparent_mode
    when 'all'
      assign transparent = true
    when 'home'
      if template.name == 'index'
        assign transparent = true
      endif
  endcase

  # Solid background: the whole header area (full width, the gap around the pill too) takes the header's
  # colour scheme and the page starts below it. Never on a page where the header is transparent.
  assign solid = false
  if section.settings.solid_background and transparent == false
    assign solid = true
  endif
-%}

{%- comment -%}
  The logo's contents, captured once: the bar shows them, and the phone drawer repeats them at its top.
{%- endcomment -%}
{%- capture logo_markup -%}
    {%- liquid
      # Logo = optional image (e.g. the flame mark) + optional text ("Oro" + italic accent "Skin").
      # With neither, the shop name is shown. The image's alt is empty when text is shown, so the
      # link isn't announced twice.
      assign has_logo_text = false
      if settings.logo_text != blank or settings.logo_text_accent != blank
        assign has_logo_text = true
      endif
      assign logo_alt = shop.name
      if has_logo_text
        assign logo_alt = ''
      endif
    -%}
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: logo_width_2x
        | image_tag:
          class: 'header__logo-image',
          widths: logo_widths,
          sizes: logo_sizes,
          loading: 'eager',
          alt: logo_alt
      }}
    {%- endif -%}
    {%- if has_logo_text -%}
      <span class="header__logo-text">
        {{- settings.logo_text | escape -}}
        {%- if settings.logo_text_accent != blank -%}<em>{{ settings.logo_text_accent | escape }}</em>{%- endif -%}
      </span>
    {%- elsif settings.logo == blank -%}
      <span class="header__logo-text">{{ shop.name | escape }}</span>
    {%- endif -%}
{%- endcapture -%}

{%- comment -%}
  The drawer's copy of the logo is inside a closed <dialog> (phones only), so its image loads lazily:
  the browser fetches it only when the drawer opens, not on every page view.
{%- endcomment -%}
{%- assign logo_markup_lazy = logo_markup | replace: 'loading="eager"', 'loading="lazy"' -%}

<sticky-header>
<header
  class="header{% if transparent %} header--transparent{% endif %}{% if solid %} header--solid color-{{ section.settings.color_scheme.id }}{% endif %}{% if section.settings.menu_button_breakpoint != 'phones' %} header--menu-button-{{ section.settings.menu_button_breakpoint }}{% endif %}{% if section.settings.mobile_show_search %} header--m-search{% endif %}{% if section.settings.mobile_show_cart %} header--m-cart{% endif %}"
  style="--logo-width: {{ settings.logo_width }}px; --logo-text-size: {{ settings.logo_text_size }}px; --nav-underline: url('{{ 'nav-underline.svg' | asset_url }}'); --mega-columns: {{ section.settings.mega_menu_columns }};"
>
  <div class="header__bar color-{{ section.settings.color_scheme.id }}">
    {%- comment -%}
      Phones: the menu button + drawer (hidden from 768px). The drawer also holds search, cart and account,
      which the bar hides below 768px unless the "Small screens" settings keep search / cart there.
    {%- endcomment -%}
    {% render 'header-drawer',
      links: section.settings.menu.links,
      logo: logo_markup_lazy,
      account_links: linklists[section.settings.customer_account_menu].links,
      scheme: section.settings.drawer_color_scheme,
      cards: section.blocks,
      image_fit: section.settings.mega_menu_image_fit,
      image_ratio: section.settings.mega_menu_image_ratio,
      shop_all_show: section.settings.mega_menu_shop_all_show,
      shop_all_label: section.settings.mega_menu_shop_all_label,
      shop_all_link: section.settings.mega_menu_shop_all_link
    %}

    <a class="header__logo" href="{{ routes.root_url }}">{{ logo_markup }}</a>

    <nav class="header__menu" aria-label="{{ 'accessibility.main_menu' | t }}">
      {% render 'header-menu',
        links: section.settings.menu.links,
        panel_width: section.settings.mega_menu_width,
        panel_scheme: section.settings.mega_menu_color_scheme,
        image_fit: section.settings.mega_menu_image_fit,
        image_ratio: section.settings.mega_menu_image_ratio,
        cards: section.blocks,
        shop_all_show: section.settings.mega_menu_shop_all_show,
        shop_all_label: section.settings.mega_menu_shop_all_label,
        shop_all_link: section.settings.mega_menu_shop_all_link
      %}
    </nav>

    <div class="header__actions">
      {%- comment -%}
        The search button + its popup (a link to the search page when JavaScript is off). All its settings
        are global (Theme settings → Search), so the snippet reads them itself.
      {%- endcomment -%}
      {%- if settings.search_show_in_header -%}
        {% render 'search-popup' %}
      {%- endif -%}

      {%- comment -%}
        <cart-count> keeps the bubble and the hidden "Cart, 3 items" up to date after a background add
        (quick add, Buy buttons, Pairs well with send "cart:changed"). The three wordings are rendered
        here, so the script picks the right one: 999999 stands in for the number.
      {%- endcomment -%}
      <cart-count
        data-label-zero="{{ 'header.cart_count' | t: count: 0 | escape_once }}"
        data-label-one="{{ 'header.cart_count' | t: count: 1 | escape_once }}"
        data-label-other="{{ 'header.cart_count' | t: count: 999999 | escape_once }}"
      >
        <a class="header__icon-button" href="{{ routes.cart_url }}">
          {{ 'icon-cart.svg' | inline_asset_content }}
          <span class="visually-hidden" data-cart-count-label>{{ 'header.cart_count' | t: count: cart.item_count }}</span>
          {%- if cart.item_count > 0 -%}
            <span class="header__count" aria-hidden="true">
              {%- if cart.item_count < 100 -%}{{ cart.item_count }}{%- else -%}99+{%- endif -%}
            </span>
          {%- endif -%}
        </a>
      </cart-count>

      {%- comment -%}
        Account (decision 6: the account pages are Shopify's own, on shopify.com). Our own menu instead of
        Shopify's <shopify-account> popup, so it matches the theme:
        - signed out: the Figma's red LOGIN pill, a link to Shopify's sign-in page
        - signed in (the customer object exists): a round glass button with the customer's initial opens a
          panel: "Hi, name", the email, the links of the "Customer account menu" (Shopify keeps that menu
          with Orders and Profile) and Sign out. The panel is a native popover: Escape and a click outside
          close it, the browser handles the open state; the script only places it under the button.
      {%- endcomment -%}
      {%- if shop.customer_accounts_enabled -%}
        {%- if customer -%}
          {%- liquid
            assign account_menu_id = 'AccountMenu-' | append: section.id
            assign account_name = customer.first_name | default: customer.name | default: customer.email
            assign account_initial = account_name | slice: 0 | upcase
            assign account_links = linklists[section.settings.customer_account_menu].links
          -%}
          <account-menu class="header__account">
            <button
              type="button"
              class="header__icon-button header__avatar"
              popovertarget="{{ account_menu_id }}"
              aria-label="{{ 'header.account_menu.open' | t: name: account_name | escape_once }}"
            >
              <span aria-hidden="true">{{ account_initial }}</span>
            </button>
            <div id="{{ account_menu_id }}" class="account-menu" popover>
              {%- comment -%} Head: the initial in a circle, then "Hi, name" and the email; the close button on the right {%- endcomment -%}
              <div class="account-menu__head">
                <span class="account-menu__initial" aria-hidden="true">{{ account_initial }}</span>
                <div class="account-menu__who">
                  <p class="account-menu__greeting">{{ 'header.account_menu.greeting' | t: name: account_name }}</p>
                  {%- if customer.email != blank -%}
                    <p class="account-menu__email">{{ customer.email | escape }}</p>
                  {%- endif -%}
                </div>
                <button type="button" class="account-menu__close" popovertarget="{{ account_menu_id }}" popovertargetaction="hide">
                  <span class="visually-hidden">{{ 'header.close_menu' | t }}</span>
                  <span aria-hidden="true">{{ 'icon-close.svg' | inline_asset_content }}</span>
                </button>
              </div>

              {%- comment -%} The account links (Shopify's Orders / Profile) as full-width rows with an arrow {%- endcomment -%}
              <ul class="account-menu__links" role="list">
                {%- for link in account_links -%}
                  <li>
                    <a class="account-menu__link" href="{{ link.url }}">
                      <span>{{ link.title | escape }}</span>
                      <span class="account-menu__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
                    </a>
                  </li>
                {%- else -%}
                  <li>
                    <a class="account-menu__link" href="{{ routes.account_url }}">
                      <span>{{ 'header.account_menu.orders' | t }}</span>
                      <span class="account-menu__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>

              <a class="account-menu__link account-menu__signout" href="{{ routes.account_logout_url }}">
                <span>{{ 'header.account_menu.sign_out' | t }}</span>
              </a>
            </div>
          </account-menu>
        {%- else -%}
          <a class="button header__login" href="{{ routes.account_login_url }}">
            {{ 'icon-account.svg' | inline_asset_content | remove: 'slot="signed-out-avatar"' }}
            <span class="header__login-text">{{- 'header.login' | t -}}</span>
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</header>
</sticky-header>

{% stylesheet %}
  /*
    Sticky header. Shopify wraps the header in a section element (class shopify-section-group-header-group);
    that wrapper is what has to stick. A sticky element only sticks inside its parent, and the <header> fills
    its wrapper exactly, so making <header> itself sticky would do nothing. Every section of the Header group
    gets that class (e.g. the announcement bar), so :has(sticky-header) picks the header's wrapper only.
  */
  .shopify-section-group-header-group:has(sticky-header) {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    /*
      The wrapper is a see-through box across the top of the page (20px gap + 77px pill). Without this it
      would still catch the mouse, so content scrolling underneath (e.g. the footer's country list on a
      short page) couldn't be hovered or clicked. Only the pill takes clicks again (below).
    */
    pointer-events: none;
  }

  .header__bar {
    pointer-events: auto;
  }

  /* The space around the pill stays see-through: only the pill has a surface */
  .header {
    padding-block-start: 1.25rem; /* 20px from the top, Figma */
  }

  /*
    The floating pill (Figma: 1363 x 77 at 1920 wide, radius 50px, 25% white "glass", soft shadow).
    The colour scheme class gives it its text colours; its background is replaced by the glass,
    and backdrop-filter blurs whatever scrolls underneath so the menu stays readable.
  */
  .header__bar {
    position: relative; /* the mega menu panel is positioned against the pill */
    display: var(--bar-display, flex); /* grid in the menu-button layout (see "Menu button layout" below) */
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    max-inline-size: 85.25rem; /* 1364px */
    block-size: 4.8125rem; /* 77px, Figma */
    margin-inline: auto;
    padding-block: 0;
    padding-inline: var(--space-2xl) var(--space-sm);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-header);
  }

  .header .header__bar {
    background-color: var(--color-glass);
    -webkit-backdrop-filter: blur(var(--glass-frost)) saturate(1.4);
    backdrop-filter: blur(var(--glass-frost)) saturate(1.4);
    transition:
      background-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      max-inline-size var(--duration-base) var(--ease-out);
  }

  sticky-header {
    display: block;
  }

  /*
    Transparent header (Figma home hero). The header's wrapper pulls the next section up underneath it
    (negative margin = 20px gap + 77px pill), so the hero starts at the very top of the page.
  */
  .shopify-section-group-header-group:has(.header--transparent) {
    margin-block-end: calc(var(--header-space) * -1);
  }

  /*
    A Hero as the first section goes under the header the same way when the header is not transparent
    (logo and menu always show): the hero image fills the top of the page behind the glass pill, instead
    of a strip of the hero's background colour. hero.liquid moves the hero's text down by --header-space.
  */
  body:has(#MainContent > .shopify-section:first-child .hero) .shopify-section-group-header-group:has(.header:not(.header--transparent):not(.header--solid)) {
    margin-block-end: calc(var(--header-space) * -1);
  }

  /*
    "Solid background" setting: the header area (full width, with the gap around the pill) is painted in the
    header's colour scheme (the color-* class on .header) and the page starts below it, so no section slides
    under it (the rules below skip .header--solid). The pill keeps its glass on top of that colour.
  */
  .header--solid {
    padding-block-end: 1.25rem; /* the same 20px under the pill as above it */
    pointer-events: auto; /* the wrapper lets clicks through; a painted band must not */
  }

  /* The band spans the whole window (the section grid puts its child in the page column; the pill still centres itself) */
  .shopify-section-group-header-group:has(.header--solid) > sticky-header {
    grid-column: 1 / -1;
  }

  /* The solid header is 20px taller (gap under the pill too): anchors and screen heights use this value */
  :root:has(.header--solid) {
    --header-space: calc(6.0625rem + 1.25rem);
  }

  /*
    Every other page: the header is see-through too. Without this, the page's own background (cream) showed
    as a band behind the pill above a first section in another colour (e.g. white search results).
    The first section slides up under the header (negative margin = the header's height) and gets a
    transparent top border of the same height: a background paints under the border, so the section's
    colour reaches the top of the page, while its content still starts below the pill. Its own padding is
    left alone. Skipped where the first section already does this: the transparent header (home hero) and
    the collection banner's "Under the header" option, and on pages without the header (the password
    layout: this CSS is bundled into every page, so it has to check that the header is there).
  */
  :root {
    --header-space: 6.0625rem; /* 20px gap + 77px pill */
  }

  body:has(sticky-header):not(:has(.header--transparent, .header--solid)) #MainContent > .shopify-section:first-child:not(:has(.collection-banner--under-header, .hero)) {
    margin-block-start: calc(var(--header-space) * -1);
  }

  body:has(sticky-header):not(:has(.header--transparent, .header--solid)) #MainContent > .shopify-section:first-child:not(:has(.collection-banner--under-header, .hero)) > * {
    border-block-start: var(--header-space) solid transparent;
  }

  /*
    A first section set to "Fill the screen height" (404, About hero): it already slides up under the
    header (above), so it is exactly one screen tall. The older rule (critical.css / screen-scale,
    100svh minus the header) subtracted the header a second time, and the footer showed at the bottom.
  */
  body:has(sticky-header):not(:has(.header--transparent, .header--solid)) #MainContent > .shopify-section:first-child:not(:has(.collection-banner--under-header, .hero)) .section--fill-screen {
    min-block-size: 100svh;
  }

  /*
    While a side drawer (filters, phone menu) is open, the header sits under the dimmed backdrop and can't be
    used, so its glass blur is switched off. Chrome otherwise composites the blurred page behind the pill
    differently from the rest of the dimmed page: a lighter/darker block showed where the banner photo starts.
  */
  html:has(.filter-drawer__dialog[open], .header-drawer__dialog[open]) .header .header__bar,
  html:has(.filter-drawer__dialog[open], .header-drawer__dialog[open]) .header__icon-button:not(.header-drawer__close) {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /*
    "At rest" = transparent header, page at the top, nobody using the header with the keyboard and no menu open.
    Then: no pill surface, the bar spans the page, and the logo and menu fade out (still focusable,
    so a keyboard user who tabs into the header brings the full pill back; :focus-visible means keyboard
    focus only, so a mouse click on a button doesn't flash the pill).
  */
  .header--transparent:not(.is-scrolled):not(:has(:focus-visible)):not(:has(.menu__dropdown[open])) .header__bar {
    max-inline-size: 100%;
    background-color: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    pointer-events: none; /* the bar is invisible and page-wide here, so let clicks through to the hero */
  }

  /* ...except the buttons, which stay visible and clickable */
  .header--transparent .header__actions {
    pointer-events: auto;
  }

  .header--transparent:not(.is-scrolled):not(:has(:focus-visible)):not(:has(.menu__dropdown[open]))
    :is(.header__logo, .header__menu) {
    opacity: 0;
    pointer-events: none;
  }

  .header--transparent :is(.header__logo, .header__menu) {
    transition: opacity var(--duration-base) var(--ease-out);
  }

  /* The actions stay at the right edge in both states */
  .header__actions {
    margin-inline-start: var(--actions-start, auto);
  }

  @media (prefers-reduced-motion: reduce) {
    .header .header__bar,
    .header--transparent :is(.header__logo, .header__menu) {
      transition: none;
    }
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: none;
    min-block-size: 1.5rem;
    color: var(--color-text);
    text-decoration: none;
  }

  /* Wide, square and tall logos: fixed width, height follows, but never taller than 4rem */
  .header__logo-image {
    inline-size: var(--logo-width);
    block-size: auto;
    max-block-size: 3.25rem; /* fits inside the 77px pill */
    object-fit: contain;
  }

  /* Text logo (Figma: Cormorant Garamond SemiBold 46.78px, line-height 100%; accent word italic, primary).
     The size follows the "Logo text size" setting and scales down on small screens. */
  .header__logo-text {
    color: var(--color-text);
    font-family: var(--font-logo--family);
    font-size: clamp(min(1.75rem, var(--logo-text-size)), 1.4rem + 1.4vw, var(--logo-text-size)); /* never above the setting */
    font-weight: var(--font-logo--weight);
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  /* The accent word follows the header's colour scheme (--color-accent), so it stays readable on red / dark schemes */
  .header__logo-text em {
    color: var(--color-accent);
    font-style: italic;
  }

  .header__menu,
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  /* Hidden in the menu-button layout (its items are in the drawer) */
  .header__menu {
    display: var(--menu-display, flex);
  }

  /* Header actions (Figma): round glass icon buttons, then the red LOGIN pill */
  .header {
    --icon-size: 1.25rem;
  }

  /* The cart link's wrapper adds no box of its own: the link stays a direct flex item of the icon row */
  cart-count {
    display: contents;
  }

  .header__icon-button {
    position: relative;
    display: inline-grid;
    place-items: center;
    inline-size: 3.125rem; /* 50px, Figma "Liquid Glass Button" */
    block-size: 3.125rem;
    padding: var(--space-xs);
    border-radius: var(--radius-pill);
    background-color: var(--color-glass);
    box-shadow: var(--shadow-header);
    color: var(--color-text);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .header__icon-button:hover {
    background-color: var(--color-glass-strong);
    color: var(--color-accent);
  }

  .header__icon-button svg {
    inline-size: var(--icon-size);
    block-size: var(--icon-size);
  }

  /* Item count bubble on the cart (Figma: small red circle, top right). The scheme's button colours, so it follows the scheme */
  .header__count {
    position: absolute;
    inset-block-start: -0.125rem;
    inset-inline-end: -0.125rem;
    display: inline-grid;
    place-items: center;
    min-inline-size: 1.25rem;
    block-size: 1.25rem;
    padding-inline: 0.3rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-button);
    color: var(--color-button-text);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .header__account {
    display: inline-flex;
  }

  .header__login {
    gap: var(--space-xs);
    padding-inline: var(--space-xl);
  }

  .header__login svg {
    inline-size: var(--icon-size);
    block-size: var(--icon-size);
  }

  /*
    Signed in: a glass circle with the customer's initial in the accent colour. The body font (the
    heading serif's tall letter shapes sat the initial off-centre), centred with flexbox; no border, and
    the focus ring only for the keyboard.
  */
  .header .header__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    outline: none;
    color: var(--color-accent);
    font-family: var(--font-body--family);
    font-size: 1.125rem;
    font-weight: var(--font-weight-medium);
    line-height: 1;
    cursor: pointer;
  }

  .header .header__avatar:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /*
    The account panel: a native popover (top layer), placed by the script under the avatar, its right
    edge lined up with it (--account-top / --account-left). The browser centres a popover by default
    (inset 0, margin auto) and gives it a black border: both reset. A glass card in the scheme's
    background colour with a soft shadow, no borders inside: head (initial, name, email, close), a
    hairline, the link rows, a hairline, Sign out. It inherits the header's colour scheme (inheritance
    follows the page structure, even in the top layer), so a dark scheme gives a dark card.
  */
  .account-menu {
    position: fixed;
    inset: auto;
    inset-block-start: var(--account-top, 6rem);
    inset-inline-start: var(--account-left, auto);
    inline-size: min(19rem, calc(100vw - 2rem));
    margin: 0;
    padding: var(--space-sm);
    border: 0;
    border-radius: 1.25rem;
    background-color: color-mix(in srgb, var(--color-background) 92%, transparent);
    box-shadow: 0 12px 40px #0000001f, 0 2px 8px #0000000d;
    color: var(--color-text);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .account-menu:popover-open {
    display: flex;
    flex-direction: column;
  }

  @media (prefers-reduced-motion: no-preference) {
    .account-menu:popover-open {
      animation: account-menu-in 0.25s var(--ease-out);
    }
  }

  @keyframes account-menu-in {
    from {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }

  /* Head: initial | name + email | close, all vertically centred */
  .account-menu__head {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-sm) var(--space-md);
    border-block-end: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .account-menu__initial {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-accent) 10%, var(--color-background));
    color: var(--color-accent);
    font-size: 1.125rem;
    font-weight: var(--font-weight-medium);
    line-height: 1;
  }

  .account-menu__who {
    flex: 1;
    min-inline-size: 0;
  }

  .account-menu__greeting {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .account-menu__email {
    margin: 0.125rem 0 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--color-text) 62%, var(--color-background));
    font-size: var(--font-size-small);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-menu .account-menu__close {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    inline-size: 2rem;
    block-size: 2rem;
    min-block-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: transparent;
    box-shadow: none;
    color: color-mix(in srgb, var(--color-text) 62%, var(--color-background));
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .account-menu .account-menu__close:hover {
    background-color: color-mix(in srgb, var(--color-text) 6%, transparent);
    color: var(--color-text);
  }

  .account-menu__close svg {
    inline-size: 0.75rem;
    block-size: 0.75rem;
  }

  /* Link rows: label left, arrow right, a soft tint on hover; no borders */
  .account-menu__links {
    margin: 0;
    padding: var(--space-xs) 0;
    border-block-end: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
    list-style: none;
  }

  .account-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-block-size: 2.75rem;
    padding-inline: var(--space-sm);
    border-radius: 0.75rem;
    color: var(--color-text);
    font-size: var(--font-size-body-sm);
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .account-menu__link:hover,
  .account-menu__link:focus-visible {
    background-color: color-mix(in srgb, var(--color-accent) 7%, transparent);
    color: var(--color-accent);
  }

  .account-menu__arrow {
    display: inline-flex;
    opacity: 0.5;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      translate var(--duration-fast) var(--ease-out);
  }

  .account-menu__link:hover .account-menu__arrow {
    opacity: 1;
    translate: 0.125rem 0;
  }

  .account-menu__arrow svg {
    inline-size: 0.75rem;
    block-size: auto;
  }

  .account-menu .account-menu__signout {
    margin-block-start: var(--space-xs);
    color: var(--color-accent);
  }

  /* The menu button stays clickable while a transparent header is "at rest" (like the actions) */
  .header--transparent .header-drawer__toggle {
    pointer-events: auto;
  }

  /*
    Menu button layout: logo | buttons | menu button; the menu items are in the drawer.
    Phones (below 768px) always use it. Header setting "Show the menu button below" uses it on tablets too:
    990 = below 990px, 1200 = below 1200px (the class header--menu-button-990 / -1200).
    A media query can't read a setting, so each width range sets four variables on the header for the
    classes that apply there, and the layout rules read them (one set of rules for every case):
    --bar-display (grid), --menu-display (none), --drawer-display (contents: the menu button shows),
    --actions-start (0: the buttons sit in their grid column, not pushed right).
    --logo-overflow (hidden: a long logo is cut in its column instead of pushing the buttons out).
    KEEP THE THREE BLOCKS BELOW THE SAME: they hold the same five values. (One copy would need CSS style
    queries, which Firefox doesn't support, or JavaScript.) A missing value breaks only that width range.
    On tablets the logo, search, cart and LOGIN keep their tablet sizes; the phone sizes are further below.
  */
  @media (max-width: 767px) {
    .header {
      --bar-display: grid;
      --menu-display: none;
      --drawer-display: contents;
      --actions-start: 0;
      --logo-overflow: hidden;
    }
  }

  @media (min-width: 768px) and (max-width: 989px) {
    .header--menu-button-990,
    .header--menu-button-1200 {
      --bar-display: grid;
      --menu-display: none;
      --drawer-display: contents;
      --actions-start: 0;
      --logo-overflow: hidden;
    }
  }

  @media (min-width: 990px) and (max-width: 1199px) {
    .header--menu-button-1200 {
      --bar-display: grid;
      --menu-display: none;
      --drawer-display: contents;
      --actions-start: 0;
      --logo-overflow: hidden;
    }
  }

  /*
    The grid of the menu-button layout: logo (takes what is left, may shrink to 0) | buttons | menu button.
    These only act while the bar is a grid; the full layout (flexbox) ignores grid placement.
  */
  .header__bar {
    grid-template-columns: minmax(0, 1fr) auto auto;
  }

  .header__logo {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    min-inline-size: 0; /* a grid item won't shrink below its content without this */
    max-inline-size: 100%;
    overflow: var(--logo-overflow, visible); /* clips a long logo in the narrow grid column only */
  }

  .header__actions {
    grid-column: 2;
    grid-row: 1;
  }

  /* Menu button: a plain icon inside the pill (Figma), 44px tap area. Only shown in the menu-button layout. */
  .header .header-drawer__toggle {
    grid-column: 3;
    grid-row: 1;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 0;
    background-color: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .header .header-drawer__toggle:hover {
    background-color: transparent;
    color: var(--color-accent);
  }

  /*
    At rest over the hero there is no pill behind it: the glass circle like search and cart (no border).
    40px; on phones the smaller at-rest size (--rest-button).
  */
  .header--transparent:not(.is-scrolled):not(:has(:focus-visible)):not(:has(.menu__dropdown[open]))
    .header-drawer__toggle {
    inline-size: var(--rest-button, 2.5rem);
    block-size: var(--rest-button, 2.5rem);
    background-color: var(--color-glass);
    box-shadow: var(--shadow-header);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .header-drawer__toggle svg {
    inline-size: 1.125rem;
    block-size: auto;
  }

  /*
    Below 1200px (tablets and phones) the pill is smaller: 60px tall, 12px from the top and the sides, so the
    first-section pull-ups use --header-space (72px). What goes inside the pill depends on the width:
    - 768-1199px (tablets, small laptops): the desktop layout, scaled down (logo, full menu, search, cart, LOGIN),
      or the menu-button layout when the "Show the menu button below" setting covers this width.
    - below 768px (phones, Figma mobile pill): logo | menu button; the drawer holds the rest.
  */
  @media (max-width: 1199px) {
    .header {
      --icon-size: 1.125rem;

      /* A 12px gap all round: the page margins would leave the content too little room */
      padding-block-start: var(--space-sm);
      padding-inline: var(--space-sm);
    }

    /*
      The section's content grid adds the page margins; the pill spans the whole width instead.
      (Section class + element: beats critical.css's ".shopify-section > *" column rule.)
    */
    .shopify-section-group-header-group > sticky-header {
      grid-column: 1 / -1;
    }

    .header__bar {
      block-size: 3.75rem; /* 60px */
    }

    /* The buttons in the bar: 40px glass circles (smaller than desktop's 50px), never squeezed */
    .header__actions .header__icon-button {
      flex-shrink: 0;
      inline-size: 2.5rem;
      block-size: 2.5rem;
    }

    .header__login svg {
      inline-size: 1rem;
      block-size: 1rem;
    }

    /* Solid background: the same 12px under the small pill as above it */
    .header--solid {
      padding-block-end: var(--space-sm);
    }

    :root:has(.header--solid) {
      --header-space: calc(3.75rem + var(--space-sm) * 2);
    }

    /* The small pill: 12px gap + 60px pill (every pull-up above uses it, so they follow on their own) */
    :root {
      --header-space: calc(3.75rem + var(--space-sm));
    }
  }

  /*
    Tablets and small laptops (768-1199px): the desktop layout with small adjustments so it fits at 768px:
    a smaller logo, menu text and gaps, 40px buttons and a compact LOGIN pill. The mega menu opens under the
    pill as on desktop, with less padding.
  */
  @media (min-width: 768px) and (max-width: 1199px) {
    .header__bar {
      gap: var(--space-md);
      padding-inline: var(--space-lg) var(--space-xs);
    }

    /*
      The desktop's fluid size (33px at 768px, 37px at 1024px, 39px at 1199px: no jump at 1200px), never
      above the "Logo text size" setting and never above 40px, so it fits the 60px pill.
    */
    .header__logo-text {
      font-size: clamp(min(1.75rem, var(--logo-text-size)), 1.4rem + 1.4vw, min(var(--logo-text-size), 2.5rem));
    }

    /* The logo image grows the same way: 28px tall at 768px up to 36px, never wider than the Logo width setting */
    .header__logo-image {
      inline-size: auto;
      max-inline-size: var(--logo-width);
      block-size: clamp(1.75rem, 1rem + 1.6vw, 2.25rem);
    }

    .header .menu {
      gap: clamp(var(--space-sm), 2vw, var(--space-xl));
    }

    .header .menu__link {
      font-size: clamp(0.75rem, 1.15vw, 0.9375rem);
    }

    .header__actions {
      gap: var(--space-xs);
    }

    .header__login {
      gap: var(--space-2xs);
      min-block-size: 2.5rem;
      padding-inline: var(--space-md);
      white-space: nowrap;
    }

    .header .menu__panel {
      inset-block-start: calc(100% + var(--space-sm));
      padding: var(--space-md) var(--space-lg) var(--space-lg);
    }
  }

  /*
    Phones (below 768px), Figma mobile pill: logo (left) | menu button (right). The menu, account, search and
    cart move into the drawer (snippets/header-drawer.liquid); search and cart can stay in the bar (settings
    "Small screens"). The logo column is the only one that gives way when space runs short (minmax(0, 1fr)).
    At rest on a transparent header the logo is hidden as on desktop: the hero shows its own logo there.
  */
  @media (max-width: 767px) {
      /*
        Columns: logo (takes what is left, may shrink to 0) | optional search + cart | menu button.
        Figma mobile pill: 58px tall, ~24px inside padding, the logo on the left and a plain menu icon on the right.
      */
      .header__bar {
        gap: var(--space-xs);
        padding-inline: var(--space-lg) var(--space-sm);
      }

      .header__logo {
        gap: var(--space-xs);
      }

      /* A small mark, a big word: 26px on a 320px phone, 30px at 375px, up to 32px on tablets */
      .header__logo-text {
        font-size: clamp(1.625rem, 8vw, 2rem);
      }

      /* Sized by height in the small pill (26px), never wider than the Logo width setting or the column */
      .header__logo-image {
        flex-shrink: 0;
        inline-size: auto;
        max-inline-size: min(var(--logo-width), 100%);
        block-size: 1.625rem;
      }

      .header__actions {
        gap: var(--space-2xs);
      }

      /*
        Account, search and cart live in the drawer here. Search and cart can stay in the bar (header settings
        "Small screens" add header--m-search / header--m-cart). Only the search BUTTON is hidden: its popup
        <dialog> sits in the same element and must still open from the drawer.
      */
      .header__actions :is(.header__account, .header__login),
      .header:not(.header--m-search) .header__actions [data-search-open],
      .header:not(.header--m-cart) .header__actions cart-count > a {
        display: none;
      }

      /*
        Transparent header at rest (top of the homepage, Figma mobile hero): no pill and no logo (the hero has
        its own), so there is room for search, cart and LOGIN / the account initial in the bar. Once the page
        scrolls they go back into the drawer. (This selector outweighs the hiding rule above.)
      */
      /*
        At rest the round buttons sit straight on the hero photo, so they are smaller than in the pill
        (36px circles, 16px icons) and cover less of the photo. --rest-button / --icon-size are read by
        search, cart, LOGIN / the account initial and the menu button below. Once the page scrolls, the
        pill's sizes (40px, 18px) come back.
      */
      .header--transparent:not(.is-scrolled):not(:has(:focus-visible)):not(:has(.menu__dropdown[open])) {
        --rest-button: 2.25rem;
        --icon-size: 1rem;
      }

      .header--transparent:not(.is-scrolled):not(:has(:focus-visible)):not(:has(.menu__dropdown[open]))
        .header__actions
        :is([data-search-open], cart-count > a, .header__avatar) {
        display: inline-grid; /* the round button's own display: centres the icon (place-items) */
        inline-size: var(--rest-button);
        block-size: var(--rest-button);
      }

      .header--transparent:not(.is-scrolled):not(:has(:focus-visible)):not(:has(.menu__dropdown[open]))
        .header__actions
        .header__avatar {
        display: inline-flex; /* the initial is centred with flexbox (see .header__avatar) */
        font-size: 1rem;
      }

      .header--transparent:not(.is-scrolled):not(:has(:focus-visible)):not(:has(.menu__dropdown[open]))
        .header__actions
        .header__account {
        display: inline-flex;
      }

      .header--transparent:not(.is-scrolled):not(:has(:focus-visible)):not(:has(.menu__dropdown[open]))
        .header__actions
        .header__login {
        display: inline-flex;
        inline-size: var(--rest-button);
        min-block-size: var(--rest-button);
        padding: 0;
      }

      /* LOGIN at rest is a round icon button like search and cart: the word is only for screen readers */
      .header__login-text {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .header__login svg {
        inline-size: var(--icon-size);
        block-size: var(--icon-size);
      }

      /* The menu icon at rest: the same 16px as search and cart */
      .header--transparent:not(.is-scrolled):not(:has(:focus-visible)):not(:has(.menu__dropdown[open]))
        .header-drawer__toggle
        svg {
        inline-size: var(--icon-size);
      }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <sticky-header>: adds "is-scrolled" to the header once the page has scrolled a little, so a transparent
   * header turns into the full pill. A web component, so the theme editor's re-render restarts it on its own.
   */
  class StickyHeader extends HTMLElement {
    connectedCallback() {
      this.header = this.querySelector('.header');
      if (!this.header?.classList.contains('header--transparent')) return;
      this.onScroll = () => {
        if (this.ticking) return;
        this.ticking = true;
        requestAnimationFrame(() => {
          this.header.classList.toggle('is-scrolled', window.scrollY > 10);
          this.ticking = false;
        });
      };
      window.addEventListener('scroll', this.onScroll, { passive: true });
      this.onScroll();
    }

    disconnectedCallback() {
      if (this.onScroll) window.removeEventListener('scroll', this.onScroll);
    }
  }

  if (!customElements.get('sticky-header')) customElements.define('sticky-header', StickyHeader);

  /**
   * <cart-count>: the one place that refreshes the header's cart count.
   * - "cart:changed" (sent by quick add, Buy buttons and Pairs well with after a background add): fetch
   *   /cart.js once, update the bubble and the hidden label, then send "cart:updated" with the cart (the
   *   cart page listens to it and redraws itself).
   * - "cart:updated" from the cart page itself already carries the cart: just update the bubble.
   * There are two <cart-count> elements (the bar and the phone drawer). Both receive the SAME event object
   * for one "cart:changed", so they share one request for that event (CartCount.requests, keyed by the
   * event), and only that request sends "cart:updated": the cart page redraws once. A later
   * "cart:changed" is a new event, so it always gets a new request and never an older answer.
   */
  class CartCount extends HTMLElement {
    static requests = new WeakMap();

    /** The /cart.js request for this "cart:changed" event: started by the first <cart-count>, reused by the other */
    static fetchCart(root, event) {
      let request = CartCount.requests.get(event);
      if (!request) {
        request = fetch(`${root}cart.js`, { headers: { Accept: 'application/json' } })
          .then((response) => response.json())
          .then((cart) => {
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart, source: 'header' } }));
            return cart;
          });
        CartCount.requests.set(event, request);
      }
      return request;
    }

    connectedCallback() {
      this.root = window.Shopify?.routes?.root || '/';
      this.onChanged = (event) => this.refresh(event);
      this.onUpdated = (event) => {
        if (event.detail?.source !== 'header' && event.detail?.cart) this.show(event.detail.cart.item_count);
      };
      document.addEventListener('cart:changed', this.onChanged);
      document.addEventListener('cart:updated', this.onUpdated);
    }

    disconnectedCallback() {
      document.removeEventListener('cart:changed', this.onChanged);
      document.removeEventListener('cart:updated', this.onUpdated);
    }

    async refresh(event) {
      try {
        const cart = await CartCount.fetchCart(this.root, event);
        this.show(cart.item_count);
      } catch (error) {
        // The add itself worked; only the count is stale. The cart page shows the right total.
      }
    }

    /** The red bubble (created on the first item, removed at 0) and "Cart, 3 items" for screen readers */
    show(count) {
      const link = this.querySelector('.header__icon-button');
      if (!link) return;
      let bubble = link.querySelector('.header__count');
      if (count > 0 && !bubble) {
        bubble = document.createElement('span');
        bubble.className = 'header__count';
        bubble.setAttribute('aria-hidden', 'true');
        link.append(bubble);
      }
      if (bubble) {
        if (count > 0) bubble.textContent = count < 100 ? count : '99+';
        else bubble.remove();
      }
      const label = this.querySelector('[data-cart-count-label]');
      if (label) {
        const wording = count === 0 ? this.dataset.labelZero : count === 1 ? this.dataset.labelOne : this.dataset.labelOther;
        label.textContent = (wording || '').replace('999999', count);
      }
    }
  }

  if (!customElements.get('cart-count')) customElements.define('cart-count', CartCount);

  /**
   * <account-menu>: the signed-in customer's panel is a native popover (the browser opens and closes it:
   * the avatar button, Escape, a click outside). This places it: under the avatar, its right edge lined
   * up with the avatar's, kept inside the screen.
   * While it is open, the avatar can move or disappear: the window is resized, or the page scrolls and a
   * transparent header changes from "at rest" to the full pill (the pill gets narrower on desktop; on
   * phones the avatar goes back into the drawer). On each of those changes the panel follows the avatar,
   * or closes when the avatar is no longer shown. The listeners exist only while the panel is open.
   */
  class AccountMenu extends HTMLElement {
    connectedCallback() {
      this.button = this.querySelector('[popovertarget]');
      this.panel = this.querySelector('[popover]');
      if (!this.button || !this.panel) return;
      this.onBeforeToggle = (event) => {
        if (event.newState === 'open') this.place();
      };
      this.onToggle = (event) => {
        if (event.newState === 'open') this.watch();
        else this.unwatch();
      };
      this.panel.addEventListener('beforetoggle', this.onBeforeToggle);
      this.panel.addEventListener('toggle', this.onToggle);
    }

    disconnectedCallback() {
      this.panel?.removeEventListener('beforetoggle', this.onBeforeToggle);
      this.panel?.removeEventListener('toggle', this.onToggle);
      this.unwatch();
    }

    /** Follow the avatar while the panel is open (one check per frame at most) */
    watch() {
      this.unwatch();
      this.watcher = new AbortController();
      const { signal } = this.watcher;
      const update = () => {
        if (this.frame) return;
        this.frame = requestAnimationFrame(() => {
          this.frame = null;
          this.follow();
        });
      };
      window.addEventListener('resize', update, { signal });
      window.addEventListener('scroll', update, { passive: true, signal });
      // The pill's width animates after "is-scrolled" changes: place the panel again when THAT transition ends
      // (hover transitions inside the header also bubble a transitionend; they are ignored)
      const bar = this.closest('.header__bar');
      bar?.addEventListener(
        'transitionend',
        (event) => {
          if (event.target === bar && event.propertyName === 'max-inline-size') update();
        },
        { signal }
      );
    }

    unwatch() {
      this.watcher?.abort();
      this.watcher = null;
      if (this.frame) cancelAnimationFrame(this.frame);
      this.frame = null;
    }

    /** The avatar is hidden (display: none in the bar): close. Otherwise move the panel under it. */
    follow() {
      if (!this.panel.matches(':popover-open')) return;
      const visible = this.button.checkVisibility ? this.button.checkVisibility() : this.button.offsetParent !== null;
      if (!visible) this.panel.hidePopover();
      else this.place();
    }

    place() {
      const rect = this.button.getBoundingClientRect();
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      const width = Math.min(19 * rem, window.innerWidth - 2 * rem); // the panel's CSS width (.account-menu)
      const left = Math.max(rem, Math.min(rect.right - width, window.innerWidth - width - rem));
      this.panel.style.setProperty('--account-top', `${rect.bottom + 0.75 * rem}px`);
      this.panel.style.setProperty('--account-left', `${left}px`);
    }
  }

  if (!customElements.get('account-menu')) customElements.define('account-menu', AccountMenu);
{% endjavascript %}

