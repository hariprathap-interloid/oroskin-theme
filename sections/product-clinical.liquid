{%- comment -%}
  Before and after (M6.7, Figma PDP "Product details 9", phones Variant97-2): eyebrow, a heading with
  accent words, then a before / after slider (WEEK 0 | WEEK 12), rings of the results (the first one's
  figure in the middle: "94% RADIANCE") and the results as rows ("reported visibly brighter skin … 94%").
  - Before / after: the "after" image lies over the "before" one and is cut at the slider position
    (clip-path). The control is a real range input over the images (drag, tap, or ← / → from the
    keyboard), named and with a value text for screen readers. The slider is always left to right
    (direction: ltr): a photo is not mirrored in RTL. It shows only with both images (the editor shows
    placeholders).
  - Rings: one for each of the first 4 results, drawn with SVG circles of pathLength 100, so a dash of
    94 is 94% of the ring. They draw one after the other once the section is in view (not with reduced
    motion; without JS they show full at once).
  - Layout: desktop (≥ 1200px) slider | rings | list; below 1200px (agreed) one under the other: the
    slider full width, the rings centred (at most 16rem), then the list full width.
  - Static content (each field can be connected to a product metafield). The tabs link here with the
    Link name (#clinical-results).
{%- endcomment -%}

{%- liquid
  assign scheme_id = section.settings.color_scheme.id | default: 'scheme-2'
  assign anchor = section.settings.anchor | handleize | default: 'clinical-results'
  assign start = section.settings.start | default: 50

  # The results that show: a result needs a label
  assign result_count = 0
  for block in section.blocks
    if block.settings.label != blank
      assign result_count = result_count | plus: 1
    endif
  endfor

  assign has_intro = false
  if section.settings.eyebrow != blank or section.settings.heading != blank
    assign has_intro = true
  endif

  # The slider needs both images on the store; the editor shows placeholders (but not in a section with
  # no content at all: that one shows the editor note)
  assign has_images = false
  if section.settings.before != blank and section.settings.after != blank
    assign has_images = true
  endif
  assign has_content = false
  if has_intro or has_images or result_count > 0
    assign has_content = true
  endif
  assign has_compare = has_images
  if request.design_mode and has_content
    assign has_compare = true
  endif

  # The list: the results with a label; in the editor also the empty ones (with a note)
  assign show_list = false
  if result_count > 0
    assign show_list = true
  elsif request.design_mode and section.blocks.size > 0
    assign show_list = true
  endif

  # The slider image: 735 / 1589 of the content from 1200px (widest ~92vw, full ~96vw, wide at most
  # the 1650px page width; without results at most 48rem); the content width below
  if result_count == 0
    assign compare_sizes = 'min(94vw, 768px)'
  elsif section.settings.section_width == 'wide'
    assign compare_sizes = '(min-width: 1200px) min(43vw, 764px), 94vw'
  elsif section.settings.section_width == 'full'
    assign compare_sizes = '(min-width: 1200px) 45vw, 94vw'
  else
    assign compare_sizes = '(min-width: 1200px) 43vw, 94vw'
  endif

  # The slider's name: with both labels "Compare Week 0 and Week 12", else a plain name
  if section.settings.before_label != blank and section.settings.after_label != blank
    assign compare_label = 'products.clinical.compare' | t: before: section.settings.before_label, after: section.settings.after_label
  else
    assign compare_label = 'products.clinical.compare_plain' | t
  endif
  # The value text: how much of the before image shows ([percent] is replaced by the script)
  assign value_template = 'products.clinical.position' | t
  assign value_text = value_template | replace: '[percent]', start

  assign before_alt = section.settings.before.alt | default: section.settings.before_label | default: ''
  assign after_alt = section.settings.after.alt | default: section.settings.after_label | default: ''
-%}

{%- capture image_loading -%}{% render 'section-loading' %}{%- endcapture -%}
{%- assign image_loading = image_loading | strip -%}

{%- if has_content == false -%}
  {%- if request.design_mode -%}
    <div class="product-clinical-empty color-{{ scheme_id }}">
      <p>{{ 'products.clinical.editor_empty' | t }}</p>
    </div>
  {%- endif -%}
{%- else -%}
<product-clinical
  id="{{ anchor }}"
  class="product-clinical full-width section-width--{{ section.settings.section_width | default: 'widest' }} color-{{ scheme_id }}{% unless has_compare %} product-clinical--no-compare{% endunless %}{% if result_count == 0 %} product-clinical--no-results{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="product-clinical__inner">
    {%- if has_intro -%}
      <div class="product-clinical__intro" data-tab-item>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow product-clinical__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="product-clinical__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_compare or show_list -%}
    <div class="product-clinical__layout">
      {%- if has_compare -%}
        <div class="product-clinical__compare" style="--pos: {{ start }}%;" data-compare data-tab-item>
          <div class="product-clinical__frame">
            {%- if section.settings.before != blank -%}
              {{
                section.settings.before
                | image_url: width: 1600
                | image_tag:
                  loading: image_loading,
                  widths: '400, 600, 800, 1100, 1400, 1600',
                  sizes: compare_sizes,
                  alt: before_alt,
                  class: 'product-clinical__image'
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'product-clinical__image product-clinical__placeholder' }}
            {%- endif -%}
          </div>
          <div class="product-clinical__frame product-clinical__frame--after">
            {%- if section.settings.after != blank -%}
              {{
                section.settings.after
                | image_url: width: 1600
                | image_tag:
                  loading: image_loading,
                  widths: '400, 600, 800, 1100, 1400, 1600',
                  sizes: compare_sizes,
                  alt: after_alt,
                  class: 'product-clinical__image'
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'product-clinical__image product-clinical__placeholder product-clinical__placeholder--after' }}
            {%- endif -%}
          </div>

          {%- if section.settings.before_label != blank -%}
            <span class="product-clinical__tag product-clinical__tag--before" aria-hidden="true">{{ section.settings.before_label | escape }}</span>
          {%- endif -%}
          {%- if section.settings.after_label != blank -%}
            <span class="product-clinical__tag product-clinical__tag--after" aria-hidden="true">{{ section.settings.after_label | escape }}</span>
          {%- endif -%}

          <span class="product-clinical__line" aria-hidden="true">
            <span class="product-clinical__handle">
              <span class="product-clinical__handle-icon">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
              <span class="product-clinical__handle-icon product-clinical__handle-icon--right">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
            </span>
          </span>

          <input
            id="CompareRange-{{ section.id }}"
            class="product-clinical__range"
            type="range"
            min="0"
            max="100"
            step="1"
            value="{{ start }}"
            aria-label="{{ compare_label | escape }}"
            aria-valuetext="{{ value_text | escape }}"
            data-valuetext="{{ value_template | escape }}"
            data-compare-range
          >
        </div>
      {%- endif -%}

      {%- if result_count > 0 -%}
        {%- comment -%}
          The rings: the first 4 results, the first outermost in the accent colour, the others pale inside.
          Decoration: the list below says the same in words, with the ring label on the first result
          (aria-hidden).
        {%- endcomment -%}
        <div class="product-clinical__rings" data-tab-item aria-hidden="true">
          <svg class="product-clinical__svg" viewBox="0 0 100 100" focusable="false">
            {%- assign n = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.label == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- if n == 4 -%}
                {%- break -%}
              {%- endif -%}
              {%- assign ring_r = n | times: 7.5 | minus: 47 | abs -%}
              <circle class="product-clinical__track" cx="50" cy="50" r="{{ ring_r }}" pathLength="100"></circle>
              <circle
                class="product-clinical__arc{% if n == 0 %} product-clinical__arc--lead{% endif %}"
                cx="50"
                cy="50"
                r="{{ ring_r }}"
                pathLength="100"
                style="--value: {{ block.settings.value }}; --ring: {{ n }};"
              ></circle>
              {%- if n == 0 -%}
                {%- assign lead_value = block.settings.value -%}
              {%- endif -%}
              {%- assign n = n | plus: 1 -%}
            {%- endfor -%}
          </svg>
          <p class="product-clinical__centre">
            <span class="product-clinical__centre-value">{{ lead_value }}%</span>
            {%- if section.settings.ring_label != blank -%}
              <span class="product-clinical__centre-label">{{ section.settings.ring_label | escape }}</span>
            {%- endif -%}
          </p>
        </div>

      {%- endif -%}

      {%- if show_list -%}
        <dl class="product-clinical__results" data-tab-item>
          {%- assign n = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.label == blank -%}
              {%- comment -%} No label: nothing on the store; in the editor a row with a note, so the block can be found {%- endcomment -%}
              {%- if request.design_mode -%}
                <div class="product-clinical__result product-clinical__result--empty" {{ block.shopify_attributes }}>
                  <dt>{{ 'products.clinical.result_empty' | t }}</dt>
                </div>
              {%- endif -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign n = n | plus: 1 -%}
            <div class="product-clinical__result{% if n == 1 %} product-clinical__result--lead{% endif %}" {{ block.shopify_attributes }}>
              <dt>
                {{- block.settings.label | escape -}}
                {%- if n == 1 and section.settings.ring_label != blank -%}
                  {%- comment -%} The ring label shows only in the rings (hidden from screen readers) {%- endcomment -%}
                  <span class="visually-hidden"> ({{ section.settings.ring_label | escape }})</span>
                {%- endif -%}
              </dt>
              <dd>{{ block.settings.value }}%</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</product-clinical>
{%- endif -%}

{% stylesheet %}
  /*
    Figma 1920 ("Product details 9"): eyebrow y 211; heading x 54–845, ~70px, 2 lines, accent words;
    before / after x 56–791 (735 x 455), square corners: a 1px white line with a 56px white circle (◂ ▸)
    at the middle; frosted pills "WEEK 0" (top left) and "WEEK 12" (top right). Rings x 907–1226 (~320):
    the outer ring accent ~3px, three pale ones inside; "94%" ~26px medium and "RADIANCE" caps in the
    middle. Results x 1303–1837: label ~18px (the first dark, the others grey), value caps ~15px right,
    a hairline under each row. --px = one Figma pixel: the 1920px sizes get smaller on smaller screens.
    Below 1200px: the slider, the rings centred, the list (agreed, not the Variant97-2 side by side).
  */
  .product-clinical {
    --px: min(calc(100vw / 1920), 0.0625rem);
    display: block;
    padding-block: var(--section-padding-top) var(--section-padding-bottom);
    background-color: var(--color-background);
  }

  .product-clinical-empty {
    padding: var(--space-2xl) var(--page-margin);
    background-color: var(--color-background);
    text-align: center;
  }

  .product-clinical__inner {
    inline-size: min(
      calc(var(--section-width, var(--page-width)) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .product-clinical__eyebrow {
    margin: 0 0 var(--space-lg);
  }

  .product-clinical__heading {
    margin: 0;
    font-size: var(--font-size-h1);
    font-weight: 400;
    line-height: 1.1;
  }

  .product-clinical__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  /* Below 1200px (agreed): the slider full width, then the rings centred, then the list full width */
  .product-clinical__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--space-xl);
  }

  @media (max-width: 1199px) {
    .product-clinical__rings {
      justify-self: center;
      inline-size: min(100%, 16rem);
    }
  }

  .product-clinical__intro + .product-clinical__layout {
    margin-block-start: max(var(--space-xl), calc(44 * var(--px)));
  }

  .product-clinical__compare {
    grid-column: 1 / -1;
  }

  /* No results: the slider alone, not wider than 48rem */
  .product-clinical--no-results .product-clinical__layout {
    grid-template-columns: minmax(0, 48rem);
  }

  /*
    Before / after: both frames on top of each other; the "after" one is cut at --pos. Always left to
    right: the photos are not mirrored in RTL, so the cut, the line, the tags and the range must not be.
  */
  .product-clinical__compare {
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: 735 / 455;
    background-color: color-mix(in srgb, var(--color-text) 6%, var(--color-background));
    direction: ltr;
    user-select: none;
    /* A sideways drag moves the line (the script); an up / down swipe still scrolls the page */
    touch-action: pan-y;
    cursor: ew-resize;
  }

  .product-clinical__frame {
    grid-area: 1 / 1;
  }

  .product-clinical__frame--after {
    clip-path: inset(0 0 0 var(--pos));
  }

  .product-clinical__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .product-clinical__placeholder {
    fill: color-mix(in srgb, var(--color-text) 30%, transparent);
  }

  .product-clinical__placeholder--after {
    background-color: color-mix(in srgb, var(--color-accent) 10%, var(--color-background));
  }

  .product-clinical__tag {
    position: absolute;
    z-index: 2;
    top: max(var(--space-sm), calc(20 * var(--px)));
    padding: 0.45em 1.25em;
    border-radius: var(--radius-pill);
    background-color: #00000040;
    color: #ffffff;
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
    pointer-events: none;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .product-clinical__tag--before {
    left: max(var(--space-sm), calc(25 * var(--px)));
  }

  .product-clinical__tag--after {
    right: max(var(--space-sm), calc(25 * var(--px)));
  }

  /* The divider at --pos, with the round handle in the middle */
  .product-clinical__line {
    position: absolute;
    z-index: 2;
    inset-block: 0;
    left: var(--pos);
    inline-size: 1px;
    background-color: #ffffffcc;
    pointer-events: none;
  }

  .product-clinical__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    inline-size: max(2.75rem, calc(56 * var(--px)));
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: #ffffff;
    box-shadow: 0 2px 10px #00000026;
    color: var(--color-text);
    translate: -50% -50%;
  }

  .product-clinical__handle-icon {
    display: inline-flex;
    rotate: 180deg; /* icon-arrow.svg points right: the first one points left */
  }

  .product-clinical__handle-icon--right {
    rotate: 0deg;
  }

  .product-clinical__handle-icon svg {
    inline-size: 0.625rem;
    block-size: auto;
  }

  /* The real control for the keyboard and screen readers: an invisible range input over the image */
  .product-clinical .product-clinical__range {
    position: absolute;
    z-index: 3;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    opacity: 0;
    appearance: none;
    /* The keyboard uses it (Tab, ← / →); presses and drags go to the photo (the script) */
    pointer-events: none;
  }

  .product-clinical__compare:has(.product-clinical__range:focus-visible) .product-clinical__handle {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* The rings */
  .product-clinical__rings {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }

  .product-clinical__svg {
    grid-area: 1 / 1;
    inline-size: 100%;
    block-size: 100%;
    rotate: -90deg; /* the rings start at the top */
  }

  .product-clinical__track,
  .product-clinical__arc {
    fill: none;
    stroke-width: 1.6;
  }

  .product-clinical__track {
    stroke: color-mix(in srgb, var(--color-accent) 7%, var(--color-background));
  }

  .product-clinical__arc {
    stroke: color-mix(in srgb, var(--color-accent) 30%, var(--color-background));
    stroke-dasharray: var(--value) 100;
    stroke-linecap: round;
  }

  .product-clinical__arc--lead {
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  /*
    Drawn when in view (the script adds is-drawn), one ring after the other from the outside. Without
    JS, before the element is defined, if its script fails, or with reduced motion: full at once.
  */
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    product-clinical:defined:not(.is-drawn) .product-clinical__arc {
      stroke-dasharray: 0 100;
    }

    .product-clinical__arc {
      transition: stroke-dasharray 1.4s var(--ease-out);
      transition-delay: calc(var(--ring, 0) * 0.15s);
    }
  }

  .product-clinical__centre {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    text-align: center;
  }

  .product-clinical__centre-value {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-medium);
  }

  .product-clinical__centre-label {
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .product-clinical__results {
    margin: 0;
  }

  .product-clinical__result {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--color-card-border);
    color: color-mix(in srgb, var(--color-text) 62%, var(--color-background));
  }

  .product-clinical__result--lead {
    color: var(--color-text);
  }

  .product-clinical__result--empty {
    font-style: italic;
  }

  .product-clinical__result dt {
    font-size: var(--font-size-body-sm);
  }

  .product-clinical__result dd {
    margin: 0;
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    white-space: nowrap;
  }

  /* Phones: smaller heading, slider tags and handle (Variant97-2); rings and list as on tablets */
  @media (max-width: 749px) {
    .product-clinical__layout {
      gap: var(--space-lg);
    }

    .product-clinical__intro + .product-clinical__layout {
      margin-block-start: var(--space-lg);
    }

    .product-clinical__eyebrow {
      margin-block-end: var(--space-sm);
    }

    .product-clinical__heading {
      font-size: 1.5rem;
      line-height: 1.2;
    }

    .product-clinical__tag {
      font-size: 0.625rem;
    }

    .product-clinical__handle {
      inline-size: 1.75rem;
    }

    .product-clinical__handle-icon svg {
      inline-size: 0.5rem;
    }
  }

  /* Desktop: slider | rings | list (Figma 735 : 320 : 534) */
  @media (min-width: 1200px) {
    .product-clinical__layout {
      grid-template-columns: minmax(0, 735fr) minmax(0, 320fr) minmax(0, 534fr);
      gap: max(var(--space-xl), calc(90 * var(--px)));
    }

    .product-clinical__compare {
      grid-column: auto;
    }

    .product-clinical--no-compare .product-clinical__layout {
      grid-template-columns: minmax(0, 320fr) minmax(0, 534fr);
    }

    .product-clinical__heading {
      max-inline-size: 26ch; /* Figma: 2 lines */
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <product-clinical>: the before / after range moves the cut (--pos) and updates its value text; the
   * rings draw once the section is in view (is-drawn).
   */
  class ProductClinical extends HTMLElement {
    connectedCallback() {
      const compare = this.querySelector('[data-compare]');
      const range = this.querySelector('[data-compare-range]');
      // Through a signal, removed when the element leaves the page (the tabs' pinned track moves it)
      this.controller = new AbortController();
      const { signal } = this.controller;
      const setValue = (value) => {
        range.value = String(Math.round(Math.min(100, Math.max(0, value))));
        compare.style.setProperty('--pos', `${range.value}%`);
        range.setAttribute('aria-valuetext', range.dataset.valuetext.replace('[percent]', range.value));
      };
      range?.addEventListener('input', () => setValue(Number(range.value)), { signal });

      // Drag anywhere on the photo (mouse, pen, touch). Some browsers (iPhone Safari) move an invisible
      // range input only when the press hits its small thumb, so the script follows the pointer itself.
      // Mouse / pen: the line moves at once. Touch: only after the finger moves more sideways than up /
      // down (a scroll that starts on the photo must not move the line), or on a tap
      this.dragging = false;
      this.press = null;
      if (compare && range) {
        const fromPointer = (event) => {
          const box = compare.getBoundingClientRect();
          setValue(((event.clientX - box.left) / box.width) * 100);
        };
        const startDrag = (event) => {
          compare.setPointerCapture(event.pointerId);
          this.dragging = true;
          range.focus({ preventScroll: true });
          fromPointer(event);
        };
        compare.addEventListener(
          'pointerdown',
          (event) => {
            if (event.button !== 0) return;
            if (event.pointerType === 'touch') {
              this.press = { x: event.clientX, y: event.clientY, id: event.pointerId };
              return;
            }
            event.preventDefault(); // no text selection or native range drag on top of this one
            startDrag(event);
          },
          { signal }
        );
        compare.addEventListener(
          'pointermove',
          (event) => {
            if (this.dragging) {
              fromPointer(event);
              return;
            }
            const press = this.press;
            if (!press || press.id !== event.pointerId) return;
            const dx = Math.abs(event.clientX - press.x);
            const dy = Math.abs(event.clientY - press.y);
            if (dx > 6 && dx > dy) {
              this.press = null;
              startDrag(event);
            }
          },
          { signal }
        );
        compare.addEventListener(
          'pointerup',
          (event) => {
            // A tap (the finger hardly moved): the line jumps there
            const press = this.press;
            if (press && press.id === event.pointerId && Math.hypot(event.clientX - press.x, event.clientY - press.y) < 8) {
              fromPointer(event);
            }
            this.press = null;
            this.dragging = false;
          },
          { signal }
        );
        const stop = () => {
          this.press = null;
          this.dragging = false;
        };
        compare.addEventListener('pointercancel', stop, { signal }); // the page scrolls: no change
        compare.addEventListener('lostpointercapture', stop, { signal });
      }

      if (this.classList.contains('is-drawn')) return; // drawn before a move in the page
      // Watch the rings themselves: below 1200px they sit under the slider, so the section can be on
      // screen long before the rings are
      const rings = this.querySelector('.product-clinical__rings');
      if (!rings) return;
      this.observer = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) return;
        this.classList.add('is-drawn');
        this.observer.disconnect();
      }, { threshold: 0.5 });
      this.observer.observe(rings);
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
      this.dragging = false; // a move in the page during a drag must not leave the line following the mouse
      this.press = null;
    }
  }

  if (!customElements.get('product-clinical')) customElements.define('product-clinical', ProductClinical);
{% endjavascript %}

