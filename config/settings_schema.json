[
  {
    "name": "theme_info",
    "theme_name": "OroSkin",
    "theme_version": "0.1.0",
    "theme_author": "Interloid",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_email": "hariprathap@interloid.com"
  },
  {
    "name": "t:general.logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo",
        "info": "t:labels.logo_info"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "unit": "px",
        "label": "t:labels.logo_width",
        "default": 140
      },
      {
        "type": "header",
        "content": "t:labels.logo_text_group"
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "t:labels.logo_text",
        "info": "t:labels.logo_text_info"
      },
      {
        "type": "text",
        "id": "logo_text_accent",
        "label": "t:labels.logo_text_accent",
        "info": "t:labels.logo_text_accent_info"
      },
      {
        "type": "font_picker",
        "id": "type_logo_font",
        "label": "t:labels.logo_font",
        "default": "cormorant_n6"
      },
      {
        "type": "range",
        "id": "logo_text_size",
        "min": 24,
        "max": 64,
        "step": 1,
        "unit": "px",
        "label": "t:labels.logo_text_size",
        "default": 47
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:labels.favicon_info"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "newsreader_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "plus_jakarta_sans_n4",
        "label": "t:labels.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "105.625rem",
            "label": "t:options.page_width.standard"
          },
          {
            "value": "120rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "105.625rem",
        "info": "t:labels.page_width_info"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:color_scheme.background",
            "default": "#fffaf0"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:color_scheme.text",
            "default": "#1f1f1f"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:color_scheme.accent",
            "default": "#7d0000"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:color_scheme.border",
            "default": "#eedede"
          },
          {
            "type": "header",
            "content": "t:color_scheme.primary_button"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:color_scheme.button_background",
            "default": "#7d0000"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:color_scheme.button_text",
            "default": "#ffffff"
          },
          {
            "type": "color",
            "id": "button_border",
            "label": "t:color_scheme.button_border",
            "default": "#7d0000"
          },
          {
            "type": "header",
            "content": "t:color_scheme.secondary_button"
          },
          {
            "type": "color",
            "id": "secondary_button",
            "label": "t:color_scheme.button_background",
            "default": "#fffaf0"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:color_scheme.button_text",
            "default": "#7d0000"
          },
          {
            "type": "color",
            "id": "secondary_button_border",
            "label": "t:color_scheme.button_border",
            "default": "#7d0000"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "links": "accent",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button_border",
          "secondary_button": "secondary_button",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_border"
        }
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.product_cards",
    "settings": [
      {
        "type": "header",
        "content": "t:labels.badges"
      },
      {
        "type": "paragraph",
        "content": "t:labels.badges_info"
      },
      {
        "type": "color_scheme",
        "id": "badge_color_scheme",
        "label": "t:labels.badge_color_scheme",
        "default": "scheme-1"
      },
      {
        "type": "color_scheme",
        "id": "sale_badge_color_scheme",
        "label": "t:labels.sale_badge_color_scheme",
        "default": "scheme-3"
      },
      {
        "type": "color_scheme",
        "id": "sold_out_badge_color_scheme",
        "label": "t:labels.sold_out_badge_color_scheme",
        "default": "scheme-5"
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "header",
        "content": "t:labels.social_accounts"
      },
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "t:labels.social_instagram"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "t:labels.social_facebook"
      },
      {
        "type": "url",
        "id": "social_whatsapp_link",
        "label": "t:labels.social_whatsapp",
        "info": "t:labels.social_whatsapp_info"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "t:labels.social_tiktok"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "t:labels.social_pinterest"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "t:labels.social_youtube"
      },
      {
        "type": "url",
        "id": "social_x_link",
        "label": "t:labels.social_x"
      }
    ]
  },
  {
    "name": "t:general.animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "t:labels.animations_enabled",
        "info": "t:labels.animations_enabled_info",
        "default": true
      }
    ]
  }
]
