<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Font preloading, as in theme.liquid: the font CDN and the base weight of each font %}
    {% unless settings.type_heading_font.system? and settings.type_body_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}

    {%- unless settings.type_heading_font.system? -%}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless -%}
    {%- unless settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  {%- comment -%} No no-js / js / motion-on classes here: nothing on this page uses them (no animations, no .no-js rules) {%- endcomment -%}
  <body>
    {%- comment -%} Main landmark, as in theme.liquid (no header here, so no skip link is needed) {%- endcomment -%}
    <main id="MainContent" class="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
