<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {%- comment -%} Main landmark, as in theme.liquid (no header here, so no skip link is needed) {%- endcomment -%}
    <main id="MainContent" class="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
