{% layout none %}
{%- comment -%}
  Gift card page (M8.7, no Figma: the M5 pages' style). The customer opens it from the gift card
  email. Theme Store: the balance, the code (with a copy button), a QR code of at least 120 x 120px
  (staff scan it in a shop), "Add to Apple Wallet" when Shopify offers a pass, the logo and a way
  back to the shop. A full page of its own ({% layout none %}): the theme's variables and critical
  CSS, plus the styles and a small script below.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/gift-card-liquid
{%- endcomment -%}

{%- liquid
  assign scheme_id = 'scheme-2'
  assign expired = false
  if gift_card.enabled == false or gift_card.expired
    assign expired = true
  endif
  assign formatted_code = gift_card.code | format_code
-%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">

    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}

    {%- comment -%} Shopify's QR code library (draws the code into a <canvas> / <img>); defer: it doesn't block the page {%- endcomment -%}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>

    {% style %}
      .gift-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-xl);
        min-block-size: 100svh;
        box-sizing: border-box;
        padding: var(--space-2xl) var(--page-margin);
        background:
          radial-gradient(60% 50% at 15% 0%, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent 70%),
          var(--color-background);
        color: var(--color-text);
        text-align: center;
      }

      .gift-card__logo {
        margin: 0;
        color: inherit;
        text-decoration: none;
      }

      .gift-card__logo img {
        inline-size: auto;
        max-inline-size: 11rem;
        block-size: auto;
      }

      .gift-card__logo-text {
        font-family: var(--font-heading--family);
        font-size: 1.75rem;
      }

      .gift-card__logo-text em {
        color: var(--color-accent);
      }

      .gift-card__panel {
        inline-size: min(100%, 34rem);
        box-sizing: border-box;
        padding: clamp(1.5rem, 1rem + 3vw, 3rem);
        border: 1px solid var(--color-card-border);
        border-radius: var(--radius-md);
        background-color: var(--color-background);
        box-shadow: 0 20px 60px 0 #0000000f;
      }

      /* The card: accent, with the balance on it (the brand's red, the heading font) */
      .gift-card__card {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        aspect-ratio: 1.6;
        box-sizing: border-box;
        padding: var(--space-lg);
        border-radius: var(--radius-md);
        background:
          radial-gradient(80% 90% at 100% 0%, #ffffff33, transparent 60%),
          var(--color-accent);
        color: var(--color-background);
        text-align: start;
      }

      .gift-card__card-label {
        margin: 0;
        font-size: var(--font-size-small);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
      }

      .gift-card__balance {
        margin: 0;
        font-family: var(--font-heading--family);
        font-size: clamp(2.5rem, 2rem + 2.5vw, 3.5rem);
        font-weight: 400;
        line-height: 1;
      }

      .gift-card__initial {
        margin: var(--space-xs) 0 0;
        font-size: var(--font-size-caption);
        opacity: 0.85;
      }

      .gift-card--expired .gift-card__card {
        filter: grayscale(1);
        opacity: 0.6;
      }

      .gift-card__status {
        margin: var(--space-lg) 0 0;
        color: var(--color-accent);
        font-size: var(--font-size-body-sm);
      }

      .gift-card__use {
        margin: var(--space-lg) 0 0;
        font-size: var(--font-size-body-sm);
      }

      /* The code: large, letter-spaced, with a copy button beside it */
      .gift-card__code {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm);
        margin-block-start: var(--space-sm);
        padding: 0.375rem 0.375rem 0.375rem var(--space-lg);
        border: 1px dashed color-mix(in srgb, var(--color-accent) 35%, transparent);
        border-radius: var(--radius-pill);
        background-color: var(--color-card);
      }

      .gift-card__code-value {
        font-family: var(--font-body--family);
        font-size: var(--font-size-body-lg);
        font-weight: var(--font-weight-medium);
        letter-spacing: 0.12em;
        word-break: break-all;
      }

      .gift-card__copy {
        flex: none;
        min-block-size: 2.75rem;
        padding-inline: var(--space-lg);
      }

      .gift-card__copied {
        min-block-size: 1.5em;
        margin: var(--space-xs) 0 0;
        color: var(--color-accent);
        font-size: var(--font-size-caption);
      }

      /* The QR code: at least 120 x 120 (Theme Store), on white with a quiet margin to scan well */
      .gift-card__qr {
        display: inline-grid;
        place-items: center;
        margin-block-start: var(--space-lg);
        padding: var(--space-sm);
        border-radius: var(--radius-sm);
        background-color: #ffffff;
      }

      .gift-card__qr :is(img, canvas) {
        inline-size: 120px;
        block-size: 120px;
      }

      .gift-card__qr-label {
        margin: var(--space-xs) 0 0;
        font-size: var(--font-size-small);
      }

      .gift-card__wallet {
        display: inline-block;
        margin-block-start: var(--space-lg);
      }

      .gift-card__wallet img {
        display: block;
        inline-size: auto;
        block-size: 2.75rem;
      }

      .gift-card__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-sm) var(--space-md);
        margin-block-start: var(--space-xl);
      }

      @media print {
        .gift-card {
          min-block-size: 0;
          background: none;
        }

        .gift-card__panel {
          box-shadow: none;
        }

        .gift-card__actions,
        .gift-card__copy,
        .gift-card__wallet {
          display: none;
        }
      }

      @media (max-width: 479px) {
        .gift-card__actions > .button {
          flex: 1 1 100%;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main id="MainContent" class="gift-card color-{{ scheme_id }}{% if expired %} gift-card--expired{% endif %}">
      <a class="gift-card__logo" href="{{ shop.url }}">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'eager' }}
        {%- elsif settings.logo_text != blank or settings.logo_text_accent != blank -%}
          <span class="gift-card__logo-text">
            {{- settings.logo_text | escape -}}
            {%- if settings.logo_text_accent != blank -%}<em>{{ settings.logo_text_accent | escape }}</em>{%- endif -%}
          </span>
        {%- else -%}
          <span class="gift-card__logo-text">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>

      <div class="gift-card__panel">
        <h1 class="visually-hidden">{{ 'gift_card.title' | t: shop: shop.name }}</h1>

        <div class="gift-card__card">
          <p class="gift-card__card-label">{{ 'gift_card.card' | t }}</p>
          <div>
            <p class="gift-card__balance">{{ gift_card.balance | money }}</p>
            {%- if gift_card.balance != gift_card.initial_value -%}
              {%- comment -%} assign first: a filter can't go inside another filter's argument {%- endcomment -%}
              {%- assign initial_value = gift_card.initial_value | money -%}
              <p class="gift-card__initial">{{ 'gift_card.initial_value' | t: value: initial_value }}</p>
            {%- endif -%}
          </div>
        </div>

        {%- if expired -%}
          <p class="gift-card__status">{{ 'gift_card.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
          <p class="gift-card__status">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
        {%- endif -%}

        <p class="gift-card__use">{{ 'gift_card.use_at_checkout' | t }}</p>

        <div class="gift-card__code">
          <span class="gift-card__code-value" id="GiftCardCode">{{ formatted_code }}</span>
          <button
            type="button"
            class="button button--secondary gift-card__copy"
            data-copy="{{ gift_card.code | escape }}"
            hidden
          >
            {{- 'gift_card.copy' | t -}}
          </button>
        </div>
        <p class="gift-card__copied" role="status" data-copied-text="{{ 'gift_card.copied' | t | escape }}"></p>

        {%- if gift_card.qr_identifier != blank -%}
          <div>
            <div class="gift-card__qr" id="GiftCardQr" data-identifier="{{ gift_card.qr_identifier | escape }}" data-alt="{{ 'gift_card.qr_alt' | t | escape }}"></div>
            <p class="gift-card__qr-label">{{ 'gift_card.qr_label' | t }}</p>
          </div>
        {%- endif -%}

        {%- if gift_card.pass_url -%}
          <a class="gift-card__wallet" href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              width="120"
              height="40"
            >
          </a>
        {%- endif -%}

        <div class="gift-card__actions">
          <a class="button" href="{{ shop.url }}">{{ 'gift_card.shop_now' | t }}</a>
          <button type="button" class="button button--secondary" data-print hidden>{{ 'gift_card.print' | t }}</button>
        </div>
      </div>
    </main>

    <script>
      // Runs once the page (and the deferred QR library) has loaded
      document.addEventListener('DOMContentLoaded', () => {
        // QR code (Shopify's library): the identifier staff scan at a point of sale
        const qr = document.getElementById('GiftCardQr');
        if (qr && window.QRCode) {
          new QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120, imageAltText: qr.dataset.alt });
        }

        // Copy the code (the button only shows when the browser can copy)
        const copy = document.querySelector('[data-copy]');
        const copied = document.querySelector('[data-copied-text]');
        if (copy && navigator.clipboard) {
          copy.hidden = false;
          copy.addEventListener('click', () => {
            navigator.clipboard.writeText(copy.dataset.copy).then(() => {
              copied.textContent = copied.dataset.copiedText;
            });
          });
        }

        // Print (shown only with JS)
        const print = document.querySelector('[data-print]');
        if (print) {
          print.hidden = false;
          print.addEventListener('click', () => window.print());
        }
      });
    </script>
  </body>
</html>
