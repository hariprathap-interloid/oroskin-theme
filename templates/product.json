    "how_to": {
      "type": "product-how-to",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "title": "Cleanse & press dry",
            "text": "Begin on skin still faintly damp — the serum travels further on moisture.",
            "image": "shopify://shop_images/image_667.jpg",
            "caption": "Blot with linen — never wipe."
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Four drops, warmed",
            "text": "Warm four drops between your palms for a few seconds.",
            "image": "shopify://shop_images/image_670.jpg",
            "caption": "Body heat opens the oils."
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "Press, never rub",
            "text": "Press your palms to the cheeks, forehead and neck, holding each for a breath.",
            "image": "shopify://shop_images/image_669.jpg",
            "caption": "Pressure, not friction."
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "title": "Seal & rest",
            "text": "Finish with your moisturiser and let it settle before bed.",
            "image": "shopify://shop_images/Component_1639.jpg",
            "caption": "Let the night do the rest."
          }
        }
      },
