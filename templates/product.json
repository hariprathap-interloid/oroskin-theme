      "settings": {
        "anchor": "overview",
        "eyebrow": "The object",
        "heading": "Written for <em>the senses,</em> not the spec sheet.",
        "text": "<p>The formula was built backwards — from the finish. We wanted the look of skin caught in late afternoon light, then reverse-engineered a lipid system that could hold it through a full day of wear.</p>",
        "image": "shopify://shop_images/d25e9d3b6caacff864387637efd0c84e17cf417b.png",
        "quote": "It behaves less like a treatment and more like <em>a change of light</em>",
        "section_width": "widest",
        "color_scheme": "",
        "padding_top": 64,
        "padding_bottom": 64
      }
