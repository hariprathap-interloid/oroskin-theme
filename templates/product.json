      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Can I use this with retinol?",
            "answer": "<p>Yes — alternate nights to begin. After a month most skins tolerate both in one routine, serum first.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Will it break me out?",
            "answer": "<p>It's non-comedogenic and fragrance-free. Patch test first; if your skin feels tight, use it every other day for the first week.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Is it pregnancy safe?",
            "answer": "<p>It contains no retinoids or salicylic acid, but please check with your doctor before starting new skincare.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How long does one bottle last?",
            "answer": "<p>About two months, using two or three drops morning and night.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Is it suitable for sensitive skin?",
            "answer": "<p>Yes. It's dermatologist tested on sensitive skin, with no alcohol or added fragrance.</p>"
          }
        }
