    "pillars": {
      "type": "about-pillars",
      "blocks": {
        "mission": {
          "type": "_pillar",
          "settings": {
            "label": "Mission",
            "heading": "Make beauty you can read as easily as you can wear.",
            "text": "<p>We formulate fragrance, skincare and colour at clinical doses, print every percentage on the carton, and name the grower behind each botanical. No proprietary blends, no silent dilutions.</p>",
            "checklist": "Full dose disclosure on all 68 formulas\nNine named growers, long-term contracts\nRefillable glass and aluminium only"
          },
          "blocks": {}
        },
        "vision": {
          "type": "_pillar",
          "settings": {
            "label": "Vision",
            "heading": "A beauty house measured in decades, not launches.",
            "text": "<p>By 2030 we want every OroSkin object to be refilled more often than it is bought: a shelf that ages with you, with formulas revised only when the evidence asks for it.</p>",
            "checklist": "Zero virgin plastic across the line\nEvery claim backed by in-vivo panels\nFormulas revised, not replaced"
          },
          "blocks": {}
        },
        "promise": {
          "type": "_pillar",
          "settings": {
            "label": "Promise",
            "heading": "Three quiet minutes that actually do something.",
            "text": "<p>Texture is not decoration. A serum should absorb in eleven seconds, a fragrance should still read at hour six, and a compact should close with a sound you trust. We test all three.</p>",
            "checklist": "11-second absorption standard\n6-hour wear verification on skin\nVegan, cruelty-free, dermatologist-reviewed"
          },
          "blocks": {}
        }
      },
