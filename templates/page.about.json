          "type": "_value-card",
          "settings": {
            "icon": "lashes",
            "title": "Conscious beauty",
            "text": "<p>Sustainability is not a trend — it's our responsibility. Every partner brand must meet our rigorous environmental and ethical standards.</p>"
          },
          "blocks": {}
        },
