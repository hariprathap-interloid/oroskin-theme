      "settings": {
        "show_breadcrumb": true,
        "script_text": "Our story",
        "heading_line_1": "Made <em>Slowly,</em>",
        "heading_line_2": "worn <strong>daily</strong>",
        "heading_line_2_b": "read <strong>openly</strong>",
        "heading_line_2_c": "refilled <strong>always</strong>",
        "heading_line_2_d": "",
        "rotate_interval": 3,
        "text": "<p>OroSkin is a fragrance, skincare and makeup house built on three unfashionable ideas: name your growers, dose your actives honestly, and make packaging you refill instead of replace.</p>",
        "button_label": "Shop all products",
        "button_link": "shopify://collections/all",
