{% doc %}
  One feature in the Icon features section (Figma: "Free Shipping" / "Orders over $200 qualify for
  fast, free delivery"): a round badge with a line icon, a title and a short text. With a link, the
  title is the link and its ::after covers the feature (the text stays above it, so it can be
  selected), and the focus ring goes around the full feature.

  The section's Scroll animation moves each feature on its own; the section's CSS gives each one a
  delay by its position, so they show one by one. Never on the first section of the page.

  A feature with no icon, no title and no text shows nothing on the store; in the editor it shows a
  note, so it can still be selected.

  @example
  {% content_for 'block', type: '_icon-feature', id: 'icon-feature' %}
{% enddoc %}

{%- liquid
  assign icon_file = 'icon-' | append: block.settings.icon | append: '.svg'

  assign has_icon = false
  if block.settings.icon_image != blank or block.settings.icon != 'none'
    assign has_icon = true
  endif

  assign is_empty = false
  unless has_icon
    if block.settings.title == blank and block.settings.text == blank
      assign is_empty = true
    endif
  endunless

  assign animation = section.settings.animation | default: 'none'
  if section.index == 1
    assign animation = 'none'
  endif
-%}

{%- if is_empty -%}
  {%- if request.design_mode -%}
    <div class="icon-feature icon-feature--empty" {{ block.shopify_attributes }}>
      <p>{{ 'sections.icon_features.empty_feature' | t }}</p>
    </div>
  {%- endif -%}
{%- else -%}
  <div
    class="icon-feature"
    {% if animation != 'none' %}
      data-animate="{{ animation }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.icon_image != blank -%}
      {%- capture icon_loading -%}{%- render 'section-loading' -%}{%- endcapture -%}
      {%- assign icon_loading = icon_loading | strip -%}
      <span class="icon-feature__badge">
        {{- block.settings.icon_image | image_url: width: 96 | image_tag: alt: '', loading: icon_loading, width: 28, height: 28, sizes: '28px' -}}
      </span>
    {%- elsif block.settings.icon != 'none' -%}
      <span class="icon-feature__badge">{{ icon_file | inline_asset_content }}</span>
    {%- endif -%}

    {%- if block.settings.title != blank -%}
      <h3 class="icon-feature__title">
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
        {%- else -%}
          {{ block.settings.title | escape }}
        {%- endif -%}
      </h3>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="icon-feature__text rte">{{ block.settings.text }}</div>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .icon-feature {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    text-align: center;
  }

  .icon-feature--empty {
    justify-content: center;
    padding: var(--space-md);
    border: 1px dashed var(--color-border);
  }

  /*
    Figma: a white circle with a soft shadow, the icon in the Icon color (empty = the scheme's
    "Links and highlights" color). The circle is the scheme's --color-surface-raised: white on a
    light background, a light mix of the text color on a dark one (snippets/css-variables.liquid).
    Sizes: phones 48px (Figma mobile), tablets 64px, desktop 72 -> 84px.
  */
  .icon-feature__badge {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    aspect-ratio: 1;
    margin-block-end: var(--space-xs);
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-raised, #ffffff);
    box-shadow: 0 0.5rem 1.5rem #0000000f;
    color: var(--icon-feature-color, var(--color-accent));
  }

  .icon-feature__badge svg,
  .icon-feature__badge img {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    object-fit: contain;
  }

  /* Phones (Figma mobile): small title and text, so 2 columns fit at 390px */
  .icon-feature__title {
    margin: 0;
    font-size: 1rem;
  }

  .icon-feature__title a {
    color: inherit;
    text-decoration: none;
  }

  /* The link covers the full feature */
  .icon-feature__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .icon-feature__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .icon-feature__text {
    max-inline-size: 22rem;
    font-size: var(--font-size-small);
    color: color-mix(in srgb, var(--color-text) 80%, var(--color-background));
  }

  .icon-feature__text > * {
    margin: 0;
  }

  /*
    The text stays above the covering link: visitors can select and copy it, and links in the text
    still work. The badge, the title and the space around them are the click area.
  */
  .icon-feature__text {
    position: relative;
    z-index: 1;
  }

  /* Keyboard focus: the ring goes around the full feature (the click area), not only the title */
  @supports selector(:has(*)) {
    .icon-feature:has(.icon-feature__title a:focus-visible) {
      outline: 2px solid var(--color-accent);
      outline-offset: var(--space-xs);
      border-radius: var(--radius-focus);
    }

    .icon-feature__title a:focus-visible {
      outline: none;
    }
  }

  @media (min-width: 750px) {
    .icon-feature {
      gap: var(--space-sm);
    }

    .icon-feature__badge {
      inline-size: 4rem;
      margin-block-end: var(--space-sm);
    }

    .icon-feature__badge svg,
    .icon-feature__badge img {
      inline-size: 1.5rem;
      block-size: 1.5rem;
    }

    .icon-feature__title {
      font-size: 1.25rem;
    }

    .icon-feature__text {
      font-size: var(--font-size-body-sm);
    }
  }

  @media (min-width: 1200px) {
    .icon-feature__badge {
      inline-size: clamp(4.5rem, 3.5rem + 0.85vw, 5.25rem);
    }

    .icon-feature__badge svg,
    .icon-feature__badge img {
      inline-size: 1.75rem;
      block-size: 1.75rem;
    }

    .icon-feature__title {
      font-size: var(--font-size-h3);
    }

    .icon-feature__text {
      font-size: var(--font-size-body);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.icon_feature",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:labels.icon",
      "options": [
        { "value": "truck", "label": "t:options.feature_icon.truck" },
        { "value": "shield", "label": "t:options.feature_icon.shield" },
        { "value": "return", "label": "t:options.feature_icon.return" },
        { "value": "headset", "label": "t:options.feature_icon.headset" },
        { "value": "sparkle", "label": "t:options.feature_icon.sparkle" },
        { "value": "book", "label": "t:options.feature_icon.book" },
        { "value": "users", "label": "t:options.feature_icon.users" },
        { "value": "none", "label": "t:options.feature_icon.none" }
      ],
      "default": "truck"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "t:labels.custom_icon",
      "info": "t:labels.icon_feature_custom_icon_info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading",
      "default": "Free shipping"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Orders over $200 qualify for fast, free delivery</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link",
      "info": "t:labels.icon_feature_link_info",
      "visible_if": "{{ block.settings.title != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.icon_feature"
    }
  ]
}
{% endschema %}
