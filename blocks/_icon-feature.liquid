{% doc %}
  One feature in the Feature icons row (Figma: "Free Shipping" / "Orders over $200 qualify for fast,
  free delivery"): a round white badge with a line icon, a title and a short text. With a link, the
  title becomes a link (e.g. to the shipping policy).

  @example
  {% content_for 'block', type: '_icon-feature', id: 'icon-feature' %}
{% enddoc %}

{%- assign icon_file = 'icon-' | append: block.settings.icon | append: '.svg' -%}

<div class="icon-feature" {{ block.shopify_attributes }}>
  {%- if block.settings.icon_image != blank -%}
    <span class="icon-feature__badge">
      {{ block.settings.icon_image | image_url: width: 96 | image_tag: alt: '', loading: 'lazy', width: 28, height: 28 }}
    </span>
  {%- elsif block.settings.icon != 'none' -%}
    <span class="icon-feature__badge">{{ icon_file | inline_asset_content }}</span>
  {%- endif -%}

  {%- if block.settings.title != blank -%}
    <h3 class="icon-feature__title">
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
      {%- else -%}
        {{ block.settings.title | escape }}
      {%- endif -%}
    </h3>
  {%- endif -%}

  {%- if block.settings.text != blank -%}
    <div class="icon-feature__text rte">{{ block.settings.text }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .icon-feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-align: center;
  }

  /* Figma: a white circle with a soft shadow, the icon in the section's icon colour (gold) */
  .icon-feature__badge {
    display: grid;
    place-items: center;
    inline-size: clamp(4rem, 3.6rem + 1vw, 5.25rem);
    aspect-ratio: 1;
    margin-block-end: var(--space-sm);
    border-radius: var(--radius-pill);
    background-color: #ffffff;
    box-shadow: 0 0.5rem 1.5rem #0000000f;
    color: var(--icon-feature-color, var(--color-accent));
  }

  .icon-feature__badge svg,
  .icon-feature__badge img {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    object-fit: contain;
  }

  .icon-feature__title {
    margin: 0;
    font-size: var(--font-size-h3);
  }

  .icon-feature__title a {
    color: inherit;
    text-decoration: none;
  }

  .icon-feature__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .icon-feature__text {
    max-inline-size: 22rem;
    color: color-mix(in srgb, var(--color-text) 80%, var(--color-background));
  }

  .icon-feature__text > * {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.icon_feature",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:labels.icon",
      "options": [
        { "value": "truck", "label": "t:options.feature_icon.truck" },
        { "value": "shield", "label": "t:options.feature_icon.shield" },
        { "value": "return", "label": "t:options.feature_icon.return" },
        { "value": "headset", "label": "t:options.feature_icon.headset" },
        { "value": "sparkle", "label": "t:options.feature_icon.sparkle" },
        { "value": "book", "label": "t:options.feature_icon.book" },
        { "value": "users", "label": "t:options.feature_icon.users" },
        { "value": "none", "label": "t:options.feature_icon.none" }
      ],
      "default": "truck"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "t:labels.custom_icon",
      "info": "t:labels.custom_icon_info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading",
      "default": "Free shipping"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Orders over $200 qualify for fast, free delivery</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:general.icon_feature"
    }
  ]
}
{% endschema %}
