{% doc %}
  The product's title. The product comes from closest.product: the nearest section or block with a
  product setting (e.g. Featured product), or the product page itself (M6), so this block works in
  both without its own product picker.

  The heading level and the link follow the place: the product of the product page is the page's h1,
  with no link; anywhere else (Featured product) it is an h2 that links to the product. "Heading level:
  Always H2" turns this off, for a second title of the same product on its page (one h1 per page).

  Without a product: a placeholder title in the theme editor, nothing on the live store.

  @example
  {% content_for 'block', type: 'product-title', id: 'product-title' %}
{% enddoc %}

{%- liquid
  assign title_product = closest.product
  assign title_tag = 'h2'
  assign title_link = true
  if template.name == 'product' and title_product.id == product.id
    # The page's own product: no link to the page it is on; h1 unless the merchant chose Always H2
    assign title_link = false
    if block.settings.heading_level != 'h2'
      assign title_tag = 'h1'
    endif
  endif
-%}

{%- if title_product != blank or request.design_mode -%}
  <{{ title_tag }}
    class="product-title {{ block.settings.size }}"
    {{ block.shopify_attributes }}
  >
    {%- if title_product == blank -%}
      {{ 'products.card.placeholder_title' | t }}
    {%- elsif title_link -%}
      <a href="{{ title_product.url }}" class="product-title__link">{{ title_product.title | escape }}</a>
    {%- else -%}
      {{ title_product.title | escape }}
    {%- endif -%}
  </{{ title_tag }}>
{%- endif -%}

{% stylesheet %}
  .product-title {
    margin: 0;
  }

  /*
    "Product page" size (Figma PDP: the title ~46px at 1920): between Heading 1 (60px) and Heading 2
    (40px); 32px on phones, growing with the screen like the other heading sizes
  */
  .product-title--product {
    font-size: clamp(2rem, 1.733rem + 1.098vw, 2.875rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .product-title__link {
    color: inherit;
    text-decoration: none;
  }

  .product-title__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_title",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "size",
      "label": "t:labels.heading_size",
      "info": "t:labels.product_title_size_info",
      "options": [
        { "value": "h1", "label": "t:options.heading_size.h1" },
        { "value": "product-title--product", "label": "t:options.heading_size.product" },
        { "value": "h2", "label": "t:options.heading_size.h2" },
        { "value": "h3", "label": "t:options.heading_size.h3" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:labels.product_title_heading_level",
      "info": "t:labels.product_title_heading_level_info",
      "options": [
        { "value": "auto", "label": "t:options.product_title_heading_level.auto" },
        { "value": "h2", "label": "t:options.product_title_heading_level.h2" }
      ],
      "default": "auto"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_title",
      "category": "t:general.product"
    }
  ]
}
{% endschema %}
