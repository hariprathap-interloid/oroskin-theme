{% doc %}
  "BANK OFFERS" (Figma PDP second card): a heading and a row of offer tickets (the _offer blocks inside:
  bank, offer, a small line, a code with COPY). The same offers show on every product; the merchant edits
  them in the theme editor. 4 tickets in a row when there's room, 2 x 2 when the card is narrow.
  Nothing shows when it has no offers (an editor hint in the theme editor).

  @example
  {% content_for 'block', type: 'product-offers', id: 'product-offers' %}
{% enddoc %}

{%- liquid
  assign heading_default = 'products.offers.heading' | t
  assign offers_heading = block.settings.heading | default: heading_default

-%}

{%- comment -%}
  The tickets are rendered first and kept: an empty offer (blocks/_offer.liquid: no bank, offer or
  code) outputs nothing, so empty output = no ticket shows. (block.blocks can't read the offers'
  settings here.) Store: then nothing at all (no empty list, no heading). Editor: the list is always
  output (the editor needs it to place new offers), with a note when nothing shows yet.
{%- endcomment -%}
{%- capture offers_tickets -%}{% content_for 'blocks' %}{%- endcapture -%}
{%- assign offers_tickets_check = offers_tickets | strip -%}

{%- if offers_tickets_check != blank or request.design_mode -%}
  <div class="product-offers" {{ block.shopify_attributes }}>
    {%- if offers_tickets_check != blank -%}
      {%- if offers_heading != blank -%}
        {% render 'product-block-heading', text: offers_heading %}
      {%- endif -%}
    {%- else -%}
      <p class="product-offers__empty">{{ 'products.offers.empty' | t }}</p>
    {%- endif -%}
    <div class="product-offers__list" role="list">
      {{- offers_tickets -}}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /*
    Figma: 4 tickets ~186px wide, overlapping a few px and slightly tilted, each its own angle. The
    tickets are the list's direct children (the blocks have no wrapper: "tag": null) and an empty
    offer outputs nothing, so :nth-child counts only the tickets that show.
  */
  /* The container is the block, not the list: a container query only styles the container's children */
  .product-offers {
    container-type: inline-size;
  }

  .product-offers__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  @container (min-width: 40rem) {
    .product-offers__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-sm) 0;
    }

    /* Each ticket overlaps the one at its left; the first of each row of 4 has none at its left */
    .product-offers__list > :not(:nth-child(4n + 1)) {
      margin-inline-start: -0.25rem;
    }
  }

  .product-offers__list > :nth-child(4n + 1) {
    --offer-tilt: -1deg;
  }

  .product-offers__list > :nth-child(4n + 2) {
    --offer-tilt: 0.6deg;
  }

  .product-offers__list > :nth-child(4n + 3) {
    --offer-tilt: -0.4deg;
  }

  .product-offers__list > :nth-child(4n + 4) {
    --offer-tilt: 0.8deg;
  }

  .product-offers__empty {
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 65%, var(--color-background));
    font-size: var(--font-size-small);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_offers",
  "tag": null,
  "blocks": [{ "type": "_offer" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.product_offers_heading_info"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_offers",
      "category": "t:general.product",
      "blocks": [
        {
          "type": "_offer",
          "settings": {
            "bank": "Bank or card name",
            "offer": "Describe the offer",
            "detail": "Add the conditions"
          }
        },
        {
          "type": "_offer",
          "settings": {
            "bank": "Bank or card name",
            "offer": "Describe the offer",
            "detail": "Add the conditions"
          }
        }
      ]
    }
  ]
}
{% endschema %}
