{% doc %}
  "BANK OFFERS" (Figma PDP second card): a heading and a row of offer tickets (the _offer blocks inside:
  bank, offer, a small line, a code with COPY). The same offers show on every product; the merchant edits
  them in the theme editor. 4 tickets in a row when there's room, 2 x 2 when the card is narrow.
  Nothing shows when it has no offers (an editor hint in the theme editor).

  @example
  {% content_for 'block', type: 'product-offers', id: 'product-offers' %}
{% enddoc %}

{%- liquid
  assign heading_default = 'products.offers.heading' | t
  assign offers_heading = block.settings.heading | default: heading_default
-%}

{%- if block.blocks.size > 0 -%}
  <div class="product-offers" {{ block.shopify_attributes }}>
    {%- if offers_heading != blank -%}
      {% render 'product-block-heading', text: offers_heading %}
    {%- endif -%}
    <div class="product-offers__list" role="list">
      {% content_for 'blocks' %}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <p class="product-offers__empty" {{ block.shopify_attributes }}>{{ 'products.offers.empty' | t }}</p>
{%- endif -%}

{% stylesheet %}
  /*
    Figma: 4 tickets ~186px wide, overlapping a few px and slightly tilted, each its own angle. The
    angles are set here on Shopify's block wrappers (the ticket is the only child of its wrapper, so
    the ticket itself can't tell which one it is).
  */
  /* The container is the block, not the list: a container query only styles the container's children */
  .product-offers {
    container-type: inline-size;
  }

  .product-offers__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  @container (min-width: 40rem) {
    .product-offers__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }

    .product-offers__list > * + * {
      margin-inline-start: -0.25rem;
    }
  }

  .product-offers__list > :nth-child(4n + 1) {
    --offer-tilt: -1deg;
  }

  .product-offers__list > :nth-child(4n + 2) {
    --offer-tilt: 0.6deg;
  }

  .product-offers__list > :nth-child(4n + 3) {
    --offer-tilt: -0.4deg;
  }

  .product-offers__list > :nth-child(4n + 4) {
    --offer-tilt: 0.8deg;
  }

  .product-offers__empty {
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 65%, var(--color-background));
    font-size: var(--font-size-small);
  }
{% endstylesheet %}

