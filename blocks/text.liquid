{% doc %}
  Renders a text block: rich text (paragraphs, bold, italic, links, lists) in one of the theme's type
  styles. Sizes come from the M1 type tokens (css-variables.liquid), so they grow smoothly from phones
  to the 1920px Figma frame and stay consistent with every other part of the theme.

  For headings use the Heading block: this one is for body copy, intros and small labels.

  @example
  {% content_for 'block', type: 'text', id: 'text' %}
{% enddoc %}

{%- liquid
  # Custom size (optional): the merchant sets the Figma size in px (as read in Dev Mode, e.g. 63).
  # It's the size at the 1920px design width; below that it shrinks smoothly, like the theme tokens,
  # down to a phone size of half the value + 7px (20px -> 17px, 60px -> 37px, 108px -> 61px).
  # The setting is a range (8-108px), so the editor itself refuses bigger or smaller values.
  # (Shopify allows at most 101 steps in a range: 8 to 108 in 1px steps is exactly 100.)
  # The size maths lives in snippets/fluid-font-size.liquid (shared with the Heading block).
  assign size_style = ''
  if block.settings.use_custom_size
    capture size_style
      render 'fluid-font-size', size: block.settings.custom_size
    endcapture
  endif
-%}

<div
  class="text rte text--{{ block.settings.style }} text--{{ block.settings.font }} text--{{ block.settings.color }} text--align-{{ block.settings.alignment }}{% if block.settings.use_custom_size %} text--custom-size{% endif %}"
  style="--text-max-width: {{ block.settings.max_width }}; {{ size_style | strip }}"
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</div>

{% stylesheet %}
  .text {
    max-inline-size: var(--text-max-width, none);
    text-align: var(--text-align, start);
  }

  /*
    Alignment also moves the box itself: a narrow centred paragraph should sit in the middle of its
    container, not only have its lines centred inside a box stuck on the left.
  */
  .text--align-left {
    --text-align: start;
  }

  .text--align-center {
    --text-align: center;
    margin-inline: auto;
  }

  .text--align-right {
    --text-align: end;
    margin-inline-start: auto;
  }

  /* Rich text wraps its content in <p>: no extra space above the first or below the last paragraph */
  .text > :first-child {
    margin-block-start: 0;
  }

  .text > :last-child {
    margin-block-end: 0;
  }

  /* Type styles = the M1 tokens (Figma sizes at 1920, fluid down to phones) */
  .text--body-lg {
    font-size: var(--font-size-body-lg);
  }

  .text--body {
    font-size: var(--font-size-body);
  }

  .text--small {
    font-size: var(--font-size-body-sm);
  }

  .text--caption {
    font-size: var(--font-size-caption);
  }

  /* Eyebrow: the Figma's small uppercase label in the accent colour (same look as .eyebrow in critical.css) */
  .text--eyebrow {
    color: var(--color-accent);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  /* The Figma eyebrow has a short gold rule in front of the label (like .eyebrow in critical.css) */
  .text--eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .text--eyebrow::before {
    content: "";
    flex: none;
    inline-size: 66px;
    block-size: 2px;
    background-color: currentcolor;
  }

  .text--eyebrow > * {
    margin: 0;
  }

  /* A flex row ignores text-align, so the alignment setting moves the rule + label as a whole */
  .text--eyebrow.text--align-center {
    justify-content: center;
  }

  .text--eyebrow.text--align-right {
    justify-content: flex-end;
  }

  /*
    Custom size: replaces the style's size (this rule comes after the style rules, so it wins).
    The same fluid formula as the tokens: the phone size at 390px wide, growing in a straight line
    to the typed size at 1920px wide (1530px further), never below or above those two.
    --fs-diff is the difference without "px", because CSS can multiply a length by a plain number
    but not a length by a length.
  */
  .text--custom-size {
    font-size: clamp(
      var(--fs-min),
      calc(var(--fs-min) + (100vw - 390px) * var(--fs-diff) / 1530),
      var(--fs-max)
    );
  }

  /* Font: the Figma sets some paragraphs in the serif heading font (e.g. card and newsletter text) */
  .text--heading-font {
    font-family: var(--font-heading--family);
  }

  /*
    Colour. "Muted" mixes the scheme's text into its background (the softer grey of the Figma's footer
    and card text) and stays at about 6:1 contrast on the light schemes.
  */
  .text--muted {
    color: color-mix(in srgb, var(--color-text) 70%, var(--color-background));
  }

  .text--accent {
    color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Share details about your brand, a product or a promotion.</p>"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:labels.text_style",
      "options": [
        { "value": "body-lg", "label": "t:options.text_style.body_large" },
        { "value": "body", "label": "t:options.text_style.body" },
        { "value": "small", "label": "t:options.text_style.small" },
        { "value": "caption", "label": "t:options.text_style.caption" },
        { "value": "eyebrow", "label": "t:options.text_style.eyebrow" }
      ],
      "default": "body"
    },
    {
      "type": "checkbox",
      "id": "use_custom_size",
      "label": "t:labels.use_custom_size",
      "default": false
    },
    {
      "type": "range",
      "id": "custom_size",
      "label": "t:labels.custom_size",
      "info": "t:labels.custom_size_info",
      "min": 8,
      "max": 108,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.use_custom_size }}"
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:labels.font",
      "options": [
        { "value": "body-font", "label": "t:options.font.body" },
        { "value": "heading-font", "label": "t:options.font.heading" }
      ],
      "default": "body-font"
    },
    {
      "type": "select",
      "id": "color",
      "label": "t:labels.text_color",
      "options": [
        { "value": "default", "label": "t:options.text_color.default" },
        { "value": "muted", "label": "t:options.text_color.muted" },
        { "value": "accent", "label": "t:options.text_color.accent" }
      ],
      "default": "default"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "t:labels.max_width",
      "info": "t:labels.max_width_info",
      "options": [
        { "value": "none", "label": "t:options.max_width.none" },
        { "value": "60ch", "label": "t:options.max_width.normal" },
        { "value": "40ch", "label": "t:options.max_width.narrow" }
      ],
      "default": "60ch"
    }
  ],
  "presets": [{ "name": "t:general.text" }]
}
{% endschema %}
