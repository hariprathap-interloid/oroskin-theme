{% doc %}
  Countdown (Figma promo banner "The Ultimate Glow-Up Event"): four glass tiles with the days, hours,
  minutes and seconds to an end date, a label under each tile and a colon between the tiles.

  The end is a date (YYYY-MM-DD) and a time (HH:MM, 24-hour clock) in the store's time zone. Liquid
  turns them into a Unix time (seconds) and computes the first numbers, so the countdown shows without
  JavaScript and nothing jumps when the script starts. <countdown-timer> then counts down each second,
  only while it is on screen.

  Screen readers: the ticking tiles are hidden (a reading that changes each second is noise); one
  sentence with the end date ("Offer ends December 31, 2026 at 11:59 pm") is read instead.

  When the time ends ("When the time ends" setting): hide the countdown, show 00 in all tiles, or show
  a message. Shopify can cache a page for some time, so the script also checks this on the visitor's
  clock.

  @example
  {% content_for 'block', type: 'countdown', id: 'countdown' %}
{% enddoc %}

{%- liquid
  assign end_date = block.settings.end_date | strip
  assign end_time = block.settings.end_time | strip | default: '23:59'

  # The store's time zone offset (e.g. +0100), so the end is read in the store's time zone. It is
  # today's offset: on a daylight saving change between now and the end, the end can move one hour.
  assign end_epoch = 0
  if end_date != blank
    assign offset = 'now' | date: '%z'
    assign end_string = end_date | append: ' ' | append: end_time | append: ' ' | append: offset
    assign end_epoch = end_string | date: '%s' | plus: 0
  endif

  # A date that can't be read comes back unchanged and gives a small number (e.g. "2026-13-45" -> 2026):
  # anything before 2001 is not a real end date
  if end_epoch < 1000000000
    assign end_epoch = 0
  endif

  assign now_epoch = 'now' | date: '%s' | plus: 0
  assign remaining = end_epoch | minus: now_epoch | at_least: 0
  assign ended = false
  if end_epoch > 0 and remaining == 0
    assign ended = true
  endif

  assign days = remaining | divided_by: 86400
  assign hours = remaining | modulo: 86400 | divided_by: 3600
  assign minutes = remaining | modulo: 3600 | divided_by: 60
  assign seconds = remaining | modulo: 60

  assign on_end = block.settings.on_end
  assign show = true
  if end_epoch == 0
    assign show = false
  endif
  if ended
    if on_end == 'hide'
      assign show = false
    endif
  endif
  # The editor always shows the block, so it can be selected. After the end it shows what the store
  # shows ("When the time ends"); for "Hide" the tiles are faded and a note tells that they are hidden.
  if request.design_mode
    assign show = true
  endif

  assign show_message = false
  if ended and on_end == 'message'
    assign show_message = true
  endif
-%}

{%- if show -%}
  <countdown-timer
    class="countdown countdown--{{ block.settings.alignment }} countdown--mobile-{{ block.settings.mobile_alignment }}{% if ended and on_end == 'hide' %} countdown--preview-hidden{% endif %}"
    {% if end_epoch > 0 %}
      data-end="{{ end_epoch }}"
    {% endif %}
    data-on-end="{{ on_end }}"
    {{ block.shopify_attributes }}
  >
    {%- if end_epoch > 0 -%}
      {%- assign end_label = end_epoch | date: format: 'date_at_time' -%}
      <p class="visually-hidden">{{ 'sections.countdown.ends' | t: date: end_label }}</p>
    {%- endif -%}

    <div class="countdown__row"{% if show_message %} hidden{% endif %}>
    <div class="countdown__units" aria-hidden="true">
      <div class="countdown__unit">
        <span class="countdown__value" data-unit="days">{% if days < 10 %}0{% endif %}{{ days }}</span>
        <span class="countdown__label">{{ 'sections.countdown.days' | t }}</span>
      </div>
      <span class="countdown__colon">:</span>
      <div class="countdown__unit">
        <span class="countdown__value" data-unit="hours">{% if hours < 10 %}0{% endif %}{{ hours }}</span>
        <span class="countdown__label">{{ 'sections.countdown.hours' | t }}</span>
      </div>
      <span class="countdown__colon">:</span>
      <div class="countdown__unit">
        <span class="countdown__value" data-unit="minutes">{% if minutes < 10 %}0{% endif %}{{ minutes }}</span>
        <span class="countdown__label">{{ 'sections.countdown.minutes' | t }}</span>
      </div>
      {%- if block.settings.show_seconds -%}
        <span class="countdown__colon">:</span>
        <div class="countdown__unit">
          <span class="countdown__value" data-unit="seconds">{% if seconds < 10 %}0{% endif %}{{ seconds }}</span>
          <span class="countdown__label">{{ 'sections.countdown.seconds' | t }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%}
      Pause button (WCAG 2.2.2: content that updates by itself for more than 5 seconds next to other
      content needs a way to stop it). Outside the aria-hidden tiles, so screen readers find it. Shown by
      the script while the countdown ticks (no JS = nothing ticks = no button). Fixed label; aria-pressed
      says whether it is on (pressed = paused).
    {%- endcomment -%}
    {%- if end_epoch > 0 and ended == false -%}
      <button type="button" class="countdown__pause" aria-pressed="false" hidden>
        <span class="visually-hidden">{{ 'sections.countdown.pause' | t }}</span>
        <svg class="countdown__pause-icon countdown__pause-icon--pause" aria-hidden="true" focusable="false" viewBox="0 0 16 16"><rect x="3.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/><rect x="9.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/></svg>
        <svg class="countdown__pause-icon countdown__pause-icon--play" aria-hidden="true" focusable="false" viewBox="0 0 16 16"><path d="M4.5 2.8v10.4a.8.8 0 0 0 1.2.7l8.4-5.2a.8.8 0 0 0 0-1.4L5.7 2.1a.8.8 0 0 0-1.2.7z" fill="currentColor"/></svg>
      </button>
    {%- endif -%}
    </div>

    {%- if on_end == 'message' and block.settings.end_message != blank -%}
      <p class="countdown__message"{% unless show_message %} hidden{% endunless %}>
        {{- block.settings.end_message | escape -}}
      </p>
    {%- endif -%}

    {%- if request.design_mode -%}
      {%- if end_epoch == 0 -%}
        <p class="countdown__editor-note">{{ 'sections.countdown.editor_no_date' | t }}</p>
      {%- elsif ended -%}
        {%- assign note_key = 'sections.countdown.editor_ended_' | append: on_end -%}
        <p class="countdown__editor-note">{{ note_key | t }}</p>
      {%- endif -%}
    {%- endif -%}
  </countdown-timer>
{%- endif -%}

{% stylesheet %}
  countdown-timer {
    display: block;
  }

  /* hidden (set by the script at the end) must win over the display values in this file */
  countdown-timer[hidden],
  .countdown .countdown__row[hidden],
  .countdown .countdown__pause[hidden] {
    display: none;
  }

  /*
    Sizes from the Figma: phones (375px) tiles ~52 x 36px, numbers ~22px, labels ~10px; desktop
    (1920px) tiles ~110 x 78px, numbers ~46px, labels ~18px. Fluid between the two.
    The colours follow the section's scheme (currentColor), so the tiles also work on a light scheme.
  */
  .countdown {
    --countdown-tile: clamp(3.25rem, 2.37rem + 3.75vw, 6.875rem);
    --countdown-number: clamp(1.375rem, 1.01rem + 1.55vw, 2.875rem);
    --countdown-label: clamp(0.6875rem, 0.55rem + 0.45vw, 1.125rem);
    --countdown-gap: clamp(0.375rem, 0.15rem + 0.9vw, 1.25rem);
  }

  /* Alignment: "Alignment" from 1200px, "Alignment on phones and tablets" below 1200px */
  /* The row: the tiles, then the pause button */
  .countdown__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: var(--countdown-justify, flex-start);
    gap: var(--countdown-gap);
  }

  .countdown__units {
    display: flex;
    align-items: flex-start;
    gap: var(--countdown-gap);
  }

  /*
    Pause button: a round glass button like the tiles, centred on the tile height (tile width x 0.7),
    at least 2.25rem (a big enough tap target).
  */
  .countdown .countdown__pause {
    --countdown-pause: max(2.25rem, calc(var(--countdown-tile) * 0.45));
    display: grid;
    place-items: center;
    flex: none;
    inline-size: var(--countdown-pause);
    block-size: var(--countdown-pause);
    margin: calc((var(--countdown-tile) * 0.7 - var(--countdown-pause)) / 2) 0 0;
    padding: 0;
    border: 1px solid color-mix(in srgb, currentcolor 25%, transparent);
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-background) 45%, transparent);
    color: inherit;
    cursor: pointer;
  }

  .countdown__pause svg {
    inline-size: 40%;
    block-size: auto;
  }

  .countdown__pause-icon--play,
  .countdown__pause[aria-pressed='true'] .countdown__pause-icon--pause {
    display: none;
  }

  .countdown__pause[aria-pressed='true'] .countdown__pause-icon--play {
    display: block;
  }

  .countdown__message,
  .countdown__editor-note {
    text-align: var(--countdown-text-align, start);
  }

  @media (min-width: 1200px) {
    .countdown--center { --countdown-justify: center; --countdown-text-align: center; }
    .countdown--end { --countdown-justify: flex-end; --countdown-text-align: end; }
  }

  @media (max-width: 1199px) {
    .countdown--mobile-center { --countdown-justify: center; --countdown-text-align: center; }
    .countdown--mobile-end { --countdown-justify: flex-end; --countdown-text-align: end; }
  }

  .countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.5rem, 0.35rem + 0.5vw, 1rem);
  }

  /*
    Glass tile (Figma): a dark see-through fill (the scheme's background, so a light scheme gets light
    tiles), a thin light edge and a blur of the photo behind it.
    tabular-nums: every digit is the same width, so the tiles don't twitch while the numbers change.
  */
  .countdown__value {
    display: grid;
    place-items: center;
    min-inline-size: var(--countdown-tile);
    aspect-ratio: 10 / 7;
    padding-inline: 0.25em;
    border: 1px solid color-mix(in srgb, currentcolor 25%, transparent);
    border-radius: clamp(0.375rem, 0.25rem + 0.4vw, 0.625rem);
    background-color: color-mix(in srgb, var(--color-background) 45%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, currentcolor 18%, transparent);
    -webkit-backdrop-filter: blur(0.5rem);
    backdrop-filter: blur(0.5rem);
    font-family: var(--font-body--family);
    font-size: var(--countdown-number);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    line-height: 1;
  }

  .countdown__label {
    font-size: var(--countdown-label);
    font-weight: 500;
    line-height: 1.2;
  }

  /* The colon sits on the middle of the tile (half the tile height), not of tile + label */
  .countdown__colon {
    display: grid;
    place-items: center;
    block-size: calc(var(--countdown-tile) * 0.7);
    font-size: calc(var(--countdown-number) * 0.7);
    font-weight: 600;
    line-height: 1;
  }

  .countdown__message {
    margin: 0;
    font-size: var(--font-size-body-lg);
  }

  /* Editor only: the time is over and the store hides the countdown */
  .countdown--preview-hidden .countdown__units {
    opacity: 0.35;
  }

  .countdown__editor-note {
    margin: var(--space-xs) 0 0;
    font-size: var(--font-size-small);
    opacity: 0.8;
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <countdown-timer>: counts down to data-end (Unix seconds). Updates on the second, only while it is
   * on screen and the tab is visible. At the end it follows data-on-end: hide / zeros / message.
   */
  class CountdownTimer extends HTMLElement {
    connectedCallback() {
      this.end = Number(this.dataset.end) * 1000;
      if (!this.end) return;

      // One controller for every listener: the editor can move the section (disconnect + connect again)
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.values = {};
      this.querySelectorAll('[data-unit]').forEach((element) => {
        this.values[element.dataset.unit] = element;
      });

      this.observer = new IntersectionObserver(([entry]) => {
        this.onScreen = entry.isIntersecting;
        this.schedule();
      });
      this.observer.observe(this);
      document.addEventListener('visibilitychange', () => this.schedule(), { signal });

      // Pause button: stops the ticking; play shows the real time left again at once (and ends the
      // countdown if the time ran out while it was paused)
      this.pauseButton = this.querySelector('.countdown__pause');
      if (this.pauseButton) {
        this.pauseButton.hidden = false;
        this.pauseButton.addEventListener(
          'click',
          () => {
            this.paused = !this.paused;
            this.pauseButton.setAttribute('aria-pressed', String(this.paused));
            this.schedule();
          },
          { signal }
        );
      }
      this.tick();
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
      clearTimeout(this.timer);
    }

    /** Runs the next tick at the start of the next second, while the countdown can be seen */
    schedule() {
      clearTimeout(this.timer);
      if (!this.onScreen || document.hidden || this.ended || this.paused) return;
      this.tick();
      this.timer = setTimeout(() => this.schedule(), 1000 - (Date.now() % 1000) + 10);
    }

    tick() {
      const left = Math.max(0, Math.floor((this.end - Date.now()) / 1000));
      const parts = {
        days: Math.floor(left / 86400),
        hours: Math.floor((left % 86400) / 3600),
        minutes: Math.floor((left % 3600) / 60),
        seconds: left % 60,
      };
      Object.entries(this.values).forEach(([unit, element]) => {
        const text = String(parts[unit]).padStart(2, '0');
        // Only write a number that changed: no repaint for the tiles that stay the same
        if (element.textContent !== text) element.textContent = text;
      });
      if (left === 0) this.finish();
    }

    /** The time is over: hide the countdown, keep the zeros, or show the message */
    finish() {
      this.ended = true;
      clearTimeout(this.timer);
      // Nothing ticks any more: no pause button
      if (this.pauseButton) this.pauseButton.hidden = true;
      const mode = this.dataset.onEnd;
      if (mode === 'hide') {
        // The editor keeps the block (faded), so it can still be selected
        if (window.Shopify?.designMode) this.classList.add('countdown--preview-hidden');
        else this.hidden = true;
      } else if (mode === 'message') {
        const message = this.querySelector('.countdown__message');
        if (!message) return;
        message.hidden = false;
        this.querySelector('.countdown__row')?.setAttribute('hidden', '');
      }
    }
  }

  if (!customElements.get('countdown-timer')) {
    customElements.define('countdown-timer', CountdownTimer);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.countdown",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "t:labels.countdown_end_date",
      "info": "t:labels.countdown_end_date_info",
      "placeholder": "YYYY-MM-DD"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "t:labels.countdown_end_time",
      "info": "t:labels.countdown_end_time_info",
      "placeholder": "23:59",
      "default": "23:59"
    },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "t:labels.countdown_show_seconds",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.countdown_after_end"
    },
    {
      "type": "select",
      "id": "on_end",
      "label": "t:labels.countdown_on_end",
      "options": [
        {
          "value": "hide",
          "label": "t:options.countdown_on_end.hide"
        },
        {
          "value": "zeros",
          "label": "t:options.countdown_on_end.zeros"
        },
        {
          "value": "message",
          "label": "t:options.countdown_on_end.message"
        }
      ],
      "default": "hide"
    },
    {
      "type": "text",
      "id": "end_message",
      "label": "t:labels.countdown_end_message",
      "info": "t:labels.countdown_end_message_info",
      "default": "This offer has ended.",
      "visible_if": "{{ block.settings.on_end == 'message' }}"
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "info": "t:labels.countdown_alignment_info",
      "options": [
        {
          "value": "start",
          "label": "t:options.countdown_alignment.start"
        },
        {
          "value": "center",
          "label": "t:options.countdown_alignment.center"
        },
        {
          "value": "end",
          "label": "t:options.countdown_alignment.end"
        }
      ],
      "default": "end"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "t:labels.countdown_mobile_alignment",
      "info": "t:labels.countdown_mobile_alignment_info",
      "options": [
        {
          "value": "start",
          "label": "t:options.countdown_alignment.start"
        },
        {
          "value": "center",
          "label": "t:options.countdown_alignment.center"
        },
        {
          "value": "end",
          "label": "t:options.countdown_alignment.end"
        }
      ],
      "default": "start"
    }
  ],
  "presets": [
    {
      "name": "t:general.countdown"
    }
  ]
}
{% endschema %}
