{% doc %}
  The feature badges row (Figma PDP second card: Recyclable, Vegan, Cruelty-free, Parabens free): an
  optional heading and the _product-feature blocks inside (icon + label), 4 in a row when there's room.
  The same badges show on every product.

  @example
  {% content_for 'block', type: 'product-features', id: 'product-features' %}
{% enddoc %}

{%- comment -%}
  The features are rendered first and kept: on the store a feature without a label outputs nothing
  (blocks/_product-feature.liquid), so empty output = no feature shows. (block.blocks can't read the
  features' settings here.) Store: then nothing at all (no empty list, no heading). Editor: the list
  is always output (the editor needs it to place new features), with a note when nothing shows yet.
{%- endcomment -%}
{%- capture features_items -%}{% content_for 'blocks' %}{%- endcapture -%}
{%- assign features_items_check = features_items | strip -%}

{%- if features_items_check != blank or request.design_mode -%}
  <div class="product-features" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank and features_items_check != blank -%}
      {% render 'product-block-heading', text: block.settings.heading %}
    {%- endif -%}
    {%- if features_items_check == blank -%}
      <p class="product-features__empty">{{ 'products.features.empty' | t }}</p>
    {%- endif -%}
    <div class="product-features__list" role="list">
      {{- features_items -}}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* Figma: 4 badges spread across the card (~160px apart), icon above, label under */
  .product-features__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: var(--space-md);
  }

  /* Editor only: the note when no feature has a label */
  .product-features__empty {
    margin: 0 0 var(--space-sm);
    color: color-mix(in srgb, var(--color-text) 65%, var(--color-background));
    font-size: var(--font-size-small);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_features",
  "tag": null,
  "blocks": [{ "type": "_product-feature" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_features",
      "category": "t:general.product",
      "blocks": [
        { "type": "_product-feature", "settings": { "label": "Recyclable", "builtin_icon": "recyclable" } },
        { "type": "_product-feature", "settings": { "label": "Vegan", "builtin_icon": "vegan" } },
        { "type": "_product-feature", "settings": { "label": "Cruelty-free", "builtin_icon": "cruelty-free" } },
        { "type": "_product-feature", "settings": { "label": "Parabens free", "builtin_icon": "paraben-free" } }
      ]
    }
  ]
}
{% endschema %}
