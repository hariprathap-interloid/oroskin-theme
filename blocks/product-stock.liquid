{% doc %}
  The stock line under the price (Figma PDP "• IN OROSKIN STOCK —— 7 PIECES REMAINING"): an accent dot
  and label, a thin line, and how many are left. The number shows only when it's low (at or under
  "Show the number from"), so a well-stocked product just says "In stock". Products that Shopify
  doesn't track, or that can be sold when out of stock, show the label only. Sold out: "Sold out".
  It follows the chosen variant (the Buy buttons' "variant:change"); a combination of values that is
  no variant hides the line. The product comes from closest.product.
  Settings: the labels ("Low stock text" with [count]), hide the line when sold out, and the colours of
  the label (empty = the scheme's accent).

  @example
  {% content_for 'block', type: 'product-stock', id: 'product-stock' %}
{% enddoc %}

{%- liquid
  assign stock_product = closest.product
  if stock_product != blank
    assign stock_variant = stock_product.selected_or_first_available_variant
  endif
  assign threshold = block.settings.threshold | default: 10
  # Two steps: in one line, | t would also try to translate the merchant's own label
  assign in_stock_default = 'products.in_stock' | t
  assign in_stock_label = block.settings.label | default: in_stock_default
  assign low_text = block.settings.low_stock_text | strip
  assign show_sold_out = block.settings.show_sold_out
  if show_sold_out == nil
    assign show_sold_out = true
  endif

  # Colours: only written when set, so the CSS falls back to the scheme's accent
  capture stock_style
    if block.settings.in_stock_color != blank
      echo '--stock-color: ' | append: block.settings.in_stock_color | append: ';'
    endif
    if block.settings.low_stock_color != blank
      echo '--stock-low-color: ' | append: block.settings.low_stock_color | append: ';'
    endif
  endcapture
-%}

{%- if stock_product != blank -%}
  <product-stock
    class="product-stock"
    {% if stock_style != blank %}
      style="{{ stock_style }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {%- comment -%} One line per variant, rendered by Liquid; the script shows the chosen variant's {%- endcomment -%}
    {%- for variant in stock_product.variants -%}
      {%- liquid
        assign tracked = false
        if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
          assign tracked = true
        endif
        assign is_low = false
        if variant.available and tracked and variant.inventory_quantity <= threshold and variant.inventory_quantity > 0
          assign is_low = true
        endif
        assign line_class = ''
        if variant.available == false
          assign line_class = ' product-stock__line--out'
          unless show_sold_out
            assign line_class = ' product-stock__line--out product-stock__line--none'
          endunless
        elsif is_low
          assign line_class = ' product-stock__line--low'
        endif
      -%}
      <p
        class="product-stock__line{{ line_class }}"
        data-variant-id="{{ variant.id }}"
        {% unless variant == stock_variant %}
          hidden
        {% endunless %}
      >
        <span class="product-stock__label">
          {%- if variant.available -%}
            {{- in_stock_label | escape -}}
          {%- else -%}
            {{- 'products.sold_out' | t -}}
          {%- endif -%}
        </span>
        {%- if is_low -%}
          {%- liquid
            assign count_text = variant.inventory_quantity
            if low_text != blank
              assign count_text = low_text | replace: '[count]', count_text
            else
              assign count_text = 'products.pieces_left' | t: count: variant.inventory_quantity
            endif
          -%}
          <span class="product-stock__rule" aria-hidden="true"></span>
          <span class="product-stock__count">{{ count_text | escape }}</span>
        {%- endif -%}
      </p>
    {%- endfor -%}
  </product-stock>
{%- elsif request.design_mode -%}
  <p class="product-stock__line" {{ block.shopify_attributes }}>
    <span class="product-stock__label">{{ 'products.in_stock' | t }}</span>
  </p>
{%- endif -%}

{% stylesheet %}
  /* Figma: accent caps ~15px with a dot; a 1px line ~45px; grey caps count */
  .product-stock__line {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: 0;
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .product-stock__line[hidden],
  .product-stock__line--none {
    display: none;
  }

  .product-stock__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--stock-color, var(--color-accent));
    font-weight: var(--font-weight-medium);
  }

  .product-stock__line--low .product-stock__label {
    color: var(--stock-low-color, var(--stock-color, var(--color-accent)));
  }

  .product-stock__label::before {
    content: "";
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 50%;
    background-color: currentcolor;
  }

  .product-stock__line--out .product-stock__label {
    color: color-mix(in srgb, var(--color-text) 60%, var(--color-background));
  }

  .product-stock__rule {
    inline-size: 2.75rem;
    block-size: 1px;
    background-color: color-mix(in srgb, var(--color-text) 25%, transparent);
  }

  .product-stock__count {
    color: color-mix(in srgb, var(--color-text) 65%, var(--color-background));
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Shows the line of the variant chosen in the Buy buttons block. Listens on its own section (as the
   * Price block does) and ignores variants it has no line for, so another product on the same page
   * can't hide this one's stock.
   */
  class ProductStock extends HTMLElement {
    connectedCallback() {
      // One controller: the theme editor re-attaches a moved block and runs connectedCallback again
      this.controller?.abort();
      this.controller = new AbortController();
      this.scope = this.closest('.shopify-section') || document;
      this.scope.addEventListener(
        'variant:change',
        (event) => {
          const id = event.detail?.variantId;
          // null = the chosen values are no variant ("Unavailable"): no stock line
          if (id === null) {
            this.querySelectorAll('[data-variant-id]').forEach((line) => (line.hidden = true));
            return;
          }
          if (!id || !this.querySelector(`[data-variant-id="${id}"]`)) return;
          this.querySelectorAll('[data-variant-id]').forEach((line) => {
            line.hidden = line.dataset.variantId !== String(id);
          });
        },
        { signal: this.controller.signal }
      );
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  if (!customElements.get('product-stock')) customElements.define('product-stock', ProductStock);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product_stock",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.product_stock_label",
      "info": "t:labels.product_stock_label_info"
    },
    {
      "type": "text",
      "id": "low_stock_text",
      "label": "t:labels.product_stock_low_text",
      "info": "t:labels.product_stock_low_text_info"
    },
    {
      "type": "checkbox",
      "id": "show_sold_out",
      "label": "t:labels.product_stock_show_sold_out",
      "info": "t:labels.product_stock_show_sold_out_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.product_stock_low_stock"
    },
    {
      "type": "range",
      "id": "threshold",
      "label": "t:labels.product_stock_threshold",
      "info": "t:labels.product_stock_threshold_info",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color",
      "id": "in_stock_color",
      "label": "t:labels.product_stock_color",
      "info": "t:labels.product_stock_color_info"
    },
    {
      "type": "color",
      "id": "low_stock_color",
      "label": "t:labels.product_stock_low_color",
      "info": "t:labels.product_stock_low_color_info"
    }
  ],
  "presets": [
    {
      "name": "t:general.product_stock",
      "category": "t:general.product"
    }
  ]
}
{% endschema %}
