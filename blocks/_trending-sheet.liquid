{% doc %}
  The Image banner's Trending sheet (static block): a dark panel with the Trending list (heading,
  View all, numbered product rows from a collection; snippets/trending-list.liquid).

  Figma: Manifesto and Trending Now are one scene on the same photo. With "Show the Trending sheet"
  on, the Image banner pins while scrolling: the banner's text and cards slide away and this sheet
  slides in from the left over the photo, then the page continues. Without JavaScript, with reduced
  motion or with the theme's animations off, the sheet simply sits under the banner content.

  Width: "Sheet width" from 1200px, "Sheet width on tablets" from 750px, "Sheet width on phones" below (defaults: 70% on tablets, 80% on phones).
  "Products on phones" hides the later rows below 750px, so the sheet fits the screen (Figma mobile: 5).

  The scene's "Transition" (sideways / vertical) and "Slide in the heading and View all" are settings
  of the Image banner section itself, next to its "Scroll animation".

  @example
  {% content_for 'block', type: '_trending-sheet', id: 'trending-sheet' %}
{% enddoc %}

{%- if block.settings.show -%}
  {%- liquid
    assign phone_width = block.settings.phone_width | default: 80
    assign tablet_width = block.settings.tablet_width | default: 70
  -%}
  <div
    class="banner-sheet"
    style="--sheet-width: {{ block.settings.width }}%; --sheet-width-tablet: {{ tablet_width }}%; --sheet-width-phone: {{ phone_width }}%;"
    data-banner-sheet
    data-scene-length="{{ block.settings.scene_length }}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.background_image != blank -%}
      {%- liquid
        assign bg_opacity = block.settings.background_opacity | divided_by: 100.0
        # The sheet has its set widths only in the scroll scene (theme animations on). Without it the sheet is
        # full width. Lazy: the sheet shows only after some scrolling, so it never competes with the LCP image.
        if settings.animations_enabled
          capture bg_sizes
            echo '(min-width: 1200px) ' | append: block.settings.width | append: 'vw, (min-width: 750px) '
            echo tablet_width | append: 'vw, ' | append: phone_width | append: 'vw'
          endcapture
        else
          assign bg_sizes = '100vw'
        endif
      -%}
      <div class="trending-bg" style="--trending-bg-opacity: {{ bg_opacity }};" aria-hidden="true">
        {{ block.settings.background_image | image_url: width: 1600 | image_tag: widths: '400, 600, 900, 1200, 1600', sizes: bg_sizes, alt: '', loading: 'lazy' }}
      </div>
    {%- endif -%}
    {% render 'trending-list',
      collection: block.settings.collection,
      limit: block.settings.products_to_show,
      phone_limit: block.settings.products_to_show_phone,
      heading: block.settings.heading,
      link_label: block.settings.link_label,
      link: block.settings.link,
      heading_size: block.settings.heading_size,
      title_size: block.settings.title_size
    %}
  </div>
{%- endif -%}

{% stylesheet %}
  /* The sheet: a solid panel in the section's background colour (dark in the Dark scheme) */
  .banner-sheet {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    /*
      Figma: the heading sits just under the sticky header and the rows run down to the bottom.
      So the content starts at the top (no centring: that left an empty band above it on tall screens)
      and the list stretches to fill the rest of the sheet (see below).
    */
    justify-content: flex-start;
    padding: clamp(7rem, 3rem + 7vw, 11rem) clamp(var(--page-margin), 3vw, 4rem) clamp(2rem, 1rem + 2vw, 4rem);
    background-color: var(--color-background);
    color: var(--color-text);

    /* Scrollbar (when the list is taller than the screen): thin, gold thumb on a faint track */
    scrollbar-width: thin;
    scrollbar-color: var(--color-accent) color-mix(in srgb, var(--color-text) 10%, transparent);
  }

  /*
    The list fills the sheet's height: heading at the top, then the rows spread evenly down to the
    bottom (space-between). Gaps follow the screen height (svh); when the rows don't fit, the gaps
    shrink to their minimum and the sheet scrolls from the top, so row 01 is always reachable.
  */
  .banner-sheet .trending-list {
    flex: 1;
    gap: clamp(1.5rem, 5svh, 4.5rem);
  }

  .banner-sheet .trending-list > animate-on-scroll {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .banner-sheet .trending-list__rows {
    flex: 1;
    justify-content: space-between;
    gap: clamp(0.75rem, 2svh, 2rem);
  }

  /*
    Phones (Figma mobile): the rows stay together under the heading with an even gap (no spread to the
    bottom), and the heading is closer to the list; the space left under the list stays empty.
  */
  @media (max-width: 749px) {
    .banner-sheet .trending-list {
      gap: 1.25rem;
    }

    .banner-sheet .trending-list__rows {
      justify-content: flex-start;
      gap: 1.5rem;
    }
  }

  .banner-sheet::-webkit-scrollbar {
    inline-size: 6px;
  }

  .banner-sheet::-webkit-scrollbar-track {
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
  }

  .banner-sheet::-webkit-scrollbar-thumb {
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.trending_sheet",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show",
      "label": "t:labels.show_trending_sheet",
      "info": "t:labels.trending_sheet_show_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.trending_heading_info",
      "default": "Trending <em>Now</em>",
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "View all",
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link",
      "info": "t:labels.trending_link_info",
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "header",
      "content": "t:labels.products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection",
      "info": "t:labels.trending_collection_info"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5,
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:labels.sheet_width",
      "info": "t:labels.trending_sheet_width_info",
      "min": 40,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "range",
      "id": "scene_length",
      "label": "t:labels.scene_length",
      "info": "t:labels.trending_sheet_scene_length_info",
      "min": 150,
      "max": 400,
      "step": 25,
      "unit": "%",
      "default": 250,
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "header",
      "content": "t:labels.phones"
    },
    {
      "type": "range",
      "id": "phone_width",
      "label": "t:labels.trending_sheet_phone_width",
      "info": "t:labels.trending_sheet_phone_width_info",
      "min": 50,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 80,
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "range",
      "id": "products_to_show_phone",
      "label": "t:labels.trending_sheet_phone_products",
      "info": "t:labels.trending_sheet_phone_products_info",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5,
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "header",
      "content": "t:labels.tablets"
    },
    {
      "type": "range",
      "id": "tablet_width",
      "label": "t:labels.trending_sheet_tablet_width",
      "info": "t:labels.trending_sheet_tablet_width_info",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70,
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "header",
      "content": "t:labels.text_size"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:labels.heading_size_px",
      "info": "t:labels.size_px_info",
      "min": 32,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "t:labels.title_size_px",
      "info": "t:labels.size_px_info",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "header",
      "content": "t:labels.background_image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.image",
      "info": "t:labels.trending_sheet_image_info",
      "visible_if": "{{ block.settings.show }}"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "label": "t:labels.image_opacity",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ block.settings.show }}"
    }
  ]
}
{% endschema %}
