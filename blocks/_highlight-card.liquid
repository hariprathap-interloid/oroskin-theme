{% doc %}
  One glass highlight card (Figma Manifesto): a round icon, a small uppercase label ("Stories") and a value
  ("48 Articles"). With a link, the whole card is clickable.

  @example
  {% content_for 'block', type: '_highlight-card', id: 'highlight-card' %}
{% enddoc %}

{%- liquid
  if block.settings.link != blank
    assign card_tag = 'a'
  else
    assign card_tag = 'div'
  endif

  assign icon_file = 'icon-' | append: block.settings.icon | append: '.svg'
-%}

{%- if block.settings.label != blank or block.settings.value != blank -%}
  <{{ card_tag }}
    class="highlight-card"
    {% if block.settings.link != blank %}
      href="{{ block.settings.link }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.icon_image != blank -%}
      <span class="highlight-card__icon">
        {{ block.settings.icon_image | image_url: width: 64 | image_tag: alt: '', loading: 'lazy', width: 22, height: 22 }}
      </span>
    {%- elsif block.settings.icon != 'none' -%}
      <span class="highlight-card__icon">{{ icon_file | inline_asset_content }}</span>
    {%- endif -%}

    <span class="highlight-card__text">
      {%- if block.settings.label != blank -%}
        <span class="highlight-card__label">{{ block.settings.label | escape }}</span>
      {%- endif -%}
      {%- if block.settings.value != blank -%}
        <span class="highlight-card__value">{{ block.settings.value | escape }}</span>
      {%- endif -%}
    </span>
  </{{ card_tag }}>
{%- endif -%}

{% stylesheet %}
  /*
    Glass card over the photo: a light, see-through fill that blurs what is behind it, a thin bright
    edge and a soft shadow. The text uses the section's (light) text colour.
  */
  .highlight-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    inline-size: clamp(15rem, 14vw, 17rem);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid #ffffff59;
    border-radius: var(--highlight-card-radius, var(--radius-lg));
    background-color: #ffffff2e;
    box-shadow: 0 0.75rem 2rem #00000026, var(--glass-rim);
    color: var(--color-text);
    text-decoration: none;
    -webkit-backdrop-filter: blur(var(--glass-frost)) saturate(1.2);
    backdrop-filter: blur(var(--glass-frost)) saturate(1.2);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      translate var(--duration-fast) var(--ease-out);
  }

  a.highlight-card:hover {
    background-color: #ffffff47;
    translate: 0 -2px;
  }

  .highlight-card__icon {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border: 1px solid #ffffff59;
    border-radius: var(--radius-pill);
    background-color: #ffffff26;
  }

  .highlight-card__icon svg,
  .highlight-card__icon img {
    inline-size: 1.375rem;
    block-size: 1.375rem;
    object-fit: contain;
  }

  .highlight-card__text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-inline-size: 0;
  }

  .highlight-card__label {
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
    opacity: 0.85;
  }

  .highlight-card__value {
    font-size: var(--font-size-h3);
    line-height: 1.2;
  }

  @media (prefers-reduced-motion: reduce) {
    a.highlight-card:hover {
      translate: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.highlight_card",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:labels.icon",
      "options": [
        { "value": "book", "label": "t:options.stat_icon.book" },
        { "value": "video", "label": "t:options.stat_icon.video" },
        { "value": "users", "label": "t:options.stat_icon.users" },
        { "value": "sparkle", "label": "t:options.stat_icon.sparkle" },
        { "value": "none", "label": "t:options.stat_icon.none" }
      ],
      "default": "book"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "t:labels.custom_icon",
      "info": "t:labels.custom_icon_info"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.stat_label",
      "default": "Stories"
    },
    {
      "type": "text",
      "id": "value",
      "label": "t:labels.stat_value",
      "default": "48 Articles"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:general.highlight_card"
    }
  ]
}
{% endschema %}
