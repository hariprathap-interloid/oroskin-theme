{%- comment -%}
  One card of the About values (design/briefs/about-us.md §4.6, exports "Default-9" (desktop),
  "Variant49" / "Variant50" (phone)): a round icon, the pale number "01" top right (a CSS counter
  from the section), a title, the text and an optional photo.
  Desktop: the photo at the bottom; with "Feature the first card" the first card is two rows tall
  (only with a photo and 3 or more cards). Phones and tablets: the featured first card takes the
  full width with its photo beside the text; the other cards show their photo under the text.
  "tag": null: no Shopify wrapper, so the article is the grid item (the section counts children)
  and an empty card leaves no cell. An empty card (no title, text or photo) shows nothing on the
  store and a note in the theme editor.
{%- endcomment -%}

{%- liquid
  assign has_content = false
  if block.settings.title != blank or block.settings.text != blank or block.settings.image != blank
    assign has_content = true
  endif

  assign animation = section.settings.animation | default: 'fade-up'
  if section.index == 1
    assign animation = 'none'
  endif
-%}

{%- if has_content -%}
  {%- liquid
    assign icon = block.settings.icon | default: 'diamond'
    assign icon_file = 'icon-' | append: icon | append: '.svg'
  -%}

  <article
    class="value-card{% if block.settings.image != blank %} value-card--media{% endif %}"
    {% if animation != 'none' %}
      data-animate="{{ animation }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <div class="value-card__body">
      <div class="value-card__top">
        {%- if icon != 'none' -%}
          <span class="value-card__icon" aria-hidden="true">{{ icon_file | inline_asset_content }}</span>
        {%- endif -%}
        <span class="value-card__number" aria-hidden="true"></span>
      </div>

      {%- if block.settings.title != blank -%}
        <h3 class="value-card__title">{{ block.settings.title | escape }}</h3>
      {%- endif -%}

      {%- if block.settings.text != blank -%}
        <div class="value-card__text">{{ block.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if block.settings.image != blank -%}
      {%- liquid
        capture image_loading
          render 'section-loading'
        endcapture
        assign image_loading = image_loading | strip

        # Desktop: a third of the content width less the card padding. Phones and tablets: a small card's
        # photo under its text (half the row less the padding: ~42vw tablets, ~36vw phones) is the larger
        # place; the featured card's photo column (0.7 of 1.7 of its inside) is a little smaller.
        if section.settings.section_width == 'narrow'
          assign image_sizes = '(min-width: 1200px) min(30vw, 340px), (min-width: 750px) 42vw, 36vw'
        else
          assign image_sizes = '(min-width: 1200px) 30vw, (min-width: 750px) 42vw, 36vw'
        endif
      -%}
      <div class="value-card__media">
        {% render 'image',
          image: block.settings.image,
          class: 'image--cover',
          alt: '',
          widths: '300, 450, 600, 800, 1100',
          sizes: image_sizes,
          loading: image_loading
        %}
      </div>
    {%- endif -%}
  </article>
{%- elsif request.design_mode -%}
  <p class="about-values__note" {{ block.shopify_attributes }}>{{ 'about.value_card_empty' | t }}</p>
{%- endif -%}

{% stylesheet %}
  /*
    Figma 1920 (Default-9): card #fcfafa, 1px pale border, radius ~24, soft shadow, padding ~32;
    icon 50px circle, accent ~10% fill, accent icon 24px; number heading font thin ~90px, accent
    ~20%, top right (its top in line with the icon); title heading font semibold ~36px accent,
    ~24px under the icon; text body ~18px / 29px, ~30px under the title; photo 471x225, radius ~24,
    ~20px under the text, at the card's bottom.
    Phones (Variant49 / 50, 375px): padding ~16–20, icon ~26px, number ~26px, title ~17px, text
    ~10–11px; the featured card's photo ~120x195 beside the text (text column : photo ~ 1 : 0.7).
  */
  .value-card {
    counter-increment: value-card;
    display: flex;
    flex-direction: column;
    gap: max(var(--space-md), calc(20 * var(--px)));
    block-size: 100%;
    box-sizing: border-box;
    padding: max(var(--space-lg), calc(32 * var(--px)));
    border: 1px solid var(--color-card-border);
    border-radius: max(1rem, calc(24 * var(--px)));
    background-color: color-mix(in srgb, var(--color-accent) 2%, var(--color-background));
    box-shadow: 0 2px 10px 0 #0000001a;
  }

  /* Figma: title ~24px under the icon row, text ~30px under the title */
  .value-card__body {
    display: flex;
    flex-direction: column;
  }

  .value-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .value-card__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    inline-size: max(2.75rem, calc(50 * var(--px)));
    block-size: max(2.75rem, calc(50 * var(--px)));
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
  }

  .value-card__icon svg {
    inline-size: max(1.25rem, calc(24 * var(--px)));
    block-size: max(1.25rem, calc(24 * var(--px)));
  }

  /* "01", "02"…: the section's counter (one per card) */
  .value-card__number::before {
    content: counter(value-card, decimal-leading-zero);
  }

  /*
    line-height 1 and no negative margin: a tighter box let the digits rise above it, through the
    card's top padding (they touched the card's edge).
  */
  .value-card__number {
    margin: 0;
    color: color-mix(in srgb, var(--color-accent) 20%, transparent);
    font-family: var(--font-heading--family);
    font-size: max(3rem, calc(90 * var(--px)));
    font-weight: 200;
    line-height: 1;
  }

  .value-card__title {
    margin: max(var(--space-md), calc(24 * var(--px))) 0 0;
    color: var(--color-accent);
    font-size: max(1.5rem, calc(36 * var(--px)));
    font-weight: 600;
    line-height: 1.1;
  }

  .value-card__text {
    margin-block-start: max(var(--space-lg), calc(30 * var(--px)));
    font-size: var(--font-size-body-sm);
    line-height: 1.6;
  }

  .value-card__text > * {
    margin: 0;
  }

  .value-card__text > * + * {
    margin-block-start: max(var(--space-md), calc(24 * var(--px)));
  }

  /*
    The photo fills what is left of the card and never makes it taller: the img is taken out of the
    flow (absolute), so the two-row card is as tall as its two rows (~326px each), not the photo.
  */
  .value-card__media {
    position: relative;
    overflow: hidden;
    flex: 1 1 0;
    min-block-size: max(10rem, calc(225 * var(--px)));
    border-radius: max(1rem, calc(24 * var(--px)));
  }

  .value-card__media .image {
    position: absolute;
    inset: 0;
  }

  .value-card__media .image,
  .value-card__media img {
    inline-size: 100%;
    block-size: 100%;
  }

  /*
    Phones and tablets: smaller type. The featured first card (the section adds --feature) puts its
    photo beside the text, as tall as the text (the img is absolute, so the row height comes from
    the text); the other cards keep the photo under their text.
  */
  @media (max-width: 1199px) {
    .value-card {
      gap: var(--space-sm);
      padding: var(--space-md);
    }

    .value-card__icon {
      inline-size: 2.25rem;
      block-size: 2.25rem;
    }

    .value-card__icon svg {
      inline-size: 1.125rem;
      block-size: 1.125rem;
    }

    .value-card__number {
      font-size: 2.25rem;
    }

    .value-card__title {
      margin-block-start: var(--space-sm);
      font-size: clamp(1.125rem, 3.5vw, 1.75rem);
    }

    .value-card__text {
      margin-block-start: var(--space-sm);
      font-size: clamp(0.75rem, 2vw, 1rem);
    }

    .value-card__media {
      flex: none;
      min-block-size: 0;
      aspect-ratio: 16 / 10;
    }

    /* The icon row stays full width (the number at the card's corner); the photo sits beside the title and text */
    .about-values__list--feature > .value-card--media:first-child {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        "top top"
        "title media"
        "text media";
      gap: 0 var(--space-md);
    }

    .about-values__list--feature > .value-card--media:first-child .value-card__body {
      display: contents;
    }

    .about-values__list--feature > .value-card--media:first-child .value-card__top {
      grid-area: top;
    }

    .about-values__list--feature > .value-card--media:first-child .value-card__title {
      grid-area: title;
    }

    .about-values__list--feature > .value-card--media:first-child .value-card__text {
      grid-area: text;
    }

    .about-values__list--feature > .value-card--media:first-child .value-card__media {
      grid-area: media;
      min-block-size: 10rem;
      margin-block-start: var(--space-sm);
      aspect-ratio: auto;
    }
  }

  /* Phones (Variant49 / 50): compact cards, 2 per row (the section) */
  @media (max-width: 749px) {
    .value-card {
      gap: var(--space-sm);
      padding: 1rem;
      border-radius: 1.25rem;
    }

    .value-card__icon {
      inline-size: 1.625rem;
      block-size: 1.625rem;
    }

    .value-card__icon svg {
      inline-size: 0.875rem;
      block-size: 0.875rem;
    }

    .value-card__number {
      font-size: 1.75rem;
    }

    .value-card__title {
      margin-block-start: 0.75rem;
      font-size: 1.0625rem;
      line-height: 1.2;
    }

    .value-card__text {
      margin-block-start: 0.75rem;
      font-size: 0.6875rem;
      line-height: 1.65;
    }

    .value-card__text > * + * {
      margin-block-start: 0.75rem;
    }

    .value-card__media {
      border-radius: 0.875rem;
    }

    .about-values__list--feature > .value-card--media:first-child {
      column-gap: 0.75rem;
    }

    .about-values__list--feature > .value-card--media:first-child .value-card__media {
      min-block-size: 8rem;
      margin-block-start: 0.75rem;
      border-radius: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.value_card",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:labels.icon",
      "options": [
        { "value": "diamond", "label": "t:options.value_icon.diamond" },
        { "value": "lashes", "label": "t:options.value_icon.lashes" },
        { "value": "heart-bold", "label": "t:options.value_icon.heart" },
        { "value": "graduation", "label": "t:options.value_icon.graduation" },
        { "value": "globe", "label": "t:options.value_icon.globe" },
        { "value": "sparkle", "label": "t:options.value_icon.sparkle" },
        { "value": "shield", "label": "t:options.value_icon.shield" },
        { "value": "users", "label": "t:options.value_icon.users" },
        { "value": "none", "label": "t:options.value_icon.none" }
      ],
      "default": "diamond"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Quality"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Describe a value that guides your work and why it matters to your customers.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:labels.about_value_image_info"
    }
  ],
  "presets": [
    {
      "name": "t:general.value_card"
    }
  ]
}
{% endschema %}
