{% doc %}
  The Trending list (Figma "Trending Now"): a heading with a "View all" link, then numbered product rows
  (01 · thumbnail · category · title · badge · price) from one collection. Shared by the Trending
  products section and the Image banner's Trending sheet, so both always look the same.

  Per row: category = the product's type (hidden when empty); badge = the first value of the product's
  "Badges" field via the product-badge snippet; the whole row is one link (the title's link stretches
  over it). Without a collection: placeholder rows.

  @param {collection} [collection] - The collection to list. Empty = placeholder rows
  @param {number} [limit] - How many products, default 5
  @param {string} [heading] - Heading HTML (inline rich text: italic words show in the accent colour)
  @param {string} [link_label] - "View all" text
  @param {string} [link] - "View all" URL; default the collection's page
  @param {string} [animation] - Row reveal ('none', 'fade-up', 'slide-left'...), default 'none'
  @param {number} [heading_size] - Heading size in px at 1920px wide (shrinks smoothly on smaller screens)
  @param {number} [title_size] - Product title size in px at 1920px wide

  @example
  {% render 'trending-list', collection: section.settings.collection, heading: section.settings.heading %}
{% enddoc %}

{%- liquid
  assign row_limit = limit | default: 5
  assign row_animation = animation | default: 'none'

  # Custom sizes: the same fluid formula as the Heading / Text blocks (snippets/fluid-font-size.liquid)
  assign heading_style = ''
  if heading_size
    capture heading_style
      render 'fluid-font-size', size: heading_size
    endcapture
  endif
  assign title_style = ''
  if title_size
    capture title_style
      render 'fluid-font-size', size: title_size
    endcapture
  endif

  assign view_all_url = link
  if view_all_url == blank and collection != blank
    assign view_all_url = collection.url
  endif
-%}

<div class="trending-list">
  {%- if heading != blank or link_label != blank -%}
    <div class="trending-list__header">
      {%- if heading != blank -%}
        <h2
          class="trending-list__heading{% if heading_size %} trending-list__heading--custom{% endif %}"
          {% if heading_size %}
            style="{{ heading_style | strip }}"
          {% endif %}
        >
          {{ heading }}
        </h2>
      {%- endif -%}
      {%- if link_label != blank and view_all_url != blank -%}
        <a class="button button--text trending-list__view-all" href="{{ view_all_url }}">
          {{- link_label | escape -}}
          <span class="trending-list__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <animate-on-scroll>
    <ol
      class="trending-list__rows{% if title_size %} trending-list__rows--custom{% endif %}"
      role="list"
      {% if title_size %}
        style="{{ title_style | strip }}"
      {% endif %}
    >
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: row_limit -%}
          {%- liquid
            assign row_number = forloop.index | prepend: '0' | slice: -2, 2
            assign delay = forloop.index0 | times: 80 | at_most: 480
            assign badges_field = product.metafields.custom.badges
          -%}
          <li
            class="trending-list__row"
            {% if row_animation != 'none' %}
              data-animate="{{ row_animation }}"
              style="--animate-delay: {{ delay }}ms;"
            {% endif %}
          >
            <span class="trending-list__number" aria-hidden="true">{{ row_number }}</span>
            <div class="trending-list__thumb">
              {%- if product.featured_media != blank -%}
                {{ product.featured_media.preview_image | image_url: width: 240, height: 160, crop: 'center' | image_tag: widths: '120, 240', sizes: '120px', alt: '', loading: 'lazy' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="trending-list__text">
              {%- if product.type != blank -%}
                <p class="trending-list__category">{{ product.type | escape }}</p>
              {%- endif -%}
              <h3 class="trending-list__title">
                <a class="trending-list__link" href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>
            </div>
            <div class="trending-list__badge">
              {%- if badges_field != blank -%}
                {%- if badges_field.type contains 'list.' -%}
                  {%- for badge in badges_field.value limit: 1 -%}
                    {% render 'product-badge', badge: badge %}
                  {%- endfor -%}
                {%- else -%}
                  {% render 'product-badge', badge: badges_field.value %}
                {%- endif -%}
              {%- endif -%}
            </div>
            <div class="trending-list__price">{% render 'price', product: product %}</div>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..row_limit) -%}
          <li class="trending-list__row">
            <span class="trending-list__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div class="trending-list__thumb">{{ 'product-1' | placeholder_svg_tag }}</div>
            <div class="trending-list__text">
              <p class="trending-list__category">{{ 'sections.trending.placeholder_category' | t }}</p>
              <h3 class="trending-list__title">{{ 'products.card.placeholder_title' | t }}</h3>
            </div>
            <div class="trending-list__badge"></div>
            <div class="trending-list__price">
              <div class="price"><span class="price__current">{{ 1999 | money }}</span></div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ol>
  </animate-on-scroll>
</div>

{% stylesheet %}
  .trending-list {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1rem + 3vw, 5rem);
  }

  .trending-list__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .trending-list__heading {
    margin: 0;
    font-size: var(--font-size-display);
  }

  /* "Trending *Now*": the italic word in the accent colour (gold in the Dark scheme), not slanted */
  .trending-list__heading em {
    color: var(--color-accent);
    font-style: normal;
  }

  /* Custom sizes: the typed size at 1920px, shrinking in a straight line to the phone size */
  .trending-list__heading--custom,
  .trending-list__rows--custom .trending-list__title {
    font-size: clamp(
      var(--fs-min),
      calc(var(--fs-min) + (100vw - 390px) * var(--fs-diff) / 1530),
      var(--fs-max)
    );
  }

  /*
    Optional background image behind the list (Trending sheet / Trending products panel): it sits
    under the content (z-index -1 inside the panel's own stacking context) at the chosen opacity,
    over the panel's background colour.
  */
  .trending-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: var(--trending-bg-opacity, 0.3);
    pointer-events: none;
  }

  .trending-bg img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .trending-list__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: color-mix(in srgb, var(--color-text) 75%, var(--color-background));
  }

  .trending-list__arrow svg {
    inline-size: 1em;
    block-size: auto;
  }

  .trending-list__rows {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 1rem + 1.5vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One row: number · thumbnail · category + title · badge · price */
  .trending-list__row {
    position: relative;
    display: grid;
    grid-template-columns: auto clamp(5rem, 4rem + 3vw, 7.5rem) 1fr auto auto;
    align-items: center;
    gap: var(--space-sm) clamp(1rem, 0.5rem + 1.5vw, 2.25rem);
  }

  .trending-list__number {
    min-inline-size: 2ch;
    color: color-mix(in srgb, var(--color-text) 55%, var(--color-background));
    font-family: var(--font-heading--family);
    font-size: var(--font-size-h2);
    line-height: 1;
  }

  .trending-list__thumb {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background-color: var(--color-tint);
  }

  .trending-list__thumb > :is(img, svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .trending-list__text {
    min-inline-size: 0;
  }

  .trending-list__category {
    margin: 0 0 var(--space-xs);
    color: var(--color-accent);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .trending-list__title {
    margin: 0;
    font-size: var(--font-size-h3);
    font-weight: var(--font-heading--weight);
  }

  /* The title's link covers the whole row: one click target, one tab stop per product */
  .trending-list__link {
    color: inherit;
    text-decoration: none;
  }

  .trending-list__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .trending-list__row:hover .trending-list__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .trending-list__link:focus-visible {
    outline: none;
  }

  .trending-list__row:has(.trending-list__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 0.5rem;
  }

  /* Figma: the price in white, bold, body font (the theme's price is accent-coloured elsewhere) */
  .trending-list__price .price__current {
    color: var(--color-text);
    font-size: var(--font-size-body-lg);
    font-weight: 600;
  }

  .trending-list__price .price {
    justify-content: flex-end;
  }

  /* Phones: badge and price move under the title */
  @media (max-width: 749px) {
    .trending-list__row {
      grid-template-columns: auto 5rem 1fr;
    }

    .trending-list__badge,
    .trending-list__price {
      grid-column: 3;
    }

    .trending-list__badge:empty {
      display: none;
    }

    .trending-list__price .price {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}
