{% doc %}
  Renders the Filters button and the drawer it opens (collection and search pages). Design: Figma 170:94885
  (design/briefs/filter-drawer.md).

  The filters themselves (which ones, in what order) are set by the merchant in the Search & Discovery
  app; the theme only shows what `collection.filters` / `search.filters` returns. Shopify leaves out a
  filter that has no values in the current collection, so a Makeup collection only gets makeup filters.
  Every choice is a URL parameter (filter.v.availability=1, filter.p.vendor=Oroskin, filter.v.price.gte=10),
  so the form is a plain GET form: Shopify reads the URL and returns the filtered products.

  Layout: Shopify's general filters first (Availability, Price, Brand, Product type), then a divider
  ("Makeup filters") and every other filter. Each group is snippets/filter-group.liquid.
  All groups start open; the visitor can close any of them.

  Ticking boxes doesn't change the page yet. While the drawer is open, the button "View results (N)" and
  the counts next to each choice update after every change (a background request for the same section with
  the new choices, ~0.3s after the last change). "View results" asks the section's <results-view> to load
  the results and closes. Closing any other way puts the boxes back as they were (form.reset()).

  @param {filter[]} filters - collection.filters or search.filters
  @param {string} results_url - Where the form sends to, e.g. collection.url
  @param {string} section_id - The section's id, for unique ids and Section Rendering
  @param {string} clear_url - The URL with every filter removed (keeps the sort and search terms)
  @param {number} results_count - The number of results now (collection.products_count / search.results_count)
  @param {string} [category_label] - The divider's text, e.g. "Makeup filters"
  @param {string} [terms] - The search terms on the search page, sent again as q

  @example
  {% render 'filter-drawer', filters: collection.filters, results_url: collection.url, section_id: section.id, clear_url: clear_url, results_count: collection.products_count, category_label: category_label %}
{% enddoc %}

{%- liquid
  # How many choices are applied: each ticked value, plus 1 for a price range
  assign active_count = 0
  for filter in filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor

  # "General" filters (before the divider) are Shopify's built-in ones, recognised by their URL name:
  # availability, price, vendor (Brand) and product type. Variant options (Size) and the merchant's own
  # fields (Scent, Skin type…) are about the category, so they go under the divider.
  # Commas around each name, so a name matches only whole (",filter.v.price," not a longer one).
  assign general_csv = ',filter.v.availability,filter.v.price,filter.p.vendor,filter.p.product_type,'
-%}

<filter-drawer class="filter-drawer" data-section-id="{{ section_id }}">
  <button
    type="button"
    class="filter-drawer__toggle"
    aria-haspopup="dialog"
    aria-controls="FilterDrawer-{{ section_id }}"
    aria-expanded="false"
  >
    {{- 'icon-filter.svg' | inline_asset_content -}}
    {{- 'collections.filters' | t -}}
    <span id="FilterCount-{{ section_id }}" data-results-part>
      {%- if active_count > 0 -%}
        <span class="filter-drawer__count" aria-hidden="true">{{ active_count }}</span>
        <span class="visually-hidden">{{ 'collections.filters_applied' | t: count: active_count }}</span>
      {%- endif -%}
    </span>
  </button>

  <dialog
    id="FilterDrawer-{{ section_id }}"
    class="filter-drawer__dialog"
    aria-labelledby="FilterDrawerTitle-{{ section_id }}"
  >
    <form
      id="FilterForm-{{ section_id }}"
      class="filter-drawer__form"
      action="{{ results_url }}"
      method="get"
      data-results-form
      data-results-part
    >
      <div class="filter-drawer__head">
        <h2 class="filter-drawer__title" id="FilterDrawerTitle-{{ section_id }}">{{ 'collections.filters' | t }}</h2>
        <a class="filter-drawer__reset" href="{{ clear_url }}" data-results-link>{{ 'collections.reset' | t }}</a>
        {%- comment -%} autofocus: showModal() puts focus here first (not on Reset) {%- endcomment -%}
        <button type="button" class="filter-drawer__close" data-drawer-close autofocus>
          {{- 'icon-close.svg' | inline_asset_content -}}
          <span class="visually-hidden">{{ 'collections.close_filters' | t }}</span>
        </button>
      </div>

      <div class="filter-drawer__body">
        {%- if terms != blank -%}
          <input type="hidden" name="q" value="{{ terms | escape }}">
        {%- endif -%}

        {%- comment -%} General filters first, in Search & Discovery's order {%- endcomment -%}
        {%- assign has_category = false -%}
        {%- for filter in filters -%}
          {%- assign needle = filter.param_name | prepend: ',' | append: ',' -%}
          {%- if general_csv contains needle -%}
            {%- render 'filter-group', filter: filter, section_id: section_id -%}
          {%- else -%}
            {%- assign has_category = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Then the divider and every other filter {%- endcomment -%}
        {%- if has_category -%}
          {%- if category_label != blank -%}
            <p class="filter-drawer__divider"><span>{{ category_label | escape }}</span></p>
          {%- endif -%}
          {%- for filter in filters -%}
            {%- assign needle = filter.param_name | prepend: ',' | append: ',' -%}
            {%- unless general_csv contains needle -%}
              {%- render 'filter-group', filter: filter, section_id: section_id -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="filter-drawer__foot">
        <button type="submit" class="button filter-drawer__apply">
          <span id="FilterResults-{{ section_id }}" aria-live="polite">
            {{- 'collections.view_results' | t: count: results_count -}}
          </span>
        </button>
      </div>
    </form>
  </dialog>
</filter-drawer>

{% stylesheet %}
  /* The button and the dialog sit in the toolbar's flow as if the wrapper weren't there */
  .filter-drawer {
    display: contents;
  }

  /* Without JavaScript the drawer can't open, so the button is hidden until the element is defined */
  filter-drawer:not(:defined) .filter-drawer__toggle {
    display: none;
  }

  /* Figma "Filters": a 50px outlined pill (same rose border as SORT), red icon, then the label */
  .filter-drawer__toggle {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: 3.125rem;
    padding-inline: var(--space-lg);
    border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    border-radius: var(--radius-pill);
    background-color: var(--color-glass);
    color: var(--color-text);
    font: inherit;
    font-size: var(--font-size-body-sm);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .filter-drawer__toggle:hover {
    background-color: var(--color-glass-strong);
  }

  .filter-drawer__toggle svg {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    color: var(--color-primary);
  }

  /*
    The number of applied choices: the small raised red number, like the pill counts. It sits in a
    wrapper span (swapped after each load), so it's lifted with translate rather than flex alignment.
  */
  .filter-drawer__count {
    display: inline-block;
    translate: 0 -0.6em;
    color: var(--color-primary);
    font-size: 0.65em;
    font-variant-numeric: tabular-nums;
  }

  /*
    The panel (Figma 332 x full height): a soft off-white sheet from the left, rounded on the right,
    34px side padding. The background mixes 2% of the text colour into the scheme background (#faf8f8).
  */
  .filter-drawer__dialog {
    inset-block: 0;
    inset-inline: 0 auto;
    inline-size: min(20.75rem, calc(100vw - 3rem));
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-start-end-radius: var(--radius-lg);
    border-end-end-radius: var(--radius-lg);
    background-color: color-mix(in srgb, var(--color-text) 2%, var(--color-background));
    box-shadow: var(--shadow-header);
    color: var(--color-text);
  }

  .filter-drawer__dialog::backdrop {
    background-color: #00000040;
  }

  html:has(.filter-drawer__dialog[open]) {
    overflow: hidden;
  }

  .animations-on .filter-drawer__dialog {
    transition:
      translate var(--duration-base) var(--ease-out),
      display var(--duration-base) allow-discrete,
      overlay var(--duration-base) allow-discrete;
    translate: -100% 0;
  }

  .animations-on .filter-drawer__dialog[open] {
    translate: 0 0;
  }

  @starting-style {
    .animations-on .filter-drawer__dialog[open] {
      translate: -100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animations-on .filter-drawer__dialog {
      transition: none;
    }
  }

  /* Head and foot stay put, the groups in between scroll */
  .filter-drawer__form {
    display: grid;
    grid-template-rows: auto 1fr auto;
    block-size: 100%;
    margin: 0;
  }

  .filter-drawer__head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-xl) var(--space-sm);
  }

  .filter-drawer__title {
    flex: 1;
    margin: 0;
    color: var(--color-primary);
    font-size: var(--font-size-h3);
  }

  .filter-drawer__reset {
    color: var(--color-primary);
    font-size: var(--font-size-caption);
    text-decoration: none;
  }

  .filter-drawer__reset:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* A 38px white circle with the × */
  .filter-drawer__close {
    display: inline-grid;
    flex: none;
    place-items: center;
    inline-size: 2.375rem;
    block-size: 2.375rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: #ffffff;
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    cursor: pointer;
  }

  .filter-drawer__close svg {
    inline-size: 0.875rem;
    block-size: 0.875rem;
  }

  /*
    The scrolling middle. A thin rose scrollbar instead of the grey system one: scrollbar-width / -color
    for Chrome, Edge and Firefox; the ::-webkit-scrollbar rules for Safari.
  */
  .filter-drawer__body {
    overflow-y: auto;
    padding-inline: var(--space-xl);
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-primary) 30%, transparent) transparent;
  }

  .filter-drawer__body::-webkit-scrollbar {
    inline-size: 0.375rem;
  }

  .filter-drawer__body::-webkit-scrollbar-track {
    background: transparent;
  }

  .filter-drawer__body::-webkit-scrollbar-thumb {
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
  }

  /* "Makeup filters": small grey text between two thin rose lines */
  .filter-drawer__divider {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: var(--space-md) 0 0;
    color: color-mix(in srgb, var(--color-text) 60%, var(--color-background));
    font-size: var(--font-size-small);
    white-space: nowrap;
  }

  .filter-drawer__divider::before,
  .filter-drawer__divider::after {
    content: '';
    flex: 1;
    block-size: 1px;
    background-color: color-mix(in srgb, var(--color-primary) 18%, transparent);
  }

  .filter-drawer__foot {
    display: flex;
    justify-content: center;
    padding: var(--space-md) var(--space-xl) var(--space-lg);
  }

  /* Figma: 274 x 50 red pill, white uppercase, soft shadow */
  .filter-drawer__apply {
    inline-size: 100%;
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <filter-drawer>: opens the filter <dialog> with showModal() (focus moves in, Tab stays inside, Escape
   * closes, the page behind is inert).
   * - While it's open, every change asks Shopify for the same section with the new choices (~0.3s after the
   *   last change) and copies the new total into "View results (N)" and the new counts next to each choice.
   *   Nothing else on the page changes.
   * - "View results" asks the section's <results-view> to load the results (a bubbling 'results:load' event;
   *   it reads this form and the sort to build the URL), then closes. "Reset" is a link <results-view> loads.
   * - The Brand search box hides the rows that don't contain what was typed.
   * - Closing without applying resets the boxes to what's applied.
   */
  class FilterDrawer extends HTMLElement {
    connectedCallback() {
      this.toggle = this.querySelector('.filter-drawer__toggle');
      this.dialog = this.querySelector('dialog');
      this.sectionId = this.dataset.sectionId;

      this.toggle.addEventListener('click', () => {
        this.applied = false;
        this.dialog.showModal();
        this.toggle.setAttribute('aria-expanded', 'true');
      });

      this.dialog.addEventListener('click', (event) => {
        // The form fills the dialog, so the dialog itself is only the target for a backdrop click
        if (event.target === this.dialog || event.target.closest('[data-drawer-close]')) {
          this.dialog.close();
        } else if (event.target.closest('[data-results-link]')) {
          // "Reset": <results-view> loads the link; the drawer just gets out of the way
          this.applied = true;
          this.dialog.close();
        }
      });

      this.dialog.addEventListener('submit', (event) => {
        event.preventDefault();
        this.dispatchEvent(new CustomEvent('results:load', { bubbles: true }));
        this.applied = true;
        this.dialog.close();
      });

      this.dialog.addEventListener('change', (event) => {
        if (event.target.name) this.queueCount();
      });

      this.dialog.addEventListener('input', (event) => {
        if (event.target.matches('[data-filter-search]')) this.searchBrands(event.target);
      });

      // Enter in the brand search shouldn't submit the whole form
      this.dialog.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && event.target.matches('[data-filter-search]')) event.preventDefault();
      });

      this.dialog.addEventListener('close', () => {
        this.toggle.setAttribute('aria-expanded', 'false');
        clearTimeout(this.countTimer);
        this.controller?.abort();
        if (!this.applied) {
          this.dialog.querySelector('form')?.reset();
          this.queueCount();
        }
      });
    }

    disconnectedCallback() {
      clearTimeout(this.countTimer);
      this.controller?.abort();
    }

    searchBrands(input) {
      const term = input.value.trim().toLowerCase();
      const list = input.closest('fieldset').querySelector('.filter-group__options');
      list.querySelectorAll('.filter-group__item').forEach((item) => {
        item.hidden = term !== '' && !item.textContent.toLowerCase().includes(term);
      });
    }

    queueCount() {
      clearTimeout(this.countTimer);
      this.countTimer = setTimeout(() => this.updateCount(), 300);
    }

    // The same URL "View results" would load: this form + the sort, empty boxes left out
    countUrl() {
      const form = this.dialog.querySelector('form');
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(form)) {
        if (value !== '') params.append(key, value);
      }
      const sort = this.closest('results-view')?.querySelector('select[name="sort_by"]')?.value;
      if (sort) params.set('sort_by', sort);
      params.set('section_id', this.sectionId);
      return `${form.action}?${params}`;
    }

    async updateCount() {
      this.controller?.abort();
      this.controller = new AbortController();
      try {
        const response = await fetch(this.countUrl(), { signal: this.controller.signal });
        if (!response.ok) return;
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');

        const total = html.getElementById(`FilterResults-${this.sectionId}`);
        const button = this.querySelector(`#FilterResults-${this.sectionId}`);
        if (total && button) button.textContent = total.textContent;

        // Each choice's count and whether it can still be picked (an id per choice, see filter-group)
        this.dialog.querySelectorAll('[data-filter-count]').forEach((count) => {
          const fresh = html.getElementById(count.id);
          if (fresh) count.textContent = fresh.textContent;
          const input = count.closest('label')?.querySelector('input');
          const freshInput = fresh?.closest('label')?.querySelector('input');
          if (input && freshInput && !input.checked) input.disabled = freshInput.disabled;
        });
      } catch (error) {
        // A failed count is only a hint: the visitor can still press View results
      }
    }
  }

  if (!customElements.get('filter-drawer')) customElements.define('filter-drawer', FilterDrawer);
{% endjavascript %}
