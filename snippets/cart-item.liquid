{% doc %}
  One line of the cart page (Figma cart item card): a "select" checkbox, the image, the product type,
  title, chosen options (a colour dot when the option value has a swatch), subscription, line item
  properties and discounts, the price, a - / + quantity stepper and a remove button.

  Works without JavaScript: the quantity field is part of <form id="CartForm"> (name="updates[]", in
  the same order as cart.items) and the remove button is a link to the line's remove URL. The
  <cart-page> script (sections/cart.liquid) makes the stepper and the buttons update the cart in place.

  @param {line_item} item - The cart line
  @param {number} index - The line's position in cart.items, starting at 1 (Shopify's "line" number)

  @example
  {% for item in cart.items %}
    {% render 'cart-item', item: item, index: forloop.index %}
  {% endfor %}
{% enddoc %}

{%- liquid
  # Escaped copy for printing; t filters get item.product.title (t escapes its own output, so an
  # escaped title would show as &amp;#39; etc.)
  assign title = item.product.title | escape
  assign on_sale = false
  if item.original_line_price > item.final_line_price
    assign on_sale = true
  endif
-%}

<li class="cart-item" data-line-key="{{ item.key }}" data-index="{{ index }}">
  <label class="cart-item__select">
    <input class="cart-item__checkbox" type="checkbox" value="{{ item.key }}" data-cart-select data-cart-focus="select-{{ item.key }}">
    <span class="visually-hidden">{{ 'cart.select_item' | t: title: item.product.title }}</span>
  </label>

  <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image != blank -%}
      {% render 'image', image: item.image, class: 'image--cover', sizes: '100px', widths: '100, 200, 300', alt: '' %}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'cart-item__placeholder' }}
    {%- endif -%}
  </a>

  <div class="cart-item__details">
    {%- if item.product.type != blank -%}
      <p class="cart-item__type">{{ item.product.type | escape }}</p>
    {%- endif -%}

    <a class="cart-item__title" href="{{ item.url }}">{{ title }}</a>

    {%- comment -%}
      Options: "30ml  ● Porcelain". A dot only where the option value has a swatch colour (set in the
      admin on the product's option). Products without real options ("Default Title") show nothing.
    {%- endcomment -%}
    {%- unless item.product.has_only_default_variant -%}
      <ul class="cart-item__options" role="list">
        {%- for option in item.options_with_values -%}
          {%- liquid
            assign swatch_color = blank
            assign product_option = item.product.options_by_name[option.name]
            for value in product_option.values
              if value.name == option.value and value.swatch.color != blank
                assign swatch_color = value.swatch.color
              endif
            endfor
          -%}
          <li class="cart-item__option">
            {%- if swatch_color != blank -%}
              <span class="cart-item__swatch" style="--swatch: {{ swatch_color }};" aria-hidden="true"></span>
            {%- endif -%}
            <span class="visually-hidden">{{ option.name | escape }}:</span>
            {{ option.value | escape }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endunless -%}

    {%- if item.selling_plan_allocation -%}
      <p class="cart-item__note">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
    {%- endif -%}

    {%- comment -%} Line item properties (e.g. engraving); names starting with "_" are private {%- endcomment -%}
    {%- for property in item.properties -%}
      {%- assign first_letter = property.first | slice: 0 -%}
      {%- if property.last != blank and first_letter != '_' -%}
        <p class="cart-item__note">
          {{ property.first | escape }}:
          {% if property.last contains '/uploads/' -%}
            <a href="{{ property.last }}">{{ property.last | split: '/' | last | escape }}</a>
          {%- else -%}
            {{ property.last | escape }}
          {%- endif %}
        </p>
      {%- endif -%}
    {%- endfor -%}

    {%- for allocation in item.line_level_discount_allocations -%}
      <p class="cart-item__discount">
        {{- allocation.discount_application.title | escape }} (−{{ allocation.amount | money -}})
      </p>
    {%- endfor -%}

    <p class="cart-item__price">
      {%- if on_sale -%}
        <span class="visually-hidden">{{ 'products.price.sale' | t }}</span>
        {{ item.final_line_price | money }}
        <span class="visually-hidden">{{ 'products.price.regular' | t }}</span>
        <s class="cart-item__compare">{{ item.original_line_price | money }}</s>
      {%- else -%}
        {{ item.final_line_price | money }}
      {%- endif -%}
    </p>

    {%- if item.unit_price_measurement -%}
      <p class="cart-item__unit">
        <span class="visually-hidden">{{ 'products.price.unit' | t }}</span>
        {{ item.unit_price | money }}/
        {%- if item.unit_price_measurement.reference_value != 1 -%}
          {{- item.unit_price_measurement.reference_value -}}
        {%- endif -%}
        {{ item.unit_price_measurement.reference_unit }}
      </p>
    {%- endif -%}
  </div>

  <div class="cart-item__actions">
    <div class="cart-item__quantity">
      <button
        type="button"
        class="cart-item__step"
        data-cart-step="-1"
        data-cart-focus="minus-{{ item.key }}"
        {% if item.quantity <= 1 %}
          disabled
        {% endif %}
        aria-label="{{ 'cart.decrease' | t: title: item.product.title }}"
      >
        {{- 'icon-minus.svg' | inline_asset_content -}}
      </button>
      <label class="visually-hidden" for="CartQuantity-{{ index }}">{{ 'cart.quantity_for' | t: title: item.product.title }}</label>
      <input
        class="cart-item__input"
        id="CartQuantity-{{ index }}"
        type="number"
        name="updates[]"
        value="{{ item.quantity }}"
        min="0"
        inputmode="numeric"
        data-cart-quantity
        data-cart-focus="quantity-{{ item.key }}"
      >
      <button
        type="button"
        class="cart-item__step"
        data-cart-step="1"
        data-cart-focus="plus-{{ item.key }}"
        aria-label="{{ 'cart.increase' | t: title: item.product.title }}"
      >
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </button>
    </div>

    <a
      class="cart-item__remove"
      href="{{ item.url_to_remove }}"
      data-cart-remove
      aria-label="{{ 'cart.remove_item' | t: title: item.product.title }}"
    >
      {{- 'icon-trash.svg' | inline_asset_content -}}
    </a>
  </div>
</li>

{% stylesheet %}
  /*
    Figma cart item card: Glass (Light -45deg 80%, Frost 4), fill #FFFFFF1A, drop shadow
    0 4px 10px #B9B9B91A. Frost 4 = a 1.4px blur, as on the testimonial cards.
  */
  .cart-item {
    display: grid;
    grid-template-columns: auto 6.125rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    padding: var(--space-lg) var(--space-xl) var(--space-lg) var(--space-lg);
    border-radius: var(--radius-md);
    background-color: #ffffff1a;
    box-shadow:
      0 4px 10px 0 #b9b9b91a,
      inset 1px 1px 0 #ffffffcc,
      inset -1px -1px 0 #ffffffbd;
    -webkit-backdrop-filter: blur(1.4px);
    backdrop-filter: blur(1.4px);
    transition: opacity var(--duration-base) var(--ease-out);
  }

  /*
    Figma checkbox: a soft white rounded square; ticked = the accent colour with a white tick. Drawn by
    hand (appearance: none), so two classes, to beat the global input[type="checkbox"] rule.
  */
  .cart-item__select .cart-item__checkbox {
    display: grid;
    place-content: center;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--color-text) 15%, var(--color-background));
    border-radius: 0.3rem;
    background-color: #ffffff;
    cursor: pointer;
    appearance: none;
  }

  .cart-item__select .cart-item__checkbox::after {
    content: "";
    inline-size: 0.35rem;
    block-size: 0.65rem;
    margin-block-start: -0.15rem;
    border: solid #ffffff;
    border-width: 0 2px 2px 0;
    rotate: 45deg;
    opacity: 0;
  }

  .cart-item__select .cart-item__checkbox:checked {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
  }

  .cart-item__select .cart-item__checkbox:checked::after {
    opacity: 1;
  }

  /* Selecting items only does something with JavaScript ("Remove selected") */
  .no-js .cart-item__select {
    display: none;
  }

  .no-js .cart-item {
    grid-template-columns: 6.125rem minmax(0, 1fr) auto;
  }

  .cart-item__media {
    display: block;
    aspect-ratio: 98 / 122;
    overflow: hidden;
    border-radius: 0.25rem; /* Figma: almost square */
    background-color: var(--color-tint, #f3ede2);
  }

  .cart-item__media .image,
  .cart-item__placeholder {
    inline-size: 100%;
    block-size: 100%;
  }

  .cart-item__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-inline-size: 0;
  }

  .cart-item__details p {
    margin: 0;
  }

  .cart-item__type {
    color: var(--color-accent);
    font-size: var(--font-size-caption);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  /* Figma: body font, ~20px at 1920px */
  .cart-item__title {
    color: var(--color-text);
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-heading);
    text-decoration: none;
  }

  .cart-item__title:hover {
    text-decoration: underline;
  }

  .cart-item__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    color: color-mix(in srgb, var(--color-text) 75%, var(--color-background));
    font-size: var(--font-size-body-sm);
  }

  .cart-item__option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .cart-item__swatch {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    border-radius: 50%;
    background-color: var(--swatch);
    box-shadow: inset 0 0 0 1px #0000001a;
  }

  .cart-item__note,
  .cart-item__unit {
    color: color-mix(in srgb, var(--color-text) 70%, var(--color-background));
    font-size: var(--font-size-small);
  }

  .cart-item__discount {
    color: var(--color-accent);
    font-size: var(--font-size-small);
  }

  .cart-item__price {
    margin-block-start: var(--space-xs);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-medium);
  }

  .cart-item__compare {
    margin-inline-start: var(--space-xs);
    color: color-mix(in srgb, var(--color-text) 55%, var(--color-background));
    font-size: var(--font-size-body);
    font-weight: normal;
  }

  .cart-item__actions {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-md), 3vw, 2.5rem);
  }

  /* The - 1 + pill (Figma: 160 x 50px, same glass as the card, a little brighter) */
  .cart-item__quantity {
    display: flex;
    align-items: center;
    justify-content: space-between;
    inline-size: 10rem;
    block-size: 3.125rem;
    padding-inline: var(--space-xs);
    border-radius: var(--radius-pill);
    background-color: #ffffff59;
    box-shadow:
      0 4px 10px 0 #b9b9b91a,
      inset 1px 1px 0 #ffffffcc,
      inset -1px -1px 0 #ffffffbd;
  }

  .cart-item__step {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  /*
    critical.css adds a top margin between neighbouring form controls (label + input, input + button)
    for stacked forms. The stepper is a row, so that margin pushed the number and the + down.
  */
  .cart-item__quantity > * {
    margin-block-start: 0;
  }

  /* display: block: an inline SVG sits on the text baseline, which pushed the - and + off centre */
  .cart-item__step svg {
    display: block;
    inline-size: 0.9375rem;
    block-size: auto;
  }

  .cart-item__step:hover:not(:disabled) {
    color: var(--color-accent);
  }

  /*
    Figma: at quantity 1 the minus is light grey = disabled (the bin removes a product, not the minus).
    Above 1 it's dark like the plus.
  */
  .cart-item__step:disabled {
    color: color-mix(in srgb, var(--color-text) 30%, var(--color-background));
    cursor: default;
  }

  /*
    Two classes on purpose: the global form rule in critical.css is `input[type="number"]` (element +
    attribute), which beats a single class, so one class alone would keep its border, background,
    padding, 50px height and 100% width. Every property that rule sets is reset here.
  */
  .cart-item__quantity .cart-item__input {
    inline-size: 2.5rem;
    min-block-size: 0;
    block-size: 100%;
    line-height: 1; /* the number sits on the same centre line as the - and + */
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--color-text);
    font-size: var(--font-size-h3);
    text-align: center;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  /* Keyboard focus: a ring around the whole pill instead of the field's own outline */
  .cart-item__quantity .cart-item__input:focus-visible {
    outline: none;
  }

  .cart-item__quantity:has(.cart-item__input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .cart-item__input::-webkit-inner-spin-button,
  .cart-item__input::-webkit-outer-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  /* Round white trash button */
  .cart-item__remove {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 50%;
    background-color: #ffffff;
    box-shadow: 0 4px 10px 0 #b9b9b933;
    color: var(--color-text);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  /* Figma: the bin turns brand red with a white icon on hover */
  .cart-item__remove:hover {
    background-color: var(--color-button);
    color: var(--color-button-text);
  }

  .cart-item__remove svg {
    inline-size: 1rem;
    block-size: auto;
  }

  /* A line being updated dims until the new cart arrives */
  .cart-item.is-loading {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Small screens: the stepper and remove button move under the text (no mobile design yet) */
  @media (max-width: 749px) {
    .cart-item {
      grid-template-columns: auto 5rem minmax(0, 1fr);
    }

    .cart-item__actions {
      grid-column: 2 / -1;
      justify-content: space-between;
    }

    .no-js .cart-item__actions {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}
