{% doc %}
  Round glass social buttons (Figma footer: red icons in 50px white circles).

  One button per network whose link is filled in under Theme settings -> Social media; networks with
  an empty link are skipped, and if all are empty nothing is output. Each network needs a setting
  "social_<name>_link", an icon "assets/icon-<name>.svg" and a name "social.<name>" in the locale file.

  @example
  {% render 'social-icons' %}
{% enddoc %}

{%- liquid
  # The order here is the order on the page: the Figma's four first (Facebook, WhatsApp, Instagram,
  # YouTube), then the other networks the theme supports. To add one: a setting, an icon and a name
  # (see the doc comment above), then its name here.
  assign networks = 'facebook,whatsapp,instagram,youtube,tiktok,pinterest,x' | split: ','

  # Is any link filled in? Otherwise output nothing (no empty <ul>).
  assign has_links = false
  for network in networks
    assign setting_id = 'social_' | append: network | append: '_link'
    if settings[setting_id] != blank
      assign has_links = true
      break
    endif
  endfor
-%}

{%- if has_links -%}
  <ul class="social-icons" role="list">
    {%- for network in networks -%}
      {%- liquid
        assign setting_id = 'social_' | append: network | append: '_link'
        assign link = settings[setting_id]
        assign icon_file = 'icon-' | append: network | append: '.svg'
        assign name_key = 'social.' | append: network
      -%}
      {%- if link != blank -%}
        <li>
          <a class="social-icons__link" href="{{ link }}">
            {{- icon_file | inline_asset_content -}}
            <span class="visually-hidden">{{ name_key | t }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  /* Figma: 50px circles, 23px apart (buttons start every 73px) */
  .social-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Same round "Liquid Glass" button as the header icons, in the white of the Figma footer */
  .social-icons__link {
    position: relative; /* the ::before fill is positioned against the button */
    isolation: isolate; /* keeps the fill's z-index: -1 inside the button, behind the icon */
    display: grid;
    place-items: center;
    inline-size: 3.125rem;
    block-size: 3.125rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-glass-strong);
    box-shadow: var(--shadow-header);
    color: var(--color-accent);
    transition: color var(--duration-normal) var(--ease-out);
  }

  /*
    Hover (not in the Figma, our choice): an accent circle grows from the centre of the button
    (scale 0 -> 1) and the icon turns white. Only transform animates, which the browser can do on the
    GPU, so it stays smooth. Keyboard focus gets the same effect.
  */
  .social-icons__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--color-accent);
    transform: scale(0);
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .social-icons__link:hover,
  .social-icons__link:focus-visible {
    color: var(--color-button-text);
  }

  .social-icons__link:hover::before,
  .social-icons__link:focus-visible::before {
    transform: scale(1);
  }

  /* Reduced motion: the fill and colour change at once, no growing */
  @media (prefers-reduced-motion: reduce) {
    .social-icons__link,
    .social-icons__link::before {
      transition: none;
    }
  }

  .social-icons__link svg {
    display: block;
  }
{% endstylesheet %}
