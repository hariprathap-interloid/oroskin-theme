{% doc %}
  The sticky add-to-cart bar (Figma PDP "Product details 4" onward, phone "Variant96-1"): a glass bar at
  the bottom of the screen with the image, product type, title, "15ML · QTY 1", the price, Add to cart
  and Buy now.
  - It appears once the page's own Add to cart row has scrolled up out of view, and steps aside once
    the footer fills the bottom third of the screen (so it never covers the footer's links and forms). Without JavaScript it never shows (the page's own buttons still work).
  - It has no form of its own: its buttons press the Buy buttons block's form, so the chosen variant,
    quantity, purchase option and gift card fields all come along (and the browser checks them).
    Buy now presses Shopify's own "Buy it now" button when there is one, else adds to the cart and goes
    straight to checkout (return_to=/checkout). Add to cart stays on the page: the Buy buttons block adds
    in the background and both show "Added ✓" (the "product:added" event).
  - It follows the chosen variant ("variant:change" on its section): variant name, price, image, and
    Sold out / Unavailable; and the quantity box.

  @param {product} product - The product
  @param {string} [type_label] - The small line above the title (e.g. the product type)
  @param {boolean} [minimize] - Show the ⌄ button (inside the bar, after Buy now) that shrinks the bar to a round cart button

  @example
  {% render 'product-sticky-bar', product: product, type_label: product.type %}
{% enddoc %}

{%- liquid
  assign sticky_variant = product.selected_or_first_available_variant
  assign sticky_image = sticky_variant.featured_image | default: product.featured_image
  assign bar_label = 'products.sticky_bar.label' | t: title: product.title
-%}

<product-sticky-bar
  class="product-sticky-bar"
  role="region"
  aria-label="{{ bar_label | escape }}"
  data-label-add="{{ 'products.add_to_cart' | t | escape_once }}"
  data-label-sold-out="{{ 'products.sold_out' | t | escape_once }}"
  data-label-unavailable="{{ 'products.unavailable' | t | escape_once }}"
  data-label-added="{{ 'products.added' | t | escape_once }}"
  data-quantity-label="{{ 'products.sticky_bar.quantity' | t: quantity: '[quantity]' | escape }}"
  inert
>
  {%- if minimize -%}
    <button
      type="button"
      class="product-sticky-bar__mini"
      aria-label="{{ 'products.sticky_bar.expand' | t | escape_once }}"
      data-sticky-expand
    >
      <span aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
    </button>
  {%- endif -%}
  <div class="product-sticky-bar__inner">
    <div class="product-sticky-bar__product">
      <div class="product-sticky-bar__media">
        {%- if sticky_image != blank -%}
          {{
            sticky_image
            | image_url: width: 180
            | image_tag:
              loading: 'lazy',
              widths: '90, 180',
              sizes: '5rem',
              alt: '',
              class: 'product-sticky-bar__image'
          }}
        {%- endif -%}
      </div>
      <div class="product-sticky-bar__text">
        {%- if type_label != blank -%}
          <p class="product-sticky-bar__type">{{ type_label | escape }}</p>
        {%- endif -%}
        <p class="product-sticky-bar__title">{{ product.title | escape }}</p>
        <p class="product-sticky-bar__meta">
          {%- unless product.has_only_default_variant -%}
            <span data-sticky-variant>{{ sticky_variant.title | escape }}</span>
            <span aria-hidden="true"> · </span>
          {%- endunless -%}
          <span data-sticky-quantity>{{ 'products.sticky_bar.quantity' | t: quantity: 1 }}</span>
        </p>
      </div>
    </div>

    <p class="product-sticky-bar__price" data-sticky-price>{{ sticky_variant.price | money }}</p>

    <div class="product-sticky-bar__buttons">
      <button
        type="button"
        class="button button--secondary product-sticky-bar__add"
        data-sticky-add
        {% unless sticky_variant.available %}
          disabled
        {% endunless %}
      >
        <span class="product-sticky-bar__icon" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        <span data-sticky-add-label>
          {%- if sticky_variant.available -%}
            {{ 'products.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>
      <button
        type="button"
        class="button product-sticky-bar__buy"
        data-sticky-buy
        {% unless sticky_variant.available %}
          disabled
        {% endunless %}
      >
        <span class="product-sticky-bar__icon" aria-hidden="true">{{ 'icon-buy-now.svg' | inline_asset_content }}</span>
        <span>{{ 'products.sticky_bar.buy_now' | t }}</span>
      </button>
      {%- if minimize -%}
        {%- comment -%} Inside the bar, after Buy now: a round glass button with a ⌄ (shrinks the bar to the round cart) {%- endcomment -%}
        <button
          type="button"
          class="product-sticky-bar__minimize"
          aria-label="{{ 'products.sticky_bar.minimize' | t | escape_once }}"
          data-sticky-minimize
        >
          <span aria-hidden="true">{{ 'icon-chevron.svg' | inline_asset_content }}</span>
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Every variant's name, price, image and availability, read by the script {%- endcomment -%}
  <script type="application/json" data-sticky-variants>
    {
      {%- for variant in product.variants -%}
        {%- assign variant_image = variant.featured_image | default: product.featured_image -%}
        "{{ variant.id }}": {
          "title": {{ variant.title | json }},
          "price": {{ variant.price | money | json }},
          "available": {{ variant.available | json }},
          "image": {% if variant_image != blank %}{{ variant_image | image_url: width: 180 | json }}{% else %}null{% endif %}
        }
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    }
  </script>
</product-sticky-bar>

{% stylesheet %}
  /*
    Figma 1920: x 375–1545 (1170 x 94), 24px above the bottom, a white glass card (radius ~24, soft
    shadow); image 70px (radius ~10); type in the heading font accent ~18px; title heading font ~26px;
    "15ML . QTY 1" grey caps ~14px wide spacing; price ~28px medium; Add to cart (outline glass) and
    Buy now (red), both 50px pills.
    Hidden: below the screen edge and see-through; shown (.is-visible): slides up.
  */
  .product-sticky-bar {
    position: fixed;
    z-index: 40;
    inset-block-end: max(var(--space-sm), calc(24 * var(--px, 0.0625rem)));
    inset-inline: 0;
    display: flex;
    justify-content: center;
    padding-inline: var(--page-margin);
    container-type: inline-size; /* the bar's layout follows its own width (see @container below) */
    pointer-events: none; /* the empty sides of the row let clicks through to the page */
    opacity: 0;
    translate: 0 calc(100% + 2rem);
    visibility: hidden;
    transition:
      translate var(--duration-normal) var(--ease-out),
      opacity var(--duration-normal) var(--ease-out),
      visibility 0s linear var(--duration-normal);
  }

  .product-sticky-bar.is-visible {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
    transition:
      translate var(--duration-normal) var(--ease-out),
      opacity var(--duration-normal) var(--ease-out),
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-sticky-bar,
    .product-sticky-bar.is-visible {
      translate: 0 0;
      transition: opacity var(--duration-fast) linear, visibility 0s;
    }
  }

  .product-sticky-bar__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-sm) max(var(--space-md), calc(40 * var(--px, 0.0625rem)));
    inline-size: min(100%, max(56rem, calc(1170 * var(--px, 0.0625rem))));
    padding: max(var(--space-sm), calc(12 * var(--px, 0.0625rem)));
    padding-inline-end: max(var(--space-md), calc(24 * var(--px, 0.0625rem)));
    border: 1px solid color-mix(in srgb, var(--color-background) 60%, transparent);
    border-radius: max(1rem, calc(24 * var(--px, 0.0625rem)));
    background-color: color-mix(in srgb, var(--color-background) 82%, transparent);
    box-shadow: 0 10px 40px #0000001f;
    color: var(--color-text);
    pointer-events: auto;
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  /*
    Minimise: a round glass button with a ⌄ inside the bar, after Buy now, as tall as the buttons (50px).
    Hover / focus: accent ring and the chevron nudges down (it shows where the bar goes).
  */
  .product-sticky-bar .product-sticky-bar__minimize {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 3.125rem;
    block-size: 3.125rem;
    min-block-size: 0;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-card-border);
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-background) 70%, transparent);
    box-shadow: var(--shadow-glass-edge);
    color: var(--color-text);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .product-sticky-bar__minimize > span {
    display: inline-flex;
    transition: translate var(--duration-fast) var(--ease-out);
  }

  .product-sticky-bar__minimize svg {
    inline-size: 0.875rem;
    block-size: auto;
  }

  .product-sticky-bar .product-sticky-bar__minimize:hover,
  .product-sticky-bar .product-sticky-bar__minimize:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-sticky-bar__minimize:hover > span {
      translate: 0 2px;
    }

    /* Minimised: the round cart pops in; opened again: the bar rises back */
    .product-sticky-bar.is-minimized .product-sticky-bar__mini {
      animation: sticky-bar-pop 0.45s var(--ease-out);
    }

    .product-sticky-bar.is-expanding .product-sticky-bar__inner {
      animation: sticky-bar-rise 0.35s var(--ease-out);
    }

    /*
      Minimise (the script closes the bar like a lens onto the minimise button): everything but that
      button fades, so the last thing left is the round button
    */
    .product-sticky-bar.is-minimizing :is(.product-sticky-bar__product, .product-sticky-bar__price, .product-sticky-bar__buttons > :not(.product-sticky-bar__minimize)) {
      opacity: 0;
      transition: opacity 0.2s ease-out;
    }

    /* Landed in the corner: two rings pulse out of the round cart and its icon wiggles */
    .product-sticky-bar.is-landed .product-sticky-bar__mini::after {
      content: "";
      position: absolute;
      inset: 0;
      border: 2px solid var(--color-button);
      border-radius: 50%;
      pointer-events: none;
      animation: sticky-bar-ripple 0.9s ease-out 2;
    }

    .product-sticky-bar.is-landed .product-sticky-bar__mini svg {
      animation: sticky-bar-wiggle 0.6s ease-in-out 0.1s;
    }
  }

  @keyframes sticky-bar-ripple {
    from {
      opacity: 0.7;
      scale: 1;
    }

    to {
      opacity: 0;
      scale: 1.9;
    }
  }

  @keyframes sticky-bar-wiggle {
    25% {
      rotate: -14deg;
    }

    50% {
      rotate: 10deg;
    }

    75% {
      rotate: -5deg;
    }
  }

  /* The round cart rises from below the screen edge with a small bounce */
  @keyframes sticky-bar-pop {
    0% {
      opacity: 0;
      translate: 0 calc(100% + 2rem);
    }

    70% {
      opacity: 1;
      translate: 0 -0.375rem;
    }

    100% {
      translate: 0 0;
    }
  }

  @keyframes sticky-bar-rise {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }

  /* Minimised: only a round cart button in the bottom right corner; a click opens the bar again */
  .product-sticky-bar .product-sticky-bar__mini {
    position: relative;
    display: none;
    place-items: center;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    min-block-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--color-button);
    box-shadow: 0 6px 24px #00000033;
    color: var(--color-button-text);
    cursor: pointer;
    pointer-events: auto;
  }

  .product-sticky-bar__mini svg {
    inline-size: 1.375rem;
    block-size: 1.375rem;
  }

  .product-sticky-bar.is-minimized {
    justify-content: flex-end;
  }

  .product-sticky-bar.is-minimized .product-sticky-bar__inner {
    display: none;
  }

  .product-sticky-bar.is-minimized .product-sticky-bar__mini {
    display: grid;
  }

  .product-sticky-bar__product {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-inline-size: 0;
  }

  .product-sticky-bar__media {
    flex: none;
    overflow: hidden;
    inline-size: max(3.5rem, calc(70 * var(--px, 0.0625rem)));
    aspect-ratio: 1;
    border-radius: max(0.5rem, calc(10 * var(--px, 0.0625rem)));
    background-color: var(--color-tint, color-mix(in srgb, var(--color-text) 5%, var(--color-background)));
  }

  .product-sticky-bar__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .product-sticky-bar__text {
    min-inline-size: 0;
  }

  .product-sticky-bar__text p {
    margin: 0;
  }

  .product-sticky-bar__type {
    color: var(--color-accent);
    font-family: var(--font-heading--family);
    font-size: var(--font-size-body);
    line-height: 1.2;
  }

  .product-sticky-bar__title {
    overflow: hidden;
    font-family: var(--font-heading--family);
    font-size: var(--font-size-h3);
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-sticky-bar__meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-text) 65%, var(--color-background)); /* 60% = 4.35:1 on white */
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .product-sticky-bar__price {
    margin: 0;
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
  }

  .product-sticky-bar__buttons {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /*
    margin 0: the global form rule spaces a button that follows another button (button + button), which
    pushed Buy now 12px down. nowrap: a squeezed button grew to two lines (62px) instead of 50px.
  */
  .product-sticky-bar__buttons > .button {
    margin: 0;
    padding-inline: max(var(--space-md), calc(26 * var(--px, 0.0625rem)));
    white-space: nowrap;
  }

  /* While Buy buttons adds: the label dims a little and a small spinning ring takes the place of the icon */
  .product-sticky-bar__add.is-adding {
    cursor: progress;
  }

  .product-sticky-bar__add.is-adding .product-sticky-bar__icon {
    display: none;
  }

  .product-sticky-bar__add.is-adding [data-sticky-add-label] {
    opacity: 0.7;
  }

  .product-sticky-bar__add.is-adding::before {
    content: "";
    flex: none;
    inline-size: 1em;
    block-size: 1em;
    border: 2px solid color-mix(in srgb, currentcolor 25%, transparent);
    border-block-start-color: currentcolor;
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-sticky-bar__add.is-adding::before {
      animation: sticky-bar-spin 0.7s linear infinite;
    }
  }

  @keyframes sticky-bar-spin {
    to {
      rotate: 1turn;
    }
  }

  /* The icons sit on the middle of the label line (block svg: no space under it for text descenders) */
  .product-sticky-bar__icon {
    display: inline-flex;
    align-items: center;
  }

  .product-sticky-bar__icon svg {
    display: block;
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  /* Outline glass Add to cart: restated because the global button[type] rules outweigh one class */
  .product-sticky-bar .product-sticky-bar__add {
    border-color: var(--color-secondary-button-border);
    background-color: var(--color-secondary-button);
    color: var(--color-secondary-button-text);
    box-shadow: var(--shadow-glass-edge);
  }

  .product-sticky-bar .product-sticky-bar__add:hover:not(:disabled) {
    background-color: color-mix(in srgb, var(--color-secondary-button-text) 8%, var(--color-secondary-button));
  }

  .product-sticky-bar button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  /*
    When the bar is narrower than ~60rem (laptops with large text, tablets): two rows, the product and
    price on top, the two buttons side by side below. Measured on the bar itself (container query), so it
    works at any screen width and text size.
  */
  @container (max-width: 60rem) {
    .product-sticky-bar__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-sm) var(--space-md);
    }

    .product-sticky-bar__price {
      grid-column: 2;
      grid-row: 1;
    }

    .product-sticky-bar__buttons {
      grid-column: 1 / -1;
    }

    .product-sticky-bar__buttons > .button {
      flex: 1;
    }
  }

  /* Phones (Variant96-1): smaller title and price */
  @container (max-width: 40rem) {
    .product-sticky-bar__inner {
      padding: var(--space-sm);
    }

    .product-sticky-bar__title {
      font-size: var(--font-size-body-lg);
    }

    .product-sticky-bar__price {
      font-size: var(--font-size-body-lg);
    }

    /*
      Phones: the two buttons share the row with the minimise button (Figma Variant96-1); smaller text so
      the labels stay on one line and nothing goes past the screen edge
    */
    .product-sticky-bar__buttons > .button {
      flex: 1 1 0;
      min-inline-size: 0;
      gap: 0.25rem;
      padding-inline: 0.5rem;
      font-size: 0.6875rem;
      letter-spacing: 0.05em;
    }

    .product-sticky-bar__icon svg {
      inline-size: 1rem;
      block-size: 1rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <product-sticky-bar>: shows itself while the page's Add to cart row is scrolled up out of view and the
   * footer isn't in view; its buttons press the Buy buttons form (same section).
   */
  class ProductStickyBar extends HTMLElement {
    connectedCallback() {
      // One controller for every listener: the theme editor re-attaches a moved section and runs
      // connectedCallback again (without it, one Buy now press ran twice)
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      // A minimise that was running when the editor moved the bar: start clean (sessionStorage decides below)
      this.classList.remove('is-minimizing', 'is-landed');

      this.scope = this.closest('.shopify-section') || document;
      this.form = this.scope.querySelector('buy-buttons form');
      const row = this.scope.querySelector('buy-buttons .buy-buttons__row');
      if (!this.form || !row) return;

      try {
        this.variants = JSON.parse(this.querySelector('[data-sticky-variants]').textContent);
      } catch (error) {
        this.variants = {};
      }

      // Two conditions: the Add to cart row is above the screen, and the footer isn't on screen
      this.rowPassed = false;
      this.footerInView = false;
      this.rowObserver?.disconnect();
      this.rowObserver = new IntersectionObserver(([entry]) => {
        this.rowPassed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        this.toggle();
      });
      this.rowObserver.observe(row);

      const footer = document.querySelector('.shopify-section-group-footer-group, footer');
      this.footerObserver?.disconnect();
      if (footer) {
        // "In view" = the footer has reached the top two thirds of the screen (rootMargin shrinks the
        // watched area by the bottom third), so a sliver of footer doesn't hide the bar on a short page
        this.footerObserver = new IntersectionObserver(
          ([entry]) => {
            this.footerInView = entry.isIntersecting;
            this.toggle();
          },
          { rootMargin: '0px 0px -33% 0px' }
        );
        this.footerObserver.observe(footer);
      }

      this.querySelector('[data-sticky-add]').addEventListener('click', () => this.add(false), { signal });
      this.querySelector('[data-sticky-buy]').addEventListener('click', () => this.buyNow(), { signal });

      // Minimise / open again; remembered for this browser session (sessionStorage can be blocked: try)
      this.querySelector('[data-sticky-minimize]')?.addEventListener('click', () => this.minimize(true), { signal });
      this.querySelector('[data-sticky-expand]')?.addEventListener('click', () => this.minimize(false), { signal });
      try {
        if (sessionStorage.getItem('oroskin-sticky-bar') === 'min') this.minimize(true, false);
      } catch (error) {
        // No storage: the bar starts open
      }

      // The Buy buttons block adds in the background and says so: the same fill while it adds, then
      // "Added" here too for 2s
      const addButton = this.querySelector('[data-sticky-add]');
      this.scope.addEventListener('product:adding', () => addButton.classList.add('is-adding'), { signal });
      this.scope.addEventListener('product:add-error', () => addButton.classList.remove('is-adding'), { signal });
      this.scope.addEventListener(
        'product:added',
        () => {
          const label = this.querySelector('[data-sticky-add-label]');
          const add = addButton;
          add.classList.remove('is-adding');
          label.textContent = this.dataset.labelAdded;
          add.classList.add('is-added');
          clearTimeout(this.addedTimer);
          this.addedTimer = setTimeout(() => {
            add.classList.remove('is-added');
            if (!add.disabled) label.textContent = this.dataset.labelAdd;
          }, 2000);
        },
        { signal }
      );

      this.scope.addEventListener('variant:change', (event) => this.showVariant(event.detail?.variantId), { signal });
      // Purchase options: a subscription plan's price is the price shown (Buy buttons, "plan:change")
      this.scope.addEventListener(
        'plan:change',
        (event) => {
          this.plan = event.detail;
          this.showPrice(event.detail.variantId);
        },
        { signal }
      );

      this.quantity = this.form.querySelector('input[name="quantity"]');
      this.quantity?.addEventListener('change', () => this.showQuantity(), { signal });
      this.quantity?.addEventListener('input', () => this.showQuantity(), { signal });

      // Back from checkout (page restored from the browser's cache): no Buy now field may stay in the form,
      // or the page's own Add to cart would go to checkout too
      window.addEventListener('pageshow', () => this.removeReturnTo(), { signal });
      // A focused button in the bar keeps it on screen (hiding it would drop the focus to the page)
      this.addEventListener('focusout', () => requestAnimationFrame(() => this.toggle()), { signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.rowObserver?.disconnect();
      this.footerObserver?.disconnect();
      clearTimeout(this.addedTimer);
      clearTimeout(this.landedTimer);
    }

    /**
     * Shrinks the bar to the round cart button (or opens it), moving focus to the button that's left.
     * Minimise (morphToButton): the bar closes like a lens onto the minimise button, that circle becomes the
     * round cart and jumps to the corner, lands with a bounce, two rings pulse and the icon wiggles, so the
     * visitor sees where the bar went. Open again: the bar rises back in. No animation with reduced motion
     * or on page load
     */
    minimize(on, moveFocus = true) {
      const inner = this.querySelector('.product-sticky-bar__inner');
      const animate = moveFocus && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finish = () => {
        this.classList.remove('is-minimizing');
        this.classList.toggle('is-minimized', on);
        this.toggle(); // the round cart may stay over the footer, the full bar not
        if (moveFocus) this.querySelector(on ? '[data-sticky-expand]' : '[data-sticky-minimize]')?.focus();
      };
      try {
        sessionStorage.setItem('oroskin-sticky-bar', on ? 'min' : 'open');
      } catch (error) {
        // No storage: just this page
      }

      // animationend can fail to come (a hidden tab pauses animations): a timer finishes the step anyway
      const afterAnimation = (callback) => {
        let done = false;
        const run = () => {
          if (done) return;
          done = true;
          callback();
        };
        inner.addEventListener('animationend', run, { once: true });
        setTimeout(run, 600);
      };

      if (on && animate && inner) {
        if (this.classList.contains('is-minimizing')) return; // a second press while it runs
        this.morphToButton(inner, finish);
        return;
      }
      if (!on) {
        this.querySelector('[data-sticky-expand]')?.style.removeProperty('animation');
        this.classList.remove('is-landed');
      }
      this.classList.toggle('is-expanding', !on && animate);
      if (!on && animate && inner) afterAnimation(() => this.classList.remove('is-expanding'));
      finish();
    }

    /** The minimise movement (see minimize). Each step also ends on a timer: a hidden tab pauses animations */
    morphToButton(inner, finish) {
      const button = this.querySelector('[data-sticky-minimize]');
      const mini = this.querySelector('[data-sticky-expand]');
      if (!button || !mini) {
        finish();
        return;
      }
      const ended = (animation, ms) =>
        Promise.race([animation.finished.catch(() => {}), new Promise((resolve) => setTimeout(resolve, ms))]);
      // Moved or removed while it runs (theme editor): the rest of the steps stop
      const { signal } = this.controller;

      // 1. The lens: a clip from the whole bar down to the minimise button's circle
      const box = inner.getBoundingClientRect();
      const target = button.getBoundingClientRect();
      const radius = getComputedStyle(inner).borderRadius;
      const to = `inset(${target.top - box.top}px ${box.right - target.right}px ${box.bottom - target.bottom}px ${target.left - box.left}px round 50%)`;
      this.classList.add('is-minimizing');
      const lens = inner.animate([{ clipPath: `inset(0 round ${radius})` }, { clipPath: to }], {
        duration: 420,
        easing: 'cubic-bezier(0.6, 0, 0.4, 1)',
        fill: 'forwards',
      });

      ended(lens, 700).then(() => {
        if (signal.aborted) return;
        // 2. The circle becomes the round cart, which jumps from there to the corner
        finish();
        lens.cancel();
        mini.style.animation = 'none'; // this movement replaces the CSS pop
        const corner = mini.getBoundingClientRect();
        const dx = target.left + target.width / 2 - (corner.left + corner.width / 2);
        const dy = target.top + target.height / 2 - (corner.top + corner.height / 2);
        const jump = mini.animate(
          [
            { transform: `translate(${dx}px, ${dy}px) scale(${target.width / corner.width})` },
            { transform: `translate(${dx * 0.5}px, ${dy * 0.5 - 40}px) scale(1.1)`, offset: 0.5 },
            { transform: 'translate(0, 0) scale(1)' },
          ],
          { duration: 520, easing: 'cubic-bezier(0.34, 1.4, 0.64, 1)' }
        );
        ended(jump, 800).then(() => {
          if (signal.aborted) return;
          // 3. Landed: rings and a wiggle (CSS), then back to rest. The pop stays off until the bar opens
          // again (putting it back now would play it a second time)
          this.classList.add('is-landed');
          clearTimeout(this.landedTimer);
          this.landedTimer = setTimeout(() => this.classList.remove('is-landed'), 1900);
        });
      });
    }

    toggle() {
      // The round cart (minimised) is small: it stays over the footer too; the full bar makes room for it
      const minimized = this.classList.contains('is-minimized');
      const show =
        (this.rowPassed && (!this.footerInView || minimized)) || this.contains(document.activeElement);
      this.classList.toggle('is-visible', show);
      // inert while hidden: its buttons can't be reached with Tab or read out when it isn't there
      this.inert = !show;
    }

    removeReturnTo() {
      this.form?.querySelector('input[name="return_to"][data-sticky]')?.remove();
    }

    /**
     * Submit the Buy buttons form (the browser checks it first, e.g. a gift card email).
     * toCheckout: Shopify sends the visitor to checkout instead of the cart (return_to). The field is only
     * there while the form is sent, then removed again.
     */
    add(toCheckout) {
      const submit = this.form.querySelector('[data-submit]');
      if (!this.form.checkValidity()) {
        this.form.reportValidity();
        const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.form.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
        return;
      }
      this.removeReturnTo();
      // Buy buttons flies the product photo from the button that was pressed: this one
      if (!toCheckout) this.form.dataset.addSource = 'sticky';
      if (toCheckout) {
        const returnTo = Object.assign(document.createElement('input'), {
          type: 'hidden',
          name: 'return_to',
          value: '/checkout',
        });
        returnTo.dataset.sticky = '';
        this.form.append(returnTo);
      }
      this.form.requestSubmit(submit || undefined);
      // The form's data is read during requestSubmit: the field is no longer needed
      this.removeReturnTo();
    }

    /**
     * Buy now: Shopify's plain "Buy it now" button if it's there. The branded buttons (Shop Pay, PayPal…)
     * draw their real button inside their own frame, so a click on them from here does nothing: then
     * add + go straight to checkout
     */
    buyNow() {
      const shopifyButton = this.form.querySelector('.shopify-payment-button__button--unbranded');
      if (shopifyButton && !shopifyButton.closest('[hidden]') && !shopifyButton.disabled) {
        shopifyButton.click();
        return;
      }
      this.add(true);
    }

    /** The variant's price, or the chosen subscription plan's price for it */
    showPrice(variantId) {
      const variant = variantId && this.variants[variantId];
      const price = this.querySelector('[data-sticky-price]');
      if (!variant || !price) return;
      const plan = this.plan;
      const planPrice = plan?.planId && String(plan.variantId) === String(variantId) ? plan.price : '';
      price.textContent = planPrice || variant.price;
    }

    /** The chosen variant's name, price, image and state ("Sold out", "Unavailable") */
    showVariant(variantId) {
      const variant = variantId && this.variants[variantId];
      const add = this.querySelector('[data-sticky-add]');
      const buy = this.querySelector('[data-sticky-buy]');
      const addLabel = this.querySelector('[data-sticky-add-label]');

      if (!variant) {
        add.disabled = buy.disabled = true;
        addLabel.textContent = this.dataset.labelUnavailable;
        return;
      }
      const name = this.querySelector('[data-sticky-variant]');
      if (name) name.textContent = variant.title;
      this.showPrice(variantId);
      if (variant.image) {
        // A product without a featured image has no <img> in the bar yet: make one
        let image = this.querySelector('.product-sticky-bar__image');
        if (!image) {
          image = Object.assign(document.createElement('img'), { alt: '', className: 'product-sticky-bar__image' });
          this.querySelector('.product-sticky-bar__media')?.append(image);
        }
        image.removeAttribute('srcset');
        image.src = variant.image;
      }
      add.disabled = buy.disabled = !variant.available;
      addLabel.textContent = variant.available ? this.dataset.labelAdd : this.dataset.labelSoldOut;
    }

    showQuantity() {
      const quantity = Math.max(1, parseInt(this.quantity.value, 10) || 1);
      this.querySelector('[data-sticky-quantity]').textContent = this.dataset.quantityLabel.replace('[quantity]', quantity);
    }
  }

  if (!customElements.get('product-sticky-bar')) customElements.define('product-sticky-bar', ProductStickyBar);
{% endjavascript %}
