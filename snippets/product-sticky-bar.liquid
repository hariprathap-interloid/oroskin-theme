{% doc %}
  The sticky add-to-cart bar (Figma PDP "Product details 4" onward, phone "Variant96-1"): a glass bar at
  the bottom of the screen with the image, product type, title, "15ML · QTY 1", the price, Add to cart
  and Buy now.
  - It appears once the page's own Add to cart row has scrolled up out of view, and steps aside once
    the footer fills the bottom third of the screen (so it never covers the footer's links and forms). Without JavaScript it never shows (the page's own buttons still work).
  - It has no form of its own: its buttons press the Buy buttons block's form, so the chosen variant,
    quantity, purchase option and gift card fields all come along (and the browser checks them).
    Buy now presses Shopify's own "Buy it now" button when there is one, else adds to the cart and goes
    straight to checkout (return_to=/checkout). Add to cart stays on the page: the Buy buttons block adds
    in the background and both show "Added ✓" (the "product:added" event).
  - It follows the chosen variant ("variant:change" on its section): variant name, price, image, and
    Sold out / Unavailable; and the quantity box.

  @param {product} product - The product
  @param {string} [type_label] - The small line above the title (e.g. the product type)

  @example
  {% render 'product-sticky-bar', product: product, type_label: product.type %}
{% enddoc %}

{%- liquid
  assign sticky_variant = product.selected_or_first_available_variant
  assign sticky_image = sticky_variant.featured_image | default: product.featured_image
  assign bar_label = 'products.sticky_bar.label' | t: title: product.title
-%}

<product-sticky-bar
  class="product-sticky-bar"
  role="region"
  aria-label="{{ bar_label | escape }}"
  data-label-add="{{ 'products.add_to_cart' | t | escape_once }}"
  data-label-sold-out="{{ 'products.sold_out' | t | escape_once }}"
  data-label-unavailable="{{ 'products.unavailable' | t | escape_once }}"
  data-label-added="{{ 'products.added' | t | escape_once }}"
  data-quantity-label="{{ 'products.sticky_bar.quantity' | t: quantity: '[quantity]' | escape }}"
  inert
>
  <div class="product-sticky-bar__inner">
    <div class="product-sticky-bar__product">
      <div class="product-sticky-bar__media">
        {%- if sticky_image != blank -%}
          {{
            sticky_image
            | image_url: width: 180
            | image_tag:
              loading: 'lazy',
              widths: '90, 180',
              sizes: '5rem',
              alt: '',
              class: 'product-sticky-bar__image'
          }}
        {%- endif -%}
      </div>
      <div class="product-sticky-bar__text">
        {%- if type_label != blank -%}
          <p class="product-sticky-bar__type">{{ type_label | escape }}</p>
        {%- endif -%}
        <p class="product-sticky-bar__title">{{ product.title | escape }}</p>
        <p class="product-sticky-bar__meta">
          {%- unless product.has_only_default_variant -%}
            <span data-sticky-variant>{{ sticky_variant.title | escape }}</span>
            <span aria-hidden="true"> · </span>
          {%- endunless -%}
          <span data-sticky-quantity>{{ 'products.sticky_bar.quantity' | t: quantity: 1 }}</span>
        </p>
      </div>
    </div>

    <p class="product-sticky-bar__price" data-sticky-price>{{ sticky_variant.price | money }}</p>

    <div class="product-sticky-bar__buttons">
      <button
        type="button"
        class="button button--secondary product-sticky-bar__add"
        data-sticky-add
        {% unless sticky_variant.available %}
          disabled
        {% endunless %}
      >
        <span class="product-sticky-bar__icon" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        <span data-sticky-add-label>
          {%- if sticky_variant.available -%}
            {{ 'products.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>
      <button
        type="button"
        class="button product-sticky-bar__buy"
        data-sticky-buy
        {% unless sticky_variant.available %}
          disabled
        {% endunless %}
      >
        <span class="product-sticky-bar__icon" aria-hidden="true">{{ 'icon-buy-now.svg' | inline_asset_content }}</span>
        <span>{{ 'products.sticky_bar.buy_now' | t }}</span>
      </button>
    </div>
  </div>

  {%- comment -%} Every variant's name, price, image and availability, read by the script {%- endcomment -%}
  <script type="application/json" data-sticky-variants>
    {
      {%- for variant in product.variants -%}
        {%- assign variant_image = variant.featured_image | default: product.featured_image -%}
        "{{ variant.id }}": {
          "title": {{ variant.title | json }},
          "price": {{ variant.price | money | json }},
          "available": {{ variant.available | json }},
          "image": {% if variant_image != blank %}{{ variant_image | image_url: width: 180 | json }}{% else %}null{% endif %}
        }
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    }
  </script>
</product-sticky-bar>

{% stylesheet %}
  /*
    Figma 1920: x 375–1545 (1170 x 94), 24px above the bottom, a white glass card (radius ~24, soft
    shadow); image 70px (radius ~10); type in the heading font accent ~18px; title heading font ~26px;
    "15ML . QTY 1" grey caps ~14px wide spacing; price ~28px medium; Add to cart (outline glass) and
    Buy now (red), both 50px pills.
    Hidden: below the screen edge and see-through; shown (.is-visible): slides up.
  */
  .product-sticky-bar {
    position: fixed;
    z-index: 40;
    inset-block-end: max(var(--space-sm), calc(24 * var(--px, 0.0625rem)));
    inset-inline: 0;
    display: flex;
    justify-content: center;
    padding-inline: var(--page-margin);
    container-type: inline-size; /* the bar's layout follows its own width (see @container below) */
    pointer-events: none; /* the empty sides of the row let clicks through to the page */
    opacity: 0;
    translate: 0 calc(100% + 2rem);
    visibility: hidden;
    transition:
      translate var(--duration-normal) var(--ease-out),
      opacity var(--duration-normal) var(--ease-out),
      visibility 0s linear var(--duration-normal);
  }

  .product-sticky-bar.is-visible {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
    transition:
      translate var(--duration-normal) var(--ease-out),
      opacity var(--duration-normal) var(--ease-out),
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-sticky-bar,
    .product-sticky-bar.is-visible {
      translate: 0 0;
      transition: opacity var(--duration-fast) linear, visibility 0s;
    }
  }

  .product-sticky-bar__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-sm) max(var(--space-md), calc(40 * var(--px, 0.0625rem)));
    inline-size: min(100%, max(56rem, calc(1170 * var(--px, 0.0625rem))));
    padding: max(var(--space-sm), calc(12 * var(--px, 0.0625rem)));
    padding-inline-end: max(var(--space-md), calc(24 * var(--px, 0.0625rem)));
    border: 1px solid color-mix(in srgb, var(--color-background) 60%, transparent);
    border-radius: max(1rem, calc(24 * var(--px, 0.0625rem)));
    background-color: color-mix(in srgb, var(--color-background) 82%, transparent);
    box-shadow: 0 10px 40px #0000001f;
    color: var(--color-text);
    pointer-events: auto;
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .product-sticky-bar__product {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-inline-size: 0;
  }

  .product-sticky-bar__media {
    flex: none;
    overflow: hidden;
    inline-size: max(3.5rem, calc(70 * var(--px, 0.0625rem)));
    aspect-ratio: 1;
    border-radius: max(0.5rem, calc(10 * var(--px, 0.0625rem)));
    background-color: var(--color-tint, color-mix(in srgb, var(--color-text) 5%, var(--color-background)));
  }

  .product-sticky-bar__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .product-sticky-bar__text {
    min-inline-size: 0;
  }

  .product-sticky-bar__text p {
    margin: 0;
  }

  .product-sticky-bar__type {
    color: var(--color-accent);
    font-family: var(--font-heading--family);
    font-size: var(--font-size-body);
    line-height: 1.2;
  }

  .product-sticky-bar__title {
    overflow: hidden;
    font-family: var(--font-heading--family);
    font-size: var(--font-size-h3);
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-sticky-bar__meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-text) 60%, var(--color-background));
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .product-sticky-bar__price {
    margin: 0;
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
  }

  .product-sticky-bar__buttons {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /*
    margin 0: the global form rule spaces a button that follows another button (button + button), which
    pushed Buy now 12px down. nowrap: a squeezed button grew to two lines (62px) instead of 50px.
  */
  .product-sticky-bar__buttons > .button {
    margin: 0;
    padding-inline: max(var(--space-md), calc(26 * var(--px, 0.0625rem)));
    white-space: nowrap;
  }

  .product-sticky-bar__icon {
    display: inline-flex;
  }

  .product-sticky-bar__icon svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  /* Outline glass Add to cart: restated because the global button[type] rules outweigh one class */
  .product-sticky-bar .product-sticky-bar__add {
    border-color: var(--color-secondary-button-border);
    background-color: var(--color-secondary-button);
    color: var(--color-secondary-button-text);
    box-shadow: var(--shadow-glass-edge);
  }

  .product-sticky-bar .product-sticky-bar__add:hover:not(:disabled) {
    background-color: color-mix(in srgb, var(--color-secondary-button-text) 8%, var(--color-secondary-button));
  }

  .product-sticky-bar__add.is-added [data-sticky-add-label]::after {
    content: " ✓";
  }

  .product-sticky-bar button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  /*
    When the bar is narrower than ~60rem (laptops with large text, tablets): two rows, the product and
    price on top, the two buttons side by side below. Measured on the bar itself (container query), so it
    works at any screen width and text size.
  */
  @container (max-width: 60rem) {
    .product-sticky-bar__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-sm) var(--space-md);
    }

    .product-sticky-bar__price {
      grid-column: 2;
      grid-row: 1;
    }

    .product-sticky-bar__buttons {
      grid-column: 1 / -1;
    }

    .product-sticky-bar__buttons > * {
      flex: 1;
    }
  }

  /* Phones (Variant96-1): smaller title and price */
  @container (max-width: 40rem) {
    .product-sticky-bar__inner {
      padding: var(--space-sm);
    }

    .product-sticky-bar__title {
      font-size: var(--font-size-body-lg);
    }

    .product-sticky-bar__price {
      font-size: var(--font-size-body-lg);
    }

    .product-sticky-bar__buttons .button {
      padding-inline: var(--space-sm);
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <product-sticky-bar>: shows itself while the page's Add to cart row is scrolled up out of view and the
   * footer isn't in view; its buttons press the Buy buttons form (same section).
   */
  class ProductStickyBar extends HTMLElement {
    connectedCallback() {
      this.scope = this.closest('.shopify-section') || document;
      this.form = this.scope.querySelector('buy-buttons form');
      const row = this.scope.querySelector('buy-buttons .buy-buttons__row');
      if (!this.form || !row) return;

      try {
        this.variants = JSON.parse(this.querySelector('[data-sticky-variants]').textContent);
      } catch (error) {
        this.variants = {};
      }

      // Two conditions: the Add to cart row is above the screen, and the footer isn't on screen
      this.rowPassed = false;
      this.footerInView = false;
      this.rowObserver = new IntersectionObserver(([entry]) => {
        this.rowPassed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        this.toggle();
      });
      this.rowObserver.observe(row);

      const footer = document.querySelector('.shopify-section-group-footer-group, footer');
      if (footer) {
        // "In view" = the footer has reached the top two thirds of the screen (rootMargin shrinks the
        // watched area by the bottom third), so a sliver of footer doesn't hide the bar on a short page
        this.footerObserver = new IntersectionObserver(
          ([entry]) => {
            this.footerInView = entry.isIntersecting;
            this.toggle();
          },
          { rootMargin: '0px 0px -33% 0px' }
        );
        this.footerObserver.observe(footer);
      }

      this.querySelector('[data-sticky-add]').addEventListener('click', () => this.add(false));
      this.querySelector('[data-sticky-buy]').addEventListener('click', () => this.buyNow());

      // The Buy buttons block adds in the background and says so: show "Added ✓" here too for 2s
      this.onAdded = () => {
        const label = this.querySelector('[data-sticky-add-label]');
        const add = this.querySelector('[data-sticky-add]');
        label.textContent = this.dataset.labelAdded;
        add.classList.add('is-added');
        clearTimeout(this.addedTimer);
        this.addedTimer = setTimeout(() => {
          add.classList.remove('is-added');
          if (!add.disabled) label.textContent = this.dataset.labelAdd;
        }, 2000);
      };
      this.scope.addEventListener('product:added', this.onAdded);

      this.onVariantChange = (event) => this.showVariant(event.detail?.variantId);
      this.scope.addEventListener('variant:change', this.onVariantChange);

      this.quantity = this.form.querySelector('input[name="quantity"]');
      this.onQuantity = () => this.showQuantity();
      this.quantity?.addEventListener('change', this.onQuantity);
      this.quantity?.addEventListener('input', this.onQuantity);
    }

    disconnectedCallback() {
      this.rowObserver?.disconnect();
      this.footerObserver?.disconnect();
      this.scope?.removeEventListener('variant:change', this.onVariantChange);
      this.scope?.removeEventListener('product:added', this.onAdded);
    }

    toggle() {
      const show = this.rowPassed && !this.footerInView;
      this.classList.toggle('is-visible', show);
      // inert while hidden: its buttons can't be reached with Tab or read out when it isn't there
      this.inert = !show;
    }

    /**
     * Submit the Buy buttons form (the browser checks it first, e.g. a gift card email).
     * toCheckout: Shopify sends the visitor to checkout instead of the cart (return_to); a plain Add to
     * cart removes it again, in case an earlier Buy now didn't go through.
     */
    add(toCheckout) {
      let returnTo = this.form.querySelector('input[name="return_to"][data-sticky]');
      if (toCheckout && !returnTo) {
        returnTo = Object.assign(document.createElement('input'), { type: 'hidden', name: 'return_to', value: '/checkout' });
        returnTo.dataset.sticky = '';
        this.form.append(returnTo);
      } else if (!toCheckout) {
        returnTo?.remove();
      }
      const submit = this.form.querySelector('[data-submit]');
      if (!this.form.checkValidity()) {
        this.form.reportValidity();
        this.form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      this.form.requestSubmit(submit || undefined);
    }

    /** Buy now: Shopify's own Buy it now button if it's there, else add + go straight to checkout */
    buyNow() {
      const shopifyButton = this.form.querySelector('.shopify-payment-button__button--unbranded, .shopify-payment-button__button');
      if (shopifyButton && !shopifyButton.closest('[hidden]')) {
        shopifyButton.click();
        return;
      }
      this.add(true);
    }

    /** The chosen variant's name, price, image and state ("Sold out", "Unavailable") */
    showVariant(variantId) {
      const variant = variantId && this.variants[variantId];
      const add = this.querySelector('[data-sticky-add]');
      const buy = this.querySelector('[data-sticky-buy]');
      const addLabel = this.querySelector('[data-sticky-add-label]');

      if (!variant) {
        add.disabled = buy.disabled = true;
        addLabel.textContent = this.dataset.labelUnavailable;
        return;
      }
      const name = this.querySelector('[data-sticky-variant]');
      if (name) name.textContent = variant.title;
      this.querySelector('[data-sticky-price]').textContent = variant.price;
      const image = this.querySelector('.product-sticky-bar__image');
      if (image && variant.image) {
        image.removeAttribute('srcset');
        image.src = variant.image;
      }
      add.disabled = buy.disabled = !variant.available;
      addLabel.textContent = variant.available ? this.dataset.labelAdd : this.dataset.labelSoldOut;
    }

    showQuantity() {
      const quantity = Math.max(1, parseInt(this.quantity.value, 10) || 1);
      this.querySelector('[data-sticky-quantity]').textContent = this.dataset.quantityLabel.replace('[quantity]', quantity);
    }
  }

  if (!customElements.get('product-sticky-bar')) customElements.define('product-sticky-bar', ProductStickyBar);
{% endjavascript %}
