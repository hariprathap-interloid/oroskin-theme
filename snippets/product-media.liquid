{% doc %}
  Renders one product media item, whatever its type (Theme Store: all media must be viewable):
  - image: the responsive image snippet, with the merchant's alt text
  - video (uploaded to Shopify): a <video> with the browser's controls, never autoplaying
  - external_video (YouTube / Vimeo): the platform's player in an iframe
  - model (3D): Shopify's <model-viewer>; the section loads its controls (model-viewer-ui: Featured
    product and the product page's <product-page>)

  The parent decides the box size; everything here fills it.

  @param {media} media - One item from product.media
  @param {string} [sizes] - The image `sizes` attribute, e.g. '(min-width: 990px) 50vw, 100vw'
  @param {string} [loading] - 'lazy' to load the image only when scrolled near; empty = automatic
  @param {boolean} [priority] - true for the page's main (LCP) image: eager + fetchpriority high

  @example
  {% render 'product-media', media: media, sizes: '(min-width: 990px) 50vw, 100vw' %}
{% enddoc %}

<div class="product-media product-media--{{ media.media_type }}">
  {%- case media.media_type -%}
    {%- when 'image' -%}
      {% render 'image', image: media.preview_image, alt: media.alt, sizes: sizes, class: 'image--cover', loading: loading, priority: priority %}
    {%- when 'video' -%}
      {{ media | video_tag: controls: true, preload: 'metadata' }}
    {%- when 'external_video' -%}
      {%- comment -%}
        Lazy: the player (about 1 MB of script) loads only when it comes near the screen. YouTube gets
        enablejsapi=1, so the image viewer can pause it with a message (Vimeo accepts those by default)
      {%- endcomment -%}
      {%- if media.host == 'youtube' -%}
        {{ media | external_video_url: enablejsapi: '1' | external_video_tag: loading: 'lazy' }}
      {%- else -%}
        {{ media | external_video_tag: loading: 'lazy' }}
      {%- endif -%}
    {%- when 'model' -%}
      {%- comment -%} image_size: the cover image before play (the default small one is blurry in the image viewer) {%- endcomment -%}
      {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true, image_size: '1024x' }}
    {%- else -%}
      {{ media | media_tag }}
  {%- endcase -%}
</div>

{% stylesheet %}
  .product-media {
    position: relative;
    block-size: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--color-tint);
  }

  .product-media .image,
  .product-media :is(video, iframe, model-viewer) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
  }

  /*
    3D: Shopify's control script wraps <model-viewer> in its own div, which has no size of its own: it
    and the model were 0 x 0 (empty tile, the play button cut off in the corner). It fills the box
  */
  .product-media .shopify-model-viewer-ui {
    position: absolute;
    inset: 0;
  }

  /*
    Shopify's zoom / full screen column sits bottom right; in a small gallery tile it reached up to the
    gallery's "open viewer" button (top right). Bottom left instead (the image is not mirrored in RTL)
  */
  .product-media .shopify-model-viewer-ui .shopify-model-viewer-ui__controls-area {
    right: auto;
    left: 10px;
  }

  .product-media .image > img,
  .product-media video {
    block-size: 100%;
    object-fit: cover;
  }
{% endstylesheet %}
