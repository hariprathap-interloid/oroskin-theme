{% doc %}
  Country/region (which sets the currency) and language pickers, for the footer and later the mobile drawer.

  Shows nothing unless the store sells to more than one country or has more than one published language
  (Settings -> Markets, Settings -> Languages). Each picker only appears when it has a choice to make.

  Each picker is a glass pill (<summary>) that opens a list above it. Every item in the list is a submit
  button carrying its own value (name="country_code" value="GB"), so picking one submits the form straight
  away. That's an explicit click, not a change "on input", so it stays WCAG 3.2.2-friendly, and without
  JavaScript <details> still opens and the buttons still submit. The script only adds Escape, closing on
  an outside click or when focus leaves, and one-open-at-a-time.

  @param {string} id_prefix - Unique prefix for the form's id, e.g. 'footer' (needed when it appears twice)

  @example
  {% render 'localization-form', id_prefix: 'footer' %}
{% enddoc %}

{%- liquid
  assign show_countries = false
  if localization.available_countries.size > 1
    assign show_countries = true
  endif

  assign show_languages = false
  if localization.available_languages.size > 1
    assign show_languages = true
  endif

  assign form_id = id_prefix | append: '-localization'
-%}

{%- if show_countries or show_languages -%}
  {%- form 'localization', id: form_id, class: 'localization' -%}
    {%- if show_countries -%}
      <localization-picker class="localization__picker">
        <details class="localization__details">
          <summary class="localization__toggle">
            <span class="visually-hidden">{{ 'localization.country' | t }}:</span>
            {%- liquid
              assign current_currency = localization.country.currency
            -%}
            <span class="localization__label">
              {{- localization.country.name }} ({{ current_currency.iso_code }} {{ current_currency.symbol }})
            </span>
            {{- 'icon-chevron.svg' | inline_asset_content -}}
          </summary>
          <ul class="localization__list" role="list">
            {%- for country in localization.available_countries -%}
              <li>
                <button
                  type="submit"
                  class="localization__option"
                  name="country_code"
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}
                    aria-current="true"
                  {% endif %}
                >
                  {{- country.name }}
                  <span class="localization__currency">
                    {{- country.currency.iso_code }}
                    {{ country.currency.symbol -}}
                  </span>
                </button>
              </li>
            {%- endfor -%}
          </ul>
        </details>
      </localization-picker>
    {%- endif -%}

    {%- if show_languages -%}
      <localization-picker class="localization__picker">
        <details class="localization__details">
          <summary class="localization__toggle">
            <span class="visually-hidden">{{ 'localization.language' | t }}:</span>
            {%- comment -%} The pill shows the name in capitals (text-transform), so no first-letter fix here {%- endcomment -%}
            <span class="localization__label">{{ localization.language.endonym_name }}</span>
            {{- 'icon-chevron.svg' | inline_asset_content -}}
          </summary>
          <ul class="localization__list" role="list">
            {%- for language in localization.available_languages -%}
              {%- liquid
                # Only the first letter capital: capitalize would also make every other letter small
                # ("English (United Kingdom)" -> "English (united kingdom)")
                assign language_first = language.endonym_name | slice: 0 | upcase
                assign language_rest = language.endonym_name | slice: 1, 200
              -%}
              <li>
                <button
                  type="submit"
                  class="localization__option"
                  name="language_code"
                  value="{{ language.iso_code }}"
                  lang="{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}
                    aria-current="true"
                  {% endif %}
                >
                  {{- language_first }}{{ language_rest -}}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        </details>
      </localization-picker>
    {%- endif -%}
  {%- endform -%}
{%- endif -%}

{% stylesheet %}
  .localization {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    min-inline-size: 0; /* a flex item: without this it can't get narrower than its text */
    max-inline-size: 100%; /* never wider than its row, so a long name is cut in the pill */
  }

  .localization__picker {
    display: block;
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .localization__details {
    position: relative;
  }

  /* The pill: same glass as the header's round buttons. Never wider than its row (long names, below). */
  .localization__toggle {
    display: inline-flex;
    max-inline-size: 100%;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: 2.75rem; /* 44px touch target */
    padding-inline: var(--space-md);
    border-radius: var(--radius-pill);
    background-color: var(--color-glass);
    box-shadow: var(--shadow-header);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-nav);
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  /*
    A long name ("Bosnia & Herzegovina (BAM КМ)") stays on one line in the pill and is cut with …; the
    full name is still in the text, so screen readers read all of it, and the list shows it in full.
  */
  .localization__label {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Remove the browser's default triangle on <summary> */
  .localization__toggle::-webkit-details-marker {
    display: none;
  }

  .localization__toggle:hover,
  .localization__details[open] > .localization__toggle {
    background-color: var(--color-glass-strong);
    color: var(--color-accent);
  }

  .localization__toggle svg {
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .localization__details[open] > .localization__toggle svg {
    transform: rotate(180deg);
  }

  /* The list opens upwards: the picker sits at the bottom of the page */
  .localization__list {
    position: absolute;
    z-index: 2;
    inset-block-end: calc(100% + var(--space-xs));
    inset-inline-start: 0;
    display: grid;
    gap: 2px;
    /* At least the pill's width and 15rem, but never wider than the screen minus its margins (min() wins) */
    min-inline-size: min(max(100%, 15rem), calc(100vw - var(--page-margin) * 2));
    translate: var(--list-shift, 0) 0; /* set by the script only when the list fits on neither side */
    max-block-size: min(20rem, 60vh);
    overflow-y: auto;
    margin: 0;
    padding: var(--space-xs);
    border-radius: var(--radius-md);
    background-color: var(--color-background);
    color: var(--color-text);
    box-shadow: var(--shadow-panel);
    list-style: none;
  }

  /*
    No space on the opening side (e.g. the language pill at the right on a phone): the script sets
    data-align="end", and the list opens from the pill's other edge. Without JS it opens from the start.
  */
  .localization__list[data-align='end'] {
    inset-inline: auto 0;
  }

  /*
    Two classes on purpose: critical.css styles every button[type='submit'] as the red pill, and its
    selector (one attribute + one element) beats a single class.
  */
  .localization .localization__option {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    inline-size: 100%;
    min-block-size: 2.75rem;
    padding: var(--space-xs) var(--space-md);
    border: 0;
    border-radius: var(--radius-pill);
    background-color: transparent;
    color: inherit;
    box-shadow: none;
    font-size: var(--font-size-small);
    font-weight: 400;
    letter-spacing: normal;
    text-align: start;
    text-transform: none;
  }

  .localization .localization__option:hover {
    background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
    box-shadow: none;
  }

  .localization .localization__option[aria-current='true'] {
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
  }

  .localization__currency {
    color: color-mix(in srgb, currentColor 70%, transparent);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .localization__toggle,
    .localization__toggle svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <localization-picker>: closes its <details> on Escape (focus goes back to the pill), on a click
   * outside it, and when keyboard focus leaves it. Clicking another picker counts as "outside", so only
   * one list is open at a time. Picking an item needs no script: it's a submit button.
   */
  class LocalizationPicker extends HTMLElement {
    connectedCallback() {
      this.details = this.querySelector('details');
      if (!this.details) return;

      // All listeners on one AbortController: the theme editor can move the section (disconnect, then
      // connect again), and without this the element's own listeners were added a second time.
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;

      this.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'Escape' || !this.details.open) return;
          this.details.open = false;
          this.details.querySelector('summary')?.focus();
        },
        { signal }
      );
      // relatedTarget is the element receiving focus; it's null when clicking empty space (the click handler covers that)
      this.addEventListener(
        'focusout',
        (event) => {
          if (event.relatedTarget && !this.contains(event.relatedTarget)) this.details.open = false;
        },
        { signal }
      );
      // The list must never go past the side of the screen, not even for one frame: a short sideways
      // overflow can make a phone browser pan or zoom the page. So the script opens the list itself and
      // places it in the same step; the browser paints only after this handler. Enter and Space on the
      // summary also fire click. Closing keeps the browser's own behaviour.
      this.list = this.details.querySelector('.localization__list');
      const summary = this.details.querySelector('summary');
      if (summary && this.list) {
        summary.addEventListener(
          'click',
          (event) => {
            if (this.details.open) return;
            event.preventDefault();
            this.details.open = true;
            this.placeList();
          },
          { signal }
        );
        // A rotation or resize while the list is open: place it again
        window.addEventListener(
          'resize',
          () => {
            if (this.details.open) this.placeList();
          },
          { signal }
        );
      }
      document.addEventListener(
        'click',
        (event) => {
          if (!this.contains(event.target)) this.details.open = false;
        },
        { signal }
      );
    }

    disconnectedCallback() {
      this.controller?.abort();
    }

    /**
     * Measures the open list (its real size, so it always matches the CSS) and picks the edge it opens
     * from: the pill's start edge, or the end edge when the start does not fit. If neither fits (a very
     * narrow or zoomed screen), it keeps the better edge and moves the list back onto the screen.
     */
    placeList() {
      const list = this.list;
      list.style.removeProperty('--list-shift');
      delete list.dataset.align;

      const screen = document.documentElement.clientWidth;
      const overflow = (box) => Math.max(0, box.right - screen) + Math.max(0, -box.left);

      const startBox = list.getBoundingClientRect();
      if (overflow(startBox) === 0) return;

      list.dataset.align = 'end';
      const endBox = list.getBoundingClientRect();
      if (overflow(endBox) === 0) return;

      let box = endBox;
      if (overflow(startBox) < overflow(endBox)) {
        delete list.dataset.align;
        box = startBox;
      }
      const shift = box.left < 0 ? -box.left : screen - box.right;
      list.style.setProperty('--list-shift', `${shift}px`);
    }
  }

  if (!customElements.get('localization-picker')) customElements.define('localization-picker', LocalizationPicker);
{% endjavascript %}
