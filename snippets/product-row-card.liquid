{% doc %}
  A compact product row (Product list "Compact rows" layout): a small square photo, then the category
  (product type), title and price on a glass panel, and a round quick add button on the right.

  The photo + text is one link to the product; the quick add button sits next to it, not inside it (a
  button inside a link is invalid HTML). Without a product (no collection chosen yet) it renders a
  placeholder row without the button.

  @param {product} [product] - The product. Leave empty for a placeholder row
  @param {string} [heading_tag] - Tag for the title, default 'h3'

  @example
  {% render 'product-row-card', product: product %}
{% enddoc %}

{%- assign title_tag = heading_tag | default: 'h3' -%}

<div class="product-row-card">
  <a class="product-row-card__link" href="{{ product.url | default: routes.all_products_collection_url }}">
    <span class="product-row-card__media">
      {%- if product.featured_media != blank -%}
        {{
          product.featured_media.preview_image
          | image_url: width: 192, height: 192, crop: 'center'
          | image_tag: widths: '96, 192', sizes: '96px', alt: '', loading: 'lazy'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </span>
    {%- comment -%} divs, not spans: the price snippet outputs a <div> (a link may hold divs) {%- endcomment -%}
    <div class="product-row-card__text">
      {%- if product.type != blank -%}
        <span class="product-row-card__category">{{ product.type | escape }}</span>
      {%- endif -%}
      <{{ title_tag }} class="product-row-card__title">
        {%- if product != blank -%}
          {{ product.title | escape }}
        {%- else -%}
          {{ 'products.placeholder_title' | t }}
        {%- endif -%}
      </{{ title_tag }}>
      {%- if product != blank -%}
        <div class="product-row-card__price">{% render 'price', product: product %}</div>
      {%- endif -%}
    </div>
  </a>
  {%- if product != blank -%}
    {% render 'quick-add', product: product, size: 44, icon_color: '#7d0000', class: 'product-row-card__add' %}
  {%- endif -%}
</div>

{% stylesheet %}
  /* Glass row (Figma Glass: Light 45deg 80%, Frost 100), like the search popup's product cards */
  .product-row-card {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.625rem;
    padding-inline-end: var(--space-md);
    border-radius: 1rem;
    background-color: var(--color-glass-strong);
    box-shadow:
      0 4px 15px #b9b9b926,
      inset -1px 1px 0 #ffffffcc,
      inset 1px -1px 0 #ffffff80;
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .product-row-card__link {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.875rem;
    min-inline-size: 0;
    border-radius: 0.625rem; /* rounded focus ring */
    color: var(--color-text);
    text-decoration: none;
  }

  .product-row-card__media {
    flex: none;
    inline-size: 5.25rem;
    block-size: 5.25rem;
    overflow: hidden;
    border-radius: 0.625rem;
  }

  .product-row-card__media :is(img, svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .product-row-card__text {
    display: grid;
    gap: 0.1875rem;
    min-inline-size: 0;
  }

  .product-row-card__category {
    color: var(--color-accent);
    font-size: var(--font-size-small);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .product-row-card__title {
    overflow: hidden;
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size-body-sm);
    font-weight: 400;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-row-card__link:hover .product-row-card__title {
    text-decoration: underline;
  }

  /* Dark bold price (the price snippet uses the accent colour on the big product cards) */
  .product-row-card__price .price__current {
    color: var(--color-text);
    font-weight: 700;
  }

  .product-row-card__add {
    flex: none;
  }
{% endstylesheet %}
