{% doc %}
  Email sign-up form: the footer and the Newsletter section (sections/newsletter.liquid).

  Uses Shopify's 'customer' form: submitting it creates a customer with that email (or updates the
  existing one), marks them as accepting email marketing and adds the tag "newsletter", so the merchant
  sees sign-ups in Admin -> Customers. No app and no JavaScript needed.

  After submitting, Shopify reloads the page and jumps back to the form (the form's id is the #anchor).
  Then form.posted_successfully? is true, or form.errors says what went wrong. For screen readers, focus
  goes to the success message, or back to the email field (which points at the error with
  aria-describedby), because a message that is already on the page when it loads isn't announced.
  That focus move is done by the script below (data-focus-after-submit), not the autofocus attribute:
  Shopify's accessibility rules for themes say "no autofocus".

  Note for a second copy (the Newsletter section): form.posted_successfully? and form.errors aren't
  tied to one form's id, so after one sign-up every newsletter form on that page shows the message. The
  script moves focus into the form that was sent (its id is the #anchor in the URL).

  @param {string} id_prefix - Unique prefix for the ids, e.g. 'footer' (needed when the form appears twice)
  @param {string} [button_label] - Button text. Empty = "Subscribe" (newsletter.subscribe)
  @param {string} [class] - Extra class on the <form>, for a caller's own layout (e.g. 'newsletter-form--row')

  @example
  {% render 'newsletter-form', id_prefix: 'footer' %}
  {% render 'newsletter-form', id_prefix: section.id, button_label: section.settings.button_label, class: 'newsletter-form--row' %}
{% enddoc %}

{%- liquid
  assign form_id = 'NewsletterForm-' | append: id_prefix
  assign input_id = form_id | append: '-email'
  assign error_id = form_id | append: '-error'
  assign success_id = form_id | append: '-success'

  assign form_class = 'newsletter-form'
  if class != blank
    assign form_class = form_class | append: ' ' | append: class
  endif
-%}

{%- form 'customer', id: form_id, class: form_class -%}
  <input type="hidden" name="contact[tags]" value="newsletter">

  <label class="visually-hidden" for="{{ input_id }}">{{ 'newsletter.email_label' | t }}</label>
  <input
    class="newsletter-form__input"
    id="{{ input_id }}"
    type="email"
    name="contact[email]"
    value="{{ form.email | escape }}"
    placeholder="{{ 'newsletter.placeholder' | t }}"
    autocomplete="email"
    autocapitalize="off"
    spellcheck="false"
    required
    {% if form.errors %}
      aria-invalid="true"
      aria-describedby="{{ error_id }}"
      data-focus-after-submit
    {% elsif form.posted_successfully? %}
      aria-describedby="{{ success_id }}"
    {% endif %}
  >
  {%- comment -%}
    The theme's own line for an empty or wrong email (in place of the browser's bubble, as the contact
    form): the script fills it from data-missing / data-format. Without JavaScript the browser checks.
  {%- endcomment -%}
  <p
    class="newsletter-form__error"
    id="{{ form_id }}-check"
    data-missing="{{ 'contact.form.error_email' | t | escape_once }}"
    data-format="{{ 'contact.form.error_email_format' | t | escape_once }}"
    hidden
  ></p>

  <button type="submit" class="button newsletter-form__button">
    {%- if button_label != blank -%}
      {{- button_label | escape -}}
    {%- else -%}
      {{- 'newsletter.subscribe' | t -}}
    {%- endif -%}
  </button>

  {%- if form.errors -%}
    <p class="form-message form-message--error newsletter-form__message" id="{{ error_id }}">
      {%- for error in form.errors -%}
        {%- comment -%} 'form' = a general error; others are per field, e.g. "Email is invalid" {%- endcomment -%}
        {%- if error == 'form' -%}
          {{ form.errors.messages[error] }}
        {%- else -%}
          {{ form.errors.translated_fields[error] | capitalize }} {{ form.errors.messages[error] }}
        {%- endif -%}
      {%- endfor -%}
    </p>
  {%- elsif form.posted_successfully? -%}
    {%- comment -%}
      <auto-dismiss> fades the message out after data-delay milliseconds (script below). Without
      JavaScript the message simply stays. 6 seconds leaves time to read it, also with a screen reader.
    {%- endcomment -%}
    <auto-dismiss data-delay="6000" data-focus-target="{{ input_id }}">
      <p
        class="form-message form-message--success newsletter-form__message"
        id="{{ success_id }}"
        tabindex="-1"
        data-focus-after-submit
      >
        {{- 'newsletter.success' | t -}}
      </p>
    </auto-dismiss>
  {%- endif -%}
{%- endform -%}

{% stylesheet %}
  /*
    Figma (footer): a glass pill input (~330 x 50px, 50% white, 1.5px white border) with the red
    SUBSCRIBE pill underneath, 30px apart. The button is the theme's .button (critical.css).
  */
  /*
    Spacing uses margins on our own elements, not flex gap: when the field gets focus, Shopify's bot
    protection injects an empty, invisible <div class="h-captcha"> into the form. Gap is added between
    every flex item, even an empty one, so it pushed the button 30px down. Margins only apply where we
    put them, so the injected div (0px tall) changes nothing.
  */
  .newsletter-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-inline-size: 20.625rem; /* 330px, Figma input width */
  }

  /*
    Two classes on purpose: critical.css styles input[type='email'] (specificity 0,1,1), which beats a
    single class (0,1,0). Two classes (0,2,0) win, so the hover/focus/error borders are set again below.
  */
  .newsletter-form .newsletter-form__input {
    padding-inline: 1.875rem; /* text starts 30px in, Figma */
    /*
      The edge: the Figma white border gave 1.03:1 on the glass panel, so the field did not show (WCAG
      1.4.11 asks 3:1 for the edge of a field). 55% text: 3.6:1 on the light panel; on a dark scheme the
      text is light, so the edge is near white on the dark panel (as before).
    */
    border: 1.5px solid color-mix(in srgb, var(--color-text) 55%, #ffffff);
    border-radius: var(--radius-pill);
    background-color: var(--color-glass-strong);
    box-shadow: var(--shadow-card);
    font-size: var(--font-size-caption);
    /* No backdrop-filter: flat footer panel behind (nothing to blur); a blur showed dark under the header on phones */
  }

  .newsletter-form .newsletter-form__input:hover {
    border-color: color-mix(in srgb, var(--color-text) 80%, #ffffff);
  }

  .newsletter-form .newsletter-form__input:focus-visible {
    border-color: var(--color-accent);
  }

  .newsletter-form .newsletter-form__input[aria-invalid='true'] {
    border-color: var(--color-error);
  }

  /*
    Our own spacing. Two classes so it beats critical.css's margins between neighbouring fields and
    buttons (the hidden label still counts as the input's neighbour).
  */
  .newsletter-form .newsletter-form__input {
    margin-block-start: 0;
  }

  .newsletter-form .newsletter-form__button {
    margin-block-start: 1.875rem; /* 30px under the field, Figma */
  }

  /* Empty or wrong email: a round "!" and the text under the field (the contact form's look) */
  .newsletter-form__error {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
    margin: var(--space-xs) 0 0;
    color: var(--color-error);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
  }

  .newsletter-form__error[hidden] {
    display: none;
  }

  .newsletter-form__error::before {
    content: "!" / "";
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 1.1em;
    block-size: 1.1em;
    margin-block-start: 0.15em;
    border-radius: 50%;
    background-color: var(--color-error);
    color: #ffffff;
    font-size: 0.85em;
    line-height: 1;
  }

  /* Error text, or the success message's <auto-dismiss> wrapper, under the button */
  .newsletter-form__message {
    margin: 0;
  }

  .newsletter-form > .newsletter-form__message,
  .newsletter-form > auto-dismiss {
    margin-block-start: var(--space-md);
  }

  /* The success message takes focus after the reload; it's text, so no focus ring box around it */
  .newsletter-form__message:focus {
    outline: none;
  }

  auto-dismiss {
    display: block;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  auto-dismiss.is-hiding {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    auto-dismiss {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <auto-dismiss>: removes itself after data-delay ms (default 6000), fading out first.
   * If the message had keyboard/screen-reader focus, focus moves to data-focus-target (the email field)
   * instead of being lost to the top of the page when the message disappears.
   */
  class AutoDismiss extends HTMLElement {
    connectedCallback() {
      const delay = Number(this.dataset.delay) || 6000;
      this.timer = setTimeout(() => this.dismiss(), delay);
    }

    disconnectedCallback() {
      clearTimeout(this.timer);
    }

    dismiss() {
      const hadFocus = this.contains(document.activeElement);
      let removed = false;
      const remove = () => {
        if (removed) return;
        removed = true;
        this.remove();
        if (hadFocus) document.getElementById(this.dataset.focusTarget)?.focus({ preventScroll: true });
      };

      this.classList.add('is-hiding');
      this.addEventListener('transitionend', remove, { once: true });
      // Fallback: no transitionend fires with reduced motion (transition: none)
      setTimeout(remove, 400);
    }
  }

  if (!customElements.get('auto-dismiss')) customElements.define('auto-dismiss', AutoDismiss);

  /**
   * After a sign-up, Shopify reloads the page with an error or success message. The element marked
   * data-focus-after-submit (the email field with its error, or the success message) only exists in
   * that case, so focus moves only right after the visitor's own submit, never on a normal page load.
   * preventScroll: the page already jumps to the form through its #anchor.
   * Every newsletter form on the page shows the message (Shopify doesn't tie it to one form), so the
   * form named in the #anchor (the one the visitor sent) wins; else the first one on the page.
   */
  function focusNewsletterResult() {
    let sent = null;
    try {
      const id = decodeURIComponent(location.hash.slice(1));
      if (id) sent = document.getElementById(id);
    } catch (error) {
      sent = null;
    }
    const target =
      sent?.querySelector('[data-focus-after-submit]') || document.querySelector('[data-focus-after-submit]');
    target?.focus({ preventScroll: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', focusNewsletterResult);
  } else {
    focusNewsletterResult();
  }

  /**
   * Empty or wrong email: the browser fires "invalid" before it would show its own bubble. Stopping it
   * (preventDefault) hides the bubble; the form still isn't sent and the browser still focuses the field.
   * Our line under the field says what is wrong (aria-invalid + aria-describedby for screen readers). It
   * goes away as soon as the address is correct. Listening on the document (capture: "invalid" doesn't
   * bubble) also covers forms added later, e.g. a Newsletter section added in the theme editor. One
   * listener per page.
   */
  if (!window.newsletterCheck) {
    window.newsletterCheck = true;
    const describe = (field, id, on) => {
      const ids = (field.getAttribute('aria-describedby') || '').split(' ').filter((item) => item && item !== id);
      if (on) ids.unshift(id);
      if (ids.length) field.setAttribute('aria-describedby', ids.join(' '));
      else field.removeAttribute('aria-describedby');
    };

    document.addEventListener(
      'invalid',
      (event) => {
        const field = event.target;
        const line = field.closest?.('.newsletter-form')?.querySelector('.newsletter-form__error');
        if (!line) return;
        event.preventDefault();
        line.textContent = field.validity.valueMissing ? line.dataset.missing : line.dataset.format;
        line.hidden = false;
        field.setAttribute('aria-invalid', 'true');
        describe(field, line.id, true);
        field.focus();
      },
      true
    );

    document.addEventListener('input', (event) => {
      const field = event.target;
      const line = field.closest?.('.newsletter-form')?.querySelector('.newsletter-form__error');
      // validity.valid only reads the state (checkValidity() would fire "invalid" again on every key)
      if (!line || line.hidden || !field.validity?.valid) return;
      line.hidden = true;
      field.removeAttribute('aria-invalid');
      describe(field, line.id, false);
    });
  }
{% endjavascript %}
