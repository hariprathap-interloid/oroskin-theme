{% doc %}
  Renders the page links under a product grid (Figma "Collection", under the grid): "Page 1 of 11" on the
  left, and a cream pill in the middle with round previous / next buttons, the page numbers and the current
  page as a larger red circle that sticks out of the pill.

  Built from the paginate object (only exists inside {% paginate %}): paginate.parts is the list Shopify
  already worked out, e.g. 1 2 [3] 4 … 11, each part a link (is_link) or not (the current page, or "…").
  The URLs keep the visitor's sort and filters. The links have data-results-link and data-results-scroll,
  so on a page with <results-view> the next page loads in place and the view scrolls back to the top of the
  results; anywhere else they are ordinary links.

  Phones: only previous, "Page 3 of 11" and next (the numbers don't fit).

  @param {paginate} paginate - The paginate object from the surrounding {% paginate %} tag

  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}

{%- liquid
  # A part's title is the page number or "…", current_page a number: both are turned into text
  # (append: '') before comparing, so 3 and "3" match whichever type Shopify gives
  assign current_title = paginate.current_page | append: ''
-%}

<nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
  <p class="pagination__status">
    {{- 'pagination.page_of' | t: current: paginate.current_page, total: paginate.pages -}}
  </p>

  <ul class="pagination__pill" role="list">
    <li>
      {%- if paginate.previous.is_link -%}
        <a class="pagination__arrow" href="{{ paginate.previous.url }}" data-results-link data-results-scroll>
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
          <span class="visually-hidden">{{ 'accessibility.previous' | t }}</span>
        </a>
      {%- else -%}
        <span class="pagination__arrow pagination__arrow--disabled" aria-hidden="true">
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
        </span>
      {%- endif -%}
    </li>

    {%- for part in paginate.parts -%}
      {%- assign part_title = part.title | append: '' -%}
      <li class="pagination__part">
        {%- if part.is_link -%}
          <a class="pagination__page" href="{{ part.url }}" data-results-link data-results-scroll>
            <span class="visually-hidden">{{ 'pagination.page' | t }}</span>
            {{ part.title }}
          </a>
        {%- elsif part_title == current_title -%}
          <span class="pagination__page pagination__page--current" aria-current="page">
            <span class="visually-hidden">{{ 'pagination.page' | t }}</span>
            {{ part.title }}
          </span>
        {%- else -%}
          <span class="pagination__gap" aria-hidden="true">{{ part.title }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}

    <li>
      {%- if paginate.next.is_link -%}
        <a class="pagination__arrow" href="{{ paginate.next.url }}" data-results-link data-results-scroll>
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
          <span class="visually-hidden">{{ 'accessibility.next' | t }}</span>
        </a>
      {%- else -%}
        <span class="pagination__arrow pagination__arrow--disabled" aria-hidden="true">
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </span>
      {%- endif -%}
    </li>
  </ul>
</nav>

{% stylesheet %}
  /* "Page 1 of 11" on the left, the pill in the middle (the empty third column balances it) */
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-md);
    margin-block-start: var(--space-2xl); /* Figma: 78px under the grid, with the results' 24px gap */
  }

  .pagination__status {
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 75%, var(--color-background));
    font-size: var(--font-size-caption);
  }

  /*
    Sizes are about 1.2x the Figma (circles 40 → 48px, current 60 → 72px, bar 50 → 60px), which looked
    too small on screen.

    Figma glass values (on white): the bar fill #f6f2ec at 50%, 0.94px border #fff4f4, radius 18.78px, shadow
    0 0 9.39px 5% black, Frost 100 (= --glass-frost, 35px), Light -45deg 80% (a highlight on the top-left
    edge, weaker bottom-right). The colours are mixed from the section's colour scheme (a little text colour
    into the background), so on white they match the Figma and on a red or dark scheme the bar, the pearl
    buttons and the numbers follow it instead of staying light with invisible text.
    Refraction / Depth / Dispersion need a Chrome-only SVG filter, so they are left out (as in css-variables).
  */
  .pagination {
    --pagination-light: inset 0.7px 0.7px 0 #ffffffcc, inset -0.7px -0.7px 0 #ffffff80;
  }

  /* Circles 16px apart, 24px from the ends */
  .pagination__pill {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-block-size: 3.75rem;
    margin: 0;
    padding: 0 var(--space-lg);
    border: 1px solid color-mix(in srgb, var(--color-text) 6%, var(--color-background));
    border-radius: var(--radius-sm); /* 19px, Figma 18.78px */
    background-color: color-mix(in srgb, color-mix(in srgb, var(--color-text) 5%, var(--color-background)) 50%, transparent);
    box-shadow: 0 0 9.39px 0 #0000000d, var(--pagination-light);
    list-style: none;
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
  }

  .pagination__arrow,
  .pagination__page,
  .pagination__gap {
    display: inline-grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }

  /*
    Previous / next and the page numbers: soft raised pearl buttons (my reference image). Back to front:
    - the fill: a little darker at the top-left fading to the scheme background at the bottom-right
      (on white: #eeeeee → #f8f8f8 → white)
    - a bright white rim on the top-left edge (the light), a softer white glow inside the bottom-right
    - a faint shadow outside, so the button lifts off the bar
    The current page (accent circle) has its own look.
  */
  .pagination__arrow,
  .pagination__page {
    background-image: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-text) 7%, var(--color-background)) 0%,
      color-mix(in srgb, var(--color-text) 3%, var(--color-background)) 55%,
      var(--color-background) 100%
    );
    box-shadow:
      inset 1.5px 1.5px 1px #ffffff,
      inset -2px -2px 4px #ffffffb3,
      0 3px 10px 0 #00000014;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .pagination__arrow svg {
    inline-size: 0.5625rem;
    block-size: 0.875rem;
  }

  .pagination__arrow--disabled {
    opacity: 0.4;
  }

  a.pagination__page:hover,
  a.pagination__arrow:hover {
    color: var(--color-accent);
  }

  /*
    The current page: a 72px circle in the scheme's accent (red on light schemes, white on red, gold on dark)
    with a thin ring, 6px taller than the bar on each side (Figma)
  */
  .pagination__page--current {
    inline-size: 4.5rem;
    block-size: 4.5rem;
    margin-block: -0.375rem;
    border: 1px solid color-mix(in srgb, var(--color-text) 8%, var(--color-background));
    background-color: var(--color-accent);
    background-image: none;
    box-shadow: none;
    color: var(--color-background);
  }

  /* Phones: previous, the current page, next; "Page 3 of 11" goes under the pill */
  @media (max-width: 749px) {
    .pagination {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .pagination__status {
      grid-row: 2;
    }

    .pagination__part:not(:has(.pagination__page--current)) {
      display: none;
    }
  }
{% endstylesheet %}
