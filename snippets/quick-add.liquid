{% doc %}
  Quick add: a round glass cart button (Figma "Liquid Glass Button") that adds a product to the cart
  without leaving the page, with the Figma animation:
  1. the upright cart swaps to the tilted cart and two speed lines appear (two divs)
  2. it drives off to the right, out of the circle
  3. it rolls back in from the left (meanwhile the product is added: Cart AJAX API, /cart/add.js)
  4. a gold circle with a white tick pops onto its top right
  5. the tilted cart cross-fades into the upright one, and the "Added to your bag" card shows
     (snippets/cart-notification.liquid: the product, how many are in the bag, the bag total, View bag /
     Checkout). The tick stays while the card is open, then the button is as before.
  The header's cart count updates. On failure: a short shake and the reason in a small message.
  Reduced motion: no driving, just the tick. Without JavaScript: a normal product form that adds the
  product and opens the cart.

  Which products are added directly:
  - one variant, in stock: always
  - several variants: with options: 'add_first' (default), the first available variant is added (its
    name goes into the button's label); with options: 'link', the button opens the product page
  - sold out: never; the button opens the product page

  @param {product} product - The product to add
  @param {string} [class] - Extra class for positioning, e.g. 'product-panels__cart'
  @param {number} [size] - Button size in px (44, 50 = Figma, 60, 70); icon, lines and tick scale with it
  @param {string} [icon_color] - Colour of the cart icon and speed lines (default white), e.g. dark on
    white photos
  @param {string} [options] - Products with several variants: 'add_first' (default) or 'link'
  @param {number} [overlay] - Round button only: strength (0-100, %) of a soft dark circle behind the
    button, so the white glass button stays visible on light photos ("Overlay behind the button" in
    Product panels and New arrivals). 0 or empty = no circle. The caller must position the button
    (position + z-index), as those sections do.
  @param {string} [style] - 'round' (default, the glass circle) or 'pill' (the article sidebar's white
    "ADD TO CART" pill: same adding and tick, no driving off; the visible text is the button's name,
    the product name is added for screen readers; sold out = a disabled "Sold out" pill)
  @param {string} [id_suffix] - Makes the form id unique when the same product can show two times in one
    section with the same style and class (e.g. the card style, a loop number). The form id is
    QuickAdd-<section id>-<product id>-<style>[-<class>][-<id_suffix>]. Shopify's default id
    (product_form_<product id>) repeats when a product shows two times on a page.
  @param {string} [label] - Pill only: the visible text. Default: "Add to cart" (products.add_to_cart)
  @param {image} [icon_image] - A custom icon (an uploaded image) in place of the cart drawing, both
    styles. It shows at the icon size with its own colours; while adding, a spinner takes its place
    (no driving off), then the tick pops in.
  @param {boolean} [show_icon] - Pill only: false = no icon, only the text. While adding, a spinner
    shows before the text, then the tick. Default true. The round button always has an icon.

  @example
  {% render 'quick-add', product: product, class: 'product-panels__cart' %}
  {% render 'quick-add', product: product, style: 'pill', size: 44 %}
  {% render 'quick-add', product: product, style: 'pill', size: 44, label: 'Add to bag', show_icon: false %}
{% enddoc %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign options_mode = options | default: 'add_first'
  assign can_add = false
  if product.available
    # One variant (with or without a named option, e.g. "Size: 30ml" only)
    if product.variants.size == 1
      assign can_add = true
    # Several variants: add the first available one, unless the merchant prefers the product page
    elsif options_mode == 'add_first'
      assign can_add = true
    endif
  endif

  # The label names the variant when there are several, e.g. "The Complete Snowboard - Ice"
  assign add_name = product.title
  if product.variants.size > 1
    assign add_name = product.title | append: ' - ' | append: variant.title
  endif
  assign add_label = 'products.quick_add.add' | t: title: add_name
  assign default_label = 'products.add_to_cart' | t
  assign choose_label = 'products.quick_add.choose' | t: title: product.title
  assign cart_icon = 'icon-cart.svg' | inline_asset_content
  assign tilt_icon = 'icon-cart-tilt.svg' | inline_asset_content

  assign button_style = style | default: 'round'
  assign pill_label = label | default: default_label
  # The icon: 'cart' (the drawing that drives off), 'custom' (an uploaded image) or 'none' (pill only)
  assign icon_mode = 'cart'
  if icon_image != blank
    assign icon_mode = 'custom'
  endif
  if button_style == 'pill' and show_icon == false
    assign icon_mode = 'none'
  endif
  assign button_size = size | default: 50
  assign button_color = icon_color | default: '#ffffff'
  capture quick_add_style
    echo '--quick-add-size: ' | append: button_size | append: 'px; --quick-add-color: ' | append: button_color | append: ';'
  endcapture

  # Overlay behind the round button: only when a strength above 0 is given
  assign overlay_class = ''
  assign overlay_value = overlay | default: 0
  if button_style == 'round' and overlay_value > 0
    assign overlay_class = ' quick-add--overlay'
    assign quick_add_style = quick_add_style | append: ' --quick-add-overlay: ' | append: overlay_value | append: '%;'
  endif

  # Own form id: Shopify's default (product_form_<product id>) repeats when the same product shows two
  # times on a page (Related products: a tile and a full card; Product panels and Product deck on one
  # page). The section id, the style, the class and the caller's suffix make it unique
  assign form_id = 'QuickAdd-' | append: section.id | append: '-' | append: product.id | append: '-' | append: button_style
  if class != blank
    assign class_key = class | handleize
    assign form_id = form_id | append: '-' | append: class_key
  endif
  if id_suffix != blank
    assign form_id = form_id | append: '-' | append: id_suffix
  endif
-%}

{%- capture quick_add_tick -%}
  <span class="quick-add__tick">
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 12.5 4 4 8-9"/></svg>
  </span>
{%- endcapture -%}

{%- capture quick_add_art -%}
  {%- if icon_mode == 'cart' -%}
    <span class="quick-add__line quick-add__line--1" aria-hidden="true"></span>
    <span class="quick-add__line quick-add__line--2" aria-hidden="true"></span>
    <span class="quick-add__cart" aria-hidden="true">
      <span class="quick-add__icon quick-add__icon--upright">{{ cart_icon }}</span>
      <span class="quick-add__icon quick-add__icon--tilt">{{ tilt_icon }}</span>
      {{ quick_add_tick }}
    </span>
  {%- else -%}
    {%- comment -%}
      Custom icon or no icon: a spinner while adding (an uploaded image can't drive off), then the tick.
      No icon: this box only shows while adding and added (before the text)
    {%- endcomment -%}
    <span class="quick-add__cart quick-add__cart--{{ icon_mode }}" aria-hidden="true">
      {%- if icon_mode == 'custom' -%}
        <span class="quick-add__icon quick-add__icon--custom">
          {{- icon_image | image_url: width: 48 | image_tag: alt: '', loading: 'lazy' -}}
        </span>
      {%- endif -%}
      <span class="quick-add__spinner"></span>
      {{ quick_add_tick }}
    </span>
  {%- endif -%}
{%- endcapture -%}

{%- comment -%}
  The pill shows its label as text, so that text must be the start of its accessible name (an
  aria-label "Add Serum to cart" would hide the visible "Add to cart" from voice control): the visible
  text, then the product name in a visually hidden span ("Add to cart: Serum").
{%- endcomment -%}
{%- capture hidden_name -%}
  <span class="visually-hidden" data-quick-add-name>: {{ add_name | escape }}</span>
{%- endcapture -%}

{%- if can_add -%}
  <quick-add
    class="quick-add quick-add--{{ button_style }}{{ overlay_class }} {{ class }}"
    style="{{ quick_add_style }}"
    data-variant-id="{{ variant.id }}"
    data-label-added="{{ 'products.quick_add.added' | t: title: add_name }}"
    data-label-error="{{ 'products.quick_add.error' | t }}"
  >
    {%- form 'product', product, id: form_id, class: 'quick-add__form' -%}
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      {%- if button_style == 'pill' -%}
        <button type="submit" class="quick-add__button">
          {{ quick_add_art }}
          {%- comment -%} In a span, so a caller can hide only the text (the product card's round look) {%- endcomment -%}
          <span class="quick-add__label">{{ pill_label | escape }}</span>
          {{- hidden_name -}}
        </button>
      {%- else -%}
        <button type="submit" class="quick-add__button" aria-label="{{ add_label | escape }}">
          {{ quick_add_art }}
        </button>
      {%- endif -%}
    {%- endform -%}
    <span class="visually-hidden" role="status" data-quick-add-status></span>
    {%- comment -%}
      The error message is a popover: it shows in the top layer, so a card with overflow: hidden can't
      cut it off. aria-hidden: the status line above reads it out.
    {%- endcomment -%}
    <span class="quick-add__message" popover="manual" aria-hidden="true" data-quick-add-message hidden></span>
  </quick-add>
{%- elsif button_style == 'pill' -%}
  <div class="quick-add quick-add--pill {{ class }}" style="{{ quick_add_style }}">
    {%- if product.available -%}
      <a class="quick-add__button" href="{{ product.url }}">
        {{- 'products.card.view_details' | t -}}
        {{- hidden_name -}}
      </a>
    {%- else -%}
      <button type="button" class="quick-add__button" disabled>
        {{- 'products.sold_out' | t -}}
        {{- hidden_name -}}
      </button>
    {%- endif -%}
  </div>
{%- else -%}
  <div class="quick-add{{ overlay_class }} {{ class }}" style="{{ quick_add_style }}">
    <a class="quick-add__button" href="{{ product.url }}" aria-label="{{ choose_label | escape }}">
      {{ quick_add_art }}
    </a>
  </div>
{%- endif -%}

{% stylesheet %}
  quick-add {
    display: block;
  }

  /*
    Overlay behind the round button (overlay: N): the glass button is white at 25%, so on a light photo
    it disappears. A soft dark circle, twice the button's size, fades out from its middle. The rest of
    the photo stays untouched. z-index -1 puts the circle behind the button but above the photo: the
    caller's position + z-index make the button its own stacking layer. :where() keeps this fallback
    position at zero specificity, so the caller's position: absolute always wins. The circle shows and
    hides with the button (same element).
  */
  :where(.quick-add--overlay) {
    position: relative;
  }

  .quick-add--overlay::before {
    content: "";
    position: absolute;
    inset: -50%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, #000000 var(--quick-add-overlay, 0%), transparent),
      transparent
    );
    pointer-events: none;
  }

  .quick-add__form {
    margin: 0;
  }

  /*
    Figma "Liquid Glass Button": 50px circle, white at 25%, soft grey glow, white 17.5px cart.
    Scoped under .quick-add so it outranks the theme's general button[type="submit"] style.
  */
  .quick-add .quick-add__button {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: var(--quick-add-size, 50px);
    block-size: var(--quick-add-size, 50px);
    min-block-size: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-glass);
    box-shadow: var(--glass-shadow), var(--glass-rim);
    color: var(--quick-add-color, #ffffff);
    cursor: pointer;
    -webkit-backdrop-filter: blur(var(--glass-frost));
    backdrop-filter: blur(var(--glass-frost));
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .quick-add .quick-add__button:hover {
    background-color: #ffffff59;
    box-shadow: var(--glass-shadow), var(--glass-rim); /* the theme's button:hover removes shadows */
  }

  .quick-add__button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  /*
    Pill (Figma article sidebar "🛒 ADD TO CART"): a white pill with the soft glass shadow, accent
    label and cart. Same two-class weight as the circle above, written after it, so it wins.
  */
  .quick-add--pill .quick-add__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    inline-size: auto;
    padding-inline: var(--space-lg);
    background-color: var(--color-background);
    box-shadow: var(--shadow-header);
    color: var(--color-accent);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-nav);
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .quick-add--pill .quick-add__button:hover {
    background-color: var(--color-accent);
    box-shadow: var(--shadow-header);
    color: var(--color-background);
  }

  .quick-add--pill .quick-add__button:focus-visible {
    outline-color: var(--color-accent);
  }

  .quick-add--pill .quick-add__button:disabled {
    background-color: var(--color-background);
    color: var(--color-text);
    cursor: default;
    opacity: 0.55;
  }

  /*
    The pill's cart stays in place while adding: the circle's drive-off distance is worked out from the
    circle's size and would run over the label. It tilts, then the gold tick pops in.
  */
  .quick-add--pill .quick-add__line {
    display: none;
  }

  quick-add.quick-add--pill.is-adding .quick-add__icon--tilt {
    animation: none;
  }

  /* The cart: both poses stacked; the tick sits on its top right */
  /* Cart icon: 17.5px in the 50px Figma button = 35% of the button */
  .quick-add__cart {
    position: relative;
    display: grid;
    inline-size: calc(var(--quick-add-size, 50px) * 0.35);
    block-size: calc(var(--quick-add-size, 50px) * 0.35);
  }

  .quick-add__icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
  }

  /*
    The three poses come from Figma with different canvas sizes (upright 19x19, tilted 21x21,
    slightly tilted 22x20) but the cart drawing is the same size in each. Each SVG is therefore drawn
    at its real size relative to the upright one (19 units = the icon box), centred in the same spot,
    so the cart keeps its scale when the poses swap instead of jumping.
  */
  .quick-add__icon svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .quick-add__icon--tilt svg {
    inline-size: calc(100% * 21 / 19);
    block-size: calc(100% * 21 / 19);
  }

  .quick-add__icon--tilt {
    opacity: 0;
  }

  /*
    Custom icon (icon_image): the uploaded image at the icon size, its own colours. No icon (pill,
    show_icon: false): the box takes no room at rest and shows only while adding and added, before the
    text. Both: a spinner while adding, then the tick.
  */
  .quick-add__icon--custom img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .quick-add__spinner {
    grid-area: 1 / 1;
    box-sizing: border-box;
    inline-size: 100%;
    block-size: 100%;
    border: 2px solid currentcolor;
    border-inline-end-color: transparent;
    border-radius: 50%;
    opacity: 0;
  }

  quick-add.is-adding .quick-add__icon--custom {
    opacity: 0;
  }

  quick-add.is-adding .quick-add__spinner {
    opacity: 1;
    animation: quick-add-spin 0.8s linear infinite;
  }

  .quick-add__cart--none {
    display: none;
  }

  quick-add:is(.is-adding, .is-added, .is-resetting) .quick-add__cart--none {
    display: grid;
  }

  /* No icon: the tick takes the spinner's place (there is no icon to sit on) */
  .quick-add__cart--none .quick-add__tick {
    position: static;
    grid-area: 1 / 1;
    inline-size: 100%;
    block-size: 100%;
  }

  @keyframes quick-add-spin {
    to { rotate: 1turn; }
  }

  /*
    Speed lines (Figma, in the 50px button): two 7px lines, 1px thick.
    Line 1: 30px from the top, 22px from the left. Line 2: 32px from the top, 19px from the left.
  */
  .quick-add__line {
    position: absolute;
    display: block;
    inline-size: 14%;
    block-size: max(1px, calc(var(--quick-add-size, 50px) * 0.02));
    border-radius: var(--radius-pill);
    background-color: currentcolor;
    opacity: 0;
  }

  /* Positions as % of the button (Figma px / 50), so they stay right at every button size */
  .quick-add__line--1 {
    inset-block-start: 60%;
    inset-inline-start: 44%;
  }

  .quick-add__line--2 {
    inset-block-start: 64%;
    inset-inline-start: 38%;
  }

  /* Gold circle with a white tick */
  .quick-add__tick {
    position: absolute;
    inset-block-start: -45%;
    inset-inline-end: -50%;
    display: grid;
    place-items: center;
    inline-size: 80%;
    block-size: 80%;
    border-radius: var(--radius-pill);
    background-color: #c8a24b;
    color: #ffffff;
    opacity: 0;
    scale: 0;
  }

  .quick-add__tick svg {
    inline-size: 65%;
    block-size: 65%;
  }

  /* Adding: tilt, speed lines, drive off right, roll back in from the left (1s) */
  quick-add.is-adding .quick-add__icon--upright {
    opacity: 0;
  }

  quick-add.is-adding .quick-add__icon--tilt {
    opacity: 1;
    animation: quick-add-drive 1s var(--ease-out) both;
  }

  quick-add.is-adding .quick-add__line {
    animation: quick-add-lines 1s linear both;
  }

  /*
    Added (Figma states 4 -> 5): the tick pops in while the cart is still tilted, then the tilted cart
    cross-fades into the upright one, which stays.
  */
  quick-add.is-added .quick-add__icon--tilt {
    animation: quick-add-tilt-out 0.6s var(--ease-out) both;
  }

  quick-add.is-added .quick-add__icon--upright {
    animation: quick-add-upright-in 0.6s var(--ease-out) both;
  }

  quick-add.is-added .quick-add__tick {
    animation: quick-add-tick 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  /* Back to the normal button when the "Added" card closes: the tick shrinks away (the cart stays) */
  quick-add.is-resetting .quick-add__tick {
    animation: quick-add-tick 0.3s ease-in reverse both;
  }

  quick-add.is-error .quick-add__button {
    animation: quick-add-shake 0.4s ease both;
  }

  /*
    Error message near the button: the reason a product can't be added (e.g. Shopify's "You can't add
    more ... to the cart." when the bag already holds all the stock). A small dark pill for 4 seconds. It is a popover (top layer, never cut off by a card): fixed position,
    the script writes --message-top / --message-left from the button's place (above it, else below,
    kept inside the screen). The resets undo the browser's popover box (centred, border, padding).
  */
  .quick-add__message {
    position: fixed;
    inset: auto;
    top: var(--message-top, 0);
    left: var(--message-left, 0);
    inline-size: max-content;
    max-inline-size: min(15rem, calc(100vw - 1rem));
    margin: 0;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: var(--radius-sm);
    background-color: #1f1f1fe6;
    color: #ffffff;
    font-size: var(--font-size-small);
    line-height: 1.4;
    text-align: start;
    pointer-events: none;
  }

  quick-add {
    position: relative;
  }

  /* hidden = off in every browser; browsers without popovers (Safari < 17) show it in place, fixed */
  .quick-add__message[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .quick-add__message:not([hidden]) {
      animation: quick-add-message 0.2s var(--ease-out);
    }
  }

  @keyframes quick-add-message {
    from {
      opacity: 0;
      translate: 0 0.25rem;
    }
  }

  /* One cross-fade from the tilted to the upright cart, after the tick has popped in */
  @keyframes quick-add-tilt-out {
    0%, 35% { opacity: 1; }
    100% { opacity: 0; }
  }

  @keyframes quick-add-upright-in {
    0%, 35% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* Figma state 2: the tilted cart edges a few px right while the lines appear, then drives off */
  @keyframes quick-add-drive {
    0% { translate: 0 0; }
    20% { translate: calc(var(--quick-add-size, 50px) * 0.1) 0; }
    48% { translate: calc(var(--quick-add-size, 50px) * 0.9) 0; }
    48.01% { translate: calc(var(--quick-add-size, 50px) * -0.9) 0; }
    85%,
    100% { translate: 0 0; }
  }

  /* Speed lines only while the cart drives OFF (they'd cross the cart while it rolls back in) */
  @keyframes quick-add-lines {
    0% { opacity: 0; translate: calc(var(--quick-add-size, 50px) * 0.1) 0; }
    12% { opacity: 1; translate: 0 0; }
    38% { opacity: 1; translate: calc(var(--quick-add-size, 50px) * -0.06) 0; }
    48%, 100% { opacity: 0; translate: calc(var(--quick-add-size, 50px) * -0.06) 0; }
  }

  @keyframes quick-add-tick {
    from { opacity: 0; scale: 0; }
    to { opacity: 1; scale: 1; }
  }

  @keyframes quick-add-shake {
    0%, 100% { translate: 0 0; }
    25% { translate: -4px 0; }
    75% { translate: 4px 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    quick-add.is-adding .quick-add__icon--upright {
      opacity: 1;
    }

    quick-add.is-adding :is(.quick-add__icon--tilt, .quick-add__line) {
      opacity: 0;
      animation: none;
    }

    quick-add.is-added .quick-add__icon--tilt {
      opacity: 0;
      animation: none;
    }

    quick-add.is-added .quick-add__icon--upright {
      opacity: 1;
      animation: none;
    }

    quick-add.is-added .quick-add__tick {
      animation: none;
      opacity: 1;
      scale: 1;
    }

    quick-add.is-resetting .quick-add__tick {
      animation: none;
    }

    quick-add.is-error .quick-add__button {
      animation: none;
    }

    /* The spinner stands still: the open ring still says "busy" */
    quick-add.is-adding .quick-add__spinner {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <quick-add>: adds the product with Shopify's Cart AJAX API instead of submitting the form, plays
   * the cart animation, then updates the header's cart count. The animation (1s) and the request run
   * together; the tick shows once both are done, so a fast request still gets the full animation.
   * Then the "Added to your bag" card shows (cart:added), and when it closes the button goes back to its
   * normal state.
   */
  class QuickAdd extends HTMLElement {
    static HOLD = 2500; // ms the tick stays when the page has no "Added" card

    connectedCallback() {
      // One controller for every listener: an element moved in the page (theme editor, the product
      // page's pinned track) connects again, and two submit listeners would add 2
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.form = this.querySelector('form');
      this.status = this.querySelector('[data-quick-add-status]');
      this.message = this.querySelector('[data-quick-add-message]');
      this.form?.addEventListener(
        'submit',
        (event) => {
          event.preventDefault();
          this.add();
        },
        { signal }
      );
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.closeListener?.abort();
      this.hideMessage();
      clearTimeout(this.resetTimer);
      this.classList.remove('is-adding', 'is-added', 'is-resetting', 'is-error');
      this.busy = false;
    }

    async add() {
      if (this.busy) return;
      this.busy = true;
      clearTimeout(this.resetTimer);
      this.closeListener?.abort();
      this.hideMessage();
      this.classList.remove('is-added', 'is-resetting', 'is-error');
      this.classList.add('is-adding');

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const root = window.Shopify?.routes?.root || '/';
      const request = fetch(`${root}cart/add.js`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(this.dataset.variantId), quantity: 1 }] }),
      }).then(async (response) => {
        const data = await response.json().catch(() => ({}));
        // Shopify explains a refused add (e.g. stock) in "description" or "message"
        if (!response.ok) throw new Error(data.description || data.message || '');
        return data;
      });
      const drive = new Promise((resolve) => setTimeout(resolve, reduced ? 0 : 1000));

      try {
        const [data] = await Promise.all([request, drive]);
        this.classList.replace('is-adding', 'is-added');
        this.announce(this.dataset.labelAdded);

        // The "Added to your bag" card (snippets/cart-notification.liquid) shows the line. Its
        // quantity in Shopify's answer is the line's total in the bag, not just this add.
        const card = document.querySelector('cart-notification');
        document.dispatchEvent(new CustomEvent('cart:added', { detail: { item: data?.items?.[0] } }));
        // The header's <cart-count> refreshes the count (and tells the cart page and the card)
        document.dispatchEvent(new CustomEvent('cart:changed'));

        // Back to the normal button when the card closes (or after a moment where there is no card,
        // e.g. on the cart page): the tick shrinks away (0.3s), the cart stays. Listening only after
        // "cart:added": that event closes a card still open for another button, not this one.
        const reset = () => {
          clearTimeout(this.resetTimer);
          this.closeListener?.abort();
          this.classList.replace('is-added', 'is-resetting');
          this.resetTimer = setTimeout(() => this.classList.remove('is-resetting'), reduced ? 0 : 300);
        };
        this.closeListener?.abort();
        this.closeListener = new AbortController();
        document.addEventListener('cart-notification:close', reset, { once: true, signal: this.closeListener.signal });
        if (!card) this.resetTimer = setTimeout(reset, QuickAdd.HOLD);
      } catch (error) {
        this.classList.remove('is-adding');
        this.classList.add('is-error');
        const reason = error?.message || this.dataset.labelError;
        this.announce(reason);
        this.showMessage(reason, 4000);
        this.resetTimer = setTimeout(() => this.classList.remove('is-error'), 600);
      } finally {
        this.busy = false;
      }
    }

    /**
     * Shows the message near the button for `duration` ms: above it, or below when there's no room,
     * kept 8px inside the screen. A popover (top layer) where the browser has them, so a card's
     * overflow: hidden can't cut it off. Its place is fixed on the screen, so it goes on scroll.
     */
    showMessage(message, duration) {
      const box = this.message;
      if (!box || !message) return;
      box.textContent = message;
      box.hidden = false;
      if (box.showPopover && !box.matches(':popover-open')) box.showPopover();

      const button = this.querySelector('.quick-add__button')?.getBoundingClientRect();
      if (button) {
        const gap = 8;
        const { width, height } = box.getBoundingClientRect();
        let top = button.top - height - gap;
        if (top < gap) top = button.bottom + gap;
        const left = Math.min(Math.max(gap, button.left + button.width / 2 - width / 2), window.innerWidth - width - gap);
        box.style.setProperty('--message-top', `${Math.round(top)}px`);
        box.style.setProperty('--message-left', `${Math.round(left)}px`);
      }

      clearTimeout(this.messageTimer);
      this.messageTimer = setTimeout(() => this.hideMessage(), duration);
      this.onScroll ??= () => this.hideMessage();
      window.addEventListener('scroll', this.onScroll, { passive: true, once: true });
      window.addEventListener('resize', this.onScroll, { once: true });
    }

    hideMessage() {
      const box = this.message;
      clearTimeout(this.messageTimer);
      if (this.onScroll) {
        window.removeEventListener('scroll', this.onScroll);
        window.removeEventListener('resize', this.onScroll);
      }
      if (!box || box.hidden) return;
      if (box.hidePopover && box.matches(':popover-open')) box.hidePopover();
      box.hidden = true;
    }

    announce(message) {
      if (!this.status) return;
      this.status.textContent = '';
      requestAnimationFrame(() => {
        this.status.textContent = message;
      });
    }
  }

  if (!customElements.get('quick-add')) {
    customElements.define('quick-add', QuickAdd);
  }
{% endjavascript %}
